                            	  3001: 
                            	  3002: ;================================================================
                            	  3003: ; TIER 6 — region arithmetic
                            	  3004: ;
                            	  3005: ;   z AAAA NNNN         XOR and additive sum of a region, as words
                            	  3006: ;   f AAAA NNNN VVVV    fill a region with a word
                            	  3007: ;
                            	  3008: ; Both exist because the link is 9600 baud.  Verifying 64 KB of ROM by
                            	  3009: ; dumping it is ~512 round trips and about six minutes; `z F00000 10000`
                            	  3010: ; is one round trip, and reproduces self-test phase $300 exactly — that
                            	  3011: ; phase XORs every word of the ROM and requires zero, retrying forever
                            	  3012: ; on a mismatch, which is why patch_rom.py recomputes the trailing word.
                            	  3013: ;
                            	  3014: ; XOR catches bit errors.  It cannot see ORDERING, so the additive sum
                            	  3015: ; runs in the same pass: two accumulators, one traversal.
                            	  3016: ;================================================================
                            	  3017: cmd_sum:
01:00F0BD7A 528E            	  3018:                 addq.l  #1,a6
01:00F0BD7C 6100F4BE        	  3019:                 bsr.w   skip_ws
01:00F0BD80 6100F4CE        	  3020:                 bsr.w   parse_hex
01:00F0BD84 4A01            	  3021:                 tst.b   d1
01:00F0BD86 6700EE18        	  3022:                 beq.w   cmd_err
01:00F0BD8A 2800            	  3023:                 move.l  d0,d4                   ; start
01:00F0BD8C 7E02            	  3024:                 moveq   #2,d7                   ; word access, for odd_check
01:00F0BD8E 6100F822        	  3025:                 bsr.w   odd_check
01:00F0BD92 4A01            	  3026:                 tst.b   d1
01:00F0BD94 6700EBDA        	  3027:                 beq.w   cmd_loop
01:00F0BD98 6100F4A2        	  3028:                 bsr.w   skip_ws
01:00F0BD9C 6100F4B2        	  3029:                 bsr.w   parse_hex
01:00F0BDA0 4A01            	  3030:                 tst.b   d1
01:00F0BDA2 6700EDFC        	  3031:                 beq.w   cmd_err
                            	  3032:                 ; UNSIGNED bound, as everywhere else in this monitor: the
                            	  3033:                 ; whole 68000 address space is $1000000 bytes, a few
                            	  3034:                 ; seconds at 8 MHz.  A signed compare here would be the
                            	  3035:                 ; fourth instance of the bug fixed at cmd_mem/cmd_page/
                            	  3036:                 ; cmd_bulk.
01:00F0BDA6 0C8001000000    	  3037:                 cmpi.l  #$1000000,d0
01:00F0BDAC 6306            	  3038:                 bls.b   .havelen
01:00F0BDAE 203C01000000    	  3039:                 move.l  #$1000000,d0
                            	  3040: .havelen:
01:00F0BDB4 E288            	  3041:                 lsr.l   #1,d0                   ; bytes -> words
01:00F0BDB6 6700EDE8        	  3042:                 beq.w   cmd_err                 ; a zero count would wrap
01:00F0BDBA 2600            	  3043:                 move.l  d0,d3
01:00F0BDBC 2844            	  3044:                 move.l  d4,a4
01:00F0BDBE 7A00            	  3045:                 clr.l   d5                      ; XOR accumulator
01:00F0BDC0 7C00            	  3046:                 clr.l   d6                      ; additive sum
                            	  3047: .lp:
01:00F0BDC2 301C            	  3048:                 move.w  (a4)+,d0
01:00F0BDC4 B145            	  3049:                 eor.w   d0,d5
01:00F0BDC6 02800000FFFF    	  3050:                 andi.l  #$FFFF,d0
01:00F0BDCC DC80            	  3051:                 add.l   d0,d6
01:00F0BDCE 5383            	  3052:                 subq.l  #1,d3
01:00F0BDD0 66F0            	  3053:                 bne.b   .lp
01:00F0BDD2 41FA0CA2        	  3054:                 lea     sum_x_msg(pc),a0        ; puts/puthex clobber d0 only,
01:00F0BDD6 6100F72C        	  3055:                 bsr.w   puts                    ;   so d5 and d6 survive
01:00F0BDDA 3005            	  3056:                 move.w  d5,d0
01:00F0BDDC 6100F76A        	  3057:                 bsr.w   puthex_word
01:00F0BDE0 41FA0C9A        	  3058:                 lea     sum_a_msg(pc),a0
01:00F0BDE4 6100F71E        	  3059:                 bsr.w   puts
01:00F0BDE8 2006            	  3060:                 move.l  d6,d0
01:00F0BDEA 6100F768        	  3061:                 bsr.w   puthex_long
01:00F0BDEE 6100F720        	  3062:                 bsr.w   put_crlf
01:00F0BDF2 6000EB7C        	  3063:                 bra.w   cmd_loop
