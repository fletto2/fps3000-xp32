01:00F0B74A 6C04            	  1900:                 bge.b   .lloop
01:00F0B74C 06450040        	  1901:                 addi.w  #MON_RING_N,d5
                            	  1902: .lloop:
01:00F0B750 3005            	  1903:                 move.w  d5,d0
01:00F0B752 02800000FFFF    	  1904:                 andi.l  #$FFFF,d0
01:00F0B758 C0FC000A        	  1905:                 mulu.w  #MON_RING_SZ,d0
01:00F0B75C 49F90000F900    	  1906:                 lea     MON_RING,a4
01:00F0B762 D9C0            	  1907:                 adda.l  d0,a4
01:00F0B764 102C0008        	  1908:                 move.b  8(a4),d0                ; channel
01:00F0B768 6100FC90        	  1909:                 bsr.w   puthex_byte
01:00F0B76C 103C0020        	  1910:                 move.b  #' ',d0
01:00F0B770 6100FC06        	  1911:                 bsr.w   putchar
01:00F0B774 3014            	  1912:                 move.w  (a4),d0                 ; timestamp
01:00F0B776 6100FC90        	  1913:                 bsr.w   puthex_word
01:00F0B77A 103C0020        	  1914:                 move.b  #' ',d0
01:00F0B77E 6100FBF8        	  1915:                 bsr.w   putchar
01:00F0B782 302C0002        	  1916:                 move.w  2(a4),d0                ; status
01:00F0B786 6100FC80        	  1917:                 bsr.w   puthex_word
01:00F0B78A 103C0020        	  1918:                 move.b  #' ',d0
01:00F0B78E 6100FBE8        	  1919:                 bsr.w   putchar
01:00F0B792 302C0004        	  1920:                 move.w  4(a4),d0                ; data hi
01:00F0B796 6100FC70        	  1921:                 bsr.w   puthex_word
01:00F0B79A 103C003A        	  1922:                 move.b  #':',d0
01:00F0B79E 6100FBD8        	  1923:                 bsr.w   putchar
01:00F0B7A2 302C0006        	  1924:                 move.w  6(a4),d0                ; data lo
01:00F0B7A6 6100FC60        	  1925:                 bsr.w   puthex_word
01:00F0B7AA 6100FC24        	  1926:                 bsr.w   put_crlf
01:00F0B7AE 5245            	  1927:                 addq.w  #1,d5
01:00F0B7B0 0C450040        	  1928:                 cmpi.w  #MON_RING_N,d5
01:00F0B7B4 6D04            	  1929:                 blt.b   .nowr
01:00F0B7B6 3A3C0000        	  1930:                 move.w  #0,d5
                            	  1931: .nowr:
