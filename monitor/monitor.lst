                            	  1345: ; ---- SIO init for 9600 8N1, RX+TX enabled, no IRQs ----
                            	  1346: sio_init:
                            	  1347:                 ; Channel reset
01:00F0B336 13FC001800F70015	  1348:                 move.b  #$18,SIO_A_CTRL         ; WR0: cmd 3 = chan reset
01:00F0B33E 4E71            	  1349:                 nop
01:00F0B340 4E71            	  1350:                 nop
01:00F0B342 4E71            	  1351:                 nop
01:00F0B344 4E71            	  1352:                 nop
                            	  1353:                 ; WR4: x16 clk, 1 stop, no parity
01:00F0B346 13FC000400F70015	  1354:                 move.b  #$04,SIO_A_CTRL         ; WR0: ptr to WR4
01:00F0B34E 13FC004400F70015	  1355:                 move.b  #$44,SIO_A_CTRL
                            	  1356:                 ; WR3: 8 bits/RX char, RX enable
01:00F0B356 13FC000300F70015	  1357:                 move.b  #$03,SIO_A_CTRL         ; WR0: ptr to WR3
01:00F0B35E 13FC00C100F70015	  1358:                 move.b  #$C1,SIO_A_CTRL
                            	  1359:                 ; WR5: 8 bits/TX char, TX enable, DTR, RTS
01:00F0B366 13FC000500F70015	  1360:                 move.b  #$05,SIO_A_CTRL         ; WR0: ptr to WR5
01:00F0B36E 13FC00EA00F70015	  1361:                 move.b  #$EA,SIO_A_CTRL
01:00F0B376 4E75            	  1362:                 rts
                            	  1363: 
                            	  1364: ; ---- putchar: send byte in d0 over SIO chA.  Bounded: drops the
                            	  1365: ;      character and sets MON_TXFAIL rather than hanging forever, so a
                            	  1366: ;      dead or mis-strapped SIO still lets the monitor make progress and
                            	  1367: ;      leaves evidence in RAM.  Preserves d0 and d1.
                            	  1368: putchar:
01:00F0B378 2F01            	  1369:                 move.l  d1,-(sp)
                            	  1370:                 ; Belt-and-braces: point the register pointer at RR0 before
                            	  1371:                 ; polling status.  On a Z80-SIO-family part the pointer
                            	  1372:                 ; auto-resets to 0 after each access, so this should be
                            	  1373:                 ; unnecessary -- but $00 to WR0 is the null command
                            	  1374:                 ; (pointer := 0, no side effect), it costs two instructions,
                            	  1375:                 ; and if the auto-reset does NOT behave as assumed the poll
                            	  1376:                 ; would otherwise read WR5 forever and never transmit.  One
                            	  1377:                 ; attempt per hardware trip: take the insurance.
01:00F0B37A 13FC000000F70015	  1378:                 move.b  #0,SIO_A_CTRL
01:00F0B382 72104841        	  1379:                 move.l  #TX_SPIN_LIMIT,d1
                            	  1380: .wait:
01:00F0B386 0839000200F70015	  1381:                 btst.b  #RR0_TX_EMPTY,SIO_A_CTRL
01:00F0B38E 6610            	  1382:                 bne.b   .ready
01:00F0B390 5381            	  1383:                 subq.l  #1,d1
01:00F0B392 66F2            	  1384:                 bne.b   .wait
                            	  1385:                 ; Timed out.  move.b, not an increment: a read-modify-write
                            	  1386:                 ; on never-written DRAM is a parity-BERR risk on real
                            	  1387:                 ; hardware, and this path runs when things are already bad.
01:00F0B394 13FC00010000F896	  1388:                 move.b  #1,MON_TXFAIL
01:00F0B39C 221F            	  1389:                 move.l  (sp)+,d1
01:00F0B39E 4E75            	  1390:                 rts
                            	  1391: .ready:
01:00F0B3A0 13C000F70011    	  1392:                 move.b  d0,SIO_A_DATA
01:00F0B3A6 221F            	  1393:                 move.l  (sp)+,d1
01:00F0B3A8 4E75            	  1394:                 rts
                            	  1395: 
                            	  1396: ; ---- getchar: receive byte from SIO chA into d0 ----
                            	  1397: ;      Deliberately unbounded: waiting indefinitely for a human to type
                            	  1398: ;      is correct behaviour for a monitor prompt, and a timeout here
                            	  1399: ;      would just spin the prompt.  The dangerous spin was putchar,
                            	  1400: ;      which blocks *before* any output exists; that one is bounded
                            	  1401: ;      above.  If a board goes quiet, MON_TXFAIL distinguishes "TX
                            	  1402: ;      never became ready" from "nobody typed anything".
                            	  1403: getchar:
01:00F0B3AA 13FC000000F70015	  1404:                 move.b  #0,SIO_A_CTRL           ; point at RR0 (see putchar)
                            	  1405: .poll:
01:00F0B3B2 0839000000F70015	  1406:                 btst.b  #RR0_RX_AVAIL,SIO_A_CTRL
01:00F0B3BA 67F6            	  1407:                 beq.b   .poll
01:00F0B3BC 103900F70011    	  1408:                 move.b  SIO_A_DATA,d0
01:00F0B3C2 4E75            	  1409:                 rts
                            	  1410: 
                            	  1411: ; ---- puts: print null-terminated string at (a0) ----
                            	  1412: puts:
01:00F0B3C4 1018            	  1413:                 move.b  (a0)+,d0
01:00F0B3C6 6706            	  1414:                 beq.b   .end
01:00F0B3C8 6100FFAE        	  1415:                 bsr.w   putchar
01:00F0B3CC 60F6            	  1416:                 bra.b   puts
                            	  1417: .end:
01:00F0B3CE 4E75            	  1418:                 rts
                            	  1419: 
                            	  1420: put_crlf:
01:00F0B3D0 103C000D        	  1421:                 move.b  #13,d0
01:00F0B3D4 6100FFA2        	  1422:                 bsr.w   putchar
01:00F0B3D8 103C000A        	  1423:                 move.b  #10,d0
01:00F0B3DC 6000FF9A        	  1424:                 bra.w   putchar
                            	  1425: 
                            	  1426: puthex_nibble:
01:00F0B3E0 0200000F        	  1427:                 andi.b  #$0F,d0
01:00F0B3E4 0C00000A        	  1428:                 cmpi.b  #10,d0
01:00F0B3E8 6D08            	  1429:                 blt.b   .num
01:00F0B3EA 06000037        	  1430:                 addi.b  #'A'-10,d0
01:00F0B3EE 6000FF88        	  1431:                 bra.w   putchar
                            	  1432: .num:
01:00F0B3F2 06000030        	  1433:                 addi.b  #'0',d0
01:00F0B3F6 6000FF80        	  1434:                 bra.w   putchar
                            	  1435: 
                            	  1436: puthex_byte:
01:00F0B3FA 2F00            	  1437:                 move.l  d0,-(sp)
01:00F0B3FC E808            	  1438:                 lsr.b   #4,d0
01:00F0B3FE 6100FFE0        	  1439:                 bsr.w   puthex_nibble
01:00F0B402 201F            	  1440:                 move.l  (sp)+,d0
01:00F0B404 6000FFDA        	  1441:                 bra.w   puthex_nibble
                            	  1442: 
                            	  1443: puthex_word:
01:00F0B408 E158            	  1444:                 rol.w   #8,d0
01:00F0B40A 6100FFEE        	  1445:                 bsr.w   puthex_byte
01:00F0B40E E158            	  1446:                 rol.w   #8,d0
01:00F0B410 6000FFE8        	  1447:                 bra.w   puthex_byte
                            	  1448: 
                            	  1449: puthex_long:
01:00F0B414 4840            	  1450:                 swap    d0
01:00F0B416 6100FFF0        	  1451:                 bsr.w   puthex_word
01:00F0B41A 4840            	  1452:                 swap    d0
01:00F0B41C 6000FFEA        	  1453:                 bra.w   puthex_word
                            	  1454: 
                            	  1455: ;================================================================
                            	  1456: ; TIER 1 — 16- and 32-bit peek/poke
                            	  1457: ;
                            	  1458: ; Every one of the 65 device addresses this project's
                            	  1459: ; reaching-definitions census resolves in the AP I/F and XLTR blocks
                            	  1460: ; is reached by a WORD access, and the AP I/F block is touched by
                            	  1461: ; plain `move` only (bar three `cmpi` on $FF0000).  The byte commands
                            	  1462: ; therefore cannot drive a single chassis register: `m`/`w` use
                            	  1463: ; move.b, and these are 16-bit-only blocks.
                            	  1464: ;
                            	  1465: ; The byte forms are KEPT rather than replaced.  The MC6840 PTM hangs
                            	  1466: ; off D0-D7 at ODD addresses ($F70001-$F7000F) and MUST be reached
                            	  1467: ; with move.b; so does the SIO.  Two access widths for two
                            	  1468: ; differently-wired classes of device.
                            	  1469: ;
                            	  1470: ;   mw AAAA [NN]   dump NN words (default 8, cap 64)
                            	  1471: ;   ml AAAA [NN]   dump NN longs (default 4, cap 32)
                            	  1472: ;   ww AAAA WWWW.. write words
                            	  1473: ;   wl AAAA LLLLLLLL.. write longs
                            	  1474: ;
                            	  1475: ; Odd addresses are REFUSED rather than attempted.  A word or long
                            	  1476: ; access at an odd address is an address error on a real 68000, and
                            	  1477: ; the emulator models it too since M68K_EMULATE_ADDRESS_ERROR was
                            	  1478: ; switched on — before that it silently completed them, which is how
                            	  1479: ; a move.w to the odd-byte MC6840 once ran clean in rehearsal.
                            	  1480: ; grp0_entry would catch the fault and now even reports the address,
                            	  1481: ; but a refusal names the operator's mistake instead of producing a
                            	  1482: ; fault report that reads like a dead device.
                            	  1483: ;================================================================
                            	  1484: 
                            	  1485: ; ---- xdump: dump d2 items of width d7 (2 or 4) starting at a4 ----
                            	  1486: xdump:
01:00F0B420 4A82            	  1487:                 tst.l   d2                      ; a zero count would run the
01:00F0B422 674C            	  1488:                 beq.b   .ret                    ;   item loop 4 billion times
01:00F0B424 2C02            	  1489:                 move.l  d2,d6                   ; items remaining
                            	  1490: .line:
01:00F0B426 200C            	  1491:                 move.l  a4,d0
01:00F0B428 6100FFEA        	  1492:                 bsr.w   puthex_long
01:00F0B42C 103C003A        	  1493:                 move.b  #':',d0
01:00F0B430 6100FF46        	  1494:                 bsr.w   putchar
01:00F0B434 7808            	  1495:                 moveq   #8,d4                   ; 8 words per line
01:00F0B436 0C070004        	  1496:                 cmpi.b  #4,d7
01:00F0B43A 6602            	  1497:                 bne.b   .cnt
01:00F0B43C 7804            	  1498:                 moveq   #4,d4                   ; or 4 longs
                            	  1499: .cnt:
01:00F0B43E BC84            	  1500:                 cmp.l   d4,d6
01:00F0B440 6C02            	  1501:                 bge.b   .full
01:00F0B442 2806            	  1502:                 move.l  d6,d4
                            	  1503: .full:
01:00F0B444 2604            	  1504:                 move.l  d4,d3
                            	  1505: .item:
01:00F0B446 103C0020        	  1506:                 move.b  #' ',d0
01:00F0B44A 6100FF2C        	  1507:                 bsr.w   putchar
01:00F0B44E 0C070004        	  1508:                 cmpi.b  #4,d7
01:00F0B452 6708            	  1509:                 beq.b   .l32
01:00F0B454 301C            	  1510:                 move.w  (a4)+,d0
01:00F0B456 6100FFB0        	  1511:                 bsr.w   puthex_word
01:00F0B45A 6006            	  1512:                 bra.b   .nx
                            	  1513: .l32:
01:00F0B45C 201C            	  1514:                 move.l  (a4)+,d0
01:00F0B45E 6100FFB4        	  1515:                 bsr.w   puthex_long
                            	  1516: .nx:
01:00F0B462 5383            	  1517:                 subq.l  #1,d3
01:00F0B464 66E0            	  1518:                 bne.b   .item
01:00F0B466 6100FF68        	  1519:                 bsr.w   put_crlf
01:00F0B46A 9C84            	  1520:                 sub.l   d4,d6
01:00F0B46C 6E00FFB8        	  1521:                 bgt.w   .line
                            	  1522: .ret:
01:00F0B470 4E75            	  1523:                 rts
                            	  1524: 
                            	  1525: ; ---- odd_check: d0 = address, d7 = width.  Prints and returns Z=0
                            	  1526: ;      (via d1=0) if the access would be an address error. ----
                            	  1527: odd_check:
01:00F0B472 0C070001        	  1528:                 cmpi.b  #1,d7
01:00F0B476 6712            	  1529:                 beq.b   .ok
01:00F0B478 08000000        	  1530:                 btst    #0,d0
01:00F0B47C 670C            	  1531:                 beq.b   .ok
01:00F0B47E 41FA1010        	  1532:                 lea     odd_msg(pc),a0
01:00F0B482 6100FF40        	  1533:                 bsr.w   puts
01:00F0B486 4201            	  1534:                 clr.b   d1
01:00F0B488 4E75            	  1535:                 rts
                            	  1536: .ok:
01:00F0B48A 7201            	  1537:                 moveq   #1,d1
01:00F0B48C 4E75            	  1538:                 rts
                            	  1539: 
                            	  1540: ;================================================================
                            	  1541: ; TIER 2 — device register maps
                            	  1542: ;
                            	  1543: ;   x   AP I/F  ($FF0000 bulk window + four channel windows)
                            	  1544: ;   y   XLTR    ($FF0200 control block + three MC68153 BIMs)
                            	  1545: ;
                            	  1546: ; Both walk a ROM table of addresses this project has POSITIVELY
                            	  1547: ; established, rather than sweeping the block.  Sweeping would touch
                            	  1548: ; addresses never shown to answer, and an unanswered address on this
                            	  1549: ; board is a bus error that aborts the dump — so a sweep would be
                            	  1550: ; both less informative and less safe than a table.
                            	  1551: ;
                            	  1552: ; $FF0008 is DELIBERATELY ABSENT from the AP I/F table.  It is the
                            	  1553: ; bulk data FIFO and READS POP IT: the S-record error paths spin
                            	  1554: ; `while ($FF0000 > 0) read (a0)` precisely to DRAIN a rejected
                            	  1555: ; record, and the stream read has no post-increment.  Dumping it as
                            	  1556: ; part of a register map would silently consume host data.  Use `e`.
                            	  1557: ;
                            	  1558: ; $FF0010 is absent because it does not exist: it is a register the
                            	  1559: ; emulator invented (APIF_CMD_ARG_HI), never accessed statically or
                            	  1560: ; at runtime.  Window 1 ($FF0020-$FF003F) is absent because the
                            	  1561: ; firmware's own (ch+1)<<5 arithmetic skips it by construction.
                            	  1562: ;
                            	  1563: ; The three BIM registers the firmware never individually programs —
                            	  1564: ; $FF0240 (BIM1 CR0), $FF0248 (BIM1 VR0) and $FF025E (BIM2 VR3) —
                            	  1565: ; ARE in the table.  They are written by self-test phase $1600's
                            	  1566: ; address-indexed walk, so they exist; only the firmware's per-channel
                            	  1567: ; programming skips them, and a map should show what the hardware has.
                            	  1568: ;================================================================
                            	  1569: 
                            	  1570: ; ---- devdump: walk the 12-byte table at a3 ----
                            	  1571: ;      entry = { addr.l, 7-char name, NUL }.  addr 0 terminates.
                            	  1572: devdump:
01:00F0B48E 2013            	  1573:                 move.l  (a3),d0
01:00F0B490 672E            	  1574:                 beq.b   .end
01:00F0B492 6100FF80        	  1575:                 bsr.w   puthex_long
01:00F0B496 103C0020        	  1576:                 move.b  #' ',d0
01:00F0B49A 6100FEDC        	  1577:                 bsr.w   putchar
01:00F0B49E 41EB0004        	  1578:                 lea     4(a3),a0
01:00F0B4A2 6100FF20        	  1579:                 bsr.w   puts
01:00F0B4A6 103C003D        	  1580:                 move.b  #'=',d0
01:00F0B4AA 6100FECC        	  1581:                 bsr.w   putchar
01:00F0B4AE 2053            	  1582:                 move.l  (a3),a0
01:00F0B4B0 3010            	  1583:                 move.w  (a0),d0
01:00F0B4B2 6100FF54        	  1584:                 bsr.w   puthex_word
01:00F0B4B6 6100FF18        	  1585:                 bsr.w   put_crlf
01:00F0B4BA 47EB000C        	  1586:                 lea     12(a3),a3
01:00F0B4BE 60CE            	  1587:                 bra.b   devdump
                            	  1588: .end:
01:00F0B4C0 4E75            	  1589:                 rts
                            	  1590: 
                            	  1591: cmd_apif:
01:00F0B4C2 41FA1008        	  1592:                 lea     apif_hdr(pc),a0
01:00F0B4C6 6100FEFC        	  1593:                 bsr.w   puts
01:00F0B4CA 47FA0596        	  1594:                 lea     apif_tab(pc),a3
01:00F0B4CE 6100FFBE        	  1595:                 bsr.w   devdump
01:00F0B4D2 41FA1073        	  1596:                 lea     fifo_msg(pc),a0
01:00F0B4D6 6100FEEC        	  1597:                 bsr.w   puts
01:00F0B4DA 6000F46C        	  1598:                 bra.w   cmd_loop
                            	  1599: 
                            	  1600: cmd_xltr:
01:00F0B4DE 41FA10DC        	  1601:                 lea     xltr_hdr(pc),a0
01:00F0B4E2 6100FEE0        	  1602:                 bsr.w   puts
01:00F0B4E6 47FA0662        	  1603:                 lea     xltr_tab(pc),a3
01:00F0B4EA 6100FFA2        	  1604:                 bsr.w   devdump
01:00F0B4EE 6000F458        	  1605:                 bra.w   cmd_loop
                            	  1606: 
                            	  1607: ;================================================================
                            	  1608: ; TIER 3 — an AC channel transaction, by hand
                            	  1609: ;
                            	  1610: ;   c CH OP        CH = 1..4, OP = 16-bit AC operation code
                            	  1611: ;
                            	  1612: ; Reproduces the firmware's own channel transaction primitive at
                            	  1613: ; $F07F12, which exists in five byte-identical copies (one per XP
                            	  1614: ; task plus RDHC's, at stride $2858):
                            	  1615: ;
                            	  1616: ;   mask the channel's BIM control register to $4F  (IRE cleared)
                            	  1617: ;   +$08 <- $0000          data high
                            	  1618: ;   +$0A <- operation code data low
                            	  1619: ;   +$0E <- $8004          REQUEST-TRANSFER
                            	  1620: ;   poll +$0E bit 14 = DONE, bit 13 = ERROR, 1000 iterations
                            	  1621: ;   on error  -> panel $269    on timeout -> panel $26C
                            	  1622: ;
                            	  1623: ; The channel window is $FF0000 + ((CH+1) << 5) — the firmware's own
                            	  1624: ; arithmetic at $F04CAA, which is why window 1 is skipped: (1+1)*32
                            	  1625: ; starts at $40.  BIM control registers come from the four-longword
                            	  1626: ; table at $F046E0: $244 $246 $250 $252, indexed by (CH-1)*4.  Note
                            	  1627: ; that is NOT a uniform stride.
                            	  1628: ;
                            	  1629: ; TEARDOWN IS UNCONDITIONAL.  The firmware's teardown clears the
                            	  1630: ; channel's bit in $FF021A and restores the BIM CR to $5F, and this
                            	  1631: ; project establishes that a chassis which raises a channel error and
                            	  1632: ; then ignores the resulting $269 leaves that bit SET and the BIM
                            	  1633: ; masked at $4F PERMANENTLY — the channel never re-enables and the
                            	  1634: ; machine degrades one channel at a time in a way that looks like a
                            	  1635: ; firmware bug.  This command therefore saves BOTH the BIM CR and the
                            	  1636: ; whole $FF021A word on entry and restores them on every exit path,
                            	  1637: ; including timeout and error.  Save-and-restore rather than the
                            	  1638: ; firmware's one-way clear: a probe should leave the machine as it
                            	  1639: ; found it, and $FF021A is clear-only in the firmware (50 sites, all
                            	  1640: ; bclr, zero bset) so emulating that here would be a one-shot.
                            	  1641: ;
                            	  1642: ; LATCH DISCRIMINATOR.  A model that merely acknowledges looks
                            	  1643: ; identical to a live AC unless you test for it: the emulator's
                            	  1644: ; chassis stub never examines the operation code (ch_lo is written
                            	  1645: ; and never read), so every opcode returns the same status, in ZERO
                            	  1646: ; polls, with the data pair echoing what was written.  This command
                            	  1647: ; reports that triple explicitly instead of printing "DONE" and
                            	  1648: ; letting the operator conclude an AC answered.
                            	  1649: ;================================================================
                            	  1650: cmd_ac:
01:00F0B4F2 528E            	  1651:                 addq.l  #1,a6
01:00F0B4F4 6100FC7E        	  1652:                 bsr.w   skip_ws
01:00F0B4F8 6100FC8E        	  1653:                 bsr.w   parse_hex
01:00F0B4FC 4A01            	  1654:                 tst.b   d1
01:00F0B4FE 6700F662        	  1655:                 beq.w   cmd_err
01:00F0B502 2A00            	  1656:                 move.l  d0,d5                   ; d5 = channel
01:00F0B504 7201            	  1657:                 moveq   #1,d1
01:00F0B506 BA81            	  1658:                 cmp.l   d1,d5
01:00F0B508 6D0000D6        	  1659:                 blt.w   .badch
01:00F0B50C 7204            	  1660:                 moveq   #4,d1
01:00F0B50E BA81            	  1661:                 cmp.l   d1,d5
01:00F0B510 6E0000CE        	  1662:                 bgt.w   .badch
01:00F0B514 6100FC5E        	  1663:                 bsr.w   skip_ws
01:00F0B518 6100FC6E        	  1664:                 bsr.w   parse_hex
01:00F0B51C 4A01            	  1665:                 tst.b   d1
01:00F0B51E 6700F642        	  1666:                 beq.w   cmd_err
01:00F0B522 3C00            	  1667:                 move.w  d0,d6                   ; d6 = opcode
                            	  1668: 
01:00F0B524 610000C6        	  1669:                 bsr.w   ch_window               ; a4 = window, a5 = BIM CR
01:00F0B528 3615            	  1670:                 move.w  (a5),d3                 ; save BIM CR
01:00F0B52A 383900FF021A    	  1671:                 move.w  $FF021A,d4              ; save IRQ mask word
                            	  1672: 
01:00F0B530 3ABC004F        	  1673:                 move.w  #$4F,(a5)               ; mask this channel
01:00F0B534 397C00000008    	  1674:                 move.w  #0,8(a4)                ; +$08 data high
01:00F0B53A 3946000A        	  1675:                 move.w  d6,$A(a4)               ; +$0A operation code
01:00F0B53E 397C8004000E    	  1676:                 move.w  #$8004,$E(a4)           ; +$0E REQUEST-TRANSFER
                            	  1677: 
01:00F0B544 7400            	  1678:                 clr.l   d2                      ; poll count
01:00F0B546 2E3C000003E8    	  1679:                 move.l  #1000,d7
                            	  1680: .poll:
01:00F0B54C 302C000E        	  1681:                 move.w  $E(a4),d0
01:00F0B550 0800000E        	  1682:                 btst    #14,d0                  ; DONE
01:00F0B554 6620            	  1683:                 bne.b   .done
01:00F0B556 0800000D        	  1684:                 btst    #13,d0                  ; ERROR
01:00F0B55A 6610            	  1685:                 bne.b   .err
01:00F0B55C 5282            	  1686:                 addq.l  #1,d2
01:00F0B55E 5387            	  1687:                 subq.l  #1,d7
01:00F0B560 66EA            	  1688:                 bne.b   .poll
                            	  1689: 
01:00F0B562 41FA10A1        	  1690:                 lea     ac_to_msg(pc),a0
01:00F0B566 6100FE5C        	  1691:                 bsr.w   puts
01:00F0B56A 6012            	  1692:                 bra.b   .report
                            	  1693: .err:
01:00F0B56C 41FA1087        	  1694:                 lea     ac_err_msg(pc),a0
01:00F0B570 6100FE52        	  1695:                 bsr.w   puts
01:00F0B574 6008            	  1696:                 bra.b   .report
                            	  1697: .done:
