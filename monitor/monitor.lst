Sections:
00: "segf0a826" (F0A826-F0A838)
01: "segf0a840" (F0A840-F0B82E)


Source: "monitor.s"
                            	     1: ; ----------------------------------------------------------------
                            	     2: ; FPS-3000 SBC Monitor / Debugger / Host Interface
                            	     3: ; Lives in the 21.9 KB of free ROM at $F0A826 onwards.
                            	     4: ;
                            	     5: ; Communicates over the on-board NEC µPD7201 SIO Channel A
                            	     6: ; ($F70011 data, $F70015 control), which the FPS firmware never
                            	     7: ; initialises or uses — so we have it all to ourselves.
                            	     8: ;
                            	     9: ; Triggered by jumping to monitor_entry (typically by patching
                            	    10: ; one or more vectors).
                            	    11: ; ----------------------------------------------------------------
                            	    12: 
                            	    13: ; µPD7201 register addresses, per Motorola's VERSAdos source for this
                            	    14: ; board — verdos06/SDLCPRI/NEC7201.EQ, in rms68k_source.SA:
                            	    15: ;
                            	    16: ;     NEC7201 EQU $F70011      <- ODD base: the chip is on D0-D7 / LDS
                            	    17: ;     ch A data    = base+0 = $F70011
                            	    18: ;     ch B data    = base+2 = $F70013
                            	    19: ;     ch A control = base+4 = $F70015
                            	    20: ;     ch B control = base+6 = $F70017
                            	    21: ;
                            	    22: ; Registers are grouped by FUNCTION (both data, then both control), not
                            	    23: ; interleaved per channel.  Earlier versions of this file used $F70010
                            	    24: ; and $F70012, which is wrong twice over: even addresses assert UDS only
                            	    25: ; and this chip never answers them (-> no DTACK -> BERR), and the odd
                            	    26: ; byte of that second slot, $F70013, is channel B's DATA register, not
                            	    27: ; channel A's control.  Corroborated by verdos06/_root/NEC7201.EQ
                            	    28: ; (CREG/SREG = 0, DREG = -4) and by the ROM's own MC6840 access at odd
                            	    29: ; $F70001/$F70003 in PTMInit (F09176).
                            	    30: SIO_A_DATA      equ     $F70011
                            	    31: SIO_A_CTRL      equ     $F70015
                            	    32: SIO_B_DATA      equ     $F70013
                            	    33: SIO_B_CTRL      equ     $F70017
                            	    34: 
                            	    35: ; Z80-SIO/i8274 RR0 status bits
                            	    36: RR0_RX_AVAIL    equ     0
                            	    37: RR0_TX_EMPTY    equ     2
                            	    38: 
                            	    39: ; Monitor RAM workspace.
                            	    40: ;
                            	    41: ; This used to live at $1F000, which was wrong in two ways at once:
                            	    42: ;
                            	    43: ;   * $1F000 is INSIDE the AU WCS staging buffer ($10000-$1FFFF), so
                            	    44: ;     loading a full 64 KB bank — the whole point of the L command —
                            	    45: ;     would overwrite the monitor's own saved registers, line buffer and
                            	    46: ;     stack partway through the transfer.
                            	    47: ;   * The factory firmware also writes live data there.  A RAM dump after
                            	    48: ;     booting the stock ROM to the scheduler idle loop shows 40 nonzero
                            	    49: ;     bytes in $1F000-$1F09F, so entering via the panic vector clobbered
                            	    50: ;     firmware state and quietly compromised `g`.
                            	    51: ;
                            	    52: ; Measured alternative: dumping RAM after a full stock boot shows
                            	    53: ; $01200-$0FFFF — 60,928 bytes — completely untouched by the firmware.
                            	    54: ; The workspace and the cold-path stack both now live there, which puts
                            	    55: ; them below the staging buffer AND out of the firmware's way, fixing
                            	    56: ; both problems at once.
                            	    57: ;
                            	    58: ; Caveat on the evidence: "untouched after booting to idle" is not proof
                            	    59: ; that RMS68K never allocates there under load — it is a measurement of
                            	    60: ; this chassis reaching its idle loop, not a guarantee.  It is strictly
                            	    61: ; better than the old placement, which was measurably in use.
                            	    62: MON_BASE        equ     $0F800
                            	    63: MON_REGS        equ     MON_BASE        ; saved D0..D7 then A0..A6 (15*4=60 bytes)
                            	    64: MON_SPC         equ     MON_BASE+$3C    ; saved PC (long) — at MON_REGS + 60
                            	    65: MON_SSR         equ     MON_BASE+$40    ; saved SR (word)
                            	    66: MON_LINEBUF     equ     MON_BASE+$50    ; cmd line buffer (64 B)
                            	    67: MON_LASTADDR    equ     MON_BASE+$90    ; last 'm' addr (long)
                            	    68: MON_GRP0        equ     MON_BASE+$94    ; frame kind: 0 = short (4-word,
                            	    69:                                         ;   resumable), 1 = group-0 (7-word
                            	    70:                                         ;   bus/addr error), $FF = no frame
                            	    71:                                         ;   at all (cold entry)
                            	    72: MON_NEST        equ     MON_BASE+$95    ; re-entry guard: 0 = not inside a
                            	    73:                                         ;   fault report, 1 = reporting,
                            	    74:                                         ;   2 = died re-entering (sticky)
                            	    75: MON_TXFAIL      equ     MON_BASE+$96    ; nonzero once a putchar has timed
                            	    76:                                         ;   out — survives for a RAM dump
                            	    77: 
                            	    78: ; Cold-entry supervisor stack top, growing down toward the workspace end
                            	    79: ; at MON_BASE+$97.  ~1.7 KB of stack, all inside the free region.  The
                            	    80: ; panic path deliberately leaves SP alone — it needs the firmware's
                            	    81: ; exception frame where the firmware left it.
                            	    82: MON_STACK       equ     $0FF00
                            	    83: 
                            	    84: ; Region srec_check refuses to load over: workspace + cold-entry stack.
                            	    85: MON_LO          equ     MON_BASE
                            	    86: MON_HI          equ     MON_STACK
                            	    87: 
                            	    88: ; Breakpoint table: 8 slots of {addr.l, saved original word}.  A slot
                            	    89: ; with addr = 0 is free.
                            	    90: MON_BPN         equ     8
                            	    91: MON_BPT         equ     MON_BASE+$A0    ; 8 * 6 bytes = 48, ends +$CF
                            	    92: MON_BP_SZ       equ     6
                            	    93: 
                            	    94: ; TRAP #14 opcode, used as the breakpoint trap.  Vector 46 at $B8.
                            	    95: BP_OPCODE       equ     $4E4E
                            	    96: BP_VECTOR       equ     $B8
                            	    97: TRACE_VECTOR    equ     $24             ; vector 9 — T-bit trace
                            	    98: SR_TRACE_BIT    equ     15              ; T bit in SR
                            	    99: 
                            	   100: ; putchar TX-ready spin limit.  The btst loop is ~20 cycles, so this is
                            	   101: ; roughly 20M cycles / ~2.5 s at 8 MHz — comfortably longer than one
                            	   102: ; character time even at the slowest strappable rate (50 baud = 200 ms),
                            	   103: ; while still being bounded.  An unbounded spin here is why a dead SIO
                            	   104: ; produced total silence on the first hardware attempt: the monitor hung
                            	   105: ; before emitting a single byte, so there was nothing to diagnose.
                            	   106: TX_SPIN_LIMIT   equ     $100000
                            	   107: 
                            	   108:                 org     $F0A826
                            	   109: 
                            	   110: ;================================================================
                            	   111: ; Cold entry — used when monitor is patched in as the reset PC.
                            	   112: ; SP isn't loaded by the FPS reset path, so we install it ourselves
                            	   113: ; before doing anything that pushes (like bsr).
                            	   114: ;================================================================
                            	   115: monitor_cold:
00:00F0A826 007C2700        	   116:                 ori.w   #$2700,sr               ; supervisor, IPL=7
00:00F0A82A 2E7C0000FF00    	   117:                 movea.l #MON_STACK,sp           ; supervisor stack (below
                            	   118:                                                 ;   the WCS staging buffer)
00:00F0A830 610008EA        	   119:                 bsr.w   cold_init               ; vectors + workspace
00:00F0A834 60000088        	   120:                 bra.w   monitor_common
                            	   121: 
                            	   122: ; monitor_entry MUST stay at $F0A840: patch_rom.py hardcodes
                            	   123: ; MON_ENTRY = 0xA840, and README.md / CLAUDE.md both document that
                            	   124: ; address.  Pinning it here means edits to monitor_cold above cannot
                            	   125: ; silently shift it and send the panic-vector patch into the middle of
                            	   126: ; an instruction.  vasm errors out if monitor_cold ever overflows.
                            	   127:                 org     $F0A840
                            	   128: 
                            	   129: ;================================================================
                            	   130: ; Exception entry — called as JMP target from patched vectors.
                            	   131: ;
                            	   132: ; If entered via an exception, the supervisor stack contains the
                            	   133: ; standard 7-word frame (or 4-word for IRQ).  We save D0-D7/A0-A6
                            	   134: ; into MON_REGS, then read the saved PC and SR from the stack.
                            	   135: ;================================================================
                            	   136: monitor_entry:
                            	   137:                 ; Re-entry guard FIRST, before clobbering anything: if we
                            	   138:                 ; are already reporting a fault, the fault is coming from
                            	   139:                 ; the monitor's own I/O path and reporting it again just
                            	   140:                 ; recurses, pushing a frame per pass until the stack eats
                            	   141:                 ; the workspace.  Bail to mon_dead and keep the FIRST
                            	   142:                 ; fault's PC/SR intact for post-mortem.
01:00F0A840 4A390000F895    	   143:                 tst.b   MON_NEST
01:00F0A846 66000062        	   144:                 bne.w   mon_dead
01:00F0A84A 13FC00010000F895	   145:                 move.b  #1,MON_NEST
                            	   146: 
01:00F0A852 48F97FFF0000F800	   147:                 movem.l d0-d7/a0-a6,MON_REGS
01:00F0A85A 13FC00000000F894	   148:                 move.b  #0,MON_GRP0             ; short frame: SR, then PC
01:00F0A862 33D70000F840    	   149:                 move.w  (sp),MON_SSR
01:00F0A868 23EF00020000F83C	   150:                 move.l  2(sp),MON_SPC
01:00F0A870 6000004C        	   151:                 bra.w   monitor_common
                            	   152: 
                            	   153: ;================================================================
                            	   154: ; grp0_entry — vectors 2 (bus error) and 3 (address error) ONLY.
                            	   155: ;
                            	   156: ; The 68000 pushes a 7-word group-0 frame, which is NOT laid out like
                            	   157: ; the 4-word frame every other exception uses:
                            	   158: ;
                            	   159: ;   (sp)+0  special status word
                            	   160: ;   (sp)+2  access address (long)
                            	   161: ;   (sp)+6  instruction register
                            	   162: ;   (sp)+8  status register      <- SR lives here, not at (sp)
                            	   163: ;   (sp)+10 program counter      <- PC lives here, not at 2(sp)
                            	   164: ;
                            	   165: ; Reading it as a short frame reports the SSW as "SR" and half the
                            	   166: ; fault address as "PC", which is worse than useless during bring-up.
                            	   167: ; Group-0 faults are also not resumable on a 68000, so flag the frame
                            	   168: ; and let cmd_go refuse rather than RTE into the weeds.
                            	   169: ;================================================================
                            	   170: grp0_entry:
01:00F0A874 4A390000F895    	   171:                 tst.b   MON_NEST
01:00F0A87A 6600002E        	   172:                 bne.w   mon_dead
01:00F0A87E 13FC00010000F895	   173:                 move.b  #1,MON_NEST
                            	   174: 
01:00F0A886 48F97FFF0000F800	   175:                 movem.l d0-d7/a0-a6,MON_REGS
01:00F0A88E 13FC00010000F894	   176:                 move.b  #1,MON_GRP0             ; group-0: not resumable
01:00F0A896 33EF00080000F840	   177:                 move.w  8(sp),MON_SSR
01:00F0A89E 23EF000A0000F83C	   178:                 move.l  10(sp),MON_SPC
01:00F0A8A6 60000016        	   179:                 bra.w   monitor_common
                            	   180: 
                            	   181: ;================================================================
                            	   182: ; mon_dead — nested fault.  Touch NO I/O (the I/O is what is broken)
                            	   183: ; and do not let the stack creep: re-anchor SP every pass, mark RAM so
                            	   184: ; a later RAM dump shows how we got here, and stop the CPU.  STOP with
                            	   185: ; IPL 7 still admits a level-7 NMI, so loop back and re-stop instead of
                            	   186: ; falling through into whatever follows.
                            	   187: ;================================================================
                            	   188: mon_dead:
01:00F0A8AA 2E7C0000FF00    	   189:                 movea.l #MON_STACK,sp           ; re-anchor: no creep
01:00F0A8B0 13FC00020000F895	   190:                 move.b  #2,MON_NEST             ; sticky post-mortem marker
01:00F0A8B8 4E722700        	   191:                 stop    #$2700
01:00F0A8BC 60EC            	   192:                 bra.b   mon_dead
                            	   193: 
                            	   194: monitor_common:
                            	   195: 
01:00F0A8BE 610008E0        	   196:                 bsr.w   sio_init
01:00F0A8C2 61000976        	   197:                 bsr.w   put_crlf
01:00F0A8C6 61000972        	   198:                 bsr.w   put_crlf
01:00F0A8CA 41FA09BE        	   199:                 lea     banner_msg(pc),a0
01:00F0A8CE 6100095E        	   200:                 bsr.w   puts
01:00F0A8D2 41FA0A6B        	   201:                 lea     entry_msg(pc),a0
01:00F0A8D6 61000956        	   202:                 bsr.w   puts
01:00F0A8DA 20390000F83C    	   203:                 move.l  MON_SPC,d0
01:00F0A8E0 6100099C        	   204:                 bsr.w   puthex_long
01:00F0A8E4 41FA0A69        	   205:                 lea     sr_msg(pc),a0
01:00F0A8E8 61000944        	   206:                 bsr.w   puts
01:00F0A8EC 30390000F840    	   207:                 move.w  MON_SSR,d0
01:00F0A8F2 6100097E        	   208:                 bsr.w   puthex_word
01:00F0A8F6 61000942        	   209:                 bsr.w   put_crlf
                            	   210: 
                            	   211: cmd_loop:
                            	   212:                 ; We reached the prompt, so the I/O path works: re-arm the
                            	   213:                 ; guard so a later fault is reportable too.
01:00F0A8FA 13FC00000000F895	   214:                 move.b  #0,MON_NEST
01:00F0A902 41FA0A52        	   215:                 lea     prompt_msg(pc),a0
01:00F0A906 61000926        	   216:                 bsr.w   puts
01:00F0A90A 610006D6        	   217:                 bsr.w   read_line               ; reads into MON_LINEBUF, term=0
01:00F0A90E 4DF90000F850    	   218:                 lea     MON_LINEBUF,a6          ; a6 = parse pointer
01:00F0A914 6100072A        	   219:                 bsr.w   skip_ws
01:00F0A918 1016            	   220:                 move.b  (a6),d0
01:00F0A91A 67DE            	   221:                 beq.b   cmd_loop                ; empty line
                            	   222: 
01:00F0A91C 0C00003F        	   223:                 cmpi.b  #'?',d0
01:00F0A920 67000066        	   224:                 beq.w   cmd_help
01:00F0A924 0C000068        	   225:                 cmpi.b  #'h',d0
01:00F0A928 6700005E        	   226:                 beq.w   cmd_help
01:00F0A92C 0C000072        	   227:                 cmpi.b  #'r',d0
01:00F0A930 6700006E        	   228:                 beq.w   cmd_regs
01:00F0A934 0C00006D        	   229:                 cmpi.b  #'m',d0
01:00F0A938 670000F6        	   230:                 beq.w   cmd_mem
01:00F0A93C 0C000064        	   231:                 cmpi.b  #'d',d0
01:00F0A940 6700014A        	   232:                 beq.w   cmd_dump
01:00F0A944 0C000077        	   233:                 cmpi.b  #'w',d0
01:00F0A948 67000146        	   234:                 beq.w   cmd_write
01:00F0A94C 0C000067        	   235:                 cmpi.b  #'g',d0
01:00F0A950 67000172        	   236:                 beq.w   cmd_go
01:00F0A954 0C00004C        	   237:                 cmpi.b  #'L',d0
01:00F0A958 670004A8        	   238:                 beq.w   cmd_load_srec
01:00F0A95C 0C000069        	   239:                 cmpi.b  #'i',d0
01:00F0A960 67000418        	   240:                 beq.w   cmd_info
01:00F0A964 0C000021        	   241:                 cmpi.b  #'!',d0
01:00F0A968 6700002A        	   242:                 beq.w   cmd_about
01:00F0A96C 0C000062        	   243:                 cmpi.b  #'b',d0
01:00F0A970 6700020C        	   244:                 beq.w   cmd_bp
01:00F0A974 0C000074        	   245:                 cmpi.b  #'t',d0
01:00F0A978 670003AC        	   246:                 beq.w   cmd_trace
                            	   247: 
01:00F0A97C 41FA09E0        	   248:                 lea     unknown_msg(pc),a0
01:00F0A980 610008AC        	   249:                 bsr.w   puts
01:00F0A984 6000FF74        	   250:                 bra.w   cmd_loop
                            	   251: 
                            	   252: ;----------------------------------------------------------------
                            	   253: ; Help — print command list
                            	   254: ;----------------------------------------------------------------
                            	   255: cmd_help:
01:00F0A988 41FA09EC        	   256:                 lea     help_msg(pc),a0
01:00F0A98C 610008A0        	   257:                 bsr.w   puts
01:00F0A990 6000FF68        	   258:                 bra.w   cmd_loop
                            	   259: 
                            	   260: ;----------------------------------------------------------------
                            	   261: ; About / Banner
                            	   262: ;----------------------------------------------------------------
                            	   263: cmd_about:
01:00F0A994 41FA08F4        	   264:                 lea     banner_msg(pc),a0
01:00F0A998 61000894        	   265:                 bsr.w   puts
01:00F0A99C 6000FF5C        	   266:                 bra.w   cmd_loop
                            	   267: 
                            	   268: ;----------------------------------------------------------------
                            	   269: ; Show registers
                            	   270: ;   format:
                            	   271: ;     D0=12345678  D1=12345678  D2=12345678  D3=12345678
                            	   272: ;     D4=12345678  D5=12345678  D6=12345678  D7=12345678
                            	   273: ;     A0=12345678  A1=12345678  A2=12345678  A3=12345678
                            	   274: ;     A4=12345678  A5=12345678  A6=12345678
                            	   275: ;     PC=12345678  SR=1234
                            	   276: ;----------------------------------------------------------------
                            	   277: cmd_regs:
01:00F0A9A0 7400            	   278:                 moveq   #0,d2                   ; reg index 0..14
                            	   279: .loop:
01:00F0A9A2 7600            	   280:                 moveq   #0,d3
01:00F0A9A4 1602            	   281:                 move.b  d2,d3
01:00F0A9A6 0C030008        	   282:                 cmpi.b  #8,d3
01:00F0A9AA 6D08            	   283:                 blt.b   .is_d
01:00F0A9AC 103C0041        	   284:                 move.b  #'A',d0
01:00F0A9B0 5103            	   285:                 subi.b  #8,d3
01:00F0A9B2 6004            	   286:                 bra.b   .show
                            	   287: .is_d:
01:00F0A9B4 103C0044        	   288:                 move.b  #'D',d0
                            	   289: .show:
01:00F0A9B8 61000828        	   290:                 bsr.w   putchar
01:00F0A9BC 1003            	   291:                 move.b  d3,d0
01:00F0A9BE 06000030        	   292:                 addi.b  #'0',d0
01:00F0A9C2 6100081E        	   293:                 bsr.w   putchar
01:00F0A9C6 103C003D        	   294:                 move.b  #'=',d0
01:00F0A9CA 61000816        	   295:                 bsr.w   putchar
                            	   296:                 ; load reg from MON_REGS[d2*4]
01:00F0A9CE 3002            	   297:                 move.w  d2,d0
01:00F0A9D0 E548            	   298:                 lsl.w   #2,d0
01:00F0A9D2 41F90000F800    	   299:                 lea     MON_REGS,a0
01:00F0A9D8 20300000        	   300:                 move.l  (a0,d0.w),d0
01:00F0A9DC 610008A0        	   301:                 bsr.w   puthex_long
01:00F0A9E0 103C0020        	   302:                 move.b  #' ',d0
01:00F0A9E4 610007FC        	   303:                 bsr.w   putchar
01:00F0A9E8 610007F8        	   304:                 bsr.w   putchar
01:00F0A9EC 5202            	   305:                 addq.b  #1,d2
                            	   306:                 ; new line every 4 regs
01:00F0A9EE 1002            	   307:                 move.b  d2,d0
01:00F0A9F0 02000003        	   308:                 andi.b  #3,d0
01:00F0A9F4 6604            	   309:                 bne.b   .nonl
01:00F0A9F6 61000842        	   310:                 bsr.w   put_crlf
                            	   311: .nonl:
01:00F0A9FA 0C02000F        	   312:                 cmpi.b  #15,d2
01:00F0A9FE 6DA2            	   313:                 blt.b   .loop
01:00F0AA00 61000838        	   314:                 bsr.w   put_crlf
01:00F0AA04 41FA0E1C        	   315:                 lea     pcmsg(pc),a0
01:00F0AA08 61000824        	   316:                 bsr.w   puts
01:00F0AA0C 20390000F83C    	   317:                 move.l  MON_SPC,d0
01:00F0AA12 6100086A        	   318:                 bsr.w   puthex_long
01:00F0AA16 41FA0E0F        	   319:                 lea     srmsg(pc),a0
01:00F0AA1A 61000812        	   320:                 bsr.w   puts
01:00F0AA1E 30390000F840    	   321:                 move.w  MON_SSR,d0
01:00F0AA24 6100084C        	   322:                 bsr.w   puthex_word
01:00F0AA28 61000810        	   323:                 bsr.w   put_crlf
01:00F0AA2C 6000FECC        	   324:                 bra.w   cmd_loop
                            	   325: 
                            	   326: ;----------------------------------------------------------------
                            	   327: ; Memory display (default 16 bytes from last addr or parsed addr)
                            	   328: ;   m            -> dump 16 bytes from MON_LASTADDR
                            	   329: ;   m XXXXXX     -> set MON_LASTADDR, dump 16 bytes
                            	   330: ;   m XXXXXX YY  -> dump YY bytes (hex count)
                            	   331: ;----------------------------------------------------------------
                            	   332: cmd_mem:
01:00F0AA30 528E            	   333:                 addq.l  #1,a6
01:00F0AA32 6100060C        	   334:                 bsr.w   skip_ws
01:00F0AA36 1016            	   335:                 move.b  (a6),d0
01:00F0AA38 6710            	   336:                 beq.b   .use_last
01:00F0AA3A 61000618        	   337:                 bsr.w   parse_hex
01:00F0AA3E 4A01            	   338:                 tst.b   d1
01:00F0AA40 6700003E        	   339:                 beq.w   cmd_err
01:00F0AA44 23C00000F890    	   340:                 move.l  d0,MON_LASTADDR
                            	   341: .use_last:
01:00F0AA4A 610005F4        	   342:                 bsr.w   skip_ws
01:00F0AA4E 7410            	   343:                 moveq   #16,d2                  ; default count
01:00F0AA50 1016            	   344:                 move.b  (a6),d0
01:00F0AA52 6718            	   345:                 beq.b   .do
01:00F0AA54 610005FE        	   346:                 bsr.w   parse_hex
01:00F0AA58 4A01            	   347:                 tst.b   d1
01:00F0AA5A 67000024        	   348:                 beq.w   cmd_err
01:00F0AA5E 2400            	   349:                 move.l  d0,d2
01:00F0AA60 0C8200000080    	   350:                 cmpi.l  #128,d2
01:00F0AA66 6F04            	   351:                 ble.b   .do
01:00F0AA68 7480            	   352:                 moveq   #-128,d2
01:00F0AA6A 4482            	   353:                 neg.l   d2
                            	   354: .do:
01:00F0AA6C 28790000F890    	   355:                 move.l  MON_LASTADDR,a4
01:00F0AA72 610004DA        	   356:                 bsr.w   hexdump
                            	   357:                 ; advance LASTADDR by count
01:00F0AA76 D5B90000F890    	   358:                 add.l   d2,MON_LASTADDR
01:00F0AA7C 6000FE7C        	   359:                 bra.w   cmd_loop
                            	   360: 
                            	   361: cmd_err:
01:00F0AA80 41FA0AC6        	   362:                 lea     hex_err(pc),a0
01:00F0AA84 610007A8        	   363:                 bsr.w   puts
01:00F0AA88 6000FE70        	   364:                 bra.w   cmd_loop
                            	   365: 
                            	   366: ;----------------------------------------------------------------
                            	   367: ; Dump aliases mem command
                            	   368: ;----------------------------------------------------------------
                            	   369: cmd_dump:
01:00F0AA8C 6000FFA2        	   370:                 bra.w   cmd_mem
                            	   371: 
                            	   372: ;----------------------------------------------------------------
                            	   373: ; Memory write:  w XXXXXX BB BB BB ...
                            	   374: ;----------------------------------------------------------------
                            	   375: cmd_write:
01:00F0AA90 528E            	   376:                 addq.l  #1,a6
01:00F0AA92 610005AC        	   377:                 bsr.w   skip_ws
01:00F0AA96 610005BC        	   378:                 bsr.w   parse_hex
01:00F0AA9A 4A01            	   379:                 tst.b   d1
01:00F0AA9C 6700FFE2        	   380:                 beq.w   cmd_err
01:00F0AAA0 2840            	   381:                 move.l  d0,a4
                            	   382: .wloop:
01:00F0AAA2 6100059C        	   383:                 bsr.w   skip_ws
01:00F0AAA6 1016            	   384:                 move.b  (a6),d0
01:00F0AAA8 670E            	   385:                 beq.b   .done
01:00F0AAAA 610005A8        	   386:                 bsr.w   parse_hex
01:00F0AAAE 4A01            	   387:                 tst.b   d1
01:00F0AAB0 6700FFCE        	   388:                 beq.w   cmd_err
01:00F0AAB4 18C0            	   389:                 move.b  d0,(a4)+
01:00F0AAB6 60EA            	   390:                 bra.b   .wloop
                            	   391: .done:
01:00F0AAB8 41FA0A89        	   392:                 lea     ok_msg(pc),a0
01:00F0AABC 61000770        	   393:                 bsr.w   puts
01:00F0AAC0 6000FE38        	   394:                 bra.w   cmd_loop
                            	   395: 
                            	   396: ;----------------------------------------------------------------
                            	   397: ; Go — restore registers and RTE.  No address arg = use saved PC.
                            	   398: ; "g XXXXXX" replaces the saved PC before resuming.
                            	   399: ;----------------------------------------------------------------
                            	   400: ; Only a short (4-word) frame can be *resumed*.  A group-0 frame is not
                            	   401: ; restartable on a 68000, and cold entry has no frame at all — but with
                            	   402: ; an explicit address, cold entry can still start code by synthesizing a
                            	   403: ; frame and RTE'ing into it.  That is what makes the standalone monitor
                            	   404: ; able to run and then debug something, rather than only look at memory.
                            	   405: cmd_go:
01:00F0AAC4 528E            	   406:                 addq.l  #1,a6
01:00F0AAC6 61000578        	   407:                 bsr.w   skip_ws
01:00F0AACA 1016            	   408:                 move.b  (a6),d0
01:00F0AACC 6728            	   409:                 beq.b   .noaddr
01:00F0AACE 61000584        	   410:                 bsr.w   parse_hex
01:00F0AAD2 4A01            	   411:                 tst.b   d1
01:00F0AAD4 6700FFAA        	   412:                 beq.w   cmd_err
01:00F0AAD8 0C3900FF0000F894	   413:                 cmpi.b  #$FF,MON_GRP0
01:00F0AAE0 67000056        	   414:                 beq.w   .fresh                  ; cold entry + address
01:00F0AAE4 4A390000F894    	   415:                 tst.b   MON_GRP0
01:00F0AAEA 66000086        	   416:                 bne.w   .no_frame               ; group-0: not resumable
01:00F0AAEE 23C00000F83C    	   417:                 move.l  d0,MON_SPC
01:00F0AAF4 600C            	   418:                 bra.b   .resume
                            	   419: .noaddr:
01:00F0AAF6 4A390000F894    	   420:                 tst.b   MON_GRP0                ; no address: need a real frame
01:00F0AAFC 66000074        	   421:                 bne.w   .no_frame
01:00F0AB00 4DD6            	   422:                 bra.b   .resume
                            	   423: .resume:
01:00F0AB02 41FA0B1A        	   424:                 lea     resume_msg(pc),a0
01:00F0AB06 61000726        	   425:                 bsr.w   puts
01:00F0AB0A 20390000F83C    	   426:                 move.l  MON_SPC,d0
01:00F0AB10 6100076C        	   427:                 bsr.w   puthex_long
01:00F0AB14 61000724        	   428:                 bsr.w   put_crlf
                            	   429:                 ; rebuild stack frame and RTE
01:00F0AB18 08B900070000F840	   430:                 bclr.b  #SR_TRACE_BIT-8,MON_SSR ; stop tracing on a plain g
01:00F0AB20 2F790000F83C0002	   431:                 move.l  MON_SPC,2(sp)
01:00F0AB28 3EB90000F840    	   432:                 move.w  MON_SSR,(sp)
01:00F0AB2E 4CF97FFF0000F800	   433:                 movem.l MON_REGS,d0-d7/a0-a6
01:00F0AB36 4E73            	   434:                 rte
                            	   435: .fresh:
                            	   436:                 ; Cold entry: no frame exists, so build one.  RTE pops SR
                            	   437:                 ; then PC, so push PC first and SR on top.  IPL stays 7 and
                            	   438:                 ; the T bit stays clear; every vector already points at the
                            	   439:                 ; monitor, so a fault in the target lands back here.
01:00F0AB38 23C00000F83C    	   440:                 move.l  d0,MON_SPC
01:00F0AB3E 41FA0ADE        	   441:                 lea     resume_msg(pc),a0
01:00F0AB42 610006EA        	   442:                 bsr.w   puts
01:00F0AB46 20390000F83C    	   443:                 move.l  MON_SPC,d0
01:00F0AB4C 61000730        	   444:                 bsr.w   puthex_long
01:00F0AB50 610006E8        	   445:                 bsr.w   put_crlf
01:00F0AB54 33FC27000000F840	   446:                 move.w  #$2700,MON_SSR
01:00F0AB5C 2F390000F83C    	   447:                 move.l  MON_SPC,-(sp)           ; PC
01:00F0AB62 3F390000F840    	   448:                 move.w  MON_SSR,-(sp)           ; SR
01:00F0AB68 4CF97FFF0000F800	   449:                 movem.l MON_REGS,d0-d7/a0-a6
01:00F0AB70 4E73            	   450:                 rte
                            	   451: .no_frame:
01:00F0AB72 41FA0A71        	   452:                 lea     nogo_msg(pc),a0
01:00F0AB76 610006B6        	   453:                 bsr.w   puts
01:00F0AB7A 6000FD7E        	   454:                 bra.w   cmd_loop
                            	   455: 
                            	   456: ;================================================================
                            	   457: ; Breakpoints:  b            list slots
                            	   458: ;               b ADDR       set a breakpoint
                            	   459: ;               b -ADDR      clear one
                            	   460: ;               b -          clear all
                            	   461: ;
                            	   462: ; A breakpoint replaces the word at ADDR with TRAP #14 ($4E4E) and keeps
                            	   463: ; the original in the slot table.  Vector 46 ($B8) is pointed at
                            	   464: ; monitor_entry when the first breakpoint is armed — cold_init already
                            	   465: ; filled every vector, but on the --panic path the firmware owns the
                            	   466: ; table, so arming has to install it explicitly.  That is the only write
                            	   467: ; this command makes outside the target word and the slot table.
                            	   468: ;
                            	   469: ; TRAP pushes the 4-word frame, so MON_SPC/MON_SSR read correctly and
                            	   470: ; MON_GRP0 stays 0, which keeps `g` usable.  Note the pushed PC points
                            	   471: ; *after* the trap word: `g` therefore resumes past the breakpoint, and
                            	   472: ; the original instruction is NOT re-executed.  Clear the breakpoint and
                            	   473: ; `g ADDR` if you need to run it.
                            	   474: ;================================================================
                            	   475: cmd_bp:
01:00F0AB7E 528E            	   476:                 addq.l  #1,a6
01:00F0AB80 610004BE        	   477:                 bsr.w   skip_ws
01:00F0AB84 1016            	   478:                 move.b  (a6),d0
01:00F0AB86 67000148        	   479:                 beq.w   bp_list                 ; bare "b" -> list
01:00F0AB8A 0C00002D        	   480:                 cmpi.b  #'-',d0
01:00F0AB8E 6712            	   481:                 beq.b   .clear
01:00F0AB90 610004C2        	   482:                 bsr.w   parse_hex
01:00F0AB94 4A01            	   483:                 tst.b   d1
01:00F0AB96 6700FEE8        	   484:                 beq.w   cmd_err
01:00F0AB9A 61000032        	   485:                 bsr.w   bp_set
01:00F0AB9E 6000FD5A        	   486:                 bra.w   cmd_loop
                            	   487: .clear:
01:00F0ABA2 528E            	   488:                 addq.l  #1,a6                   ; skip '-'
01:00F0ABA4 6100049A        	   489:                 bsr.w   skip_ws
01:00F0ABA8 1016            	   490:                 move.b  (a6),d0
01:00F0ABAA 6712            	   491:                 beq.b   .clr_all
01:00F0ABAC 610004A6        	   492:                 bsr.w   parse_hex
01:00F0ABB0 4A01            	   493:                 tst.b   d1
01:00F0ABB2 6700FECC        	   494:                 beq.w   cmd_err
01:00F0ABB6 610000AE        	   495:                 bsr.w   bp_clr_one
01:00F0ABBA 6000FD3E        	   496:                 bra.w   cmd_loop
                            	   497: .clr_all:
01:00F0ABBE 610000E8        	   498:                 bsr.w   bp_clr_all
01:00F0ABC2 41FA097F        	   499:                 lea     ok_msg(pc),a0
01:00F0ABC6 61000666        	   500:                 bsr.w   puts
01:00F0ABCA 6000FD2E        	   501:                 bra.w   cmd_loop
                            	   502: 
                            	   503: ; ---- bp_set: arm a breakpoint at d0 ----
                            	   504: bp_set:
01:00F0ABCE 48E7F0C0        	   505:                 movem.l d0-d3/a0-a1,-(sp)
01:00F0ABD2 2600            	   506:                 move.l  d0,d3                   ; target address
01:00F0ABD4 67000082        	   507:                 beq.w   .odd                    ; 0 is not a target
01:00F0ABD8 08030000        	   508:                 btst.l  #0,d3
01:00F0ABDC 6600007A        	   509:                 bne.w   .odd                    ; must be word-aligned
                            	   510:                 ; Target must be on-board RAM.  A breakpoint writes $4E4E to
                            	   511:                 ; the address: in ROM that is silently lost, but in
                            	   512:                 ; peripheral space it would poke the AP I/F or XLTR, and
                            	   513:                 ; $F70011 would transmit a byte over the SIO.
01:00F0ABE0 0C8300000400    	   514:                 cmpi.l  #$400,d3
01:00F0ABE6 65000070        	   515:                 bcs.w   .odd                    ; vector table
01:00F0ABEA 0C8300020000    	   516:                 cmpi.l  #$20000,d3
01:00F0ABF0 64000066        	   517:                 bcc.w   .odd                    ; not on-board RAM
                            	   518:                 ; find a free slot, and reject a duplicate
01:00F0ABF4 41F90000F8A0    	   519:                 lea     MON_BPT,a0
01:00F0ABFA 7207            	   520:                 moveq   #MON_BPN-1,d1
01:00F0ABFC 93C9            	   521:                 suba.l  a1,a1                   ; a1 = first free slot, or 0
                            	   522: .scan:
01:00F0ABFE 2410            	   523:                 move.l  (a0),d2
01:00F0AC00 6708            	   524:                 beq.b   .isfree
01:00F0AC02 B483            	   525:                 cmp.l   d3,d2
01:00F0AC04 6700003E        	   526:                 beq.w   .dup
01:00F0AC08 6006            	   527:                 bra.b   .next
                            	   528: .isfree:
01:00F0AC0A 2409            	   529:                 move.l  a1,d2
01:00F0AC0C 6602            	   530:                 bne.b   .next                   ; already have a free slot
01:00F0AC0E 2248            	   531:                 move.l  a0,a1
                            	   532: .next:
01:00F0AC10 5C88            	   533:                 lea     MON_BP_SZ(a0),a0
01:00F0AC12 51C9FFEA        	   534:                 dbra    d1,.scan
01:00F0AC16 2409            	   535:                 move.l  a1,d2
01:00F0AC18 67000034        	   536:                 beq.w   .full
                            	   537:                 ; point the TRAP #14 vector at the monitor, then patch
01:00F0AC1C 21FC00F0A84000B8	   538:                 move.l  #monitor_entry,BP_VECTOR
01:00F0AC24 2043            	   539:                 move.l  d3,a0
01:00F0AC26 33500004        	   540:                 move.w  (a0),4(a1)              ; save original word
01:00F0AC2A 30BC4E4E        	   541:                 move.w  #BP_OPCODE,(a0)
01:00F0AC2E 2283            	   542:                 move.l  d3,(a1)                 ; mark slot in use
01:00F0AC30 41FA091D        	   543:                 lea     bp_set_msg(pc),a0
01:00F0AC34 610005F8        	   544:                 bsr.w   puts
01:00F0AC38 2003            	   545:                 move.l  d3,d0
01:00F0AC3A 61000642        	   546:                 bsr.w   puthex_long
01:00F0AC3E 610005FA        	   547:                 bsr.w   put_crlf
01:00F0AC42 601C            	   548:                 bra.b   .out
                            	   549: .dup:
01:00F0AC44 41FA0913        	   550:                 lea     bp_dup_msg(pc),a0
01:00F0AC48 610005E4        	   551:                 bsr.w   puts
01:00F0AC4C 6012            	   552:                 bra.b   .out
                            	   553: .full:
01:00F0AC4E 41FA0918        	   554:                 lea     bp_full_msg(pc),a0
01:00F0AC52 610005DA        	   555:                 bsr.w   puts
01:00F0AC56 6008            	   556:                 bra.b   .out
                            	   557: .odd:
01:00F0AC58 41FA091F        	   558:                 lea     bp_odd_msg(pc),a0
01:00F0AC5C 610005D0        	   559:                 bsr.w   puts
                            	   560: .out:
01:00F0AC60 4CDF030F        	   561:                 movem.l (sp)+,d0-d3/a0-a1
01:00F0AC64 4E75            	   562:                 rts
                            	   563: 
                            	   564: ; ---- bp_clr_one: disarm the breakpoint at d0, restoring its word ----
                            	   565: bp_clr_one:
01:00F0AC66 48E7E0C0        	   566:                 movem.l d0-d2/a0-a1,-(sp)
01:00F0AC6A 2400            	   567:                 move.l  d0,d2
01:00F0AC6C 6700002C        	   568:                 beq.w   .nf                     ; 0 never matches a slot
01:00F0AC70 41F90000F8A0    	   569:                 lea     MON_BPT,a0
01:00F0AC76 7207            	   570:                 moveq   #MON_BPN-1,d1
                            	   571: .scan:
01:00F0AC78 2010            	   572:                 move.l  (a0),d0
01:00F0AC7A B082            	   573:                 cmp.l   d2,d0
01:00F0AC7C 6616            	   574:                 bne.b   .next
01:00F0AC7E 2240            	   575:                 move.l  d0,a1
01:00F0AC80 32A80004        	   576:                 move.w  4(a0),(a1)              ; put the original back
01:00F0AC84 20BC00000000    	   577:                 move.l  #0,(a0)                 ; free the slot
01:00F0AC8A 41FA08B7        	   578:                 lea     ok_msg(pc),a0
01:00F0AC8E 6100059E        	   579:                 bsr.w   puts
01:00F0AC92 600E            	   580:                 bra.b   .out
                            	   581: .next:
01:00F0AC94 5C88            	   582:                 lea     MON_BP_SZ(a0),a0
01:00F0AC96 51C9FFE0        	   583:                 dbra    d1,.scan
                            	   584: .nf:
01:00F0AC9A 41FA090C        	   585:                 lea     bp_none_msg(pc),a0
01:00F0AC9E 6100058E        	   586:                 bsr.w   puts
                            	   587: .out:
01:00F0ACA2 4CDF0307        	   588:                 movem.l (sp)+,d0-d2/a0-a1
01:00F0ACA6 4E75            	   589:                 rts
                            	   590: 
                            	   591: ; ---- bp_clr_all: disarm every armed slot ----
                            	   592: bp_clr_all:
01:00F0ACA8 48E7C0C0        	   593:                 movem.l d0-d1/a0-a1,-(sp)
01:00F0ACAC 41F90000F8A0    	   594:                 lea     MON_BPT,a0
01:00F0ACB2 7207            	   595:                 moveq   #MON_BPN-1,d1
                            	   596: .scan:
01:00F0ACB4 2010            	   597:                 move.l  (a0),d0
01:00F0ACB6 670C            	   598:                 beq.b   .next
01:00F0ACB8 2240            	   599:                 move.l  d0,a1
01:00F0ACBA 32A80004        	   600:                 move.w  4(a0),(a1)
01:00F0ACBE 20BC00000000    	   601:                 move.l  #0,(a0)
                            	   602: .next:
01:00F0ACC4 5C88            	   603:                 lea     MON_BP_SZ(a0),a0
01:00F0ACC6 51C9FFEC        	   604:                 dbra    d1,.scan
01:00F0ACCA 4CDF0303        	   605:                 movem.l (sp)+,d0-d1/a0-a1
01:00F0ACCE 4E75            	   606:                 rts
                            	   607: 
                            	   608: ; ---- bp_list: show armed slots ----
                            	   609: bp_list:
01:00F0ACD0 41FA08E4        	   610:                 lea     bp_list_msg(pc),a0
01:00F0ACD4 61000558        	   611:                 bsr.w   puts
01:00F0ACD8 49F90000F8A0    	   612:                 lea     MON_BPT,a4
01:00F0ACDE 7607            	   613:                 moveq   #MON_BPN-1,d3
01:00F0ACE0 7A00            	   614:                 moveq   #0,d5                   ; count
                            	   615: .scan:
01:00F0ACE2 2014            	   616:                 move.l  (a4),d0
01:00F0ACE4 6728            	   617:                 beq.b   .next
01:00F0ACE6 5285            	   618:                 addq.l  #1,d5
01:00F0ACE8 103C0020        	   619:                 move.b  #' ',d0
01:00F0ACEC 610004F4        	   620:                 bsr.w   putchar
01:00F0ACF0 610004F0        	   621:                 bsr.w   putchar
01:00F0ACF4 2014            	   622:                 move.l  (a4),d0
01:00F0ACF6 61000586        	   623:                 bsr.w   puthex_long
01:00F0ACFA 41FA08D4        	   624:                 lea     bp_was_msg(pc),a0
01:00F0ACFE 6100052E        	   625:                 bsr.w   puts
01:00F0AD02 302C0004        	   626:                 move.w  4(a4),d0
01:00F0AD06 6100056A        	   627:                 bsr.w   puthex_word
01:00F0AD0A 6100052E        	   628:                 bsr.w   put_crlf
                            	   629: .next:
01:00F0AD0E 5C8C            	   630:                 lea     MON_BP_SZ(a4),a4
01:00F0AD10 51CBFFD0        	   631:                 dbra    d3,.scan
01:00F0AD14 4A85            	   632:                 tst.l   d5
01:00F0AD16 6600FBE2        	   633:                 bne.w   cmd_loop
01:00F0AD1A 41FA08A9        	   634:                 lea     bp_empty_msg(pc),a0
