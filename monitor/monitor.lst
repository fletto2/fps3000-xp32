                            	   629: 
                            	   630: ;================================================================
                            	   631: ; Single step:  t
                            	   632: ;
                            	   633: ; Sets the T bit in the saved SR and resumes.  The 68000 then takes a
                            	   634: ; trace exception after one instruction, which lands back in the monitor
                            	   635: ; (vector 9 at $24).  Needs a resumable frame, same as `g`.  The T bit
                            	   636: ; stays set in the restored SR, so `t` repeats naturally; `g` clears it
                            	   637: ; on the way out so a resume does not keep tracing.
                            	   638: ;================================================================
                            	   639: cmd_trace:
01:00F0AD12 4A390000F894    	   640:                 tst.b   MON_GRP0
01:00F0AD18 66000040        	   641:                 bne.w   trace_noframe
01:00F0AD1C 21FC00F0A8400024	   642:                 move.l  #monitor_entry,TRACE_VECTOR
01:00F0AD24 08F900070000F840	   643:                 bset.b  #SR_TRACE_BIT-8,MON_SSR ; high byte of the saved SR
01:00F0AD2C 41FA087F        	   644:                 lea     trace_msg(pc),a0
01:00F0AD30 610004D8        	   645:                 bsr.w   puts
01:00F0AD34 20390000F83C    	   646:                 move.l  MON_SPC,d0
01:00F0AD3A 6100051E        	   647:                 bsr.w   puthex_long
01:00F0AD3E 610004D6        	   648:                 bsr.w   put_crlf
01:00F0AD42 2F790000F83C0002	   649:                 move.l  MON_SPC,2(sp)
01:00F0AD4A 3EB90000F840    	   650:                 move.w  MON_SSR,(sp)
01:00F0AD50 4CF97FFF0000F800	   651:                 movem.l MON_REGS,d0-d7/a0-a6
01:00F0AD58 4E73            	   652:                 rte
                            	   653: trace_noframe:
01:00F0AD5A 41FA085D        	   654:                 lea     nogo_msg(pc),a0
01:00F0AD5E 610004AA        	   655:                 bsr.w   puts
01:00F0AD62 6000FB96        	   656:                 bra.w   cmd_loop
                            	   657: 
                            	   658: ;----------------------------------------------------------------
                            	   659: ; Info — chassis state, ROM version, free RAM, etc.
                            	   660: ;----------------------------------------------------------------
                            	   661: cmd_info:
01:00F0AD66 41FA08C9        	   662:                 lea     info_msg(pc),a0
01:00F0AD6A 6100049E        	   663:                 bsr.w   puts
                            	   664: 
                            	   665:                 ; Live board status.  Byte read at ODD $F70019 — the board
                            	   666:                 ; status/control register is an 8-bit device on D0-D7, and
                            	   667:                 ; the ROM bit-tests this same odd byte (F08728 etc).
01:00F0AD6E 41FA09E9        	   668:                 lea     bstat_msg(pc),a0
01:00F0AD72 61000496        	   669:                 bsr.w   puts
01:00F0AD76 103900F70019    	   670:                 move.b  $F70019,d0
01:00F0AD7C 610004C2        	   671:                 bsr.w   puthex_byte
01:00F0AD80 61000494        	   672:                 bsr.w   put_crlf
                            	   673: 
                            	   674:                 ; VERSAmodule control register image at $1FFF0.  Per the
                            	   675:                 ; manual this is "control register image only — register
                            	   676:                 ; not directly accessible", so read-back is mediated by
                            	   677:                 ; external logic and may not reflect what was written.
01:00F0AD84 41FA09EB        	   678:                 lea     vmod_msg(pc),a0
01:00F0AD88 61000480        	   679:                 bsr.w   puts
01:00F0AD8C 30390001FFF0    	   680:                 move.w  $1FFF0,d0
01:00F0AD92 610004BA        	   681:                 bsr.w   puthex_word
01:00F0AD96 6100047E        	   682:                 bsr.w   put_crlf
                            	   683: 
                            	   684:                 ; Where this build actually ends, rather than a hardcoded
                            	   685:                 ; number that goes stale every time the monitor grows.
01:00F0AD9A 41FA09EC        	   686:                 lea     mend_msg(pc),a0
01:00F0AD9E 6100046A        	   687:                 bsr.w   puts
01:00F0ADA2 203C00F0B802    	   688:                 move.l  #monitor_end,d0
01:00F0ADA8 610004B0        	   689:                 bsr.w   puthex_long
01:00F0ADAC 61000468        	   690:                 bsr.w   put_crlf
                            	   691: 
                            	   692:                 ; Fault / link state: frame kind, nest guard, TX-timeout
                            	   693:                 ; flag.  MON_NEST = 2 means a previous run died while
                            	   694:                 ; reporting a fault; MON_TXFAIL = 1 means putchar gave up
                            	   695:                 ; waiting for the SIO at some point.
01:00F0ADB0 41FA09ED        	   696:                 lea     fault_msg(pc),a0
01:00F0ADB4 61000454        	   697:                 bsr.w   puts
01:00F0ADB8 10390000F894    	   698:                 move.b  MON_GRP0,d0
01:00F0ADBE 61000480        	   699:                 bsr.w   puthex_byte
01:00F0ADC2 103C002F        	   700:                 move.b  #'/',d0
01:00F0ADC6 61000406        	   701:                 bsr.w   putchar
01:00F0ADCA 10390000F895    	   702:                 move.b  MON_NEST,d0
01:00F0ADD0 6100046E        	   703:                 bsr.w   puthex_byte
01:00F0ADD4 103C002F        	   704:                 move.b  #'/',d0
01:00F0ADD8 610003F4        	   705:                 bsr.w   putchar
01:00F0ADDC 10390000F896    	   706:                 move.b  MON_TXFAIL,d0
01:00F0ADE2 6100045C        	   707:                 bsr.w   puthex_byte
01:00F0ADE6 6100042E        	   708:                 bsr.w   put_crlf
01:00F0ADEA 6000FB0E        	   709:                 bra.w   cmd_loop
                            	   710: 
                            	   711: ;----------------------------------------------------------------
                            	   712: ; Load S-record over the SIO (channel A).
                            	   713: ; Each line consumed and validated; bytes go to addresses inside.
                            	   714: ; Terminator: S8 / S9 record.
                            	   715: ;----------------------------------------------------------------
                            	   716: cmd_load_srec:
01:00F0ADEE 41FA080C        	   717:                 lea     load_msg(pc),a0
01:00F0ADF2 61000416        	   718:                 bsr.w   puts
01:00F0ADF6 7800            	   719:                 clr.l   d4                      ; record count
01:00F0ADF8 7A00            	   720:                 clr.l   d5                      ; byte count
                            	   721: .scan_S:
01:00F0ADFA 610003FC        	   722:                 bsr.w   getchar
01:00F0ADFE 0C000053        	   723:                 cmpi.b  #'S',d0
01:00F0AE02 66F6            	   724:                 bne.b   .scan_S                  ; skip until 'S'
01:00F0AE04 610003F2        	   725:                 bsr.w   getchar                  ; record type
01:00F0AE08 0C000038        	   726:                 cmpi.b  #'8',d0
01:00F0AE0C 670000F2        	   727:                 beq.w   .terminator
01:00F0AE10 0C000039        	   728:                 cmpi.b  #'9',d0
01:00F0AE14 670000EA        	   729:                 beq.w   .terminator
01:00F0AE18 0C000037        	   730:                 cmpi.b  #'7',d0
01:00F0AE1C 670000E2        	   731:                 beq.w   .terminator
01:00F0AE20 0C000030        	   732:                 cmpi.b  #'0',d0
01:00F0AE24 670000C4        	   733:                 beq.w   .eat_eol                ; header — skip
01:00F0AE28 0C000031        	   734:                 cmpi.b  #'1',d0
01:00F0AE2C 6D00FFCC        	   735:                 blt.w   .scan_S
01:00F0AE30 0C000033        	   736:                 cmpi.b  #'3',d0
01:00F0AE34 6E00FFC4        	   737:                 bgt.w   .scan_S
                            	   738:                 ; data record S1 / S2 / S3
01:00F0AE38 1C00            	   739:                 move.b  d0,d6                   ; save type
01:00F0AE3A 61000296        	   740:                 bsr.w   read_hex_byte
                            	   741:                 ; read_hex_byte only writes d0's low byte, so the upper 24
                            	   742:                 ; bits are stale.  Zero-extend explicitly, and keep the
                            	   743:                 ; count word-sized below: a payload count >= $80 is legal
                            	   744:                 ; in an S1 record, and a signed byte test would read it as
                            	   745:                 ; negative and silently truncate the record to no data.
01:00F0AE3E 7400            	   746:                 moveq   #0,d2
01:00F0AE40 1400            	   747:                 move.b  d0,d2                   ; payload count (incl addr+cksum)
                            	   748:                 ; d7 accumulates the record checksum: sum of the count byte,
                            	   749:                 ; the address bytes and the data bytes.  A valid record has
                            	   750:                 ; (sum + cksum) & $FF == $FF.  Without this a corrupted line
                            	   751:                 ; loads silently and reports success, which over a serial
                            	   752:                 ; link at an unverified baud rate is exactly the failure we
                            	   753:                 ; would not notice.
01:00F0AE42 7E00            	   754:                 moveq   #0,d7
01:00F0AE44 DE00            	   755:                 add.b   d0,d7
01:00F0AE46 7600            	   756:                 clr.l   d3
01:00F0AE48 0C060033        	   757:                 cmpi.b  #'3',d6
01:00F0AE4C 6708            	   758:                 beq.b   .a32
01:00F0AE4E 0C060032        	   759:                 cmpi.b  #'2',d6
01:00F0AE52 670E            	   760:                 beq.b   .a24
01:00F0AE54 6018            	   761:                 bra.b   .a16
                            	   762: .a32:
01:00F0AE56 6100027A        	   763:                 bsr.w   read_hex_byte
01:00F0AE5A DE00            	   764:                 add.b   d0,d7
01:00F0AE5C E18B            	   765:                 lsl.l   #8,d3
01:00F0AE5E 8600            	   766:                 or.b    d0,d3
01:00F0AE60 5342            	   767:                 subq.w  #1,d2
                            	   768: .a24:
01:00F0AE62 6100026E        	   769:                 bsr.w   read_hex_byte
01:00F0AE66 DE00            	   770:                 add.b   d0,d7
01:00F0AE68 E18B            	   771:                 lsl.l   #8,d3
01:00F0AE6A 8600            	   772:                 or.b    d0,d3
01:00F0AE6C 5342            	   773:                 subq.w  #1,d2
                            	   774: .a16:
01:00F0AE6E 61000262        	   775:                 bsr.w   read_hex_byte
01:00F0AE72 DE00            	   776:                 add.b   d0,d7
01:00F0AE74 E18B            	   777:                 lsl.l   #8,d3
01:00F0AE76 8600            	   778:                 or.b    d0,d3
01:00F0AE78 61000258        	   779:                 bsr.w   read_hex_byte
01:00F0AE7C DE00            	   780:                 add.b   d0,d7
01:00F0AE7E E18B            	   781:                 lsl.l   #8,d3
01:00F0AE80 8600            	   782:                 or.b    d0,d3
01:00F0AE82 5542            	   783:                 subq.w  #2,d2
01:00F0AE84 5342            	   784:                 subq.w  #1,d2                   ; -1 for checksum
01:00F0AE86 2843            	   785:                 move.l  d3,a4                   ; dest pointer
01:00F0AE88 6100020C        	   786:                 bsr.w   srec_check              ; d1 = 0 -> would self-destruct
01:00F0AE8C 4A01            	   787:                 tst.b   d1
01:00F0AE8E 67000044        	   788:                 beq.w   .badaddr
                            	   789: .dloop:
01:00F0AE92 4A42            	   790:                 tst.w   d2
01:00F0AE94 6F0E            	   791:                 ble.b   .endrec
01:00F0AE96 6100023A        	   792:                 bsr.w   read_hex_byte
01:00F0AE9A DE00            	   793:                 add.b   d0,d7
01:00F0AE9C 18C0            	   794:                 move.b  d0,(a4)+
01:00F0AE9E 5285            	   795:                 addq.l  #1,d5
01:00F0AEA0 5342            	   796:                 subq.w  #1,d2
01:00F0AEA2 60EE            	   797:                 bra.b   .dloop
                            	   798: .endrec:
01:00F0AEA4 6100022C        	   799:                 bsr.w   read_hex_byte           ; the record's checksum byte
01:00F0AEA8 DE00            	   800:                 add.b   d0,d7
01:00F0AEAA 0C0700FF        	   801:                 cmpi.b  #$FF,d7
01:00F0AEAE 660E            	   802:                 bne.b   .badsum
01:00F0AEB0 5284            	   803:                 addq.l  #1,d4
01:00F0AEB2 103C002E        	   804:                 move.b  #'.',d0
01:00F0AEB6 61000316        	   805:                 bsr.w   putchar
01:00F0AEBA 6000002E        	   806:                 bra.w   .eat_eol
                            	   807: .badsum:
                            	   808:                 ; The data was already written by the time we can check, so
                            	   809:                 ; say which record failed and let the operator re-send it.
01:00F0AEBE 41FA0923        	   810:                 lea     srec_sum_msg(pc),a0
01:00F0AEC2 61000346        	   811:                 bsr.w   puts
01:00F0AEC6 2003            	   812:                 move.l  d3,d0
01:00F0AEC8 61000390        	   813:                 bsr.w   puthex_long
01:00F0AECC 61000348        	   814:                 bsr.w   put_crlf
01:00F0AED0 6000FF28        	   815:                 bra.w   .scan_S
                            	   816: .badaddr:
                            	   817:                 ; Skip this record.  No need to consume its hex: .scan_S
                            	   818:                 ; resyncs on the next 'S', and hex digits are 0-9A-F so
                            	   819:                 ; none of the skipped payload can be mistaken for a
                            	   820:                 ; record start.
01:00F0AED4 41FA08E0        	   821:                 lea     srec_bad_msg(pc),a0
01:00F0AED8 61000330        	   822:                 bsr.w   puts
01:00F0AEDC 2003            	   823:                 move.l  d3,d0
01:00F0AEDE 6100037A        	   824:                 bsr.w   puthex_long
01:00F0AEE2 61000332        	   825:                 bsr.w   put_crlf
01:00F0AEE6 6000FF12        	   826:                 bra.w   .scan_S
                            	   827: .eat_eol:
01:00F0AEEA 6100030C        	   828:                 bsr.w   getchar
01:00F0AEEE 0C00000D        	   829:                 cmpi.b  #13,d0
01:00F0AEF2 6700FF06        	   830:                 beq.w   .scan_S
01:00F0AEF6 0C00000A        	   831:                 cmpi.b  #10,d0
01:00F0AEFA 6700FEFE        	   832:                 beq.w   .scan_S
01:00F0AEFE 60EA            	   833:                 bra.b   .eat_eol
                            	   834: .terminator:
                            	   835:                 ; finish the terminator's line
                            	   836: .t_eol:
01:00F0AF00 610002F6        	   837:                 bsr.w   getchar
01:00F0AF04 0C00000D        	   838:                 cmpi.b  #13,d0
01:00F0AF08 6708            	   839:                 beq.b   .t_done
01:00F0AF0A 0C00000A        	   840:                 cmpi.b  #10,d0
01:00F0AF0E 6702            	   841:                 beq.b   .t_done
01:00F0AF10 60EE            	   842:                 bra.b   .t_eol
                            	   843: .t_done:
01:00F0AF12 61000302        	   844:                 bsr.w   put_crlf
01:00F0AF16 41FA0702        	   845:                 lea     load_done_msg(pc),a0
01:00F0AF1A 610002EE        	   846:                 bsr.w   puts
01:00F0AF1E 2004            	   847:                 move.l  d4,d0
01:00F0AF20 61000338        	   848:                 bsr.w   puthex_long
01:00F0AF24 41FA06FF        	   849:                 lea     load_bytes_msg(pc),a0
01:00F0AF28 610002E0        	   850:                 bsr.w   puts
01:00F0AF2C 2005            	   851:                 move.l  d5,d0
01:00F0AF2E 6100032A        	   852:                 bsr.w   puthex_long
01:00F0AF32 610002E2        	   853:                 bsr.w   put_crlf
01:00F0AF36 6000F9C2        	   854:                 bra.w   cmd_loop
                            	   855: 
                            	   856: ;================================================================
                            	   857: ; Helpers
                            	   858: ;================================================================
                            	   859: 
                            	   860: ; ---- hexdump d2 bytes starting at a4 ----
                            	   861: hexdump:
01:00F0AF3A 2C02            	   862:                 move.l  d2,d6                   ; bytes remaining
                            	   863: .line:
                            	   864:                 ; Print address
01:00F0AF3C 200C            	   865:                 move.l  a4,d0
01:00F0AF3E 6100031A        	   866:                 bsr.w   puthex_long
01:00F0AF42 103C003A        	   867:                 move.b  #':',d0
01:00F0AF46 61000286        	   868:                 bsr.w   putchar
01:00F0AF4A 103C0020        	   869:                 move.b  #' ',d0
01:00F0AF4E 6100027E        	   870:                 bsr.w   putchar
                            	   871:                 ; row count = min(16, d6)
01:00F0AF52 7810            	   872:                 moveq   #16,d4
01:00F0AF54 BC84            	   873:                 cmp.l   d4,d6
01:00F0AF56 6C02            	   874:                 bge.b   .full
01:00F0AF58 2806            	   875:                 move.l  d6,d4
                            	   876: .full:
01:00F0AF5A 2A4C            	   877:                 move.l  a4,a5                   ; row start
                            	   878:                 ; print d4 hex bytes
01:00F0AF5C 2604            	   879:                 move.l  d4,d3
01:00F0AF5E 4A83            	   880:                 tst.l   d3
01:00F0AF60 6712            	   881:                 beq.b   .pad
                            	   882: .hex:
01:00F0AF62 101C            	   883:                 move.b  (a4)+,d0
01:00F0AF64 610002DA        	   884:                 bsr.w   puthex_byte
01:00F0AF68 103C0020        	   885:                 move.b  #' ',d0
01:00F0AF6C 61000260        	   886:                 bsr.w   putchar
01:00F0AF70 5383            	   887:                 subq.l  #1,d3
01:00F0AF72 66EE            	   888:                 bne.b   .hex
                            	   889: .pad:
                            	   890:                 ; pad to 16 hex slots
01:00F0AF74 7A10            	   891:                 moveq   #16,d5
01:00F0AF76 9A84            	   892:                 sub.l   d4,d5
01:00F0AF78 4A85            	   893:                 tst.l   d5
01:00F0AF7A 6714            	   894:                 beq.b   .ascii
                            	   895: .padl:
01:00F0AF7C 103C0020        	   896:                 move.b  #' ',d0
01:00F0AF80 6100024C        	   897:                 bsr.w   putchar
01:00F0AF84 61000248        	   898:                 bsr.w   putchar
01:00F0AF88 61000244        	   899:                 bsr.w   putchar
01:00F0AF8C 5385            	   900:                 subq.l  #1,d5
01:00F0AF8E 66EC            	   901:                 bne.b   .padl
                            	   902: .ascii:
01:00F0AF90 103C007C        	   903:                 move.b  #'|',d0
01:00F0AF94 61000238        	   904:                 bsr.w   putchar
01:00F0AF98 2604            	   905:                 move.l  d4,d3
01:00F0AF9A 4A83            	   906:                 tst.l   d3
01:00F0AF9C 671C            	   907:                 beq.b   .ascii_end
                            	   908: .ascii_l:
01:00F0AF9E 101D            	   909:                 move.b  (a5)+,d0
01:00F0AFA0 0C000020        	   910:                 cmpi.b  #' ',d0
01:00F0AFA4 6D08            	   911:                 blt.b   .dot
01:00F0AFA6 0C00007E        	   912:                 cmpi.b  #126,d0
01:00F0AFAA 6E02            	   913:                 bgt.b   .dot
01:00F0AFAC 6004            	   914:                 bra.b   .pchar
                            	   915: .dot:
01:00F0AFAE 103C002E        	   916:                 move.b  #'.',d0
                            	   917: .pchar:
01:00F0AFB2 6100021A        	   918:                 bsr.w   putchar
01:00F0AFB6 5383            	   919:                 subq.l  #1,d3
01:00F0AFB8 66E4            	   920:                 bne.b   .ascii_l
                            	   921: .ascii_end:
01:00F0AFBA 103C007C        	   922:                 move.b  #'|',d0
01:00F0AFBE 6100020E        	   923:                 bsr.w   putchar
01:00F0AFC2 61000252        	   924:                 bsr.w   put_crlf
01:00F0AFC6 9C84            	   925:                 sub.l   d4,d6
01:00F0AFC8 6E00FF72        	   926:                 bgt.w   .line
01:00F0AFCC 4E75            	   927:                 rts
                            	   928: 
                            	   929: ; ---- read_line: read line from SIO into MON_LINEBUF, term=0 ----
                            	   930: read_line:
01:00F0AFCE 41F90000F850    	   931:                 lea     MON_LINEBUF,a0
01:00F0AFD4 743C            	   932:                 moveq   #60,d2                  ; 61 chars + NUL, 2 spare
                            	   933:                                         ;   in the 64 B before MON_LASTADDR
                            	   934: .rloop:
01:00F0AFD6 61000220        	   935:                 bsr.w   getchar
