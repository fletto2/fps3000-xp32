Sections:
00: "segf0a826" (F0A826-F0A838)
01: "segf0a840" (F0A840-F0CA5E)


Source: "monitor.s"
                            	     1: ; ----------------------------------------------------------------
                            	     2: ; FPS-3000 SBC Monitor / Debugger / Host Interface
                            	     3: ; Lives in the 21.9 KB of free ROM at $F0A826 onwards.
                            	     4: ;
                            	     5: ; Communicates over the on-board NEC µPD7201 SIO Channel A
                            	     6: ; ($F70011 data, $F70015 control), which the FPS firmware never
                            	     7: ; initialises or uses — so we have it all to ourselves.
                            	     8: ;
                            	     9: ; Triggered by jumping to monitor_entry (typically by patching
                            	    10: ; one or more vectors).
                            	    11: ; ----------------------------------------------------------------
                            	    12: 
                            	    13: ; µPD7201 register addresses, per Motorola's VERSAdos source for this
                            	    14: ; board — verdos06/SDLCPRI/NEC7201.EQ, in rms68k_source.SA:
                            	    15: ;
                            	    16: ;     NEC7201 EQU $F70011      <- ODD base: the chip is on D0-D7 / LDS
                            	    17: ;     ch A data    = base+0 = $F70011
                            	    18: ;     ch B data    = base+2 = $F70013
                            	    19: ;     ch A control = base+4 = $F70015
                            	    20: ;     ch B control = base+6 = $F70017
                            	    21: ;
                            	    22: ; Registers are grouped by FUNCTION (both data, then both control), not
                            	    23: ; interleaved per channel.  Earlier versions of this file used $F70010
                            	    24: ; and $F70012, which is wrong twice over: even addresses assert UDS only
                            	    25: ; and this chip never answers them (-> no DTACK -> BERR), and the odd
                            	    26: ; byte of that second slot, $F70013, is channel B's DATA register, not
                            	    27: ; channel A's control.  Corroborated by verdos06/_root/NEC7201.EQ
                            	    28: ; (CREG/SREG = 0, DREG = -4) and by the ROM's own MC6840 access at odd
                            	    29: ; $F70001/$F70003 in PTMInit (F09176).
                            	    30: SIO_A_DATA      equ     $F70011
                            	    31: SIO_A_CTRL      equ     $F70015
                            	    32: SIO_B_DATA      equ     $F70013
                            	    33: SIO_B_CTRL      equ     $F70017
                            	    34: 
                            	    35: ; Z80-SIO/i8274 RR0 status bits
                            	    36: RR0_RX_AVAIL    equ     0
                            	    37: RR0_TX_EMPTY    equ     2
                            	    38: 
                            	    39: ; Monitor RAM workspace.
                            	    40: ;
                            	    41: ; This used to live at $1F000, which was wrong in two ways at once:
                            	    42: ;
                            	    43: ;   * $1F000 is INSIDE the AU WCS staging buffer ($10000-$1FFFF), so
                            	    44: ;     loading a full 64 KB bank — the whole point of the L command —
                            	    45: ;     would overwrite the monitor's own saved registers, line buffer and
                            	    46: ;     stack partway through the transfer.
                            	    47: ;   * The factory firmware also writes live data there.  A RAM dump after
                            	    48: ;     booting the stock ROM to the scheduler idle loop shows 40 nonzero
                            	    49: ;     bytes in $1F000-$1F09F, so entering via the panic vector clobbered
                            	    50: ;     firmware state and quietly compromised `g`.
                            	    51: ;
                            	    52: ; Measured alternative: dumping RAM after a full stock boot shows
                            	    53: ; $01200-$0FFFF — 60,928 bytes — completely untouched by the firmware.
                            	    54: ; The workspace and the cold-path stack both now live there, which puts
                            	    55: ; them below the staging buffer AND out of the firmware's way, fixing
                            	    56: ; both problems at once.
                            	    57: ;
                            	    58: ; Caveat on the evidence: "untouched after booting to idle" is not proof
                            	    59: ; that RMS68K never allocates there under load — it is a measurement of
                            	    60: ; this chassis reaching its idle loop, not a guarantee.  It is strictly
                            	    61: ; better than the old placement, which was measurably in use.
                            	    62: MON_BASE        equ     $0F800
                            	    63: MON_REGS        equ     MON_BASE        ; saved D0..D7 then A0..A6 (15*4=60 bytes)
                            	    64: MON_SPC         equ     MON_BASE+$3C    ; saved PC (long) — at MON_REGS + 60
                            	    65: MON_SSR         equ     MON_BASE+$40    ; saved SR (word)
                            	    66: MON_LINEBUF     equ     MON_BASE+$50    ; cmd line buffer (64 B)
                            	    67: MON_LASTADDR    equ     MON_BASE+$90    ; last 'm' addr (long)
                            	    68: MON_GRP0        equ     MON_BASE+$94    ; frame kind: 0 = short (4-word,
                            	    69:                                         ;   resumable), 1 = group-0 (7-word
                            	    70:                                         ;   bus/addr error), $FF = no frame
                            	    71:                                         ;   at all (cold entry)
                            	    72: MON_NEST        equ     MON_BASE+$95    ; re-entry guard: 0 = not inside a
                            	    73:                                         ;   fault report, 1 = reporting,
                            	    74:                                         ;   2 = died re-entering (sticky)
                            	    75: MON_FADDR       equ     MON_BASE+$98    ; group-0 ACCESS ADDRESS (long).
                            	    76:                                         ;   The 68000 pushes the address that
                            	    77:                                         ;   faulted at (sp)+2; discarding it
                            	    78:                                         ;   leaves "bus error at PC X" with no
                            	    79:                                         ;   way to say WHAT X touched, which is
                            	    80:                                         ;   the one number bring-up needs.
                            	    81: MON_SSW         equ     MON_BASE+$9C    ; group-0 special status word: bit 4 =
                            	    82:                                         ;   R/W (1 = read), bit 3 = I/N, bits
                            	    83:                                         ;   2-0 = function code (5 = supervisor
                            	    84:                                         ;   data, 6 = supervisor program)
                            	    85: MON_TXFAIL      equ     MON_BASE+$96    ; nonzero once a putchar has timed
                            	    86:                                         ;   out — survives for a RAM dump
                            	    87: 
                            	    88: ; Cold-entry supervisor stack top, growing down toward the workspace end
                            	    89: ; at MON_BASE+$97.  ~1.7 KB of stack, all inside the free region.  The
                            	    90: ; panic path deliberately leaves SP alone — it needs the firmware's
                            	    91: ; exception frame where the firmware left it.
                            	    92: MON_STACK       equ     $0FF00
                            	    93: 
                            	    94: ; Region srec_check refuses to load over: workspace + cold-entry stack.
                            	    95: MON_LO          equ     MON_BASE
                            	    96: MON_HI          equ     MON_STACK
                            	    97: 
                            	    98: ; Breakpoint table: 8 slots of {addr.l, saved original word}.  A slot
                            	    99: ; with addr = 0 is free.
                            	   100: MON_BPN         equ     8
                            	   101: MON_BPT         equ     MON_BASE+$A0    ; 8 * 6 bytes = 48, ends +$CF
                            	   102: MON_BP_SZ       equ     6
                            	   103: 
                            	   104: ; Tier 4 tap state and capture ring.  All of it sits inside
                            	   105: ; MON_LO..MON_HI, so srec_check already refuses to load over it, and
                            	   106: ; cold_init pre-writes every byte for the same DRAM-parity reason it
                            	   107: ; pre-writes MON_REGS.
                            	   108: MON_TAPMSK      equ     MON_BASE+$D0    ; armed channels, bit n = ch n+1
                            	   109: MON_TAPTGT      equ     MON_BASE+$D4    ; chain target scratch (long)
                            	   110: MON_TAPSAV      equ     MON_BASE+$D8    ; 4 saved vectors, $D8..$E7
                            	   111: MON_RINGHD      equ     MON_BASE+$E8    ; ring head index (word)
                            	   112: MON_RINGN       equ     MON_BASE+$EA    ; entries captured, saturating
                            	   113: MON_RINGOV      equ     MON_BASE+$EC    ; wrap count
                            	   114: MON_RING        equ     MON_BASE+$100   ; 64 * 10 bytes = $280, ending at
                            	   115:                                         ;   $0FB7F -- which leaves 896 bytes
                            	   116:                                         ;   of cold-entry stack below $0FF00
                            	   117: MON_RING_N      equ     64
                            	   118: MON_RING_SZ     equ     10
                            	   119: 
                            	   120: ; TRAP #14 opcode, used as the breakpoint trap.  Vector 46 at $B8.
                            	   121: BP_OPCODE       equ     $4E4E
                            	   122: BP_VECTOR       equ     $B8
                            	   123: TRACE_VECTOR    equ     $24             ; vector 9 — T-bit trace
                            	   124: SR_TRACE_BIT    equ     15              ; T bit in SR
                            	   125: 
                            	   126: ; putchar TX-ready spin limit.  The btst loop is ~20 cycles, so this is
                            	   127: ; roughly 20M cycles / ~2.5 s at 8 MHz — comfortably longer than one
                            	   128: ; character time even at the slowest strappable rate (50 baud = 200 ms),
                            	   129: ; while still being bounded.  An unbounded spin here is why a dead SIO
                            	   130: ; produced total silence on the first hardware attempt: the monitor hung
                            	   131: ; before emitting a single byte, so there was nothing to diagnose.
                            	   132: TX_SPIN_LIMIT   equ     $100000
                            	   133: 
                            	   134:                 org     $F0A826
                            	   135: 
                            	   136: ;================================================================
                            	   137: ; Cold entry — used when monitor is patched in as the reset PC.
                            	   138: ; SP isn't loaded by the FPS reset path, so we install it ourselves
                            	   139: ; before doing anything that pushes (like bsr).
                            	   140: ;================================================================
                            	   141: monitor_cold:
00:00F0A826 007C2700        	   142:                 ori.w   #$2700,sr               ; supervisor, IPL=7
00:00F0A82A 2E7C0000FF00    	   143:                 movea.l #MON_STACK,sp           ; supervisor stack (below
                            	   144:                                                 ;   the WCS staging buffer)
00:00F0A830 61000A1E        	   145:                 bsr.w   cold_init               ; vectors + workspace
00:00F0A834 600000A8        	   146:                 bra.w   monitor_common
                            	   147: 
                            	   148: ; monitor_entry MUST stay at $F0A840: patch_rom.py hardcodes
                            	   149: ; MON_ENTRY = 0xA840, and README.md / CLAUDE.md both document that
                            	   150: ; address.  Pinning it here means edits to monitor_cold above cannot
                            	   151: ; silently shift it and send the panic-vector patch into the middle of
                            	   152: ; an instruction.  vasm errors out if monitor_cold ever overflows.
                            	   153:                 org     $F0A840
                            	   154: 
                            	   155: ;================================================================
                            	   156: ; Exception entry — called as JMP target from patched vectors.
                            	   157: ;
                            	   158: ; If entered via an exception, the supervisor stack contains the
                            	   159: ; standard 7-word frame (or 4-word for IRQ).  We save D0-D7/A0-A6
                            	   160: ; into MON_REGS, then read the saved PC and SR from the stack.
                            	   161: ;================================================================
                            	   162: monitor_entry:
                            	   163:                 ; Re-entry guard FIRST, before clobbering anything: if we
                            	   164:                 ; are already reporting a fault, the fault is coming from
                            	   165:                 ; the monitor's own I/O path and reporting it again just
                            	   166:                 ; recurses, pushing a frame per pass until the stack eats
                            	   167:                 ; the workspace.  Bail to mon_dead and keep the FIRST
                            	   168:                 ; fault's PC/SR intact for post-mortem.
01:00F0A840 4A390000F895    	   169:                 tst.b   MON_NEST
01:00F0A846 66000082        	   170:                 bne.w   mon_dead
01:00F0A84A 13FC00010000F895	   171:                 move.b  #1,MON_NEST
                            	   172: 
01:00F0A852 48F97FFF0000F800	   173:                 movem.l d0-d7/a0-a6,MON_REGS
01:00F0A85A 13FC00000000F894	   174:                 move.b  #0,MON_GRP0             ; short frame: SR, then PC
01:00F0A862 23FC000000000000	   175:                 move.l  #0,MON_FADDR            ; no access address in a short
01:00F0A86A F898
01:00F0A86C 33FC00000000F89C	   176:                 move.w  #0,MON_SSW              ;   frame -- do not leave stale
01:00F0A874 33D70000F840    	   177:                 move.w  (sp),MON_SSR
01:00F0A87A 23EF00020000F83C	   178:                 move.l  2(sp),MON_SPC
01:00F0A882 6000005A        	   179:                 bra.w   monitor_common
                            	   180: 
                            	   181: ;================================================================
                            	   182: ; grp0_entry — vectors 2 (bus error) and 3 (address error) ONLY.
                            	   183: ;
                            	   184: ; The 68000 pushes a 7-word group-0 frame, which is NOT laid out like
                            	   185: ; the 4-word frame every other exception uses:
                            	   186: ;
                            	   187: ;   (sp)+0  special status word
                            	   188: ;   (sp)+2  access address (long)
                            	   189: ;   (sp)+6  instruction register
                            	   190: ;   (sp)+8  status register      <- SR lives here, not at (sp)
                            	   191: ;   (sp)+10 program counter      <- PC lives here, not at 2(sp)
                            	   192: ;
                            	   193: ; Reading it as a short frame reports the SSW as "SR" and half the
                            	   194: ; fault address as "PC", which is worse than useless during bring-up.
                            	   195: ; Group-0 faults are also not resumable on a 68000, so flag the frame
                            	   196: ; and let cmd_go refuse rather than RTE into the weeds.
                            	   197: ;================================================================
                            	   198: grp0_entry:
01:00F0A886 4A390000F895    	   199:                 tst.b   MON_NEST
01:00F0A88C 6600003C        	   200:                 bne.w   mon_dead
01:00F0A890 13FC00010000F895	   201:                 move.b  #1,MON_NEST
                            	   202: 
01:00F0A898 48F97FFF0000F800	   203:                 movem.l d0-d7/a0-a6,MON_REGS
01:00F0A8A0 13FC00010000F894	   204:                 move.b  #1,MON_GRP0             ; group-0: not resumable
01:00F0A8A8 33D70000F89C    	   205:                 move.w  (sp),MON_SSW            ; special status word
01:00F0A8AE 23EF00020000F898	   206:                 move.l  2(sp),MON_FADDR         ; THE ACCESS ADDRESS
01:00F0A8B6 33EF00080000F840	   207:                 move.w  8(sp),MON_SSR
01:00F0A8BE 23EF000A0000F83C	   208:                 move.l  10(sp),MON_SPC
01:00F0A8C6 60000016        	   209:                 bra.w   monitor_common
                            	   210: 
                            	   211: ;================================================================
                            	   212: ; mon_dead — nested fault.  Touch NO I/O (the I/O is what is broken)
                            	   213: ; and do not let the stack creep: re-anchor SP every pass, mark RAM so
                            	   214: ; a later RAM dump shows how we got here, and stop the CPU.  STOP with
                            	   215: ; IPL 7 still admits a level-7 NMI, so loop back and re-stop instead of
                            	   216: ; falling through into whatever follows.
                            	   217: ;================================================================
                            	   218: mon_dead:
01:00F0A8CA 2E7C0000FF00    	   219:                 movea.l #MON_STACK,sp           ; re-anchor: no creep
01:00F0A8D0 13FC00020000F895	   220:                 move.b  #2,MON_NEST             ; sticky post-mortem marker
01:00F0A8D8 4E722700        	   221:                 stop    #$2700
01:00F0A8DC 60EC            	   222:                 bra.b   mon_dead
                            	   223: 
                            	   224: monitor_common:
                            	   225: 
01:00F0A8DE 61000A56        	   226:                 bsr.w   sio_init
01:00F0A8E2 61000AEC        	   227:                 bsr.w   put_crlf
01:00F0A8E6 61000AE8        	   228:                 bsr.w   put_crlf
01:00F0A8EA 41FA13FA        	   229:                 lea     banner_msg(pc),a0
01:00F0A8EE 61000AD4        	   230:                 bsr.w   puts
01:00F0A8F2 41FA14A7        	   231:                 lea     entry_msg(pc),a0
01:00F0A8F6 61000ACC        	   232:                 bsr.w   puts
01:00F0A8FA 20390000F83C    	   233:                 move.l  MON_SPC,d0
01:00F0A900 61000B12        	   234:                 bsr.w   puthex_long
01:00F0A904 41FA14A5        	   235:                 lea     sr_msg(pc),a0
01:00F0A908 61000ABA        	   236:                 bsr.w   puts
01:00F0A90C 30390000F840    	   237:                 move.w  MON_SSR,d0
01:00F0A912 61000AF4        	   238:                 bsr.w   puthex_word
                            	   239:                 ; A group-0 frame carries the address that actually faulted.
                            	   240:                 ; Report it here: "bus error at PC X" without it says nothing
                            	   241:                 ; about WHAT the access touched, and on this board the answer
                            	   242:                 ; is usually a device that did not answer.
01:00F0A916 0C3900010000F894	   243:                 cmpi.b  #1,MON_GRP0
01:00F0A91E 6624            	   244:                 bne.b   .no_faddr
01:00F0A920 41FA1490        	   245:                 lea     faddr_msg(pc),a0
01:00F0A924 61000A9E        	   246:                 bsr.w   puts
01:00F0A928 20390000F898    	   247:                 move.l  MON_FADDR,d0
01:00F0A92E 61000AE4        	   248:                 bsr.w   puthex_long
01:00F0A932 41FA1488        	   249:                 lea     ssw_msg(pc),a0
01:00F0A936 61000A8C        	   250:                 bsr.w   puts
01:00F0A93A 30390000F89C    	   251:                 move.w  MON_SSW,d0
01:00F0A940 61000AC6        	   252:                 bsr.w   puthex_word
                            	   253: .no_faddr:
01:00F0A944 61000A8A        	   254:                 bsr.w   put_crlf
                            	   255: 
                            	   256: cmd_loop:
                            	   257:                 ; We reached the prompt, so the I/O path works: re-arm the
                            	   258:                 ; guard so a later fault is reportable too.
01:00F0A948 13FC00000000F895	   259:                 move.b  #0,MON_NEST
01:00F0A950 41FA1472        	   260:                 lea     prompt_msg(pc),a0
01:00F0A954 61000A6E        	   261:                 bsr.w   puts
01:00F0A958 610007BC        	   262:                 bsr.w   read_line               ; reads into MON_LINEBUF, term=0
01:00F0A95C 4DF90000F850    	   263:                 lea     MON_LINEBUF,a6          ; a6 = parse pointer
01:00F0A962 61000810        	   264:                 bsr.w   skip_ws
01:00F0A966 1016            	   265:                 move.b  (a6),d0
01:00F0A968 67DE            	   266:                 beq.b   cmd_loop                ; empty line
                            	   267: 
01:00F0A96A 0C00003F        	   268:                 cmpi.b  #'?',d0
01:00F0A96E 6700009E        	   269:                 beq.w   cmd_help
01:00F0A972 0C000068        	   270:                 cmpi.b  #'h',d0
01:00F0A976 67000096        	   271:                 beq.w   cmd_help
01:00F0A97A 0C000072        	   272:                 cmpi.b  #'r',d0
01:00F0A97E 670000A6        	   273:                 beq.w   cmd_regs
01:00F0A982 0C00006D        	   274:                 cmpi.b  #'m',d0
01:00F0A986 6700012E        	   275:                 beq.w   cmd_mem
01:00F0A98A 0C000064        	   276:                 cmpi.b  #'d',d0
01:00F0A98E 670001DE        	   277:                 beq.w   cmd_dump
01:00F0A992 0C000077        	   278:                 cmpi.b  #'w',d0
01:00F0A996 670001DA        	   279:                 beq.w   cmd_write
01:00F0A99A 0C000067        	   280:                 cmpi.b  #'g',d0
01:00F0A99E 67000240        	   281:                 beq.w   cmd_go
01:00F0A9A2 0C00004C        	   282:                 cmpi.b  #'L',d0
01:00F0A9A6 6700058E        	   283:                 beq.w   cmd_load_srec
01:00F0A9AA 0C000069        	   284:                 cmpi.b  #'i',d0
01:00F0A9AE 670004DA        	   285:                 beq.w   cmd_info
01:00F0A9B2 0C000021        	   286:                 cmpi.b  #'!',d0
01:00F0A9B6 67000062        	   287:                 beq.w   cmd_about
01:00F0A9BA 0C000062        	   288:                 cmpi.b  #'b',d0
01:00F0A9BE 670002CE        	   289:                 beq.w   cmd_bp
01:00F0A9C2 0C000074        	   290:                 cmpi.b  #'t',d0
01:00F0A9C6 6700046E        	   291:                 beq.w   cmd_trace
01:00F0A9CA 0C000078        	   292:                 cmpi.b  #'x',d0
01:00F0A9CE 67000AF2        	   293:                 beq.w   cmd_apif
01:00F0A9D2 0C000079        	   294:                 cmpi.b  #'y',d0
01:00F0A9D6 67000B06        	   295:                 beq.w   cmd_xltr
01:00F0A9DA 0C000063        	   296:                 cmpi.b  #'c',d0
01:00F0A9DE 67000B12        	   297:                 beq.w   cmd_ac
01:00F0A9E2 0C000073        	   298:                 cmpi.b  #'s',d0
01:00F0A9E6 67000C22        	   299:                 beq.w   cmd_tap
01:00F0A9EA 0C000065        	   300:                 cmpi.b  #'e',d0
01:00F0A9EE 67000EC4        	   301:                 beq.w   cmd_bulk
01:00F0A9F2 0C000070        	   302:                 cmpi.b  #'p',d0
01:00F0A9F6 67000F8C        	   303:                 beq.w   cmd_page
01:00F0A9FA 0C000071        	   304:                 cmpi.b  #'q',d0
01:00F0A9FE 67000FF4        	   305:                 beq.w   cmd_ready
                            	   306: 
01:00F0AA02 41FA13C8        	   307:                 lea     unknown_msg(pc),a0
01:00F0AA06 610009BC        	   308:                 bsr.w   puts
01:00F0AA0A 6000FF3C        	   309:                 bra.w   cmd_loop
                            	   310: 
                            	   311: ;----------------------------------------------------------------
                            	   312: ; Help — print command list
                            	   313: ;----------------------------------------------------------------
                            	   314: cmd_help:
01:00F0AA0E 41FA13D4        	   315:                 lea     help_msg(pc),a0
01:00F0AA12 610009B0        	   316:                 bsr.w   puts
01:00F0AA16 6000FF30        	   317:                 bra.w   cmd_loop
                            	   318: 
                            	   319: ;----------------------------------------------------------------
                            	   320: ; About / Banner
                            	   321: ;----------------------------------------------------------------
                            	   322: cmd_about:
01:00F0AA1A 41FA12CA        	   323:                 lea     banner_msg(pc),a0
01:00F0AA1E 610009A4        	   324:                 bsr.w   puts
01:00F0AA22 6000FF24        	   325:                 bra.w   cmd_loop
                            	   326: 
                            	   327: ;----------------------------------------------------------------
                            	   328: ; Show registers
                            	   329: ;   format:
                            	   330: ;     D0=12345678  D1=12345678  D2=12345678  D3=12345678
                            	   331: ;     D4=12345678  D5=12345678  D6=12345678  D7=12345678
                            	   332: ;     A0=12345678  A1=12345678  A2=12345678  A3=12345678
                            	   333: ;     A4=12345678  A5=12345678  A6=12345678
                            	   334: ;     PC=12345678  SR=1234
                            	   335: ;----------------------------------------------------------------
                            	   336: cmd_regs:
01:00F0AA26 7400            	   337:                 moveq   #0,d2                   ; reg index 0..14
                            	   338: .loop:
01:00F0AA28 7600            	   339:                 moveq   #0,d3
01:00F0AA2A 1602            	   340:                 move.b  d2,d3
01:00F0AA2C 0C030008        	   341:                 cmpi.b  #8,d3
01:00F0AA30 6D08            	   342:                 blt.b   .is_d
01:00F0AA32 103C0041        	   343:                 move.b  #'A',d0
