                            	   530: 
                            	   531: ;----------------------------------------------------------------
                            	   532: ; Go — restore registers and RTE.  No address arg = use saved PC.
                            	   533: ; "g XXXXXX" replaces the saved PC before resuming.
                            	   534: ;----------------------------------------------------------------
                            	   535: ; Only a short (4-word) frame can be *resumed*.  A group-0 frame is not
                            	   536: ; restartable on a 68000, and cold entry has no frame at all — but with
                            	   537: ; an explicit address, cold entry can still start code by synthesizing a
                            	   538: ; frame and RTE'ing into it.  That is what makes the standalone monitor
                            	   539: ; able to run and then debug something, rather than only look at memory.
                            	   540: cmd_go:
01:00F0ABE0 528E            	   541:                 addq.l  #1,a6
01:00F0ABE2 61000590        	   542:                 bsr.w   skip_ws
01:00F0ABE6 1016            	   543:                 move.b  (a6),d0
01:00F0ABE8 671C            	   544:                 beq.b   .noaddr
01:00F0ABEA 6100059C        	   545:                 bsr.w   parse_hex
01:00F0ABEE 4A01            	   546:                 tst.b   d1
01:00F0ABF0 6700FF70        	   547:                 beq.w   cmd_err
                            	   548:                 ; An explicit address is a START, not a resume, so any
                            	   549:                 ; frame we cannot resume ($FF cold entry OR 1 group-0) is
                            	   550:                 ; handled by synthesizing one.  Refusing the group-0 case
                            	   551:                 ; here meant that after a single bus error NO further code
                            	   552:                 ; could be started until a power cycle -- the worst failure
                            	   553:                 ; mode for a bring-up tool, since every later probe then
                            	   554:                 ; reports a fault that is about the monitor, not the board.
01:00F0ABF4 4A390000F894    	   555:                 tst.b   MON_GRP0
01:00F0ABFA 6600004C        	   556:                 bne.w   .fresh                  ; no resumable frame + address
01:00F0ABFE 23C00000F83C    	   557:                 move.l  d0,MON_SPC
01:00F0AC04 600C            	   558:                 bra.b   .resume
                            	   559: .noaddr:
01:00F0AC06 4A390000F894    	   560:                 tst.b   MON_GRP0                ; no address: need a real frame
01:00F0AC0C 66000074        	   561:                 bne.w   .no_frame
01:00F0AC10 4DD6            	   562:                 bra.b   .resume
                            	   563: .resume:
01:00F0AC12 41FA162C        	   564:                 lea     resume_msg(pc),a0
01:00F0AC16 610007AC        	   565:                 bsr.w   puts
01:00F0AC1A 20390000F83C    	   566:                 move.l  MON_SPC,d0
01:00F0AC20 610007F2        	   567:                 bsr.w   puthex_long
01:00F0AC24 610007AA        	   568:                 bsr.w   put_crlf
                            	   569:                 ; rebuild stack frame and RTE
01:00F0AC28 08B900070000F840	   570:                 bclr.b  #SR_TRACE_BIT-8,MON_SSR ; stop tracing on a plain g
01:00F0AC30 2F790000F83C0002	   571:                 move.l  MON_SPC,2(sp)
01:00F0AC38 3EB90000F840    	   572:                 move.w  MON_SSR,(sp)
01:00F0AC3E 4CF97FFF0000F800	   573:                 movem.l MON_REGS,d0-d7/a0-a6
01:00F0AC46 4E73            	   574:                 rte
                            	   575: .fresh:
                            	   576:                 ; Cold entry: no frame exists, so build one.  RTE pops SR
                            	   577:                 ; then PC, so push PC first and SR on top.  IPL stays 7 and
                            	   578:                 ; the T bit stays clear; every vector already points at the
                            	   579:                 ; monitor, so a fault in the target lands back here.
01:00F0AC48 23C00000F83C    	   580:                 move.l  d0,MON_SPC
01:00F0AC4E 41FA15F0        	   581:                 lea     resume_msg(pc),a0
01:00F0AC52 61000770        	   582:                 bsr.w   puts
01:00F0AC56 20390000F83C    	   583:                 move.l  MON_SPC,d0
01:00F0AC5C 610007B6        	   584:                 bsr.w   puthex_long
01:00F0AC60 6100076E        	   585:                 bsr.w   put_crlf
01:00F0AC64 33FC27000000F840	   586:                 move.w  #$2700,MON_SSR
01:00F0AC6C 2F390000F83C    	   587:                 move.l  MON_SPC,-(sp)           ; PC
01:00F0AC72 3F390000F840    	   588:                 move.w  MON_SSR,-(sp)           ; SR
01:00F0AC78 4CF97FFF0000F800	   589:                 movem.l MON_REGS,d0-d7/a0-a6
01:00F0AC80 4E73            	   590:                 rte
                            	   591: .no_frame:
01:00F0AC82 41FA1583        	   592:                 lea     nogo_msg(pc),a0
01:00F0AC86 6100073C        	   593:                 bsr.w   puts
01:00F0AC8A 6000FCBC        	   594:                 bra.w   cmd_loop
                            	   595: 
                            	   596: ;================================================================
                            	   597: ; Breakpoints:  b            list slots
                            	   598: ;               b ADDR       set a breakpoint
                            	   599: ;               b -ADDR      clear one
                            	   600: ;               b -          clear all
                            	   601: ;
                            	   602: ; A breakpoint replaces the word at ADDR with TRAP #14 ($4E4E) and keeps
                            	   603: ; the original in the slot table.  Vector 46 ($B8) is pointed at
                            	   604: ; monitor_entry when the first breakpoint is armed — cold_init already
                            	   605: ; filled every vector, but on the --panic path the firmware owns the
                            	   606: ; table, so arming has to install it explicitly.  That is the only write
                            	   607: ; this command makes outside the target word and the slot table.
                            	   608: ;
                            	   609: ; TRAP pushes the 4-word frame, so MON_SPC/MON_SSR read correctly and
                            	   610: ; MON_GRP0 stays 0, which keeps `g` usable.  Note the pushed PC points
                            	   611: ; *after* the trap word: `g` therefore resumes past the breakpoint, and
                            	   612: ; the original instruction is NOT re-executed.  Clear the breakpoint and
                            	   613: ; `g ADDR` if you need to run it.
                            	   614: ;================================================================
                            	   615: cmd_bp:
01:00F0AC8E 528E            	   616:                 addq.l  #1,a6
01:00F0AC90 610004E2        	   617:                 bsr.w   skip_ws
01:00F0AC94 1016            	   618:                 move.b  (a6),d0
01:00F0AC96 67000148        	   619:                 beq.w   bp_list                 ; bare "b" -> list
01:00F0AC9A 0C00002D        	   620:                 cmpi.b  #'-',d0
01:00F0AC9E 6712            	   621:                 beq.b   .clear
01:00F0ACA0 610004E6        	   622:                 bsr.w   parse_hex
01:00F0ACA4 4A01            	   623:                 tst.b   d1
01:00F0ACA6 6700FEBA        	   624:                 beq.w   cmd_err
01:00F0ACAA 61000032        	   625:                 bsr.w   bp_set
01:00F0ACAE 6000FC98        	   626:                 bra.w   cmd_loop
                            	   627: .clear:
01:00F0ACB2 528E            	   628:                 addq.l  #1,a6                   ; skip '-'
01:00F0ACB4 610004BE        	   629:                 bsr.w   skip_ws
01:00F0ACB8 1016            	   630:                 move.b  (a6),d0
01:00F0ACBA 6712            	   631:                 beq.b   .clr_all
01:00F0ACBC 610004CA        	   632:                 bsr.w   parse_hex
01:00F0ACC0 4A01            	   633:                 tst.b   d1
01:00F0ACC2 6700FE9E        	   634:                 beq.w   cmd_err
01:00F0ACC6 610000AE        	   635:                 bsr.w   bp_clr_one
01:00F0ACCA 6000FC7C        	   636:                 bra.w   cmd_loop
                            	   637: .clr_all:
01:00F0ACCE 610000E8        	   638:                 bsr.w   bp_clr_all
01:00F0ACD2 41FA1491        	   639:                 lea     ok_msg(pc),a0
01:00F0ACD6 610006EC        	   640:                 bsr.w   puts
01:00F0ACDA 6000FC6C        	   641:                 bra.w   cmd_loop
                            	   642: 
                            	   643: ; ---- bp_set: arm a breakpoint at d0 ----
                            	   644: bp_set:
01:00F0ACDE 48E7F0C0        	   645:                 movem.l d0-d3/a0-a1,-(sp)
01:00F0ACE2 2600            	   646:                 move.l  d0,d3                   ; target address
01:00F0ACE4 67000082        	   647:                 beq.w   .odd                    ; 0 is not a target
01:00F0ACE8 08030000        	   648:                 btst.l  #0,d3
01:00F0ACEC 6600007A        	   649:                 bne.w   .odd                    ; must be word-aligned
                            	   650:                 ; Target must be on-board RAM.  A breakpoint writes $4E4E to
                            	   651:                 ; the address: in ROM that is silently lost, but in
                            	   652:                 ; peripheral space it would poke the AP I/F or XLTR, and
                            	   653:                 ; $F70011 would transmit a byte over the SIO.
01:00F0ACF0 0C8300000400    	   654:                 cmpi.l  #$400,d3
01:00F0ACF6 65000070        	   655:                 bcs.w   .odd                    ; vector table
01:00F0ACFA 0C8300020000    	   656:                 cmpi.l  #$20000,d3
01:00F0AD00 64000066        	   657:                 bcc.w   .odd                    ; not on-board RAM
                            	   658:                 ; find a free slot, and reject a duplicate
01:00F0AD04 41F90000F8A0    	   659:                 lea     MON_BPT,a0
01:00F0AD0A 7207            	   660:                 moveq   #MON_BPN-1,d1
01:00F0AD0C 93C9            	   661:                 suba.l  a1,a1                   ; a1 = first free slot, or 0
                            	   662: .scan:
01:00F0AD0E 2410            	   663:                 move.l  (a0),d2
01:00F0AD10 6708            	   664:                 beq.b   .isfree
01:00F0AD12 B483            	   665:                 cmp.l   d3,d2
01:00F0AD14 6700003E        	   666:                 beq.w   .dup
01:00F0AD18 6006            	   667:                 bra.b   .next
                            	   668: .isfree:
01:00F0AD1A 2409            	   669:                 move.l  a1,d2
01:00F0AD1C 6602            	   670:                 bne.b   .next                   ; already have a free slot
01:00F0AD1E 2248            	   671:                 move.l  a0,a1
                            	   672: .next:
01:00F0AD20 5C88            	   673:                 lea     MON_BP_SZ(a0),a0
01:00F0AD22 51C9FFEA        	   674:                 dbra    d1,.scan
01:00F0AD26 2409            	   675:                 move.l  a1,d2
01:00F0AD28 67000034        	   676:                 beq.w   .full
                            	   677:                 ; point the TRAP #14 vector at the monitor, then patch
01:00F0AD2C 21FC00F0A84000B8	   678:                 move.l  #monitor_entry,BP_VECTOR
01:00F0AD34 2043            	   679:                 move.l  d3,a0
01:00F0AD36 33500004        	   680:                 move.w  (a0),4(a1)              ; save original word
01:00F0AD3A 30BC4E4E        	   681:                 move.w  #BP_OPCODE,(a0)
01:00F0AD3E 2283            	   682:                 move.l  d3,(a1)                 ; mark slot in use
01:00F0AD40 41FA142F        	   683:                 lea     bp_set_msg(pc),a0
