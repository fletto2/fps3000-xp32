01:00F0B2EC 23FC000000000000	  1329:                 move.l  #0,MON_TAPTGT
01:00F0B2F4 F8D4
01:00F0B2F6 41F90000F8D8    	  1330:                 lea     MON_TAPSAV,a0
01:00F0B2FC 7203            	  1331:                 moveq   #3,d1
                            	  1332: .tapclr:
01:00F0B2FE 20FC00000000    	  1333:                 move.l  #0,(a0)+
01:00F0B304 51C9FFF8        	  1334:                 dbra    d1,.tapclr
01:00F0B308 33FC00000000F8E8	  1335:                 move.w  #0,MON_RINGHD
01:00F0B310 33FC00000000F8EA	  1336:                 move.w  #0,MON_RINGN
01:00F0B318 33FC00000000F8EC	  1337:                 move.w  #0,MON_RINGOV
01:00F0B320 41F90000F900    	  1338:                 lea     MON_RING,a0
01:00F0B326 323C009F        	  1339:                 move.w  #(MON_RING_N*MON_RING_SZ)/4-1,d1
