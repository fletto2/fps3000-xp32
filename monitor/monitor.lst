                            	  2788: cmd_page:
01:00F0BC0E 528E            	  2789:                 addq.l  #1,a6
01:00F0BC10 0C160077        	  2790:                 cmpi.b  #'w',(a6)
01:00F0BC14 6700008E        	  2791:                 beq.w   .write
01:00F0BC18 6100F622        	  2792:                 bsr.w   skip_ws
01:00F0BC1C 6100F632        	  2793:                 bsr.w   parse_hex
01:00F0BC20 4A01            	  2794:                 tst.b   d1
01:00F0BC22 6700EF7C        	  2795:                 beq.w   cmd_err
01:00F0BC26 028000000FFF    	  2796:                 andi.l  #$FFF,d0                ; 12-bit page field
01:00F0BC2C 3A00            	  2797:                 move.w  d0,d5
01:00F0BC2E 6100F60C        	  2798:                 bsr.w   skip_ws
01:00F0BC32 7C04            	  2799:                 moveq   #4,d6                   ; default longs
01:00F0BC34 1016            	  2800:                 move.b  (a6),d0
01:00F0BC36 6716            	  2801:                 beq.b   .havecnt
01:00F0BC38 6100F616        	  2802:                 bsr.w   parse_hex
01:00F0BC3C 4A01            	  2803:                 tst.b   d1
01:00F0BC3E 6700EF60        	  2804:                 beq.w   cmd_err
01:00F0BC42 2C00            	  2805:                 move.l  d0,d6
01:00F0BC44 0C8600000020    	  2806:                 cmpi.l  #32,d6
01:00F0BC4A 6302            	  2807:                 bls.b   .havecnt                ; UNSIGNED, as cmd_bulk: a
                            	  2808:                                                 ;   signed `ble` passed every
                            	  2809:                                                 ;   value >= $80000000 through
                            	  2810:                                                 ;   unclamped, and xdump would
                            	  2811:                                                 ;   then walk 2^32 longs off
                            	  2812:                                                 ;   the $400000 window.  Zero
                            	  2813:                                                 ;   is safe -- xdump guards it.
01:00F0BC4C 7C20            	  2814:                 moveq   #32,d6
                            	  2815: .havecnt:
                            	  2816:                 ; Optional THIRD argument: a byte offset within the window.
                            	  2817:                 ; Appended rather than inserted so `p PP NN` keeps meaning
                            	  2818:                 ; what it always did -- inserting the offset second would
                            	  2819:                 ; silently re-read `p 0 4` as "page 0, offset 4".
                            	  2820:                 ;
                            	  2821:                 ; Without it the pair is asymmetric: pw writes at any
                            	  2822:                 ; offset and p could only read offset 0, so verifying a
                            	  2823:                 ; non-zero-offset write meant `ww FF0210 nnnn` + `ml` --
                            	  2824:                 ; the two-step that leaves MODE2 selected, which is exactly
                            	  2825:                 ; what pw exists to avoid.  A write command whose result
                            	  2826:                 ; can only be checked unsafely is not much of a win.
01:00F0BC4E 7800            	  2827:                 moveq   #0,d4                   ; default offset
01:00F0BC50 6100F5EA        	  2828:                 bsr.w   skip_ws
01:00F0BC54 4A16            	  2829:                 tst.b   (a6)
01:00F0BC56 6712            	  2830:                 beq.b   .haveoff
01:00F0BC58 6100F5F6        	  2831:                 bsr.w   parse_hex
01:00F0BC5C 4A01            	  2832:                 tst.b   d1
01:00F0BC5E 6700EF40        	  2833:                 beq.w   cmd_err
01:00F0BC62 0280003FFFFC    	  2834:                 andi.l  #$3FFFFC,d0             ; long-aligned, in-window.
                            	  2835:                                                 ;   $3FFFFC because ONE PAGE
                            	  2836:                                                 ;   IS 4 MB: the effective
                            	  2837:                                                 ;   longword index is
                            	  2838:                                                 ;   (MODE2 << 20) | (off >> 2),
                            	  2839:                                                 ;   so off >> 2 spans 20 bits.
                            	  2840:                                                 ;   Do NOT shrink this to
                            	  2841:                                                 ;   $FFFFC -- the emulator
                            	  2842:                                                 ;   models only the first 1 MB
                            	  2843:                                                 ;   (CHASSIS_MEM_SIZE, flagged
                            	  2844:                                                 ;   "not derived" in its own
                            	  2845:                                                 ;   source), so offsets
                            	  2846:                                                 ;   >= $100000 bus-error THERE
                            	  2847:                                                 ;   and are valid on iron.
                            	  2848:                                                 ;   The fault is reported with
                            	  2849:                                                 ;   its address, which is the
                            	  2850:                                                 ;   diagnostic working.
                            	  2851:                 ;
                            	  2852:                 ; A 20-bit offset makes the HOST MAILBOX reachable, which
                            	  2853:                 ; is worth stating because it is not obvious: $70001C is
                            	  2854:                 ; inside this window at page $F, offset $70001C-$400000 =
                            	  2855:                 ; $30001C.  So
                            	  2856:                 ;
                            	  2857:                 ;     p F 2 30001C
                            	  2858:                 ;
                            	  2859:                 ; reads the mailbox pair the firmware's TCBIO1I ISR uses
                            	  2860:                 ; ($70001C request, $700020 reply), and the ISR reaches it
                            	  2861:                 ; the same way -- it saves MODE2, writes $F, touches the
                            	  2862:                 ; pair, restores.  The mailbox is only valid at page $F.
                            	  2863:                 ;
                            	  2864:                 ; READING is harmless.  WRITING it with `pw` on the panic
                            	  2865:                 ; image is not: bit 29 is the host's "needs attention"
                            	  2866:                 ; flag and the class field at bits 16-17 selects the ISR's
                            	  2867:                 ; arm, so a poke can hand TCBIO1I a request no host made.
                            	  2868:                 ; The emulator's 1 MB window bus-errors at this offset;
                            	  2869:                 ; hardware does not.
01:00F0BC68 2800            	  2870:                 move.l  d0,d4
                            	  2871: .haveoff:
                            	  2872:                 ; Save MODE2 on the STACK, not in a register: xdump uses
                            	  2873:                 ; d3/d4/d6 for its own line arithmetic, and holding the
                            	  2874:                 ; saved page in d4 across the call restored garbage --
                            	  2875:                 ; which read as "MODE2 restored to $0004" on a page that
                            	  2876:                 ; had been $0000.  A restore that reports the wrong value
                            	  2877:                 ; is worse than none, because it is believed.
01:00F0BC6A 3F3900FF0210    	  2878:                 move.w  $FF0210,-(sp)           ; save MODE2
01:00F0BC70 33C500FF0210    	  2879:                 move.w  d5,$FF0210
01:00F0BC76 49F900400000    	  2880:                 lea     $400000,a4
01:00F0BC7C D9C4            	  2881:                 adda.l  d4,a4                   ; d4 is free again after xdump,
                            	  2882:                                                 ;   which is where the restore
                            	  2883:                                                 ;   below reloads it
01:00F0BC7E 2406            	  2884:                 move.l  d6,d2
01:00F0BC80 7E04            	  2885:                 moveq   #4,d7
01:00F0BC82 6100F8DC        	  2886:                 bsr.w   xdump
01:00F0BC86 381F            	  2887:                 move.w  (sp)+,d4
01:00F0BC88 33C400FF0210    	  2888:                 move.w  d4,$FF0210              ; restore MODE2
01:00F0BC8E 41FA152E        	  2889:                 lea     page_rest_msg(pc),a0
01:00F0BC92 6100F870        	  2890:                 bsr.w   puts
