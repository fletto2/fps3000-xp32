                            	   666: ;----------------------------------------------------------------
                            	   667: ; Info — chassis state, ROM version, free RAM, etc.
                            	   668: ;----------------------------------------------------------------
                            	   669: cmd_info:
01:00F0AD7A 41FA08E1        	   670:                 lea     info_msg(pc),a0
01:00F0AD7E 610004AE        	   671:                 bsr.w   puts
                            	   672: 
                            	   673:                 ; Live board status.  Byte read at ODD $F70019 — the board
                            	   674:                 ; status/control register is an 8-bit device on D0-D7, and
                            	   675:                 ; the ROM bit-tests this same odd byte (F08728 etc).
01:00F0AD82 41FA0A01        	   676:                 lea     bstat_msg(pc),a0
01:00F0AD86 610004A6        	   677:                 bsr.w   puts
01:00F0AD8A 103900F70019    	   678:                 move.b  $F70019,d0
01:00F0AD90 610004D2        	   679:                 bsr.w   puthex_byte
01:00F0AD94 610004A4        	   680:                 bsr.w   put_crlf
                            	   681: 
                            	   682:                 ; VERSAmodule control register image at $1FFF0.  Per the
                            	   683:                 ; manual this is "control register image only — register
                            	   684:                 ; not directly accessible", so read-back is mediated by
                            	   685:                 ; external logic and may not reflect what was written.
01:00F0AD98 41FA0A03        	   686:                 lea     vmod_msg(pc),a0
01:00F0AD9C 61000490        	   687:                 bsr.w   puts
01:00F0ADA0 30390001FFF0    	   688:                 move.w  $1FFF0,d0
01:00F0ADA6 610004CA        	   689:                 bsr.w   puthex_word
01:00F0ADAA 6100048E        	   690:                 bsr.w   put_crlf
                            	   691: 
                            	   692:                 ; Where this build actually ends, rather than a hardcoded
                            	   693:                 ; number that goes stale every time the monitor grows.
01:00F0ADAE 41FA0A04        	   694:                 lea     mend_msg(pc),a0
01:00F0ADB2 6100047A        	   695:                 bsr.w   puts
01:00F0ADB6 203C00F0B82E    	   696:                 move.l  #monitor_end,d0
01:00F0ADBC 610004C0        	   697:                 bsr.w   puthex_long
01:00F0ADC0 61000478        	   698:                 bsr.w   put_crlf
                            	   699: 
                            	   700:                 ; Fault / link state: frame kind, nest guard, TX-timeout
                            	   701:                 ; flag.  MON_NEST = 2 means a previous run died while
                            	   702:                 ; reporting a fault; MON_TXFAIL = 1 means putchar gave up
                            	   703:                 ; waiting for the SIO at some point.
01:00F0ADC4 41FA0A05        	   704:                 lea     fault_msg(pc),a0
01:00F0ADC8 61000464        	   705:                 bsr.w   puts
01:00F0ADCC 10390000F894    	   706:                 move.b  MON_GRP0,d0
01:00F0ADD2 61000490        	   707:                 bsr.w   puthex_byte
01:00F0ADD6 103C002F        	   708:                 move.b  #'/',d0
01:00F0ADDA 61000406        	   709:                 bsr.w   putchar
01:00F0ADDE 10390000F895    	   710:                 move.b  MON_NEST,d0
01:00F0ADE4 6100047E        	   711:                 bsr.w   puthex_byte
01:00F0ADE8 103C002F        	   712:                 move.b  #'/',d0
01:00F0ADEC 610003F4        	   713:                 bsr.w   putchar
01:00F0ADF0 10390000F896    	   714:                 move.b  MON_TXFAIL,d0
01:00F0ADF6 6100046C        	   715:                 bsr.w   puthex_byte
01:00F0ADFA 6100043E        	   716:                 bsr.w   put_crlf
01:00F0ADFE 6000FAFA        	   717:                 bra.w   cmd_loop
                            	   718: 
                            	   719: ;----------------------------------------------------------------
                            	   720: ; Load S-record over the SIO (channel A).
                            	   721: ; Each line consumed and validated; bytes go to addresses inside.
                            	   722: ; Terminator: S8 / S9 record.
                            	   723: ;----------------------------------------------------------------
                            	   724: cmd_load_srec:
01:00F0AE02 41FA0824        	   725:                 lea     load_msg(pc),a0
01:00F0AE06 61000426        	   726:                 bsr.w   puts
01:00F0AE0A 7800            	   727:                 clr.l   d4                      ; record count
01:00F0AE0C 7A00            	   728:                 clr.l   d5                      ; byte count
                            	   729: .scan_S:
01:00F0AE0E 61000404        	   730:                 bsr.w   getchar
01:00F0AE12 0C000053        	   731:                 cmpi.b  #'S',d0
01:00F0AE16 66F6            	   732:                 bne.b   .scan_S                  ; skip until 'S'
01:00F0AE18 610003FA        	   733:                 bsr.w   getchar                  ; record type
01:00F0AE1C 0C000038        	   734:                 cmpi.b  #'8',d0
01:00F0AE20 670000F2        	   735:                 beq.w   .terminator
01:00F0AE24 0C000039        	   736:                 cmpi.b  #'9',d0
01:00F0AE28 670000EA        	   737:                 beq.w   .terminator
01:00F0AE2C 0C000037        	   738:                 cmpi.b  #'7',d0
01:00F0AE30 670000E2        	   739:                 beq.w   .terminator
01:00F0AE34 0C000030        	   740:                 cmpi.b  #'0',d0
01:00F0AE38 670000C4        	   741:                 beq.w   .eat_eol                ; header — skip
01:00F0AE3C 0C000031        	   742:                 cmpi.b  #'1',d0
01:00F0AE40 6D00FFCC        	   743:                 blt.w   .scan_S
01:00F0AE44 0C000033        	   744:                 cmpi.b  #'3',d0
01:00F0AE48 6E00FFC4        	   745:                 bgt.w   .scan_S
                            	   746:                 ; data record S1 / S2 / S3
01:00F0AE4C 1C00            	   747:                 move.b  d0,d6                   ; save type
01:00F0AE4E 61000296        	   748:                 bsr.w   read_hex_byte
                            	   749:                 ; read_hex_byte only writes d0's low byte, so the upper 24
                            	   750:                 ; bits are stale.  Zero-extend explicitly, and keep the
                            	   751:                 ; count word-sized below: a payload count >= $80 is legal
                            	   752:                 ; in an S1 record, and a signed byte test would read it as
                            	   753:                 ; negative and silently truncate the record to no data.
01:00F0AE52 7400            	   754:                 moveq   #0,d2
01:00F0AE54 1400            	   755:                 move.b  d0,d2                   ; payload count (incl addr+cksum)
                            	   756:                 ; d7 accumulates the record checksum: sum of the count byte,
                            	   757:                 ; the address bytes and the data bytes.  A valid record has
                            	   758:                 ; (sum + cksum) & $FF == $FF.  Without this a corrupted line
                            	   759:                 ; loads silently and reports success, which over a serial
                            	   760:                 ; link at an unverified baud rate is exactly the failure we
                            	   761:                 ; would not notice.
01:00F0AE56 7E00            	   762:                 moveq   #0,d7
01:00F0AE58 DE00            	   763:                 add.b   d0,d7
01:00F0AE5A 7600            	   764:                 clr.l   d3
01:00F0AE5C 0C060033        	   765:                 cmpi.b  #'3',d6
01:00F0AE60 6708            	   766:                 beq.b   .a32
01:00F0AE62 0C060032        	   767:                 cmpi.b  #'2',d6
01:00F0AE66 670E            	   768:                 beq.b   .a24
01:00F0AE68 6018            	   769:                 bra.b   .a16
                            	   770: .a32:
01:00F0AE6A 6100027A        	   771:                 bsr.w   read_hex_byte
01:00F0AE6E DE00            	   772:                 add.b   d0,d7
01:00F0AE70 E18B            	   773:                 lsl.l   #8,d3
01:00F0AE72 8600            	   774:                 or.b    d0,d3
01:00F0AE74 5342            	   775:                 subq.w  #1,d2
                            	   776: .a24:
01:00F0AE76 6100026E        	   777:                 bsr.w   read_hex_byte
01:00F0AE7A DE00            	   778:                 add.b   d0,d7
01:00F0AE7C E18B            	   779:                 lsl.l   #8,d3
01:00F0AE7E 8600            	   780:                 or.b    d0,d3
01:00F0AE80 5342            	   781:                 subq.w  #1,d2
                            	   782: .a16:
01:00F0AE82 61000262        	   783:                 bsr.w   read_hex_byte
01:00F0AE86 DE00            	   784:                 add.b   d0,d7
01:00F0AE88 E18B            	   785:                 lsl.l   #8,d3
01:00F0AE8A 8600            	   786:                 or.b    d0,d3
01:00F0AE8C 61000258        	   787:                 bsr.w   read_hex_byte
01:00F0AE90 DE00            	   788:                 add.b   d0,d7
01:00F0AE92 E18B            	   789:                 lsl.l   #8,d3
01:00F0AE94 8600            	   790:                 or.b    d0,d3
01:00F0AE96 5542            	   791:                 subq.w  #2,d2
01:00F0AE98 5342            	   792:                 subq.w  #1,d2                   ; -1 for checksum
01:00F0AE9A 2843            	   793:                 move.l  d3,a4                   ; dest pointer
01:00F0AE9C 6100020C        	   794:                 bsr.w   srec_check              ; d1 = 0 -> would self-destruct
01:00F0AEA0 4A01            	   795:                 tst.b   d1
01:00F0AEA2 67000044        	   796:                 beq.w   .badaddr
                            	   797: .dloop:
01:00F0AEA6 4A42            	   798:                 tst.w   d2
01:00F0AEA8 6F0E            	   799:                 ble.b   .endrec
01:00F0AEAA 6100023A        	   800:                 bsr.w   read_hex_byte
01:00F0AEAE DE00            	   801:                 add.b   d0,d7
01:00F0AEB0 18C0            	   802:                 move.b  d0,(a4)+
01:00F0AEB2 5285            	   803:                 addq.l  #1,d5
01:00F0AEB4 5342            	   804:                 subq.w  #1,d2
01:00F0AEB6 60EE            	   805:                 bra.b   .dloop
                            	   806: .endrec:
01:00F0AEB8 6100022C        	   807:                 bsr.w   read_hex_byte           ; the record's checksum byte
01:00F0AEBC DE00            	   808:                 add.b   d0,d7
01:00F0AEBE 0C0700FF        	   809:                 cmpi.b  #$FF,d7
01:00F0AEC2 660E            	   810:                 bne.b   .badsum
01:00F0AEC4 5284            	   811:                 addq.l  #1,d4
01:00F0AEC6 103C002E        	   812:                 move.b  #'.',d0
01:00F0AECA 61000316        	   813:                 bsr.w   putchar
01:00F0AECE 6000002E        	   814:                 bra.w   .eat_eol
                            	   815: .badsum:
                            	   816:                 ; The data was already written by the time we can check, so
                            	   817:                 ; say which record failed and let the operator re-send it.
01:00F0AED2 41FA093B        	   818:                 lea     srec_sum_msg(pc),a0
01:00F0AED6 61000356        	   819:                 bsr.w   puts
01:00F0AEDA 2003            	   820:                 move.l  d3,d0
01:00F0AEDC 610003A0        	   821:                 bsr.w   puthex_long
01:00F0AEE0 61000358        	   822:                 bsr.w   put_crlf
01:00F0AEE4 6000FF28        	   823:                 bra.w   .scan_S
                            	   824: .badaddr:
                            	   825:                 ; Skip this record.  No need to consume its hex: .scan_S
                            	   826:                 ; resyncs on the next 'S', and hex digits are 0-9A-F so
                            	   827:                 ; none of the skipped payload can be mistaken for a
                            	   828:                 ; record start.
01:00F0AEE8 41FA08F8        	   829:                 lea     srec_bad_msg(pc),a0
01:00F0AEEC 61000340        	   830:                 bsr.w   puts
01:00F0AEF0 2003            	   831:                 move.l  d3,d0
01:00F0AEF2 6100038A        	   832:                 bsr.w   puthex_long
01:00F0AEF6 61000342        	   833:                 bsr.w   put_crlf
01:00F0AEFA 6000FF12        	   834:                 bra.w   .scan_S
                            	   835: .eat_eol:
01:00F0AEFE 61000314        	   836:                 bsr.w   getchar
01:00F0AF02 0C00000D        	   837:                 cmpi.b  #13,d0
01:00F0AF06 6700FF06        	   838:                 beq.w   .scan_S
01:00F0AF0A 0C00000A        	   839:                 cmpi.b  #10,d0
01:00F0AF0E 6700FEFE        	   840:                 beq.w   .scan_S
01:00F0AF12 60EA            	   841:                 bra.b   .eat_eol
                            	   842: .terminator:
                            	   843:                 ; finish the terminator's line
                            	   844: .t_eol:
01:00F0AF14 610002FE        	   845:                 bsr.w   getchar
01:00F0AF18 0C00000D        	   846:                 cmpi.b  #13,d0
01:00F0AF1C 6708            	   847:                 beq.b   .t_done
01:00F0AF1E 0C00000A        	   848:                 cmpi.b  #10,d0
01:00F0AF22 6702            	   849:                 beq.b   .t_done
01:00F0AF24 60EE            	   850:                 bra.b   .t_eol
                            	   851: .t_done:
01:00F0AF26 61000312        	   852:                 bsr.w   put_crlf
01:00F0AF2A 41FA071A        	   853:                 lea     load_done_msg(pc),a0
01:00F0AF2E 610002FE        	   854:                 bsr.w   puts
01:00F0AF32 2004            	   855:                 move.l  d4,d0
01:00F0AF34 61000348        	   856:                 bsr.w   puthex_long
01:00F0AF38 41FA0717        	   857:                 lea     load_bytes_msg(pc),a0
01:00F0AF3C 610002F0        	   858:                 bsr.w   puts
01:00F0AF40 2005            	   859:                 move.l  d5,d0
01:00F0AF42 6100033A        	   860:                 bsr.w   puthex_long
01:00F0AF46 610002F2        	   861:                 bsr.w   put_crlf
01:00F0AF4A 6000F9AE        	   862:                 bra.w   cmd_loop
                            	   863: 
                            	   864: ;================================================================
                            	   865: ; Helpers
                            	   866: ;================================================================
                            	   867: 
                            	   868: ; ---- hexdump d2 bytes starting at a4 ----
                            	   869: hexdump:
01:00F0AF4E 2C02            	   870:                 move.l  d2,d6                   ; bytes remaining
                            	   871: .line:
                            	   872:                 ; Print address
01:00F0AF50 200C            	   873:                 move.l  a4,d0
01:00F0AF52 6100032A        	   874:                 bsr.w   puthex_long
01:00F0AF56 103C003A        	   875:                 move.b  #':',d0
01:00F0AF5A 61000286        	   876:                 bsr.w   putchar
01:00F0AF5E 103C0020        	   877:                 move.b  #' ',d0
01:00F0AF62 6100027E        	   878:                 bsr.w   putchar
                            	   879:                 ; row count = min(16, d6)
01:00F0AF66 7810            	   880:                 moveq   #16,d4
01:00F0AF68 BC84            	   881:                 cmp.l   d4,d6
01:00F0AF6A 6C02            	   882:                 bge.b   .full
01:00F0AF6C 2806            	   883:                 move.l  d6,d4
                            	   884: .full:
01:00F0AF6E 2A4C            	   885:                 move.l  a4,a5                   ; row start
                            	   886:                 ; print d4 hex bytes
01:00F0AF70 2604            	   887:                 move.l  d4,d3
01:00F0AF72 4A83            	   888:                 tst.l   d3
01:00F0AF74 6712            	   889:                 beq.b   .pad
                            	   890: .hex:
01:00F0AF76 101C            	   891:                 move.b  (a4)+,d0
01:00F0AF78 610002EA        	   892:                 bsr.w   puthex_byte
01:00F0AF7C 103C0020        	   893:                 move.b  #' ',d0
01:00F0AF80 61000260        	   894:                 bsr.w   putchar
01:00F0AF84 5383            	   895:                 subq.l  #1,d3
01:00F0AF86 66EE            	   896:                 bne.b   .hex
                            	   897: .pad:
                            	   898:                 ; pad to 16 hex slots
01:00F0AF88 7A10            	   899:                 moveq   #16,d5
01:00F0AF8A 9A84            	   900:                 sub.l   d4,d5
01:00F0AF8C 4A85            	   901:                 tst.l   d5
01:00F0AF8E 6714            	   902:                 beq.b   .ascii
                            	   903: .padl:
01:00F0AF90 103C0020        	   904:                 move.b  #' ',d0
01:00F0AF94 6100024C        	   905:                 bsr.w   putchar
01:00F0AF98 61000248        	   906:                 bsr.w   putchar
01:00F0AF9C 61000244        	   907:                 bsr.w   putchar
01:00F0AFA0 5385            	   908:                 subq.l  #1,d5
01:00F0AFA2 66EC            	   909:                 bne.b   .padl
                            	   910: .ascii:
01:00F0AFA4 103C007C        	   911:                 move.b  #'|',d0
01:00F0AFA8 61000238        	   912:                 bsr.w   putchar
01:00F0AFAC 2604            	   913:                 move.l  d4,d3
01:00F0AFAE 4A83            	   914:                 tst.l   d3
01:00F0AFB0 671C            	   915:                 beq.b   .ascii_end
                            	   916: .ascii_l:
01:00F0AFB2 101D            	   917:                 move.b  (a5)+,d0
01:00F0AFB4 0C000020        	   918:                 cmpi.b  #' ',d0
01:00F0AFB8 6D08            	   919:                 blt.b   .dot
01:00F0AFBA 0C00007E        	   920:                 cmpi.b  #126,d0
01:00F0AFBE 6E02            	   921:                 bgt.b   .dot
01:00F0AFC0 6004            	   922:                 bra.b   .pchar
                            	   923: .dot:
01:00F0AFC2 103C002E        	   924:                 move.b  #'.',d0
                            	   925: .pchar:
01:00F0AFC6 6100021A        	   926:                 bsr.w   putchar
01:00F0AFCA 5383            	   927:                 subq.l  #1,d3
01:00F0AFCC 66E4            	   928:                 bne.b   .ascii_l
                            	   929: .ascii_end:
01:00F0AFCE 103C007C        	   930:                 move.b  #'|',d0
01:00F0AFD2 6100020E        	   931:                 bsr.w   putchar
01:00F0AFD6 61000262        	   932:                 bsr.w   put_crlf
01:00F0AFDA 9C84            	   933:                 sub.l   d4,d6
01:00F0AFDC 6E00FF72        	   934:                 bgt.w   .line
01:00F0AFE0 4E75            	   935:                 rts
                            	   936: 
                            	   937: ; ---- read_line: read line from SIO into MON_LINEBUF, term=0 ----
                            	   938: read_line:
01:00F0AFE2 41F90000F850    	   939:                 lea     MON_LINEBUF,a0
01:00F0AFE8 743C            	   940:                 moveq   #60,d2                  ; 61 chars + NUL, 2 spare
                            	   941:                                         ;   in the 64 B before MON_LASTADDR
                            	   942: .rloop:
01:00F0AFEA 61000228        	   943:                 bsr.w   getchar
01:00F0AFEE 0C00000D        	   944:                 cmpi.b  #13,d0                  ; CR
01:00F0AFF2 671C            	   945:                 beq.b   .end
01:00F0AFF4 0C00000A        	   946:                 cmpi.b  #10,d0                  ; LF
01:00F0AFF8 6716            	   947:                 beq.b   .end
01:00F0AFFA 0C000008        	   948:                 cmpi.b  #8,d0                   ; BS
01:00F0AFFE 671A            	   949:                 beq.b   .bs
01:00F0B000 0C00007F        	   950:                 cmpi.b  #127,d0                 ; DEL
01:00F0B004 6714            	   951:                 beq.b   .bs
