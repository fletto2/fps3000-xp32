                            	  2159: .havecnt:
                            	  2160:                 ; Save MODE2 on the STACK, not in a register: xdump uses
                            	  2161:                 ; d3/d4/d6 for its own line arithmetic, and holding the
                            	  2162:                 ; saved page in d4 across the call restored garbage --
                            	  2163:                 ; which read as "MODE2 restored to $0004" on a page that
                            	  2164:                 ; had been $0000.  A restore that reports the wrong value
                            	  2165:                 ; is worse than none, because it is believed.
01:00F0B9BC 3F3900FF0210    	  2166:                 move.w  $FF0210,-(sp)           ; save MODE2
01:00F0B9C2 33C500FF0210    	  2167:                 move.w  d5,$FF0210
