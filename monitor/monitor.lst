                            	   947: .end:
01:00F0AFFC 10BC0000        	   948:                 move.b  #0,(a0)                 ; not clr: CLR reads first
01:00F0B000 61000214        	   949:                 bsr.w   put_crlf
01:00F0B004 4E75            	   950:                 rts
                            	   951: .bs:
01:00F0B006 B1FC0000F850    	   952:                 cmpa.l  #MON_LINEBUF,a0
01:00F0B00C 67C8            	   953:                 beq.b   .rloop                  ; empty - ignore
01:00F0B00E 5388            	   954:                 subq.l  #1,a0
01:00F0B010 5282            	   955:                 addq.l  #1,d2
01:00F0B012 103C0008        	   956:                 move.b  #8,d0
01:00F0B016 610001B6        	   957:                 bsr.w   putchar
01:00F0B01A 103C0020        	   958:                 move.b  #' ',d0
01:00F0B01E 610001AE        	   959:                 bsr.w   putchar
01:00F0B022 103C0008        	   960:                 move.b  #8,d0
01:00F0B026 610001A6        	   961:                 bsr.w   putchar
01:00F0B02A 60AA            	   962:                 bra.b   .rloop
