00:00F0AD3A 13FC004400F70012	   577:                 move.b  #$44,SIO_A_CTRL
                            	   578:                 ; WR3: 8 bits/RX char, RX enable
00:00F0AD42 13FC000300F70012	   579:                 move.b  #$03,SIO_A_CTRL         ; WR0: ptr to WR3
00:00F0AD4A 13FC00C100F70012	   580:                 move.b  #$C1,SIO_A_CTRL
                            	   581:                 ; WR5: 8 bits/TX char, TX enable, DTR, RTS
00:00F0AD52 13FC000500F70012	   582:                 move.b  #$05,SIO_A_CTRL         ; WR0: ptr to WR5
00:00F0AD5A 13FC00EA00F70012	   583:                 move.b  #$EA,SIO_A_CTRL
00:00F0AD62 4E75            	   584:                 rts
