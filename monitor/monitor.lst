01:00F0AB86 7E02            	   492:                 moveq   #2,d7
01:00F0AB88 528E            	   493:                 addq.l  #1,a6
01:00F0AB8A 6004            	   494:                 bra.b   .havew
                            	   495: .w32:
01:00F0AB8C 7E04            	   496:                 moveq   #4,d7
01:00F0AB8E 528E            	   497:                 addq.l  #1,a6
                            	   498: .havew:
01:00F0AB90 610005E2        	   499:                 bsr.w   skip_ws
01:00F0AB94 610005F2        	   500:                 bsr.w   parse_hex
01:00F0AB98 4A01            	   501:                 tst.b   d1
01:00F0AB9A 6700FFC6        	   502:                 beq.w   cmd_err
01:00F0AB9E 610008D2        	   503:                 bsr.w   odd_check
01:00F0ABA2 4A01            	   504:                 tst.b   d1
01:00F0ABA4 6700FDA2        	   505:                 beq.w   cmd_loop
01:00F0ABA8 2840            	   506:                 move.l  d0,a4
                            	   507: .wloop:
01:00F0ABAA 610005C8        	   508:                 bsr.w   skip_ws
01:00F0ABAE 1016            	   509:                 move.b  (a6),d0
01:00F0ABB0 6722            	   510:                 beq.b   .done
01:00F0ABB2 610005D4        	   511:                 bsr.w   parse_hex
01:00F0ABB6 4A01            	   512:                 tst.b   d1
01:00F0ABB8 6700FFA8        	   513:                 beq.w   cmd_err
01:00F0ABBC 0C070001        	   514:                 cmpi.b  #1,d7
01:00F0ABC0 6604            	   515:                 bne.b   .p2
01:00F0ABC2 18C0            	   516:                 move.b  d0,(a4)+
01:00F0ABC4 60E4            	   517:                 bra.b   .wloop
