01:00F0B68C 61000156        	  2054:                 bsr.w   ch_window               ; a4 = window, a5 = BIM CR
01:00F0B690 3615            	  2055:                 move.w  (a5),d3                 ; save BIM CR
01:00F0B692 383900FF021A    	  2056:                 move.w  $FF021A,d4              ; save IRQ mask word
