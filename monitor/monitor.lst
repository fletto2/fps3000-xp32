                            	   903: 
                            	   904: ;================================================================
                            	   905: ; Single step:  t
                            	   906: ;
                            	   907: ; Sets the T bit in the saved SR and resumes.  The 68000 then takes a
                            	   908: ; trace exception after one instruction, which lands back in the monitor
                            	   909: ; (vector 9 at $24).  Needs a resumable frame, same as `g`.  The T bit
                            	   910: ; stays set in the restored SR, so `t` repeats naturally.
                            	   911: ;
                            	   912: ; Stepping has TWO halves and `g` puts both back: the T bit in the saved
                            	   913: ; SR, and the vector itself.  Contrast `b`, which installs monitor_entry
                            	   914: ; into TRAP #14 permanently and is right to -- the two differ on whether
                            	   915: ; the vector belongs to anyone, measured from the kernel's own static
                            	   916: ; vector table at $F00114 ({1-byte vector, 3-byte handler} records):
                            	   917: ;
                            	   918: ;     vector $09 TRACE   -> $F00AEE   entry 11 of the CPU-exception bsr
                            	   919: ;                                     ladder at $F00AD8.  LIVE.
                            	   920: ;     vector $2E TRAP#14 -> ABSENT from that table.  Nobody's.
                            	   921: ;
                            	   922: ; So `t` displaces a real kernel handler and must give it back.  Nothing
                            	   923: ; today notices -- RMS68K's per-task single-stepping is latent, since
                            	   924: ; nothing sets TCB+$148 bit 31 -- but leaving it installed breaks the
                            	   925: ; save/restore discipline every other stateful command here follows, and
                            	   926: ; the whole point of the panic image is to sit alongside a running RTOS.
                            	   927: ;================================================================
                            	   928: cmd_trace:
01:00F0AE92 4A390000F894    	   929:                 tst.b   MON_GRP0
01:00F0AE98 66000050        	   930:                 bne.w   trace_noframe
                            	   931:                 ; Save the ORIGINAL vector ONCE.  A second `t` must not
                            	   932:                 ; save monitor_entry over it: that is precisely the bug
                            	   933:                 ; `s` twice had, where re-arming made the taps save
                            	   934:                 ; themselves and `s-` then restored the taps.
01:00F0AE9C 4AB90000F8D4    	   935:                 tst.l   MON_TRCSAV
01:00F0AEA2 6608            	   936:                 bne.b   .haveold
01:00F0AEA4 23F800240000F8D4	   937:                 move.l  TRACE_VECTOR,MON_TRCSAV
                            	   938: .haveold:
01:00F0AEAC 21FC00F0A8400024	   939:                 move.l  #monitor_entry,TRACE_VECTOR
01:00F0AEB4 08F900070000F840	   940:                 bset.b  #SR_TRACE_BIT-8,MON_SSR ; high byte of the saved SR
01:00F0AEBC 41FA18CE        	   941:                 lea     trace_msg(pc),a0
01:00F0AEC0 61000642        	   942:                 bsr.w   puts
01:00F0AEC4 20390000F83C    	   943:                 move.l  MON_SPC,d0
01:00F0AECA 61000688        	   944:                 bsr.w   puthex_long
01:00F0AECE 61000640        	   945:                 bsr.w   put_crlf
01:00F0AED2 2F790000F83C0002	   946:                 move.l  MON_SPC,2(sp)
01:00F0AEDA 3EB90000F840    	   947:                 move.w  MON_SSR,(sp)
01:00F0AEE0 4CF97FFF0000F800	   948:                 movem.l MON_REGS,d0-d7/a0-a6
01:00F0AEE8 4E73            	   949:                 rte
                            	   950: trace_noframe:
01:00F0AEEA 41FA18AC        	   951:                 lea     nogo_msg(pc),a0
01:00F0AEEE 61000614        	   952:                 bsr.w   puts
01:00F0AEF2 6000FA7C        	   953:                 bra.w   cmd_loop
