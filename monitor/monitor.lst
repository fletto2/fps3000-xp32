01:00F0AF38 6100061A        	   986:                 bsr.w   puthex_long
01:00F0AF3C 610005D2        	   987:                 bsr.w   put_crlf
                            	   988: 
                            	   989:                 ; Fault / link state: frame kind, nest guard, TX-timeout
                            	   990:                 ; flag.  MON_NEST = 2 means a previous run died while
                            	   991:                 ; reporting a fault; MON_TXFAIL = 1 means putchar gave up
                            	   992:                 ; waiting for the SIO at some point.
01:00F0AF40 41FA1A95        	   993:                 lea     fault_msg(pc),a0
01:00F0AF44 610005BE        	   994:                 bsr.w   puts
01:00F0AF48 10390000F894    	   995:                 move.b  MON_GRP0,d0
01:00F0AF4E 610005EA        	   996:                 bsr.w   puthex_byte
01:00F0AF52 103C002F        	   997:                 move.b  #'/',d0
01:00F0AF56 61000536        	   998:                 bsr.w   putchar
01:00F0AF5A 10390000F895    	   999:                 move.b  MON_NEST,d0
01:00F0AF60 610005D8        	  1000:                 bsr.w   puthex_byte
01:00F0AF64 103C002F        	  1001:                 move.b  #'/',d0
01:00F0AF68 61000524        	  1002:                 bsr.w   putchar
01:00F0AF6C 10390000F896    	  1003:                 move.b  MON_TXFAIL,d0
01:00F0AF72 610005C6        	  1004:                 bsr.w   puthex_byte
01:00F0AF76 41FA1262        	  1005:                 lea     faddr_msg(pc),a0
01:00F0AF7A 61000588        	  1006:                 bsr.w   puts
01:00F0AF7E 20390000F898    	  1007:                 move.l  MON_FADDR,d0
01:00F0AF84 610005CE        	  1008:                 bsr.w   puthex_long
01:00F0AF88 41FA125A        	  1009:                 lea     ssw_msg(pc),a0
01:00F0AF8C 61000576        	  1010:                 bsr.w   puts
01:00F0AF90 30390000F89C    	  1011:                 move.w  MON_SSW,d0
01:00F0AF96 610005B0        	  1012:                 bsr.w   puthex_word
01:00F0AF9A 61000574        	  1013:                 bsr.w   put_crlf
01:00F0AF9E 6000F9D0        	  1014:                 bra.w   cmd_loop
                            	  1015: 
                            	  1016: ;----------------------------------------------------------------
                            	  1017: ; Load S-record over the SIO (channel A).
                            	  1018: ; Each line consumed and validated; bytes go to addresses inside.
                            	  1019: ; Terminator: S8 / S9 record.
                            	  1020: ;----------------------------------------------------------------
                            	  1021: cmd_load_srec:
01:00F0AFA2 13FC00010000F848	  1022:                 move.b  #1,MON_ABORT            ; ESC now aborts (see getchar)
01:00F0AFAA 41FA182F        	  1023:                 lea     load_msg(pc),a0
01:00F0AFAE 61000554        	  1024:                 bsr.w   puts
01:00F0AFB2 7800            	  1025:                 clr.l   d4                      ; record count
01:00F0AFB4 7A00            	  1026:                 clr.l   d5                      ; byte count
                            	  1027: .scan_S:
01:00F0AFB6 61000508        	  1028:                 bsr.w   getchar
01:00F0AFBA 0C000053        	  1029:                 cmpi.b  #'S',d0
01:00F0AFBE 66F6            	  1030:                 bne.b   .scan_S                  ; skip until 'S'
01:00F0AFC0 610004FE        	  1031:                 bsr.w   getchar                  ; record type
01:00F0AFC4 0C000038        	  1032:                 cmpi.b  #'8',d0
01:00F0AFC8 670000F2        	  1033:                 beq.w   .terminator
01:00F0AFCC 0C000039        	  1034:                 cmpi.b  #'9',d0
01:00F0AFD0 670000EA        	  1035:                 beq.w   .terminator
01:00F0AFD4 0C000037        	  1036:                 cmpi.b  #'7',d0
01:00F0AFD8 670000E2        	  1037:                 beq.w   .terminator
01:00F0AFDC 0C000030        	  1038:                 cmpi.b  #'0',d0
01:00F0AFE0 670000C4        	  1039:                 beq.w   .eat_eol                ; header — skip
01:00F0AFE4 0C000031        	  1040:                 cmpi.b  #'1',d0
01:00F0AFE8 6D00FFCC        	  1041:                 blt.w   .scan_S
01:00F0AFEC 0C000033        	  1042:                 cmpi.b  #'3',d0
01:00F0AFF0 6E00FFC4        	  1043:                 bgt.w   .scan_S
                            	  1044:                 ; data record S1 / S2 / S3
01:00F0AFF4 1C00            	  1045:                 move.b  d0,d6                   ; save type
01:00F0AFF6 610002F2        	  1046:                 bsr.w   read_hex_byte
                            	  1047:                 ; read_hex_byte only writes d0's low byte, so the upper 24
                            	  1048:                 ; bits are stale.  Zero-extend explicitly, and keep the
                            	  1049:                 ; count word-sized below: a payload count >= $80 is legal
                            	  1050:                 ; in an S1 record, and a signed byte test would read it as
                            	  1051:                 ; negative and silently truncate the record to no data.
01:00F0AFFA 7400            	  1052:                 moveq   #0,d2
01:00F0AFFC 1400            	  1053:                 move.b  d0,d2                   ; payload count (incl addr+cksum)
                            	  1054:                 ; d7 accumulates the record checksum: sum of the count byte,
                            	  1055:                 ; the address bytes and the data bytes.  A valid record has
                            	  1056:                 ; (sum + cksum) & $FF == $FF.  Without this a corrupted line
                            	  1057:                 ; loads silently and reports success, which over a serial
                            	  1058:                 ; link at an unverified baud rate is exactly the failure we
                            	  1059:                 ; would not notice.
01:00F0AFFE 7E00            	  1060:                 moveq   #0,d7
01:00F0B000 DE00            	  1061:                 add.b   d0,d7
01:00F0B002 7600            	  1062:                 clr.l   d3
01:00F0B004 0C060033        	  1063:                 cmpi.b  #'3',d6
01:00F0B008 6708            	  1064:                 beq.b   .a32
01:00F0B00A 0C060032        	  1065:                 cmpi.b  #'2',d6
01:00F0B00E 670E            	  1066:                 beq.b   .a24
01:00F0B010 6018            	  1067:                 bra.b   .a16
                            	  1068: .a32:
01:00F0B012 610002D6        	  1069:                 bsr.w   read_hex_byte
01:00F0B016 DE00            	  1070:                 add.b   d0,d7
01:00F0B018 E18B            	  1071:                 lsl.l   #8,d3
01:00F0B01A 8600            	  1072:                 or.b    d0,d3
01:00F0B01C 5342            	  1073:                 subq.w  #1,d2
                            	  1074: .a24:
01:00F0B01E 610002CA        	  1075:                 bsr.w   read_hex_byte
01:00F0B022 DE00            	  1076:                 add.b   d0,d7
01:00F0B024 E18B            	  1077:                 lsl.l   #8,d3
01:00F0B026 8600            	  1078:                 or.b    d0,d3
01:00F0B028 5342            	  1079:                 subq.w  #1,d2
                            	  1080: .a16:
01:00F0B02A 610002BE        	  1081:                 bsr.w   read_hex_byte
01:00F0B02E DE00            	  1082:                 add.b   d0,d7
01:00F0B030 E18B            	  1083:                 lsl.l   #8,d3
01:00F0B032 8600            	  1084:                 or.b    d0,d3
01:00F0B034 610002B4        	  1085:                 bsr.w   read_hex_byte
01:00F0B038 DE00            	  1086:                 add.b   d0,d7
01:00F0B03A E18B            	  1087:                 lsl.l   #8,d3
01:00F0B03C 8600            	  1088:                 or.b    d0,d3
01:00F0B03E 5542            	  1089:                 subq.w  #2,d2
01:00F0B040 5342            	  1090:                 subq.w  #1,d2                   ; -1 for checksum
01:00F0B042 2843            	  1091:                 move.l  d3,a4                   ; dest pointer
01:00F0B044 61000268        	  1092:                 bsr.w   srec_check              ; d1 = 0 -> would self-destruct
01:00F0B048 4A01            	  1093:                 tst.b   d1
01:00F0B04A 67000044        	  1094:                 beq.w   .badaddr
                            	  1095: .dloop:
01:00F0B04E 4A42            	  1096:                 tst.w   d2
01:00F0B050 6F0E            	  1097:                 ble.b   .endrec
01:00F0B052 61000296        	  1098:                 bsr.w   read_hex_byte
01:00F0B056 DE00            	  1099:                 add.b   d0,d7
01:00F0B058 18C0            	  1100:                 move.b  d0,(a4)+
01:00F0B05A 5285            	  1101:                 addq.l  #1,d5
01:00F0B05C 5342            	  1102:                 subq.w  #1,d2
01:00F0B05E 60EE            	  1103:                 bra.b   .dloop
                            	  1104: .endrec:
01:00F0B060 61000288        	  1105:                 bsr.w   read_hex_byte           ; the record's checksum byte
01:00F0B064 DE00            	  1106:                 add.b   d0,d7
01:00F0B066 0C0700FF        	  1107:                 cmpi.b  #$FF,d7
01:00F0B06A 660E            	  1108:                 bne.b   .badsum
01:00F0B06C 5284            	  1109:                 addq.l  #1,d4
01:00F0B06E 103C002E        	  1110:                 move.b  #'.',d0
01:00F0B072 6100041A        	  1111:                 bsr.w   putchar
01:00F0B076 6000002E        	  1112:                 bra.w   .eat_eol
                            	  1113: .badsum:
                            	  1114:                 ; The data was already written by the time we can check, so
                            	  1115:                 ; say which record failed and let the operator re-send it.
01:00F0B07A 41FA199F        	  1116:                 lea     srec_sum_msg(pc),a0
01:00F0B07E 61000484        	  1117:                 bsr.w   puts
01:00F0B082 2003            	  1118:                 move.l  d3,d0
01:00F0B084 610004CE        	  1119:                 bsr.w   puthex_long
01:00F0B088 61000486        	  1120:                 bsr.w   put_crlf
01:00F0B08C 6000FF28        	  1121:                 bra.w   .scan_S
                            	  1122: .badaddr:
                            	  1123:                 ; Skip this record.  No need to consume its hex: .scan_S
                            	  1124:                 ; resyncs on the next 'S', and hex digits are 0-9A-F so
                            	  1125:                 ; none of the skipped payload can be mistaken for a
                            	  1126:                 ; record start.
01:00F0B090 41FA195C        	  1127:                 lea     srec_bad_msg(pc),a0
01:00F0B094 6100046E        	  1128:                 bsr.w   puts
01:00F0B098 2003            	  1129:                 move.l  d3,d0
01:00F0B09A 610004B8        	  1130:                 bsr.w   puthex_long
01:00F0B09E 61000470        	  1131:                 bsr.w   put_crlf
01:00F0B0A2 6000FF12        	  1132:                 bra.w   .scan_S
                            	  1133: .eat_eol:
01:00F0B0A6 61000418        	  1134:                 bsr.w   getchar
01:00F0B0AA 0C00000D        	  1135:                 cmpi.b  #13,d0
01:00F0B0AE 6700FF06        	  1136:                 beq.w   .scan_S
01:00F0B0B2 0C00000A        	  1137:                 cmpi.b  #10,d0
01:00F0B0B6 6700FEFE        	  1138:                 beq.w   .scan_S
01:00F0B0BA 60EA            	  1139:                 bra.b   .eat_eol
                            	  1140: .terminator:
                            	  1141:                 ; finish the terminator's line
                            	  1142: .t_eol:
01:00F0B0BC 61000402        	  1143:                 bsr.w   getchar
01:00F0B0C0 0C00000D        	  1144:                 cmpi.b  #13,d0
01:00F0B0C4 6708            	  1145:                 beq.b   .t_done
01:00F0B0C6 0C00000A        	  1146:                 cmpi.b  #10,d0
01:00F0B0CA 6702            	  1147:                 beq.b   .t_done
01:00F0B0CC 60EE            	  1148:                 bra.b   .t_eol
                            	  1149: .t_done:
01:00F0B0CE 13FC00000000F848	  1150:                 move.b  #0,MON_ABORT            ; the only normal exit; the
                            	  1151:                                                 ;   bad-record paths loop back
                            	  1152:                                                 ;   to .scan_S and stay armed
01:00F0B0D6 61000438        	  1153:                 bsr.w   put_crlf
01:00F0B0DA 41FA1736        	  1154:                 lea     load_done_msg(pc),a0
01:00F0B0DE 61000424        	  1155:                 bsr.w   puts
01:00F0B0E2 2004            	  1156:                 move.l  d4,d0
01:00F0B0E4 6100046E        	  1157:                 bsr.w   puthex_long
01:00F0B0E8 41FA1733        	  1158:                 lea     load_bytes_msg(pc),a0
01:00F0B0EC 61000416        	  1159:                 bsr.w   puts
01:00F0B0F0 2005            	  1160:                 move.l  d5,d0
01:00F0B0F2 61000460        	  1161:                 bsr.w   puthex_long
01:00F0B0F6 61000418        	  1162:                 bsr.w   put_crlf
01:00F0B0FA 6000F874        	  1163:                 bra.w   cmd_loop
                            	  1164: 
                            	  1165: ;================================================================
                            	  1166: ; Helpers
                            	  1167: ;================================================================
                            	  1168: 
                            	  1169: ; ---- hexdump d2 bytes starting at a4 ----
                            	  1170: hexdump:
01:00F0B0FE 4A82            	  1171:                 tst.l   d2                      ; as xdump: a zero count would
01:00F0B100 67000094        	  1172:                 beq.w   .ret                    ;   otherwise print one row of
                            	  1173:                                                 ;   .w, not .b: hexdump's body
                            	  1174:                                                 ;   is ~140 bytes, past the
                            	  1175:                                                 ;   +/-127 a short branch
                            	  1176:                                                 ;   reaches.  xdump's own guard
                            	  1177:                                                 ;   is .b only because xdump is
                            	  1178:                                                 ;   short.
                            	  1179:                                                 ;   pure padding.  Same contract
                            	  1180:                                                 ;   as xdump, deliberately --
                            	  1181:                                                 ;   these two are the shared
                            	  1182:                                                 ;   dump primitives and every
                            	  1183:                                                 ;   caller should be able to
                            	  1184:                                                 ;   reason about them alike.
01:00F0B104 2C02            	  1185:                 move.l  d2,d6                   ; bytes remaining
                            	  1186: .line:
                            	  1187:                 ; Print address
01:00F0B106 200C            	  1188:                 move.l  a4,d0
01:00F0B108 6100044A        	  1189:                 bsr.w   puthex_long
01:00F0B10C 103C003A        	  1190:                 move.b  #':',d0
01:00F0B110 6100037C        	  1191:                 bsr.w   putchar
01:00F0B114 103C0020        	  1192:                 move.b  #' ',d0
01:00F0B118 61000374        	  1193:                 bsr.w   putchar
                            	  1194:                 ; row count = min(16, d6)
01:00F0B11C 7810            	  1195:                 moveq   #16,d4
01:00F0B11E BC84            	  1196:                 cmp.l   d4,d6
01:00F0B120 6402            	  1197:                 bcc.b   .full                   ; UNSIGNED -- the FIFTH instance,
                            	  1198:                                                 ;   and the first inside a shared
                            	  1199:                                                 ;   primitive rather than a
                            	  1200:                                                 ;   command.  d6 is a caller's
                            	  1201:                                                 ;   item count: with `bge`, any
                            	  1202:                                                 ;   count >= $80000000 reads as
                            	  1203:                                                 ;   negative, fails the test and
                            	  1204:                                                 ;   sets d4 = d6 -- a .hex loop
                            	  1205:                                                 ;   of 4 billion puthex calls,
                            	  1206:                                                 ;   with no ESC escape (MON_ABORT
                            	  1207:                                                 ;   is armed only inside L).
                            	  1208:                                                 ;
                            	  1209:                                                 ;   Every caller today clamps
                            	  1210:                                                 ;   unsigned, so this was not
                            	  1211:                                                 ;   reachable.  It is fixed HERE
                            	  1212:                                                 ;   because a routine whose
                            	  1213:                                                 ;   safety depends on all its
                            	  1214:                                                 ;   callers remembering is one
                            	  1215:                                                 ;   command away from a hang,
                            	  1216:                                                 ;   and this file grows commands.
01:00F0B122 2806            	  1217:                 move.l  d6,d4
                            	  1218: .full:
01:00F0B124 2A4C            	  1219:                 move.l  a4,a5                   ; row start
                            	  1220:                 ; print d4 hex bytes
01:00F0B126 2604            	  1221:                 move.l  d4,d3
01:00F0B128 4A83            	  1222:                 tst.l   d3
01:00F0B12A 6712            	  1223:                 beq.b   .pad
                            	  1224: .hex:
01:00F0B12C 101C            	  1225:                 move.b  (a4)+,d0
01:00F0B12E 6100040A        	  1226:                 bsr.w   puthex_byte
01:00F0B132 103C0020        	  1227:                 move.b  #' ',d0
01:00F0B136 61000356        	  1228:                 bsr.w   putchar
01:00F0B13A 5383            	  1229:                 subq.l  #1,d3
01:00F0B13C 66EE            	  1230:                 bne.b   .hex
                            	  1231: .pad:
                            	  1232:                 ; pad to 16 hex slots
01:00F0B13E 7A10            	  1233:                 moveq   #16,d5
01:00F0B140 9A84            	  1234:                 sub.l   d4,d5
01:00F0B142 4A85            	  1235:                 tst.l   d5
01:00F0B144 6714            	  1236:                 beq.b   .ascii
                            	  1237: .padl:
01:00F0B146 103C0020        	  1238:                 move.b  #' ',d0
01:00F0B14A 61000342        	  1239:                 bsr.w   putchar
01:00F0B14E 6100033E        	  1240:                 bsr.w   putchar
01:00F0B152 6100033A        	  1241:                 bsr.w   putchar
01:00F0B156 5385            	  1242:                 subq.l  #1,d5
01:00F0B158 66EC            	  1243:                 bne.b   .padl
                            	  1244: .ascii:
01:00F0B15A 103C007C        	  1245:                 move.b  #'|',d0
01:00F0B15E 6100032E        	  1246:                 bsr.w   putchar
01:00F0B162 2604            	  1247:                 move.l  d4,d3
01:00F0B164 4A83            	  1248:                 tst.l   d3
01:00F0B166 671C            	  1249:                 beq.b   .ascii_end
                            	  1250: .ascii_l:
01:00F0B168 101D            	  1251:                 move.b  (a5)+,d0
01:00F0B16A 0C000020        	  1252:                 cmpi.b  #' ',d0
01:00F0B16E 6D08            	  1253:                 blt.b   .dot
01:00F0B170 0C00007E        	  1254:                 cmpi.b  #126,d0
01:00F0B174 6E02            	  1255:                 bgt.b   .dot
01:00F0B176 6004            	  1256:                 bra.b   .pchar
                            	  1257: .dot:
01:00F0B178 103C002E        	  1258:                 move.b  #'.',d0
                            	  1259: .pchar:
01:00F0B17C 61000310        	  1260:                 bsr.w   putchar
01:00F0B180 5383            	  1261:                 subq.l  #1,d3
01:00F0B182 66E4            	  1262:                 bne.b   .ascii_l
                            	  1263: .ascii_end:
01:00F0B184 103C007C        	  1264:                 move.b  #'|',d0
01:00F0B188 61000304        	  1265:                 bsr.w   putchar
01:00F0B18C 61000382        	  1266:                 bsr.w   put_crlf
01:00F0B190 9C84            	  1267:                 sub.l   d4,d6
01:00F0B192 6600FF72        	  1268:                 bne.w   .line                   ; not bgt: d4 = min(16,d6) taken
                            	  1269:                                                 ;   UNSIGNED above, so d6 can
                            	  1270:                                                 ;   never go negative and "not
                            	  1271:                                                 ;   zero" IS the loop condition.
                            	  1272:                                                 ;   Signedness cannot enter --
                            	  1273:                                                 ;   which is the point, since
                            	  1274:                                                 ;   `bgt` here was the second
                            	  1275:                                                 ;   half of the same bug.
                            	  1276: .ret:
01:00F0B196 4E75            	  1277:                 rts
                            	  1278: 
                            	  1279: ; ---- read_line: read line from SIO into MON_LINEBUF, term=0 ----
                            	  1280: read_line:
01:00F0B198 41F90000F850    	  1281:                 lea     MON_LINEBUF,a0
01:00F0B19E 743C            	  1282:                 moveq   #60,d2                  ; 61 chars + NUL, 2 spare
                            	  1283:                                         ;   in the 64 B before MON_LASTADDR
                            	  1284: .rloop:
01:00F0B1A0 6100031E        	  1285:                 bsr.w   getchar
01:00F0B1A4 0C00000D        	  1286:                 cmpi.b  #13,d0                  ; CR
01:00F0B1A8 673A            	  1287:                 beq.b   .end
01:00F0B1AA 0C00000A        	  1288:                 cmpi.b  #10,d0                  ; LF
01:00F0B1AE 6734            	  1289:                 beq.b   .end
01:00F0B1B0 0C000008        	  1290:                 cmpi.b  #8,d0                   ; BS
01:00F0B1B4 6738            	  1291:                 beq.b   .bs
01:00F0B1B6 0C00007F        	  1292:                 cmpi.b  #127,d0                 ; DEL
01:00F0B1BA 6732            	  1293:                 beq.b   .bs
                            	  1294:                 ; Drop the remaining control characters rather than storing and
                            	  1295:                 ; ECHOING them.  The echo is the real harm: a bare ESC sent
                            	  1296:                 ; back can put the operator's terminal into a state they then
                            	  1297:                 ; have to unpick, and now that ESC is meaningful during L it is
                            	  1298:                 ; a key people will actually press.  This does NOT fully tidy
                            	  1299:                 ; an arrow key -- ESC '[' 'A' loses only the ESC, and the
                            	  1300:                 ; printable '[A' still reaches the buffer and draws a '?'.
                            	  1301:                 ; Swallowing those too would need a small escape-sequence state
                            	  1302:                 ; machine, and a monitor that silently eats visible characters
                            	  1303:                 ; is worse to use than one that shows you the junk it got.  TAB survives because skip_ws
                            	  1304:                 ; accepts it as whitespace.  bcs, not blt -- a byte >= $80 is
                            	  1305:                 ; negative under a signed test, and line noise would be
                            	  1306:                 ; silently swallowed instead of showing up as junk the
                            	  1307:                 ; operator can see.
01:00F0B1BC 0C000009        	  1308:                 cmpi.b  #9,d0                   ; TAB
01:00F0B1C0 6706            	  1309:                 beq.b   .store
01:00F0B1C2 0C000020        	  1310:                 cmpi.b  #' ',d0
01:00F0B1C6 65D8            	  1311:                 bcs.b   .rloop                  ; other controls: ignore
                            	  1312: .store:
01:00F0B1C8 610002C4        	  1313:                 bsr.w   putchar                 ; echo
01:00F0B1CC 10C0            	  1314:                 move.b  d0,(a0)+
01:00F0B1CE 51CAFFD0        	  1315:                 dbra    d2,.rloop
                            	  1316:                 ; Buffer full and no terminator yet.  This USED to fall
                            	  1317:                 ; straight into .end, which silently executed whatever
                            	  1318:                 ; fitted -- and truncation lands mid-TOKEN, so
                            	  1319:                 ;   ww 3000 <22 words>
                            	  1320:                 ; became a valid but WRONG write of the words that fitted,
                            	  1321:                 ; with the last one short a nibble.  The tail then stayed
                            	  1322:                 ; in the SIO and arrived as the NEXT command, so one long
                            	  1323:                 ; paste produced a wrong write followed by a cascade of
                            	  1324:                 ; junk commands.  Planting a stub with ww and running it
                            	  1325:                 ; with g is the monitor's own documented technique, and
                            	  1326:                 ; those lines are exactly the ones that exceed 61 bytes.
                            	  1327:                 ;
                            	  1328:                 ; Peek first: if the next character IS the terminator the
                            	  1329:                 ; line exactly fills the buffer and is perfectly valid --
                            	  1330:                 ; rejecting it would be an off-by-one that refuses a legal
                            	  1331:                 ; command.
01:00F0B1D2 610002EC        	  1332:                 bsr.w   getchar
01:00F0B1D6 0C00000D        	  1333:                 cmpi.b  #13,d0
01:00F0B1DA 6708            	  1334:                 beq.b   .end
01:00F0B1DC 0C00000A        	  1335:                 cmpi.b  #10,d0
01:00F0B1E0 6702            	  1336:                 beq.b   .end
01:00F0B1E2 6030            	  1337:                 bra.b   .full                   ; block lives past .bs, so
                            	  1338:                                                 ;   .bs keeps its ORIGINAL
                            	  1339:                                                 ;   distance to .rloop --
                            	  1340:                                                 ;   inserting here instead
                            	  1341:                                                 ;   pushed that bra.b out of
                            	  1342:                                                 ;   short-branch range
                            	  1343: .end:
01:00F0B1E4 10BC0000        	  1344:                 move.b  #0,(a0)                 ; not clr: CLR reads first
01:00F0B1E8 61000326        	  1345:                 bsr.w   put_crlf
01:00F0B1EC 4E75            	  1346:                 rts
                            	  1347: .bs:
01:00F0B1EE B1FC0000F850    	  1348:                 cmpa.l  #MON_LINEBUF,a0
01:00F0B1F4 67AA            	  1349:                 beq.b   .rloop                  ; empty - ignore
01:00F0B1F6 5388            	  1350:                 subq.l  #1,a0
01:00F0B1F8 5282            	  1351:                 addq.l  #1,d2
01:00F0B1FA 103C0008        	  1352:                 move.b  #8,d0
01:00F0B1FE 6100028E        	  1353:                 bsr.w   putchar
01:00F0B202 103C0020        	  1354:                 move.b  #' ',d0
01:00F0B206 61000286        	  1355:                 bsr.w   putchar
01:00F0B20A 103C0008        	  1356:                 move.b  #8,d0
01:00F0B20E 6100027E        	  1357:                 bsr.w   putchar
01:00F0B212 608C            	  1358:                 bra.b   .rloop
                            	  1359: .full:
                            	  1360:                 ; Drain to the terminator WITHOUT echoing.  Echoing would
                            	  1361:                 ; double the time per character on a link with no flow
                            	  1362:                 ; control, and the characters being dropped are the ones
                            	  1363:                 ; that would then be missed -- including the CR, which
                            	  1364:                 ; would leave the drain running on into the next command.
01:00F0B214 610002AA        	  1365:                 bsr.w   getchar
01:00F0B218 0C00000D        	  1366:                 cmpi.b  #13,d0
01:00F0B21C 6706            	  1367:                 beq.b   .toolong
01:00F0B21E 0C00000A        	  1368:                 cmpi.b  #10,d0
01:00F0B222 66F0            	  1369:                 bne.b   .full
                            	  1370: .toolong:
01:00F0B224 41F90000F850    	  1371:                 lea     MON_LINEBUF,a0
01:00F0B22A 10BC0000        	  1372:                 move.b  #0,(a0)                 ; hand back an EMPTY line:
                            	  1373:                                                 ;   cmd_loop re-prompts on it
01:00F0B22E 610002E0        	  1374:                 bsr.w   put_crlf
01:00F0B232 41FA0FC0        	  1375:                 lea     toolong_msg(pc),a0
01:00F0B236 610002CC        	  1376:                 bsr.w   puts
01:00F0B23A 4E75            	  1377:                 rts
                            	  1378: 
                            	  1379: ; ---- skip_ws: skip whitespace at (a6) ----
                            	  1380: ;      CLOBBERS d0, and ADVANCES a6 past the whitespace -- again the operation
                            	  1381: ;      itself, so it cannot be saved either.  Swept at all 24 call sites: every
                            	  1382: ;      one is followed by parse_hex, which RETURNS in d0, so nothing observes
                            	  1383: ;      the clobber.  That is the reason it has never bitten, not a reason it
                            	  1384: ;      cannot: a future caller reading d0 straight after would.
                            	  1385: skip_ws:
01:00F0B23C 1016            	  1386: .lp:            move.b  (a6),d0
01:00F0B23E 0C000020        	  1387:                 cmpi.b  #' ',d0
01:00F0B242 6708            	  1388:                 beq.b   .adv
01:00F0B244 0C000009        	  1389:                 cmpi.b  #9,d0                   ; tab
01:00F0B248 6702            	  1390:                 beq.b   .adv
01:00F0B24A 4E75            	  1391:                 rts
01:00F0B24C 528E            	  1392: .adv:           addq.l  #1,a6
01:00F0B24E 60EC            	  1393:                 bra.b   .lp
                            	  1394: 
                            	  1395: ; ---- parse_hex: parse hex number at (a6) into d0; d1=1 ok, 0 err ----
                            	  1396: ;                 advances a6 past digits.
                            	  1397: ;      CLOBBERS d0 and d1 ONLY.  It uses d2 as the digit and d3 as the
                            	  1398: ;      digit count, and saves both -- 10 bytes to remove a whole class of
                            	  1399: ;      aliasing bug.  The recorded cmd_page/xdump defect was exactly this
                            	  1400: ;      shape (a value held in d4 across a call that used d4), and it
                            	  1401: ;      reported a restore that had not happened, which is worse than no
                            	  1402: ;      restore because it is believed.
                            	  1403: parse_hex:
01:00F0B250 48E73000        	  1404:                 movem.l d2-d3,-(sp)
01:00F0B254 7000            	  1405:                 clr.l   d0
01:00F0B256 4201            	  1406:                 clr.b   d1                      ; success flag
01:00F0B258 4203            	  1407:                 clr.b   d3                      ; digit count
                            	  1408: .lp:
01:00F0B25A 1416            	  1409:                 move.b  (a6),d2
01:00F0B25C 0C020030        	  1410:                 cmpi.b  #'0',d2
01:00F0B260 6D3C            	  1411:                 blt.b   .end
01:00F0B262 0C020039        	  1412:                 cmpi.b  #'9',d2
01:00F0B266 6F24            	  1413:                 ble.b   .dig
01:00F0B268 0C020041        	  1414:                 cmpi.b  #'A',d2
01:00F0B26C 6D30            	  1415:                 blt.b   .end
01:00F0B26E 0C020046        	  1416:                 cmpi.b  #'F',d2
01:00F0B272 6F12            	  1417:                 ble.b   .upper
01:00F0B274 0C020061        	  1418:                 cmpi.b  #'a',d2
01:00F0B278 6D24            	  1419:                 blt.b   .end
01:00F0B27A 0C020066        	  1420:                 cmpi.b  #'f',d2
01:00F0B27E 6E1E            	  1421:                 bgt.b   .end
01:00F0B280 04020057        	  1422:                 subi.b  #'a'-10,d2
01:00F0B284 600A            	  1423:                 bra.b   .acc
                            	  1424: .upper:
01:00F0B286 04020037        	  1425:                 subi.b  #'A'-10,d2
01:00F0B28A 6004            	  1426:                 bra.b   .acc
                            	  1427: .dig:
01:00F0B28C 04020030        	  1428:                 subi.b  #'0',d2
                            	  1429: .acc:
01:00F0B290 E988            	  1430:                 lsl.l   #4,d0
01:00F0B292 0202000F        	  1431:                 andi.b  #$0F,d2
01:00F0B296 8002            	  1432:                 or.b    d2,d0
01:00F0B298 528E            	  1433:                 addq.l  #1,a6
01:00F0B29A 5203            	  1434:                 addq.b  #1,d3
01:00F0B29C 60BC            	  1435:                 bra.b   .lp
                            	  1436: .end:
01:00F0B29E 4A03            	  1437:                 tst.b   d3
01:00F0B2A0 6704            	  1438:                 beq.b   .err
01:00F0B2A2 7201            	  1439:                 moveq   #1,d1
01:00F0B2A4 6002            	  1440:                 bra.b   .ret
                            	  1441: .err:
01:00F0B2A6 4201            	  1442:                 clr.b   d1
                            	  1443: .ret:
01:00F0B2A8 4CDF000C        	  1444:                 movem.l (sp)+,d2-d3             ; d0/d1 carry the result out
01:00F0B2AC 4E75            	  1445:                 rts
                            	  1446: 
                            	  1447: ;================================================================
                            	  1448: ; srec_check — is it safe to write d2 bytes starting at d3?
                            	  1449: ;   returns d1 = 1 safe, 0 = refuse.  Preserves d0/d2/d3.
                            	  1450: ;
                            	  1451: ; A load is refused unless its whole range lies in on-board RAM and
                            	  1452: ; clear of the two regions the monitor itself needs:
                            	  1453: ;
                            	  1454: ;   $000000-$0003FF  the exception vector table
                            	  1455: ;   $00F800-$00FEFF  MON_* workspace, breakpoint table, and the
                            	  1456: ;                    cold-entry supervisor stack below $0FF00
                            	  1457: ;
                            	  1458: ; Anything at or above $20000 is refused outright.  That range is ROM
                            	  1459: ; and peripherals, and a stray S2/S3 record pointed there would not
                            	  1460: ; merely be ignored: a write to $F70011 would transmit a byte over the
                            	  1461: ; SIO, and writes to the XLTR or AP I/F blocks would poke the chassis.
                            	  1462: ; Deliberate peripheral pokes are what the `w` command is for.
                            	  1463: ;
                            	  1464: ; The workspace used to live at $1F000, inside the WCS staging buffer,
                            	  1465: ; which forced the top 4 KB of the buffer to be refused.  It now sits at
                            	  1466: ; $0F800, below the buffer, so $10000-$1FFFF is loadable end to end.
                            	  1467: ;================================================================
                            	  1468: srec_check:
01:00F0B2AE 48E79000        	  1469:                 movem.l d0/d3,-(sp)
01:00F0B2B2 7200            	  1470:                 moveq   #0,d1
01:00F0B2B4 0C8300000400    	  1471:                 cmpi.l  #$400,d3
01:00F0B2BA 6528            	  1472:                 bcs.b   .out                    ; below vector-table top
01:00F0B2BC 0C8300020000    	  1473:                 cmpi.l  #$20000,d3
01:00F0B2C2 6420            	  1474:                 bcc.b   .out                    ; beyond on-board RAM
01:00F0B2C4 2003            	  1475:                 move.l  d3,d0
01:00F0B2C6 D082            	  1476:                 add.l   d2,d0
01:00F0B2C8 5380            	  1477:                 subq.l  #1,d0                   ; last byte to be written
01:00F0B2CA 0C8000020000    	  1478:                 cmpi.l  #$20000,d0
01:00F0B2D0 6412            	  1479:                 bcc.b   .out                    ; would run off the end of RAM
01:00F0B2D2 0C830000FF00    	  1480:                 cmpi.l  #MON_HI,d3
01:00F0B2D8 6408            	  1481:                 bcc.b   .ok                     ; starts above our region
01:00F0B2DA 0C800000F800    	  1482:                 cmpi.l  #MON_LO,d0
01:00F0B2E0 6402            	  1483:                 bcc.b   .out                    ; reaches workspace/stack
                            	  1484: .ok:
01:00F0B2E2 7201            	  1485:                 moveq   #1,d1
                            	  1486: .out:
01:00F0B2E4 4CDF0009        	  1487:                 movem.l (sp)+,d0/d3
01:00F0B2E8 4E75            	  1488:                 rts
                            	  1489: 
                            	  1490: ; ---- read_hex_byte: read 2 hex chars from SIO, return byte in d0 ----
                            	  1491: read_hex_byte:
01:00F0B2EA 2F02            	  1492:                 move.l  d2,-(sp)                ; preserve d2 (caller may use it)
01:00F0B2EC 61000010        	  1493:                 bsr.w   read_hex_nibble
01:00F0B2F0 E908            	  1494:                 lsl.b   #4,d0
01:00F0B2F2 1400            	  1495:                 move.b  d0,d2
01:00F0B2F4 61000008        	  1496:                 bsr.w   read_hex_nibble
01:00F0B2F8 8002            	  1497:                 or.b    d2,d0
01:00F0B2FA 241F            	  1498:                 move.l  (sp)+,d2
01:00F0B2FC 4E75            	  1499:                 rts
                            	  1500: 
                            	  1501: read_hex_nibble:
01:00F0B2FE 610001C0        	  1502:                 bsr.w   getchar
01:00F0B302 0C000039        	  1503:                 cmpi.b  #'9',d0
01:00F0B306 6E06            	  1504:                 bgt.b   .alpha
01:00F0B308 04000030        	  1505:                 subi.b  #'0',d0
01:00F0B30C 4E75            	  1506:                 rts
                            	  1507: .alpha:
01:00F0B30E 0C000046        	  1508:                 cmpi.b  #'F',d0
01:00F0B312 6E06            	  1509:                 bgt.b   .lower
01:00F0B314 04000037        	  1510:                 subi.b  #'A'-10,d0
01:00F0B318 4E75            	  1511:                 rts
                            	  1512: .lower:
01:00F0B31A 04000057        	  1513:                 subi.b  #'a'-10,d0
01:00F0B31E 4E75            	  1514:                 rts
                            	  1515: 
                            	  1516: ;================================================================
                            	  1517: ; cold_init — called from monitor_cold ONLY (never from monitor_entry).
                            	  1518: ;
                            	  1519: ; The MC68000 has no VBR: the exception vector table is hard-wired at
                            	  1520: ; $000000-$0003FF, which on this board is plain DRAM.  The reset SSP/PC
                            	  1521: ; are the only vectors that come from ROM — the M68KVM02 maps just the
                            	  1522: ; first 8 bytes of ROM to address 0 for the first four bus cycles after
                            	  1523: ; a total system reset, then address 0 is DRAM like any other.  So at
                            	  1524: ; power-on every vector except reset is whatever the DRAM happens to
                            	  1525: ; hold, i.e. garbage.
                            	  1526: ;
                            	  1527: ; The stock firmware handles this on its 2nd and 3rd instructions —
                            	  1528: ; MainInit at F08700 does `lea $1ffd0,a7` then immediately installs
                            	  1529: ; $8 and $C (F08706 / F0870E) before touching any I/O.  But when
                            	  1530: ; patch_rom.py --reset points the reset PC at monitor_cold, MainInit
                            	  1531: ; never executes, so nothing fills the table and the monitor inherits
                            	  1532: ; garbage.  Any bus or address error then fetches a junk handler
                            	  1533: ; address, faults again, and the 68000 asserts HALT (double bus fault)
                            	  1534: ; with no diagnostic at all.  That is what a bad SIO address did on
                            	  1535: ; real hardware: FAIL + HALTED, silently.
                            	  1536: ;
                            	  1537: ; Point every vector at monitor_entry so the next fault reports itself
                            	  1538: ; instead of killing the CPU.  Writing all 1 KB also leaves valid DRAM
                            	  1539: ; parity across the table, which matters if the board's parity strap is
                            	  1540: ; enabled (a read of never-written DRAM can raise BERR).
                            	  1541: ;
                            	  1542: ; This deliberately does NOT run on the panic path: with --panic only,
                            	  1543: ; the firmware booted normally and its live vectors are already in
                            	  1544: ; place, and `g` needs them intact to resume.
                            	  1545: ;================================================================
                            	  1546: cold_init:
01:00F0B320 91C8            	  1547:                 suba.l  a0,a0                   ; a0 = $000000
01:00F0B322 203C00F0A840    	  1548:                 move.l  #monitor_entry,d0
01:00F0B328 323C00FF        	  1549:                 move.w  #255,d1                 ; 256 vectors, dbra -> 256 passes
                            	  1550: .vfill:
01:00F0B32C 20C0            	  1551:                 move.l  d0,(a0)+
01:00F0B32E 51C9FFFC        	  1552:                 dbra    d1,.vfill
                            	  1553: 
                            	  1554:                 ; Vectors 2 and 3 push the 7-word group-0 frame, which
                            	  1555:                 ; monitor_entry would misread — give them their own stub.
01:00F0B332 21FC00F0A8960008	  1556:                 move.l  #grp0_entry,$8          ; bus error
01:00F0B33A 21FC00F0A896000C	  1557:                 move.l  #grp0_entry,$C          ; address error
                            	  1558: 
                            	  1559:                 ; Pre-write the whole workspace.  Two reasons: it leaves
                            	  1560:                 ; valid DRAM parity on every byte the monitor later reads
                            	  1561:                 ; back (MON_NEST and MON_LASTADDR are both read before
                            	  1562:                 ; being written otherwise), and it puts the guard in a
                            	  1563:                 ; known state.  move.l/move.b, never clr: a real MC68000
                            	  1564:                 ; READS the destination before writing it on CLR, so clr
                            	  1565:                 ; on never-written DRAM is a parity-BERR risk.  (Musashi
                            	  1566:                 ; models CLR as a pure write, so the emulator never shows
                            	  1567:                 ; this — see m68k_in.c, M68KMAKE_OP(clr, 32, ., .).)
                            	  1568:                 ; MON_REGS itself must be written too, not just the
                            	  1569:                 ; scalars below it: cmd_regs READS all 60 bytes, and on a
                            	  1570:                 ; cold boot nothing has written them yet.  On a board with
                            	  1571:                 ; the DRAM parity strap enabled, reading never-written
                            	  1572:                 ; memory raises BERR, so `r` before any fault would have
                            	  1573:                 ; been a parity trap rather than a register dump.  The
                            	  1574:                 ; emulator cannot show this — its RAM is zero-filled and
                            	  1575:                 ; it models no parity.
01:00F0B342 60000002        	  1576:                 bra.w   ws_init                 ; ...which is the rest of this
                            	  1577:                                                 ;   routine, factored out so the
                            	  1578:                                                 ;   panic path can reach it too
                            	  1579: 
                            	  1580: ;================================================================
                            	  1581: ; ws_init — initialise the WORKSPACE ONLY, never the vector table.
                            	  1582: ;
                            	  1583: ; Split out of cold_init because the two entries need different amounts
                            	  1584: ; of it.  The --reset image owns the machine and fills all 256 vectors;
                            	  1585: ; the PANIC image must not touch a single one -- the RTOS is running and
                            	  1586: ; its vectors are live -- but it needs every workspace field defined just
                            	  1587: ; as badly, because $0F800-$0FEFF is DRAM the firmware never writes.
                            	  1588: ;
                            	  1589: ; Called from monitor_entry/grp0_entry BEFORE the registers are saved to
                            	  1590: ; MON_REGS, so it must preserve everything it touches or `r` would show
                            	  1591: ; the monitor's own working values instead of the faulting task's.
                            	  1592: ;
                            	  1593: ; MON_MAGIC is written LAST, deliberately: a fault partway through this
                            	  1594: ; routine leaves it unset, so the next entry re-runs the whole thing
                            	  1595: ; rather than trusting a half-built workspace.
                            	  1596: ;================================================================
                            	  1597: ws_init:
01:00F0B346 48E7C080        	  1598:                 movem.l d0-d1/a0,-(sp)
01:00F0B34A 41F90000F800    	  1599:                 lea     MON_REGS,a0
01:00F0B350 720E            	  1600:                 moveq   #14,d1                  ; 15 longs, dbra -> 15 passes
                            	  1601: .rclr:
01:00F0B352 20FC00000000    	  1602:                 move.l  #0,(a0)+
01:00F0B358 51C9FFF8        	  1603:                 dbra    d1,.rclr
                            	  1604: 
01:00F0B35C 23FC000000000000	  1605:                 move.l  #0,MON_SPC
01:00F0B364 F83C
01:00F0B366 33FC27000000F840	  1606:                 move.w  #$2700,MON_SSR
01:00F0B36E 23FC000000000000	  1607:                 move.l  #0,MON_LASTADDR
01:00F0B376 F890
01:00F0B378 13FC00FF0000F894	  1608:                 move.b  #$FF,MON_GRP0           ; cold entry: no frame
01:00F0B380 13FC00000000F895	  1609:                 move.b  #0,MON_NEST             ; first fault is reportable
01:00F0B388 13FC00000000F896	  1610:                 move.b  #0,MON_TXFAIL
01:00F0B390 23FC000000000000	  1611:                 move.l  #0,MON_FADDR            ; no fault yet: a stale address
01:00F0B398 F898
01:00F0B39A 33FC00000000F89C	  1612:                 move.w  #0,MON_SSW              ;   would read as a live one
01:00F0B3A2 13FC00000000F848	  1613:                 move.b  #0,MON_ABORT            ; read by EVERY getchar, so it
01:00F0B3AA 23FC000000000000	  1614:                 move.l  #0,MON_CMDSP            ;   must start defined
01:00F0B3B2 F844
01:00F0B3B4 23FC000000000000	  1615:                 move.l  #0,MON_TRCSAV           ; 0 = no trace vector saved.
01:00F0B3BC F8D4
                            	  1616:                                                 ;   On the PANIC image nothing
                            	  1617:                                                 ;   else writes this, so an
                            	  1618:                                                 ;   uninitialised DRAM word
                            	  1619:                                                 ;   would read as a saved
                            	  1620:                                                 ;   vector and `g` would poke
                            	  1621:                                                 ;   garbage into $24.
                            	  1622:                 ; clear the breakpoint slot table (addr 0 = free)
01:00F0B3BE 41F90000F8A0    	  1623:                 lea     MON_BPT,a0
01:00F0B3C4 7207            	  1624:                 moveq   #MON_BPN-1,d1
                            	  1625: .bpclr:
01:00F0B3C6 20BC00000000    	  1626:                 move.l  #0,(a0)
01:00F0B3CC 317C00000004    	  1627:                 move.w  #0,4(a0)
01:00F0B3D2 5C88            	  1628:                 lea     MON_BP_SZ(a0),a0
01:00F0B3D4 51C9FFF0        	  1629:                 dbra    d1,.bpclr
                            	  1630:                 ; Tier 4 tap state and capture ring.  MON_TAPMSK is read
                            	  1631:                 ; before it is written otherwise, so it must start defined
                            	  1632:                 ; for the same reason MON_NEST does.
01:00F0B3D8 13FC00000000F8D0	  1633:                 move.b  #0,MON_TAPMSK
01:00F0B3E0 41F90000F8F0    	  1634:                 lea     MON_TAPTGT,a0           ; four longs now, one per channel
01:00F0B3E6 20FC00000000    	  1635:                 move.l  #0,(a0)+
01:00F0B3EC 20FC00000000    	  1636:                 move.l  #0,(a0)+
01:00F0B3F2 20FC00000000    	  1637:                 move.l  #0,(a0)+
01:00F0B3F8 20FC00000000    	  1638:                 move.l  #0,(a0)+
01:00F0B3FE 41F90000F8D8    	  1639:                 lea     MON_TAPSAV,a0
01:00F0B404 7203            	  1640:                 moveq   #3,d1
                            	  1641: .tapclr:
01:00F0B406 20FC00000000    	  1642:                 move.l  #0,(a0)+
01:00F0B40C 51C9FFF8        	  1643:                 dbra    d1,.tapclr
01:00F0B410 33FC00000000F8E8	  1644:                 move.w  #0,MON_RINGHD
01:00F0B418 33FC00000000F8EA	  1645:                 move.w  #0,MON_RINGN
01:00F0B420 33FC00000000F8EC	  1646:                 move.w  #0,MON_RINGOV
01:00F0B428 41F90000F900    	  1647:                 lea     MON_RING,a0
01:00F0B42E 323C009F        	  1648:                 move.w  #(MON_RING_N*MON_RING_SZ)/4-1,d1
                            	  1649: .ringclr:
01:00F0B432 20FC00000000    	  1650:                 move.l  #0,(a0)+
01:00F0B438 51C9FFF8        	  1651:                 dbra    d1,.ringclr
01:00F0B43C 23FC4D4F4E310000	  1652:                 move.l  #MON_MAGIC_V,MON_MAGIC  ; LAST -- see the header
01:00F0B444 F84C
01:00F0B446 4CDF0103        	  1653:                 movem.l (sp)+,d0-d1/a0
01:00F0B44A 4E75            	  1654:                 rts
                            	  1655: 
                            	  1656: ; ---- SIO init for 9600 8N1, RX+TX enabled, no IRQs ----
                            	  1657: sio_init:
                            	  1658:                 ; Channel reset
01:00F0B44C 13FC001800F70015	  1659:                 move.b  #$18,SIO_A_CTRL         ; WR0: cmd 3 = chan reset
01:00F0B454 4E71            	  1660:                 nop
01:00F0B456 4E71            	  1661:                 nop
01:00F0B458 4E71            	  1662:                 nop
01:00F0B45A 4E71            	  1663:                 nop
                            	  1664:                 ; WR4: x16 clk, 1 stop, no parity
01:00F0B45C 13FC000400F70015	  1665:                 move.b  #$04,SIO_A_CTRL         ; WR0: ptr to WR4
01:00F0B464 13FC004400F70015	  1666:                 move.b  #$44,SIO_A_CTRL
                            	  1667:                 ; WR3: 8 bits/RX char, RX enable
01:00F0B46C 13FC000300F70015	  1668:                 move.b  #$03,SIO_A_CTRL         ; WR0: ptr to WR3
01:00F0B474 13FC00C100F70015	  1669:                 move.b  #$C1,SIO_A_CTRL
                            	  1670:                 ; WR5: 8 bits/TX char, TX enable, DTR, RTS
01:00F0B47C 13FC000500F70015	  1671:                 move.b  #$05,SIO_A_CTRL         ; WR0: ptr to WR5
01:00F0B484 13FC00EA00F70015	  1672:                 move.b  #$EA,SIO_A_CTRL
01:00F0B48C 4E75            	  1673:                 rts
                            	  1674: 
                            	  1675: ; ---- putchar: send byte in d0 over SIO chA.  Bounded: drops the
                            	  1676: ;      character and sets MON_TXFAIL rather than hanging forever, so a
                            	  1677: ;      dead or mis-strapped SIO still lets the monitor make progress and
                            	  1678: ;      leaves evidence in RAM.  Preserves d0 and d1.
                            	  1679: putchar:
01:00F0B48E 2F01            	  1680:                 move.l  d1,-(sp)
                            	  1681:                 ; Belt-and-braces: point the register pointer at RR0 before
                            	  1682:                 ; polling status.  On a Z80-SIO-family part the pointer
                            	  1683:                 ; auto-resets to 0 after each access, so this should be
                            	  1684:                 ; unnecessary -- but $00 to WR0 is the null command
                            	  1685:                 ; (pointer := 0, no side effect), it costs two instructions,
                            	  1686:                 ; and if the auto-reset does NOT behave as assumed the poll
                            	  1687:                 ; would otherwise read WR5 forever and never transmit.  One
                            	  1688:                 ; attempt per hardware trip: take the insurance.
01:00F0B490 13FC000000F70015	  1689:                 move.b  #0,SIO_A_CTRL
01:00F0B498 72104841        	  1690:                 move.l  #TX_SPIN_LIMIT,d1
                            	  1691: .wait:
01:00F0B49C 0839000200F70015	  1692:                 btst.b  #RR0_TX_EMPTY,SIO_A_CTRL
01:00F0B4A4 6610            	  1693:                 bne.b   .ready
01:00F0B4A6 5381            	  1694:                 subq.l  #1,d1
01:00F0B4A8 66F2            	  1695:                 bne.b   .wait
                            	  1696:                 ; Timed out.  move.b, not an increment: a read-modify-write
                            	  1697:                 ; on never-written DRAM is a parity-BERR risk on real
                            	  1698:                 ; hardware, and this path runs when things are already bad.
01:00F0B4AA 13FC00010000F896	  1699:                 move.b  #1,MON_TXFAIL
01:00F0B4B2 221F            	  1700:                 move.l  (sp)+,d1
01:00F0B4B4 4E75            	  1701:                 rts
                            	  1702: .ready:
01:00F0B4B6 13C000F70011    	  1703:                 move.b  d0,SIO_A_DATA
01:00F0B4BC 221F            	  1704:                 move.l  (sp)+,d1
01:00F0B4BE 4E75            	  1705:                 rts
                            	  1706: 
                            	  1707: ; ---- getchar: receive byte from SIO chA into d0 ----
                            	  1708: ;      Deliberately unbounded: waiting indefinitely for a human to type
                            	  1709: ;      is correct behaviour for a monitor prompt, and a timeout here
                            	  1710: ;      would just spin the prompt.  The dangerous spin was putchar,
                            	  1711: ;      which blocks *before* any output exists; that one is bounded
                            	  1712: ;      above.  If a board goes quiet, MON_TXFAIL distinguishes "TX
                            	  1713: ;      never became ready" from "nobody typed anything".
                            	  1714: getchar:
01:00F0B4C0 13FC000000F70015	  1715:                 move.b  #0,SIO_A_CTRL           ; point at RR0 (see putchar)
                            	  1716: .poll:
01:00F0B4C8 0839000000F70015	  1717:                 btst.b  #RR0_RX_AVAIL,SIO_A_CTRL
01:00F0B4D0 67F6            	  1718:                 beq.b   .poll
01:00F0B4D2 103900F70011    	  1719:                 move.b  SIO_A_DATA,d0
                            	  1720:                 ; The one escape from a blocking read.  Without it, `L` cannot
                            	  1721:                 ; be abandoned: mistype the command, or have the sender die
                            	  1722:                 ; mid-transfer, and the monitor waits forever -- recoverable
                            	  1723:                 ; only by a power cycle, which on this machine means re-running
                            	  1724:                 ; the whole boot and losing every breakpoint and tap capture.
                            	  1725:                 ; ESC is safe as the escape because a valid S-record stream
                            	  1726:                 ; contains only 'S', hex digits, CR and LF; $1B can never
                            	  1727:                 ; appear in one.  Costs one tst/beq per character, and
                            	  1728:                 ; MON_ABORT is zero everywhere except inside L, so ESC stays
                            	  1729:                 ; an ordinary character at the prompt.
01:00F0B4D8 4A390000F848    	  1730:                 tst.b   MON_ABORT
01:00F0B4DE 6708            	  1731:                 beq.b   .ret
01:00F0B4E0 0C00001B        	  1732:                 cmpi.b  #ESC,d0
01:00F0B4E4 67000004        	  1733:                 beq.w   srec_abort
                            	  1734: .ret:
01:00F0B4E8 4E75            	  1735:                 rts
                            	  1736: 
                            	  1737: ; ---- srec_abort: unwind an in-flight L back to the prompt ----
                            	  1738: srec_abort:
01:00F0B4EA 13FC00000000F848	  1739:                 move.b  #0,MON_ABORT            ; disarm FIRST -- puts below
                            	  1740:                                                 ;   does not read, but a later
                            	  1741:                                                 ;   getchar must not re-abort
01:00F0B4F2 2E790000F844    	  1742:                 movea.l MON_CMDSP,sp            ; three frames deep, so unwind
                            	  1743:                                                 ;   rather than rts
01:00F0B4F8 41FA130B        	  1744:                 lea     abort_msg(pc),a0
01:00F0B4FC 61000006        	  1745:                 bsr.w   puts
01:00F0B500 6000F46E        	  1746:                 bra.w   cmd_loop
                            	  1747: 
                            	  1748: ; ---- puts: print null-terminated string at (a0) ----
                            	  1749: ;      CLOBBERS d0 AND a0.  a0 is left one PAST the terminator, because that
                            	  1750: ;      is how the string is walked -- unlike parse_hex, puts cannot save its
                            	  1751: ;      registers, since advancing a0 IS the operation.  So this contract is
                            	  1752: ;      documented rather than enforced, and a caller needing either across the
                            	  1753: ;      call must reload it.  Swept at all 82 call sites: none relies on one.
                            	  1754: ;      (Two false-positive classes had to be removed before that negative meant
                            	  1755: ;      anything -- a walker that did not stop at `bra` fell through into puts
                            	  1756: ;      itself, and `movem.l MON_REGS,d0-d7/a0-a6` WRITES a0 despite naming it.)
                            	  1757: puts:
01:00F0B504 1018            	  1758:                 move.b  (a0)+,d0
01:00F0B506 6706            	  1759:                 beq.b   .end
01:00F0B508 6100FF84        	  1760:                 bsr.w   putchar
01:00F0B50C 60F6            	  1761:                 bra.b   puts
                            	  1762: .end:
01:00F0B50E 4E75            	  1763:                 rts
                            	  1764: 
                            	  1765: put_crlf:
01:00F0B510 103C000D        	  1766:                 move.b  #13,d0
01:00F0B514 6100FF78        	  1767:                 bsr.w   putchar
01:00F0B518 103C000A        	  1768:                 move.b  #10,d0
01:00F0B51C 6000FF70        	  1769:                 bra.w   putchar
                            	  1770: 
                            	  1771: puthex_nibble:
01:00F0B520 0200000F        	  1772:                 andi.b  #$0F,d0
01:00F0B524 0C00000A        	  1773:                 cmpi.b  #10,d0
01:00F0B528 6D08            	  1774:                 blt.b   .num
01:00F0B52A 06000037        	  1775:                 addi.b  #'A'-10,d0
01:00F0B52E 6000FF5E        	  1776:                 bra.w   putchar
                            	  1777: .num:
01:00F0B532 06000030        	  1778:                 addi.b  #'0',d0
01:00F0B536 6000FF56        	  1779:                 bra.w   putchar
                            	  1780: 
                            	  1781: puthex_byte:
01:00F0B53A 2F00            	  1782:                 move.l  d0,-(sp)
01:00F0B53C E808            	  1783:                 lsr.b   #4,d0
01:00F0B53E 6100FFE0        	  1784:                 bsr.w   puthex_nibble
01:00F0B542 201F            	  1785:                 move.l  (sp)+,d0
01:00F0B544 6000FFDA        	  1786:                 bra.w   puthex_nibble
                            	  1787: 
                            	  1788: puthex_word:
01:00F0B548 E158            	  1789:                 rol.w   #8,d0
01:00F0B54A 6100FFEE        	  1790:                 bsr.w   puthex_byte
01:00F0B54E E158            	  1791:                 rol.w   #8,d0
01:00F0B550 6000FFE8        	  1792:                 bra.w   puthex_byte
                            	  1793: 
                            	  1794: puthex_long:
01:00F0B554 4840            	  1795:                 swap    d0
01:00F0B556 6100FFF0        	  1796:                 bsr.w   puthex_word
01:00F0B55A 4840            	  1797:                 swap    d0
01:00F0B55C 6000FFEA        	  1798:                 bra.w   puthex_word
                            	  1799: 
                            	  1800: ;================================================================
                            	  1801: ; TIER 1 — 16- and 32-bit peek/poke
                            	  1802: ;
                            	  1803: ; Every one of the 65 device addresses this project's
                            	  1804: ; reaching-definitions census resolves in the AP I/F and XLTR blocks
                            	  1805: ; is reached by a WORD access, and the AP I/F block is touched by
                            	  1806: ; plain `move` only (bar three `cmpi` on $FF0000).  The byte commands
                            	  1807: ; therefore cannot drive a single chassis register: `m`/`w` use
                            	  1808: ; move.b, and these are 16-bit-only blocks.
                            	  1809: ;
                            	  1810: ; The byte forms are KEPT rather than replaced.  The MC6840 PTM hangs
                            	  1811: ; off D0-D7 at ODD addresses ($F70001-$F7000F) and MUST be reached
                            	  1812: ; with move.b; so does the SIO.  Two access widths for two
                            	  1813: ; differently-wired classes of device.
                            	  1814: ;
                            	  1815: ;   mw AAAA [NN]   dump NN words (default 8, cap 64)
                            	  1816: ;   ml AAAA [NN]   dump NN longs (default 4, cap 32)
                            	  1817: ;   ww AAAA WWWW.. write words
                            	  1818: ;   wl AAAA LLLLLLLL.. write longs
                            	  1819: ;
                            	  1820: ; Odd addresses are REFUSED rather than attempted.  A word or long
                            	  1821: ; access at an odd address is an address error on a real 68000, and
                            	  1822: ; the emulator models it too since M68K_EMULATE_ADDRESS_ERROR was
                            	  1823: ; switched on — before that it silently completed them, which is how
                            	  1824: ; a move.w to the odd-byte MC6840 once ran clean in rehearsal.
                            	  1825: ; grp0_entry would catch the fault and now even reports the address,
                            	  1826: ; but a refusal names the operator's mistake instead of producing a
                            	  1827: ; fault report that reads like a dead device.
                            	  1828: ;================================================================
                            	  1829: 
                            	  1830: ; ---- xdump: dump d2 items of width d7 (2 or 4) starting at a4 ----
                            	  1831: ; CONSUMES d2 = item count, d7 = width (2 or 4), a4 = address.
                            	  1832: ; CLOBBERS  d0, d3, d4, d6, and advances a4.  d3/d4/d6 are the reason
                            	  1833: ; cmd_page holds its saved MODE2 on the stack rather than in a register:
                            	  1834: ; a caller that keeps a value in any of the three across this call gets
                            	  1835: ; garbage back and, if it then prints it, reports a restore that did not
                            	  1836: ; happen.  Do not add a register to the clobber list without re-auditing
                            	  1837: ; the four call sites.
                            	  1838: xdump:
01:00F0B560 4A82            	  1839:                 tst.l   d2                      ; a zero count would run the
01:00F0B562 674C            	  1840:                 beq.b   .ret                    ;   item loop 4 billion times
01:00F0B564 2C02            	  1841:                 move.l  d2,d6                   ; items remaining
                            	  1842: .line:
01:00F0B566 200C            	  1843:                 move.l  a4,d0
01:00F0B568 6100FFEA        	  1844:                 bsr.w   puthex_long
01:00F0B56C 103C003A        	  1845:                 move.b  #':',d0
01:00F0B570 6100FF1C        	  1846:                 bsr.w   putchar
01:00F0B574 7808            	  1847:                 moveq   #8,d4                   ; 8 words per line
01:00F0B576 0C070004        	  1848:                 cmpi.b  #4,d7
01:00F0B57A 6602            	  1849:                 bne.b   .cnt
01:00F0B57C 7804            	  1850:                 moveq   #4,d4                   ; or 4 longs
                            	  1851: .cnt:
01:00F0B57E BC84            	  1852:                 cmp.l   d4,d6
01:00F0B580 6402            	  1853:                 bcc.b   .full                   ; UNSIGNED, as hexdump -- see the
                            	  1854:                                                 ;   note there.  Same bug, same
                            	  1855:                                                 ;   shape, in the other shared
                            	  1856:                                                 ;   dump primitive.
01:00F0B582 2806            	  1857:                 move.l  d6,d4
                            	  1858: .full:
01:00F0B584 2604            	  1859:                 move.l  d4,d3
                            	  1860: .item:
01:00F0B586 103C0020        	  1861:                 move.b  #' ',d0
01:00F0B58A 6100FF02        	  1862:                 bsr.w   putchar
01:00F0B58E 0C070004        	  1863:                 cmpi.b  #4,d7
01:00F0B592 6708            	  1864:                 beq.b   .l32
01:00F0B594 301C            	  1865:                 move.w  (a4)+,d0
01:00F0B596 6100FFB0        	  1866:                 bsr.w   puthex_word
01:00F0B59A 6006            	  1867:                 bra.b   .nx
                            	  1868: .l32:
01:00F0B59C 201C            	  1869:                 move.l  (a4)+,d0
01:00F0B59E 6100FFB4        	  1870:                 bsr.w   puthex_long
                            	  1871: .nx:
01:00F0B5A2 5383            	  1872:                 subq.l  #1,d3
01:00F0B5A4 66E0            	  1873:                 bne.b   .item
01:00F0B5A6 6100FF68        	  1874:                 bsr.w   put_crlf
01:00F0B5AA 9C84            	  1875:                 sub.l   d4,d6
01:00F0B5AC 6600FFB8        	  1876:                 bne.w   .line                   ; not bgt -- see hexdump
                            	  1877: .ret:
01:00F0B5B0 4E75            	  1878:                 rts
                            	  1879: 
                            	  1880: ; ---- odd_check: d0 = address, d7 = width.  Prints and returns Z=0
                            	  1881: ;      (via d1=0) if the access would be an address error. ----
                            	  1882: odd_check:
01:00F0B5B2 0C070001        	  1883:                 cmpi.b  #1,d7
01:00F0B5B6 6712            	  1884:                 beq.b   .ok
01:00F0B5B8 08000000        	  1885:                 btst    #0,d0
01:00F0B5BC 670C            	  1886:                 beq.b   .ok
01:00F0B5BE 41FA147A        	  1887:                 lea     odd_msg(pc),a0
01:00F0B5C2 6100FF40        	  1888:                 bsr.w   puts
01:00F0B5C6 4201            	  1889:                 clr.b   d1
01:00F0B5C8 4E75            	  1890:                 rts
                            	  1891: .ok:
01:00F0B5CA 7201            	  1892:                 moveq   #1,d1
01:00F0B5CC 4E75            	  1893:                 rts
                            	  1894: 
                            	  1895: ;================================================================
                            	  1896: ; TIER 2 — device register maps
                            	  1897: ;
                            	  1898: ;   x   AP I/F  ($FF0000 bulk window + four channel windows)
                            	  1899: ;   y   XLTR    ($FF0200 control block + three MC68153 BIMs)
                            	  1900: ;
                            	  1901: ; Both walk a ROM table of addresses this project has POSITIVELY
                            	  1902: ; established, rather than sweeping the block.  Sweeping would touch
                            	  1903: ; addresses never shown to answer, and an unanswered address on this
                            	  1904: ; board is a bus error that aborts the dump — so a sweep would be
                            	  1905: ; both less informative and less safe than a table.
                            	  1906: ;
                            	  1907: ; $FF0008 is DELIBERATELY ABSENT from the AP I/F table.  It is the
                            	  1908: ; bulk data FIFO and READS POP IT: the S-record error paths spin
                            	  1909: ; `while ($FF0000 > 0) read (a0)` precisely to DRAIN a rejected
                            	  1910: ; record, and the stream read has no post-increment.  Dumping it as
                            	  1911: ; part of a register map would silently consume host data.  Use `e`.
                            	  1912: ;
                            	  1913: ; $FF0010 is absent because it does not exist: it is a register the
                            	  1914: ; emulator invented (APIF_CMD_ARG_HI), never accessed statically or
                            	  1915: ; at runtime.  Window 1 ($FF0020-$FF003F) is absent because the
                            	  1916: ; firmware's own (ch+1)<<5 arithmetic skips it by construction.
                            	  1917: ;
                            	  1918: ; The three BIM registers the firmware never individually programs —
                            	  1919: ; $FF0240 (BIM1 CR0), $FF0248 (BIM1 VR0) and $FF025E (BIM2 VR3) —
                            	  1920: ; ARE in the table.  They are written by self-test phase $1600's
                            	  1921: ; address-indexed walk, so they exist; only the firmware's per-channel
                            	  1922: ; programming skips them, and a map should show what the hardware has.
                            	  1923: ;================================================================
                            	  1924: 
                            	  1925: ; ---- devdump: walk the 12-byte table at a3 ----
                            	  1926: ;      entry = { addr.l, 7-char name, NUL }.  addr 0 terminates.
                            	  1927: devdump:
01:00F0B5CE 2013            	  1928:                 move.l  (a3),d0
01:00F0B5D0 672E            	  1929:                 beq.b   .end
01:00F0B5D2 6100FF80        	  1930:                 bsr.w   puthex_long
01:00F0B5D6 103C0020        	  1931:                 move.b  #' ',d0
01:00F0B5DA 6100FEB2        	  1932:                 bsr.w   putchar
01:00F0B5DE 41EB0004        	  1933:                 lea     4(a3),a0
01:00F0B5E2 6100FF20        	  1934:                 bsr.w   puts
01:00F0B5E6 103C003D        	  1935:                 move.b  #'=',d0
01:00F0B5EA 6100FEA2        	  1936:                 bsr.w   putchar
01:00F0B5EE 2053            	  1937:                 move.l  (a3),a0
01:00F0B5F0 3010            	  1938:                 move.w  (a0),d0
01:00F0B5F2 6100FF54        	  1939:                 bsr.w   puthex_word
01:00F0B5F6 6100FF18        	  1940:                 bsr.w   put_crlf
01:00F0B5FA 47EB000C        	  1941:                 lea     12(a3),a3
01:00F0B5FE 60CE            	  1942:                 bra.b   devdump
                            	  1943: .end:
01:00F0B600 4E75            	  1944:                 rts
                            	  1945: 
                            	  1946: cmd_apif:
01:00F0B602 41FA1512        	  1947:                 lea     apif_hdr(pc),a0
01:00F0B606 6100FEFC        	  1948:                 bsr.w   puts
01:00F0B60A 47FA087E        	  1949:                 lea     apif_tab(pc),a3
01:00F0B60E 6100FFBE        	  1950:                 bsr.w   devdump
01:00F0B612 41FA157D        	  1951:                 lea     fifo_msg(pc),a0
01:00F0B616 6100FEEC        	  1952:                 bsr.w   puts
