                            	   973:                 ; not directly accessible", so read-back is mediated by
                            	   974:                 ; external logic and may not reflect what was written.
01:00F0AF14 41FA1A93        	   975:                 lea     vmod_msg(pc),a0
01:00F0AF18 610005EA        	   976:                 bsr.w   puts
01:00F0AF1C 30390001FFF0    	   977:                 move.w  $1FFF0,d0
01:00F0AF22 61000624        	   978:                 bsr.w   puthex_word
01:00F0AF26 610005E8        	   979:                 bsr.w   put_crlf
