                            	  1961: 
                            	  1962: ;================================================================
                            	  1963: ; TIER 3 — an AC channel transaction, by hand
                            	  1964: ;
                            	  1965: ;   c CH OP [DD]   CH = 1..4, OP = 16-bit AC operation code, DD = the
                            	  1966: ;                  optional CONTINUE-phase longword ($8005)
                            	  1967: ;   ca CH OP       the fire-and-forget acknowledge ($8000), no poll
                            	  1968: ;
                            	  1969: ; Reproduces the firmware's own channel transaction primitive at
                            	  1970: ; $F07F12, which exists in five byte-identical copies (one per XP
                            	  1971: ; task plus RDHC's, at stride $2858):
                            	  1972: ;
                            	  1973: ;   mask the channel's BIM control register to $4F  (IRE cleared)
                            	  1974: ;   +$08 <- $0000          data high
                            	  1975: ;   +$0A <- operation code data low
                            	  1976: ;   +$0E <- $8004          REQUEST-TRANSFER
                            	  1977: ;   poll +$0E bit 14 = DONE, bit 13 = ERROR, 1000 iterations
                            	  1978: ;   on error  -> panel $269    on timeout -> panel $26C
                            	  1979: ;
                            	  1980: ; The channel window is $FF0000 + ((CH+1) << 5) — the firmware's own
                            	  1981: ; arithmetic at $F04CAA, which is why window 1 is skipped: (1+1)*32
                            	  1982: ; starts at $40.  BIM control registers come from the four-longword
                            	  1983: ; table at $F046E0: $244 $246 $250 $252, indexed by (CH-1)*4.  Note
                            	  1984: ; that is NOT a uniform stride.
                            	  1985: ;
                            	  1986: ; TEARDOWN IS UNCONDITIONAL.  The firmware's teardown clears the
                            	  1987: ; channel's bit in $FF021A and restores the BIM CR to $5F, and this
                            	  1988: ; project establishes that a chassis which raises a channel error and
                            	  1989: ; then ignores the resulting $269 leaves that bit SET and the BIM
                            	  1990: ; masked at $4F PERMANENTLY — the channel never re-enables and the
                            	  1991: ; machine degrades one channel at a time in a way that looks like a
                            	  1992: ; firmware bug.  This command therefore saves BOTH the BIM CR and the
                            	  1993: ; whole $FF021A word on entry and restores them on every exit path,
                            	  1994: ; including timeout and error.  Save-and-restore rather than the
                            	  1995: ; firmware's one-way clear: a probe should leave the machine as it
                            	  1996: ; found it, and $FF021A is clear-only in the firmware (50 sites, all
                            	  1997: ; bclr, zero bset) so emulating that here would be a one-shot.
                            	  1998: ;
                            	  1999: ; LATCH DISCRIMINATOR.  A model that merely acknowledges looks
                            	  2000: ; identical to a live AC unless you test for it: the emulator's
                            	  2001: ; chassis stub never examines the operation code (ch_lo is written
                            	  2002: ; and never read), so every opcode returns the same status, in ZERO
                            	  2003: ; polls, with the data pair echoing what was written.  This command
                            	  2004: ; reports that triple explicitly instead of printing "DONE" and
                            	  2005: ; letting the operator conclude an AC answered.
                            	  2006: ;================================================================
                            	  2007: cmd_ac:
01:00F0B632 528E            	  2008:                 addq.l  #1,a6
                            	  2009:                 ; a2 = form: 0 plain request, 1 request+continue, 2 acknowledge.
                            	  2010:                 ; a3 = the continue-phase longword.  Both survive parse_hex
                            	  2011:                 ; (which touches only a6 and d0-d3) and every output routine
                            	  2012:                 ; (a0/d0/d1), so no workspace word is needed.
01:00F0B634 7000            	  2013:                 moveq   #0,d0
01:00F0B636 2440            	  2014:                 move.l  d0,a2
01:00F0B638 2640            	  2015:                 move.l  d0,a3
01:00F0B63A 0C160061        	  2016:                 cmpi.b  #'a',(a6)
01:00F0B63E 6606            	  2017:                 bne.b   .noack
01:00F0B640 528E            	  2018:                 addq.l  #1,a6
01:00F0B642 7002            	  2019:                 moveq   #2,d0
01:00F0B644 2440            	  2020:                 move.l  d0,a2                   ; `ca` -- the acknowledge form
                            	  2021: .noack:
01:00F0B646 6100FBF4        	  2022:                 bsr.w   skip_ws
01:00F0B64A 6100FC04        	  2023:                 bsr.w   parse_hex
01:00F0B64E 4A01            	  2024:                 tst.b   d1
01:00F0B650 6700F54E        	  2025:                 beq.w   cmd_err
01:00F0B654 2A00            	  2026:                 move.l  d0,d5                   ; d5 = channel
01:00F0B656 7201            	  2027:                 moveq   #1,d1
01:00F0B658 BA81            	  2028:                 cmp.l   d1,d5
01:00F0B65A 6D000106        	  2029:                 blt.w   .badch
01:00F0B65E 7204            	  2030:                 moveq   #4,d1
01:00F0B660 BA81            	  2031:                 cmp.l   d1,d5
01:00F0B662 6E0000FE        	  2032:                 bgt.w   .badch
01:00F0B666 6100FBD4        	  2033:                 bsr.w   skip_ws
01:00F0B66A 6100FBE4        	  2034:                 bsr.w   parse_hex
01:00F0B66E 4A01            	  2035:                 tst.b   d1
01:00F0B670 6700F52E        	  2036:                 beq.w   cmd_err
01:00F0B674 3C00            	  2037:                 move.w  d0,d6                   ; d6 = opcode
