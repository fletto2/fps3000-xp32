                            	  1830: .disarm:
01:00F0B66A 4A390000F8D0    	  1831:                 tst.b   MON_TAPMSK
01:00F0B670 67000036        	  1832:                 beq.w   .notarmed
01:00F0B674 43F90000F8D8    	  1833:                 lea     MON_TAPSAV,a1
01:00F0B67A 7400            	  1834:                 moveq   #0,d2
                            	  1835: .dloop:
01:00F0B67C 2002            	  1836:                 move.l  d2,d0
01:00F0B67E E588            	  1837:                 lsl.l   #2,d0
01:00F0B680 45F80114        	  1838:                 lea     $114,a2
01:00F0B684 D5C0            	  1839:                 adda.l  d0,a2
01:00F0B686 2491            	  1840:                 move.l  (a1),(a2)               ; restore original
01:00F0B688 5889            	  1841:                 addq.l  #4,a1
01:00F0B68A 5282            	  1842:                 addq.l  #1,d2
01:00F0B68C 0C8200000004    	  1843:                 cmpi.l  #4,d2
01:00F0B692 6DE8            	  1844:                 blt.b   .dloop
01:00F0B694 13FC00000000F8D0	  1845:                 move.b  #0,MON_TAPMSK
01:00F0B69C 41FA10A1        	  1846:                 lea     tap_off_msg(pc),a0
01:00F0B6A0 6100FD22        	  1847:                 bsr.w   puts
01:00F0B6A4 6000F2A2        	  1848:                 bra.w   cmd_loop
                            	  1849: 
                            	  1850: .notarmed:
