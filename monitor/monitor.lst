01:00F0AD76 48E7E0C0        	   706:                 movem.l d0-d2/a0-a1,-(sp)
01:00F0AD7A 2400            	   707:                 move.l  d0,d2
01:00F0AD7C 6700002C        	   708:                 beq.w   .nf                     ; 0 never matches a slot
01:00F0AD80 41F90000F8A0    	   709:                 lea     MON_BPT,a0
01:00F0AD86 7207            	   710:                 moveq   #MON_BPN-1,d1
                            	   711: .scan:
01:00F0AD88 2010            	   712:                 move.l  (a0),d0
01:00F0AD8A B082            	   713:                 cmp.l   d2,d0
01:00F0AD8C 6616            	   714:                 bne.b   .next
01:00F0AD8E 2240            	   715:                 move.l  d0,a1
01:00F0AD90 32A80004        	   716:                 move.w  4(a0),(a1)              ; put the original back
01:00F0AD94 20BC00000000    	   717:                 move.l  #0,(a0)                 ; free the slot
01:00F0AD9A 41FA13C9        	   718:                 lea     ok_msg(pc),a0
01:00F0AD9E 61000624        	   719:                 bsr.w   puts
01:00F0ADA2 600E            	   720:                 bra.b   .out
                            	   721: .next:
01:00F0ADA4 5C88            	   722:                 lea     MON_BP_SZ(a0),a0
01:00F0ADA6 51C9FFE0        	   723:                 dbra    d1,.scan
                            	   724: .nf:
01:00F0ADAA 41FA141E        	   725:                 lea     bp_none_msg(pc),a0
01:00F0ADAE 61000614        	   726:                 bsr.w   puts
                            	   727: .out:
01:00F0ADB2 4CDF0307        	   728:                 movem.l (sp)+,d0-d2/a0-a1
01:00F0ADB6 4E75            	   729:                 rts
                            	   730: 
                            	   731: ; ---- bp_clr_all: disarm every armed slot ----
                            	   732: bp_clr_all:
01:00F0ADB8 48E7C0C0        	   733:                 movem.l d0-d1/a0-a1,-(sp)
01:00F0ADBC 41F90000F8A0    	   734:                 lea     MON_BPT,a0
01:00F0ADC2 7207            	   735:                 moveq   #MON_BPN-1,d1
                            	   736: .scan:
01:00F0ADC4 2010            	   737:                 move.l  (a0),d0
01:00F0ADC6 670C            	   738:                 beq.b   .next
01:00F0ADC8 2240            	   739:                 move.l  d0,a1
01:00F0ADCA 32A80004        	   740:                 move.w  4(a0),(a1)
01:00F0ADCE 20BC00000000    	   741:                 move.l  #0,(a0)
                            	   742: .next:
01:00F0ADD4 5C88            	   743:                 lea     MON_BP_SZ(a0),a0
01:00F0ADD6 51C9FFEC        	   744:                 dbra    d1,.scan
01:00F0ADDA 4CDF0303        	   745:                 movem.l (sp)+,d0-d1/a0-a1
