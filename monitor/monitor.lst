Sections:
00: "segf0a826" (F0A826-F0B146)


Source: "monitor.s"
                            	     1: ; ----------------------------------------------------------------
                            	     2: ; FPS-3000 SBC Monitor / Debugger / Host Interface
                            	     3: ; Lives in the 22.4 KB of free ROM at $F0A825 onwards.
                            	     4: ;
                            	     5: ; Communicates over the on-board NEC µPD7201 SIO Channel A
                            	     6: ; ($F70010 data, $F70012 control), which the FPS firmware never
                            	     7: ; initialises or uses — so we have it all to ourselves.
                            	     8: ;
                            	     9: ; Triggered by jumping to monitor_entry (typically by patching
                            	    10: ; one or more vectors).
                            	    11: ; ----------------------------------------------------------------
                            	    12: 
                            	    13: SIO_A_DATA      equ     $F70010
                            	    14: SIO_A_CTRL      equ     $F70012
                            	    15: 
                            	    16: ; Z80-SIO/i8274 RR0 status bits
                            	    17: RR0_RX_AVAIL    equ     0
                            	    18: RR0_TX_EMPTY    equ     2
                            	    19: 
                            	    20: ; Monitor RAM workspace (using high-RAM area below VMOD_CTRL @ $1FFF0)
                            	    21: MON_REGS        equ     $1F000          ; saved D0..D7 then A0..A6 (15*4=60 bytes)
                            	    22: MON_SPC         equ     $1F03C          ; saved PC (long) — at MON_REGS + 60
                            	    23: MON_SSR         equ     $1F040          ; saved SR (word)
                            	    24: MON_LINEBUF     equ     $1F050          ; cmd line buffer (64 B)
                            	    25: MON_LASTADDR    equ     $1F090          ; last 'm' addr (long)
                            	    26: 
                            	    27:                 org     $F0A826
                            	    28: 
                            	    29: ;================================================================
                            	    30: ; Cold entry — used when monitor is patched in as the reset PC.
                            	    31: ; SP isn't loaded by the FPS reset path, so we install it ourselves
                            	    32: ; before doing anything that pushes (like bsr).
                            	    33: ;================================================================
                            	    34: monitor_cold:
00:00F0A826 007C2700        	    35:                 ori.w   #$2700,sr               ; supervisor, IPL=7
00:00F0A82A 4FF90001FFD0    	    36:                 lea     $1FFD0,sp               ; supervisor stack
00:00F0A830 42B90001F03C    	    37:                 clr.l   MON_SPC
00:00F0A836 33FC27000001F040	    38:                 move.w  #$2700,MON_SSR
00:00F0A83E 6016            	    39:                 bra.b   monitor_common
                            	    40: 
                            	    41: ;================================================================
                            	    42: ; Exception entry — called as JMP target from patched vectors.
                            	    43: ;
                            	    44: ; If entered via an exception, the supervisor stack contains the
                            	    45: ; standard 7-word frame (or 4-word for IRQ).  We save D0-D7/A0-A6
                            	    46: ; into MON_REGS, then read the saved PC and SR from the stack.
                            	    47: ;================================================================
                            	    48: monitor_entry:
00:00F0A840 48F97FFF0001F000	    49:                 movem.l d0-d7/a0-a6,MON_REGS
                            	    50:                 ; Top of stack: short frame = SR, PC.l ; long frame extra
                            	    51:                 ; We don't know which — peek at SR's vector field
00:00F0A848 33D70001F040    	    52:                 move.w  (sp),MON_SSR            ; saved SR is at top
00:00F0A84E 23EF00020001F03C	    53:                 move.l  2(sp),MON_SPC           ; saved PC follows
                            	    54: monitor_common:
                            	    55: 
00:00F0A856 610004CA        	    56:                 bsr.w   sio_init
00:00F0A85A 61000538        	    57:                 bsr.w   put_crlf
00:00F0A85E 61000534        	    58:                 bsr.w   put_crlf
00:00F0A862 41FA0580        	    59:                 lea     banner_msg(pc),a0
00:00F0A866 61000520        	    60:                 bsr.w   puts
00:00F0A86A 41FA062D        	    61:                 lea     entry_msg(pc),a0
00:00F0A86E 61000518        	    62:                 bsr.w   puts
00:00F0A872 20390001F03C    	    63:                 move.l  MON_SPC,d0
00:00F0A878 6100055E        	    64:                 bsr.w   puthex_long
00:00F0A87C 41FA062B        	    65:                 lea     sr_msg(pc),a0
00:00F0A880 61000506        	    66:                 bsr.w   puts
00:00F0A884 30390001F040    	    67:                 move.w  MON_SSR,d0
00:00F0A88A 61000540        	    68:                 bsr.w   puthex_word
00:00F0A88E 61000504        	    69:                 bsr.w   put_crlf
                            	    70: 
                            	    71: cmd_loop:
00:00F0A892 41FA061C        	    72:                 lea     prompt_msg(pc),a0
00:00F0A896 610004F0        	    73:                 bsr.w   puts
00:00F0A89A 6100038E        	    74:                 bsr.w   read_line               ; reads into MON_LINEBUF, term=0
00:00F0A89E 4DF90001F050    	    75:                 lea     MON_LINEBUF,a6          ; a6 = parse pointer
00:00F0A8A4 610003E0        	    76:                 bsr.w   skip_ws
00:00F0A8A8 1016            	    77:                 move.b  (a6),d0
00:00F0A8AA 67E6            	    78:                 beq.b   cmd_loop                ; empty line
                            	    79: 
00:00F0A8AC 0C00003F        	    80:                 cmpi.b  #'?',d0
00:00F0A8B0 67000056        	    81:                 beq.w   cmd_help
00:00F0A8B4 0C000068        	    82:                 cmpi.b  #'h',d0
00:00F0A8B8 6700004E        	    83:                 beq.w   cmd_help
00:00F0A8BC 0C000072        	    84:                 cmpi.b  #'r',d0
00:00F0A8C0 6700005E        	    85:                 beq.w   cmd_regs
00:00F0A8C4 0C00006D        	    86:                 cmpi.b  #'m',d0
00:00F0A8C8 670000E6        	    87:                 beq.w   cmd_mem
00:00F0A8CC 0C000064        	    88:                 cmpi.b  #'d',d0
00:00F0A8D0 6700013A        	    89:                 beq.w   cmd_dump
00:00F0A8D4 0C000077        	    90:                 cmpi.b  #'w',d0
00:00F0A8D8 67000136        	    91:                 beq.w   cmd_write
00:00F0A8DC 0C000067        	    92:                 cmpi.b  #'g',d0
00:00F0A8E0 67000162        	    93:                 beq.w   cmd_go
00:00F0A8E4 0C00004C        	    94:                 cmpi.b  #'L',d0
00:00F0A8E8 670001AE        	    95:                 beq.w   cmd_load_srec
00:00F0A8EC 0C000069        	    96:                 cmpi.b  #'i',d0
00:00F0A8F0 6700019A        	    97:                 beq.w   cmd_info
00:00F0A8F4 0C000021        	    98:                 cmpi.b  #'!',d0
00:00F0A8F8 6700001A        	    99:                 beq.w   cmd_about
                            	   100: 
00:00F0A8FC 41FA05BA        	   101:                 lea     unknown_msg(pc),a0
00:00F0A900 61000486        	   102:                 bsr.w   puts
00:00F0A904 6000FF8C        	   103:                 bra.w   cmd_loop
                            	   104: 
                            	   105: ;----------------------------------------------------------------
                            	   106: ; Help — print command list
                            	   107: ;----------------------------------------------------------------
                            	   108: cmd_help:
00:00F0A908 41FA05C6        	   109:                 lea     help_msg(pc),a0
00:00F0A90C 6100047A        	   110:                 bsr.w   puts
00:00F0A910 6000FF80        	   111:                 bra.w   cmd_loop
                            	   112: 
                            	   113: ;----------------------------------------------------------------
                            	   114: ; About / Banner
                            	   115: ;----------------------------------------------------------------
                            	   116: cmd_about:
00:00F0A914 41FA04CE        	   117:                 lea     banner_msg(pc),a0
00:00F0A918 6100046E        	   118:                 bsr.w   puts
00:00F0A91C 6000FF74        	   119:                 bra.w   cmd_loop
                            	   120: 
                            	   121: ;----------------------------------------------------------------
                            	   122: ; Show registers
                            	   123: ;   format:
                            	   124: ;     D0=12345678  D1=12345678  D2=12345678  D3=12345678
                            	   125: ;     D4=12345678  D5=12345678  D6=12345678  D7=12345678
                            	   126: ;     A0=12345678  A1=12345678  A2=12345678  A3=12345678
                            	   127: ;     A4=12345678  A5=12345678  A6=12345678
                            	   128: ;     PC=12345678  SR=1234
                            	   129: ;----------------------------------------------------------------
                            	   130: cmd_regs:
00:00F0A920 7400            	   131:                 moveq   #0,d2                   ; reg index 0..14
                            	   132: .loop:
00:00F0A922 7600            	   133:                 moveq   #0,d3
00:00F0A924 1602            	   134:                 move.b  d2,d3
00:00F0A926 0C030008        	   135:                 cmpi.b  #8,d3
00:00F0A92A 6D08            	   136:                 blt.b   .is_d
00:00F0A92C 103C0041        	   137:                 move.b  #'A',d0
00:00F0A930 5103            	   138:                 subi.b  #8,d3
00:00F0A932 6004            	   139:                 bra.b   .show
                            	   140: .is_d:
00:00F0A934 103C0044        	   141:                 move.b  #'D',d0
                            	   142: .show:
00:00F0A938 6100042A        	   143:                 bsr.w   putchar
00:00F0A93C 1003            	   144:                 move.b  d3,d0
00:00F0A93E 06000030        	   145:                 addi.b  #'0',d0
00:00F0A942 61000420        	   146:                 bsr.w   putchar
00:00F0A946 103C003D        	   147:                 move.b  #'=',d0
00:00F0A94A 61000418        	   148:                 bsr.w   putchar
                            	   149:                 ; load reg from MON_REGS[d2*4]
00:00F0A94E 3002            	   150:                 move.w  d2,d0
00:00F0A950 E548            	   151:                 lsl.w   #2,d0
00:00F0A952 41F90001F000    	   152:                 lea     MON_REGS,a0
00:00F0A958 20300000        	   153:                 move.l  (a0,d0.w),d0
00:00F0A95C 6100047A        	   154:                 bsr.w   puthex_long
00:00F0A960 103C0020        	   155:                 move.b  #' ',d0
00:00F0A964 610003FE        	   156:                 bsr.w   putchar
00:00F0A968 610003FA        	   157:                 bsr.w   putchar
00:00F0A96C 5202            	   158:                 addq.b  #1,d2
                            	   159:                 ; new line every 4 regs
00:00F0A96E 1002            	   160:                 move.b  d2,d0
00:00F0A970 02000003        	   161:                 andi.b  #3,d0
00:00F0A974 6604            	   162:                 bne.b   .nonl
00:00F0A976 6100041C        	   163:                 bsr.w   put_crlf
                            	   164: .nonl:
00:00F0A97A 0C02000F        	   165:                 cmpi.b  #15,d2
00:00F0A97E 6DA2            	   166:                 blt.b   .loop
00:00F0A980 61000412        	   167:                 bsr.w   put_crlf
00:00F0A984 41FA07B3        	   168:                 lea     pcmsg(pc),a0
00:00F0A988 610003FE        	   169:                 bsr.w   puts
00:00F0A98C 20390001F03C    	   170:                 move.l  MON_SPC,d0
00:00F0A992 61000444        	   171:                 bsr.w   puthex_long
00:00F0A996 41FA07A6        	   172:                 lea     srmsg(pc),a0
00:00F0A99A 610003EC        	   173:                 bsr.w   puts
00:00F0A99E 30390001F040    	   174:                 move.w  MON_SSR,d0
00:00F0A9A4 61000426        	   175:                 bsr.w   puthex_word
00:00F0A9A8 610003EA        	   176:                 bsr.w   put_crlf
00:00F0A9AC 6000FEE4        	   177:                 bra.w   cmd_loop
                            	   178: 
                            	   179: ;----------------------------------------------------------------
                            	   180: ; Memory display (default 16 bytes from last addr or parsed addr)
                            	   181: ;   m            -> dump 16 bytes from MON_LASTADDR
                            	   182: ;   m XXXXXX     -> set MON_LASTADDR, dump 16 bytes
                            	   183: ;   m XXXXXX YY  -> dump YY bytes (hex count)
                            	   184: ;----------------------------------------------------------------
                            	   185: cmd_mem:
00:00F0A9B0 528E            	   186:                 addq.l  #1,a6
00:00F0A9B2 610002D2        	   187:                 bsr.w   skip_ws
00:00F0A9B6 1016            	   188:                 move.b  (a6),d0
00:00F0A9B8 6710            	   189:                 beq.b   .use_last
00:00F0A9BA 610002DE        	   190:                 bsr.w   parse_hex
00:00F0A9BE 4A01            	   191:                 tst.b   d1
00:00F0A9C0 6700003E        	   192:                 beq.w   cmd_err
00:00F0A9C4 23C00001F090    	   193:                 move.l  d0,MON_LASTADDR
                            	   194: .use_last:
00:00F0A9CA 610002BA        	   195:                 bsr.w   skip_ws
00:00F0A9CE 7410            	   196:                 moveq   #16,d2                  ; default count
00:00F0A9D0 1016            	   197:                 move.b  (a6),d0
00:00F0A9D2 6718            	   198:                 beq.b   .do
00:00F0A9D4 610002C4        	   199:                 bsr.w   parse_hex
00:00F0A9D8 4A01            	   200:                 tst.b   d1
00:00F0A9DA 67000024        	   201:                 beq.w   cmd_err
00:00F0A9DE 2400            	   202:                 move.l  d0,d2
00:00F0A9E0 0C8200000080    	   203:                 cmpi.l  #128,d2
00:00F0A9E6 6F04            	   204:                 ble.b   .do
00:00F0A9E8 7480            	   205:                 moveq   #-128,d2
00:00F0A9EA 4482            	   206:                 neg.l   d2
                            	   207: .do:
00:00F0A9EC 28790001F090    	   208:                 move.l  MON_LASTADDR,a4
00:00F0A9F2 610001A2        	   209:                 bsr.w   hexdump
                            	   210:                 ; advance LASTADDR by count
00:00F0A9F6 D5B90001F090    	   211:                 add.l   d2,MON_LASTADDR
00:00F0A9FC 6000FE94        	   212:                 bra.w   cmd_loop
                            	   213: 
                            	   214: cmd_err:
00:00F0AA00 41FA063B        	   215:                 lea     hex_err(pc),a0
00:00F0AA04 61000382        	   216:                 bsr.w   puts
00:00F0AA08 6000FE88        	   217:                 bra.w   cmd_loop
                            	   218: 
                            	   219: ;----------------------------------------------------------------
                            	   220: ; Dump aliases mem command
                            	   221: ;----------------------------------------------------------------
                            	   222: cmd_dump:
00:00F0AA0C 6000FFA2        	   223:                 bra.w   cmd_mem
                            	   224: 
                            	   225: ;----------------------------------------------------------------
                            	   226: ; Memory write:  w XXXXXX BB BB BB ...
                            	   227: ;----------------------------------------------------------------
                            	   228: cmd_write:
00:00F0AA10 528E            	   229:                 addq.l  #1,a6
00:00F0AA12 61000272        	   230:                 bsr.w   skip_ws
00:00F0AA16 61000282        	   231:                 bsr.w   parse_hex
00:00F0AA1A 4A01            	   232:                 tst.b   d1
00:00F0AA1C 6700FFE2        	   233:                 beq.w   cmd_err
00:00F0AA20 2840            	   234:                 move.l  d0,a4
                            	   235: .wloop:
00:00F0AA22 61000262        	   236:                 bsr.w   skip_ws
00:00F0AA26 1016            	   237:                 move.b  (a6),d0
00:00F0AA28 670E            	   238:                 beq.b   .done
00:00F0AA2A 6100026E        	   239:                 bsr.w   parse_hex
00:00F0AA2E 4A01            	   240:                 tst.b   d1
00:00F0AA30 6700FFCE        	   241:                 beq.w   cmd_err
00:00F0AA34 18C0            	   242:                 move.b  d0,(a4)+
00:00F0AA36 60EA            	   243:                 bra.b   .wloop
                            	   244: .done:
00:00F0AA38 41FA05FE        	   245:                 lea     ok_msg(pc),a0
00:00F0AA3C 6100034A        	   246:                 bsr.w   puts
00:00F0AA40 6000FE50        	   247:                 bra.w   cmd_loop
                            	   248: 
                            	   249: ;----------------------------------------------------------------
                            	   250: ; Go — restore registers and RTE.  No address arg = use saved PC.
                            	   251: ; "g XXXXXX" replaces the saved PC before resuming.
                            	   252: ;----------------------------------------------------------------
                            	   253: cmd_go:
00:00F0AA44 528E            	   254:                 addq.l  #1,a6
00:00F0AA46 6100023E        	   255:                 bsr.w   skip_ws
00:00F0AA4A 1016            	   256:                 move.b  (a6),d0
00:00F0AA4C 6710            	   257:                 beq.b   .resume
00:00F0AA4E 6100024A        	   258:                 bsr.w   parse_hex
00:00F0AA52 4A01            	   259:                 tst.b   d1
00:00F0AA54 6700FFAA        	   260:                 beq.w   cmd_err
00:00F0AA58 23C00001F03C    	   261:                 move.l  d0,MON_SPC
                            	   262: .resume:
00:00F0AA5E 41FA05E4        	   263:                 lea     resume_msg(pc),a0
00:00F0AA62 61000324        	   264:                 bsr.w   puts
00:00F0AA66 20390001F03C    	   265:                 move.l  MON_SPC,d0
00:00F0AA6C 6100036A        	   266:                 bsr.w   puthex_long
00:00F0AA70 61000322        	   267:                 bsr.w   put_crlf
                            	   268:                 ; rebuild stack frame and RTE
00:00F0AA74 2F790001F03C0002	   269:                 move.l  MON_SPC,2(sp)
00:00F0AA7C 3EB90001F040    	   270:                 move.w  MON_SSR,(sp)
00:00F0AA82 4CF97FFF0001F000	   271:                 movem.l MON_REGS,d0-d7/a0-a6
00:00F0AA8A 4E73            	   272:                 rte
                            	   273: 
                            	   274: ;----------------------------------------------------------------
                            	   275: ; Info — chassis state, ROM version, free RAM, etc.
                            	   276: ;----------------------------------------------------------------
                            	   277: cmd_info:
00:00F0AA8C 41FA05F5        	   278:                 lea     info_msg(pc),a0
00:00F0AA90 610002F6        	   279:                 bsr.w   puts
00:00F0AA94 6000FDFC        	   280:                 bra.w   cmd_loop
                            	   281: 
                            	   282: ;----------------------------------------------------------------
                            	   283: ; Load S-record over the SIO (channel A).
                            	   284: ; Each line consumed and validated; bytes go to addresses inside.
                            	   285: ; Terminator: S8 / S9 record.
                            	   286: ;----------------------------------------------------------------
                            	   287: cmd_load_srec:
00:00F0AA98 41FA05B4        	   288:                 lea     load_msg(pc),a0
00:00F0AA9C 610002EA        	   289:                 bsr.w   puts
00:00F0AAA0 7800            	   290:                 clr.l   d4                      ; record count
00:00F0AAA2 7A00            	   291:                 clr.l   d5                      ; byte count
                            	   292: .scan_S:
00:00F0AAA4 610002D0        	   293:                 bsr.w   getchar
00:00F0AAA8 0C000053        	   294:                 cmpi.b  #'S',d0
00:00F0AAAC 66F6            	   295:                 bne.b   .scan_S                  ; skip until 'S'
00:00F0AAAE 610002C6        	   296:                 bsr.w   getchar                  ; record type
00:00F0AAB2 0C000038        	   297:                 cmpi.b  #'8',d0
00:00F0AAB6 670000A4        	   298:                 beq.w   .terminator
00:00F0AABA 0C000039        	   299:                 cmpi.b  #'9',d0
00:00F0AABE 6700009C        	   300:                 beq.w   .terminator
00:00F0AAC2 0C000037        	   301:                 cmpi.b  #'7',d0
00:00F0AAC6 67000094        	   302:                 beq.w   .terminator
00:00F0AACA 0C000030        	   303:                 cmpi.b  #'0',d0
00:00F0AACE 67000076        	   304:                 beq.w   .eat_eol                ; header — skip
00:00F0AAD2 0C000031        	   305:                 cmpi.b  #'1',d0
00:00F0AAD6 6D00FFCC        	   306:                 blt.w   .scan_S
00:00F0AADA 0C000033        	   307:                 cmpi.b  #'3',d0
00:00F0AADE 6E00FFC4        	   308:                 bgt.w   .scan_S
                            	   309:                 ; data record S1 / S2 / S3
00:00F0AAE2 1C00            	   310:                 move.b  d0,d6                   ; save type
00:00F0AAE4 6100020A        	   311:                 bsr.w   read_hex_byte
00:00F0AAE8 2400            	   312:                 move.l  d0,d2                   ; payload count (incl addr+cksum)
00:00F0AAEA 7600            	   313:                 clr.l   d3
00:00F0AAEC 0C060033        	   314:                 cmpi.b  #'3',d6
00:00F0AAF0 6708            	   315:                 beq.b   .a32
00:00F0AAF2 0C060032        	   316:                 cmpi.b  #'2',d6
00:00F0AAF6 670C            	   317:                 beq.b   .a24
00:00F0AAF8 6014            	   318:                 bra.b   .a16
                            	   319: .a32:
00:00F0AAFA 610001F4        	   320:                 bsr.w   read_hex_byte
00:00F0AAFE E18B            	   321:                 lsl.l   #8,d3
00:00F0AB00 8600            	   322:                 or.b    d0,d3
00:00F0AB02 5302            	   323:                 subq.b  #1,d2
                            	   324: .a24:
00:00F0AB04 610001EA        	   325:                 bsr.w   read_hex_byte
00:00F0AB08 E18B            	   326:                 lsl.l   #8,d3
00:00F0AB0A 8600            	   327:                 or.b    d0,d3
00:00F0AB0C 5302            	   328:                 subq.b  #1,d2
                            	   329: .a16:
00:00F0AB0E 610001E0        	   330:                 bsr.w   read_hex_byte
00:00F0AB12 E18B            	   331:                 lsl.l   #8,d3
00:00F0AB14 8600            	   332:                 or.b    d0,d3
00:00F0AB16 610001D8        	   333:                 bsr.w   read_hex_byte
00:00F0AB1A E18B            	   334:                 lsl.l   #8,d3
00:00F0AB1C 8600            	   335:                 or.b    d0,d3
00:00F0AB1E 5502            	   336:                 subq.b  #2,d2
00:00F0AB20 5302            	   337:                 subq.b  #1,d2                   ; -1 for checksum
00:00F0AB22 2843            	   338:                 move.l  d3,a4                   ; dest pointer
                            	   339: .dloop:
00:00F0AB24 4A02            	   340:                 tst.b   d2
00:00F0AB26 6F0C            	   341:                 ble.b   .endrec
