01:00F0ADD2 48E7E0C0        	   832:                 movem.l d0-d2/a0-a1,-(sp)
01:00F0ADD6 2400            	   833:                 move.l  d0,d2
01:00F0ADD8 6700002C        	   834:                 beq.w   .nf                     ; 0 never matches a slot
01:00F0ADDC 41F90000F8A0    	   835:                 lea     MON_BPT,a0
01:00F0ADE2 7207            	   836:                 moveq   #MON_BPN-1,d1
