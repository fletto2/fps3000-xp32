01:00F0B6AC 6100FD16        	  1852:                 bsr.w   puts
01:00F0B6B0 6000F296        	  1853:                 bra.w   cmd_loop
                            	  1854: 
                            	  1855: .clear:
01:00F0B6B4 33FC00000000F8E8	  1856:                 move.w  #0,MON_RINGHD
01:00F0B6BC 33FC00000000F8EA	  1857:                 move.w  #0,MON_RINGN
01:00F0B6C4 33FC00000000F8EC	  1858:                 move.w  #0,MON_RINGOV
01:00F0B6CC 41FA0A97        	  1859:                 lea     ok_msg(pc),a0
01:00F0B6D0 6100FCF2        	  1860:                 bsr.w   puts
01:00F0B6D4 6000F272        	  1861:                 bra.w   cmd_loop
                            	  1862: 
                            	  1863: .startt1:
                            	  1864:                 ; Free-run T3 for timestamps, in the firmware's own order
                            	  1865:                 ; ($F0A294-$F0A2E4): assert the internal reset, load the
                            	  1866:                 ; latch, configure, release.  A model that ignores that
                            	  1867:                 ; ordering loads a latch into a running timer.
01:00F0B6D8 13FC000100F70003	  1868:                 move.b  #$01,$F70003            ; CR2 bit0=1 -> +$1 is CR1
01:00F0B6E0 13FC000100F70001	  1869:                 move.b  #$01,$F70001            ; CR1 bit0=1 -> INTERNAL
                            	  1870:                                                 ;   RESET: holds ALL THREE
                            	  1871:                                                 ;   timers, not just T1
01:00F0B6E8 13FC000000F70003	  1872:                 move.b  #$00,$F70003            ; CR2 bit0=0 -> +$1 is CR3
01:00F0B6F0 13FC000200F70001	  1873:                 move.b  #$02,$F70001            ; CR3: 16-bit, continuous,
                            	  1874:                                                 ;   internal E clock, IRQ
                            	  1875:                                                 ;   DISABLED (bit 6 = 0)
01:00F0B6F8 13FC00FF00F7000D	  1876:                 move.b  #$FF,$F7000D            ; T3 latch MSB
01:00F0B700 13FC00FF00F7000F	  1877:                 move.b  #$FF,$F7000F            ; T3 latch LSB -> 65536
                            	  1878:                                                 ;   counts = 82 ms wrap at
                            	  1879:                                                 ;   1.25 us resolution
01:00F0B708 13FC000100F70003	  1880:                 move.b  #$01,$F70003            ; select CR1 again
01:00F0B710 13FC000000F70001	  1881:                 move.b  #$00,$F70001            ; release the reset: the
                            	  1882:                                                 ;   timers start HERE
01:00F0B718 41FA105D        	  1883:                 lea     tap_t1_msg(pc),a0
01:00F0B71C 6100FCA6        	  1884:                 bsr.w   puts
01:00F0B720 6000F226        	  1885:                 bra.w   cmd_loop
                            	  1886: 
                            	  1887: .list:
01:00F0B724 41FA1169        	  1888:                 lea     tap_hdr_msg(pc),a0
01:00F0B728 6100FC9A        	  1889:                 bsr.w   puts
01:00F0B72C 3C390000F8EA    	  1890:                 move.w  MON_RINGN,d6
01:00F0B732 4A46            	  1891:                 tst.w   d6
01:00F0B734 670000A2        	  1892:                 beq.w   .empty
