                            	   568: cmd_write:
01:00F0ABB0 7E01            	   569:                 moveq   #1,d7                   ; width, as cmd_mem
01:00F0ABB2 528E            	   570:                 addq.l  #1,a6
01:00F0ABB4 1016            	   571:                 move.b  (a6),d0
01:00F0ABB6 0C000077        	   572:                 cmpi.b  #'w',d0
01:00F0ABBA 6708            	   573:                 beq.b   .w16
01:00F0ABBC 0C00006C        	   574:                 cmpi.b  #'l',d0
01:00F0ABC0 6708            	   575:                 beq.b   .w32
01:00F0ABC2 600A            	   576:                 bra.b   .havew
                            	   577: .w16:
01:00F0ABC4 7E02            	   578:                 moveq   #2,d7
01:00F0ABC6 528E            	   579:                 addq.l  #1,a6
01:00F0ABC8 6004            	   580:                 bra.b   .havew
                            	   581: .w32:
01:00F0ABCA 7E04            	   582:                 moveq   #4,d7
01:00F0ABCC 528E            	   583:                 addq.l  #1,a6
                            	   584: .havew:
01:00F0ABCE 6100066C        	   585:                 bsr.w   skip_ws
01:00F0ABD2 6100067C        	   586:                 bsr.w   parse_hex
01:00F0ABD6 4A01            	   587:                 tst.b   d1
01:00F0ABD8 6700FFC6        	   588:                 beq.w   cmd_err
01:00F0ABDC 610009D4        	   589:                 bsr.w   odd_check
01:00F0ABE0 4A01            	   590:                 tst.b   d1
01:00F0ABE2 6700FD8C        	   591:                 beq.w   cmd_loop
01:00F0ABE6 2840            	   592:                 move.l  d0,a4
                            	   593: .wloop:
01:00F0ABE8 61000652        	   594:                 bsr.w   skip_ws
01:00F0ABEC 1016            	   595:                 move.b  (a6),d0
01:00F0ABEE 6722            	   596:                 beq.b   .done
01:00F0ABF0 6100065E        	   597:                 bsr.w   parse_hex
01:00F0ABF4 4A01            	   598:                 tst.b   d1
01:00F0ABF6 6700FFA8        	   599:                 beq.w   cmd_err
01:00F0ABFA 0C070001        	   600:                 cmpi.b  #1,d7
01:00F0ABFE 6604            	   601:                 bne.b   .p2
01:00F0AC00 18C0            	   602:                 move.b  d0,(a4)+
01:00F0AC02 60E4            	   603:                 bra.b   .wloop
                            	   604: .p2:
01:00F0AC04 0C070002        	   605:                 cmpi.b  #2,d7
01:00F0AC08 6604            	   606:                 bne.b   .p4
01:00F0AC0A 38C0            	   607:                 move.w  d0,(a4)+
01:00F0AC0C 60DA            	   608:                 bra.b   .wloop
                            	   609: .p4:
01:00F0AC0E 28C0            	   610:                 move.l  d0,(a4)+
01:00F0AC10 60D6            	   611:                 bra.b   .wloop
                            	   612: .done:
01:00F0AC12 41FA1AB5        	   613:                 lea     ok_msg(pc),a0
01:00F0AC16 610008EC        	   614:                 bsr.w   puts
01:00F0AC1A 6000FD54        	   615:                 bra.w   cmd_loop
                            	   616: 
                            	   617: ;----------------------------------------------------------------
                            	   618: ; Go — restore registers and RTE.  No address arg = use saved PC.
                            	   619: ; "g XXXXXX" replaces the saved PC before resuming.
                            	   620: ;----------------------------------------------------------------
                            	   621: ; Only a short (4-word) frame can be *resumed*.  A group-0 frame is not
                            	   622: ; restartable on a 68000, and cold entry has no frame at all — but with
                            	   623: ; an explicit address, cold entry can still start code by synthesizing a
                            	   624: ; frame and RTE'ing into it.  That is what makes the standalone monitor
                            	   625: ; able to run and then debug something, rather than only look at memory.
                            	   626: cmd_go:
                            	   627:                 ; Put the trace vector back first.  `t` displaces a LIVE
                            	   628:                 ; kernel handler ($F00AEE) where `b` displaces nobody --
                            	   629:                 ; see cmd_trace.  Doing it here rather than at .resume
                            	   630:                 ; covers .fresh too, since both paths end in RTE, and d0
                            	   631:                 ; is free at this point because nothing is parsed yet.
01:00F0AC1E 20390000F8D4    	   632:                 move.l  MON_TRCSAV,d0
01:00F0AC24 670A            	   633:                 beq.b   .notrc
01:00F0AC26 21C00024        	   634:                 move.l  d0,TRACE_VECTOR
01:00F0AC2A 42B90000F8D4    	   635:                 clr.l   MON_TRCSAV              ; so a second `g` cannot
                            	   636:                                                 ;   re-poke a stale value
                            	   637: .notrc:
01:00F0AC30 528E            	   638:                 addq.l  #1,a6
01:00F0AC32 61000608        	   639:                 bsr.w   skip_ws
01:00F0AC36 1016            	   640:                 move.b  (a6),d0
01:00F0AC38 671C            	   641:                 beq.b   .noaddr
01:00F0AC3A 61000614        	   642:                 bsr.w   parse_hex
01:00F0AC3E 4A01            	   643:                 tst.b   d1
01:00F0AC40 6700FF5E        	   644:                 beq.w   cmd_err
                            	   645:                 ; An explicit address is a START, not a resume, so any
                            	   646:                 ; frame we cannot resume ($FF cold entry OR 1 group-0) is
                            	   647:                 ; handled by synthesizing one.  Refusing the group-0 case
                            	   648:                 ; here meant that after a single bus error NO further code
                            	   649:                 ; could be started until a power cycle -- the worst failure
                            	   650:                 ; mode for a bring-up tool, since every later probe then
                            	   651:                 ; reports a fault that is about the monitor, not the board.
01:00F0AC44 4A390000F894    	   652:                 tst.b   MON_GRP0
01:00F0AC4A 6600004A        	   653:                 bne.w   .fresh                  ; no resumable frame + address
01:00F0AC4E 23C00000F83C    	   654:                 move.l  d0,MON_SPC
01:00F0AC54 600A            	   655:                 bra.b   .resume
                            	   656: .noaddr:
01:00F0AC56 4A390000F894    	   657:                 tst.b   MON_GRP0                ; no address: need a real frame
01:00F0AC5C 66000088        	   658:                 bne.w   .no_frame
                            	   659:                 ; falls through to .resume -- an explicit `bra.b .resume` here
                            	   660:                 ; assembles to a NOP (vasm warning 2058) and reads as control
                            	   661:                 ; flow that does not exist.
                            	   662: .resume:
01:00F0AC60 41FA1B6F        	   663:                 lea     resume_msg(pc),a0
01:00F0AC64 6100089E        	   664:                 bsr.w   puts
01:00F0AC68 20390000F83C    	   665:                 move.l  MON_SPC,d0
01:00F0AC6E 610008E4        	   666:                 bsr.w   puthex_long
01:00F0AC72 6100089C        	   667:                 bsr.w   put_crlf
                            	   668:                 ; rebuild stack frame and RTE
01:00F0AC76 08B900070000F840	   669:                 bclr.b  #SR_TRACE_BIT-8,MON_SSR ; stop tracing on a plain g
01:00F0AC7E 2F790000F83C0002	   670:                 move.l  MON_SPC,2(sp)
01:00F0AC86 3EB90000F840    	   671:                 move.w  MON_SSR,(sp)
01:00F0AC8C 4CF97FFF0000F800	   672:                 movem.l MON_REGS,d0-d7/a0-a6
01:00F0AC94 4E73            	   673:                 rte
                            	   674: .fresh:
                            	   675:                 ; Two ways in, and they differ on the stack.  MON_GRP0 = $FF is
                            	   676:                 ; cold entry: no frame exists.  MON_GRP0 = 1 means a 7-word
                            	   677:                 ; group-0 frame IS sitting at (sp) -- grp0_entry saves the
                            	   678:                 ; registers to MON_REGS, not the stack, so the frame is the
                            	   679:                 ; whole 14 bytes -- and we are about to abandon it.  Pop it, or
                            	   680:                 ; every bus-error-then-`g ADDR` cycle leaks 14 bytes: about 60
                            	   681:                 ; of those and the cold-entry stack reaches the tap ring at
                            	   682:                 ; $0FB7F, which CORRUPTS CAPTURES rather than crashing, so it
                            	   683:                 ; would present as bad data and be blamed on the tap.
                            	   684:                 ; Nothing is lost -- MON_SPC, MON_SSR, MON_FADDR and MON_SSW
                            	   685:                 ; already hold everything the frame carried.  MON_GRP0 -> $FF
                            	   686:                 ; afterwards so a second `g` cannot pop a frame that has gone.
01:00F0AC96 0C3900010000F894	   687:                 cmpi.b  #1,MON_GRP0
01:00F0AC9E 660C            	   688:                 bne.b   .nopop
01:00F0ACA0 4FEF000E        	   689:                 lea     14(sp),sp
01:00F0ACA4 13FC00FF0000F894	   690:                 move.b  #$FF,MON_GRP0
                            	   691: .nopop:
                            	   692:                 ; Build a frame.  RTE pops SR then PC, so push PC first and SR
                            	   693:                 ; on top.  IPL stays 7 and the T bit stays clear; every vector
                            	   694:                 ; already points at the monitor, so a fault in the target lands
                            	   695:                 ; back here.
01:00F0ACAC 23C00000F83C    	   696:                 move.l  d0,MON_SPC
01:00F0ACB2 41FA1B1D        	   697:                 lea     resume_msg(pc),a0
01:00F0ACB6 6100084C        	   698:                 bsr.w   puts
01:00F0ACBA 20390000F83C    	   699:                 move.l  MON_SPC,d0
01:00F0ACC0 61000892        	   700:                 bsr.w   puthex_long
01:00F0ACC4 6100084A        	   701:                 bsr.w   put_crlf
01:00F0ACC8 33FC27000000F840	   702:                 move.w  #$2700,MON_SSR
01:00F0ACD0 2F390000F83C    	   703:                 move.l  MON_SPC,-(sp)           ; PC
01:00F0ACD6 3F390000F840    	   704:                 move.w  MON_SSR,-(sp)           ; SR
01:00F0ACDC 4CF97FFF0000F800	   705:                 movem.l MON_REGS,d0-d7/a0-a6
01:00F0ACE4 4E73            	   706:                 rte
                            	   707: .no_frame:
01:00F0ACE6 41FA1AB0        	   708:                 lea     nogo_msg(pc),a0
01:00F0ACEA 61000818        	   709:                 bsr.w   puts
01:00F0ACEE 6000FC80        	   710:                 bra.w   cmd_loop
                            	   711: 
                            	   712: ;================================================================
                            	   713: ; Breakpoints:  b            list slots
                            	   714: ;               b ADDR       set a breakpoint
                            	   715: ;               b -ADDR      clear one
                            	   716: ;               b -          clear all
                            	   717: ;
                            	   718: ; A breakpoint replaces the word at ADDR with TRAP #14 ($4E4E) and keeps
                            	   719: ; the original in the slot table.  Vector 46 ($B8) is pointed at
                            	   720: ; monitor_entry when the first breakpoint is armed — cold_init already
                            	   721: ; filled every vector, but on the --panic path the firmware owns the
                            	   722: ; table, so arming has to install it explicitly.  That is the only write
                            	   723: ; this command makes outside the target word and the slot table.
                            	   724: ;
                            	   725: ; TRAP pushes the 4-word frame, so MON_SPC/MON_SSR read correctly and
                            	   726: ; MON_GRP0 stays 0, which keeps `g` usable.  Note the pushed PC points
                            	   727: ; *after* the trap word: `g` therefore resumes past the breakpoint, and
                            	   728: ; the original instruction is NOT re-executed.  Clear the breakpoint and
                            	   729: ; `g ADDR` if you need to run it.
                            	   730: ;================================================================
                            	   731: cmd_bp:
01:00F0ACF2 528E            	   732:                 addq.l  #1,a6
01:00F0ACF4 61000546        	   733:                 bsr.w   skip_ws
01:00F0ACF8 1016            	   734:                 move.b  (a6),d0
01:00F0ACFA 67000140        	   735:                 beq.w   bp_list                 ; bare "b" -> list
01:00F0ACFE 0C00002D        	   736:                 cmpi.b  #'-',d0
01:00F0AD02 6712            	   737:                 beq.b   .clear
01:00F0AD04 6100054A        	   738:                 bsr.w   parse_hex
01:00F0AD08 4A01            	   739:                 tst.b   d1
01:00F0AD0A 6700FE94        	   740:                 beq.w   cmd_err
01:00F0AD0E 61000032        	   741:                 bsr.w   bp_set
01:00F0AD12 6000FC5C        	   742:                 bra.w   cmd_loop
                            	   743: .clear:
01:00F0AD16 528E            	   744:                 addq.l  #1,a6                   ; skip '-'
01:00F0AD18 61000522        	   745:                 bsr.w   skip_ws
01:00F0AD1C 1016            	   746:                 move.b  (a6),d0
01:00F0AD1E 6712            	   747:                 beq.b   .clr_all
01:00F0AD20 6100052E        	   748:                 bsr.w   parse_hex
01:00F0AD24 4A01            	   749:                 tst.b   d1
01:00F0AD26 6700FE78        	   750:                 beq.w   cmd_err
01:00F0AD2A 610000A6        	   751:                 bsr.w   bp_clr_one
01:00F0AD2E 6000FC40        	   752:                 bra.w   cmd_loop
                            	   753: .clr_all:
01:00F0AD32 610000E0        	   754:                 bsr.w   bp_clr_all
01:00F0AD36 41FA1991        	   755:                 lea     ok_msg(pc),a0
01:00F0AD3A 610007C8        	   756:                 bsr.w   puts
01:00F0AD3E 6000FC30        	   757:                 bra.w   cmd_loop
                            	   758: 
                            	   759: ; ---- bp_set: arm a breakpoint at d0 ----
                            	   760: bp_set:
01:00F0AD42 48E7F0C0        	   761:                 movem.l d0-d3/a0-a1,-(sp)
01:00F0AD46 2600            	   762:                 move.l  d0,d3                   ; target address
01:00F0AD48 6700007A        	   763:                 beq.w   .odd                    ; 0 is not a target
01:00F0AD4C 08030000        	   764:                 btst.l  #0,d3
01:00F0AD50 66000072        	   765:                 bne.w   .odd                    ; must be word-aligned
                            	   766:                 ; Target must be on-board RAM.  A breakpoint writes $4E4E to
                            	   767:                 ; the address: in ROM that is silently lost, but in
                            	   768:                 ; peripheral space it would poke the AP I/F or XLTR, and
                            	   769:                 ; $F70011 would transmit a byte over the SIO.
                            	   770:                 ; Use the audited bounds routine rather than a second copy of
                            	   771:                 ; the rule.  The two cmpi.l that used to be here covered the
                            	   772:                 ; vector table and the top of RAM but NOT the monitor's own
                            	   773:                 ; workspace, so `b F900` patched $4E4E into the TAP RING and
                            	   774:                 ; `b FE00` into the monitor's own STACK -- where the next deep
                            	   775:                 ; call overwrites the trap word, and clearing the breakpoint
                            	   776:                 ; afterwards writes the saved word back over live stack.
                            	   777:                 ; srec_check reads d3 as the start and d2 as the byte count,
                            	   778:                 ; preserves d0/d3, and clobbers d1 only; d1 and d2 are both
                            	   779:                 ; free here because the scan below sets them afterwards.
01:00F0AD54 7402            	   780:                 moveq   #2,d2                   ; a breakpoint writes one word
01:00F0AD56 61000556        	   781:                 bsr.w   srec_check
01:00F0AD5A 4A01            	   782:                 tst.b   d1
01:00F0AD5C 67000066        	   783:                 beq.w   .odd
                            	   784:                 ; find a free slot, and reject a duplicate
01:00F0AD60 41F90000F8A0    	   785:                 lea     MON_BPT,a0
01:00F0AD66 7207            	   786:                 moveq   #MON_BPN-1,d1
01:00F0AD68 93C9            	   787:                 suba.l  a1,a1                   ; a1 = first free slot, or 0
                            	   788: .scan:
01:00F0AD6A 2410            	   789:                 move.l  (a0),d2
01:00F0AD6C 6708            	   790:                 beq.b   .isfree
01:00F0AD6E B483            	   791:                 cmp.l   d3,d2
01:00F0AD70 6700003E        	   792:                 beq.w   .dup
01:00F0AD74 6006            	   793:                 bra.b   .next
                            	   794: .isfree:
01:00F0AD76 2409            	   795:                 move.l  a1,d2
01:00F0AD78 6602            	   796:                 bne.b   .next                   ; already have a free slot
01:00F0AD7A 2248            	   797:                 move.l  a0,a1
                            	   798: .next:
01:00F0AD7C 5C88            	   799:                 lea     MON_BP_SZ(a0),a0
01:00F0AD7E 51C9FFEA        	   800:                 dbra    d1,.scan
01:00F0AD82 2409            	   801:                 move.l  a1,d2
01:00F0AD84 67000034        	   802:                 beq.w   .full
                            	   803:                 ; point the TRAP #14 vector at the monitor, then patch
01:00F0AD88 21FC00F0A84000B8	   804:                 move.l  #monitor_entry,BP_VECTOR
01:00F0AD90 2043            	   805:                 move.l  d3,a0
01:00F0AD92 33500004        	   806:                 move.w  (a0),4(a1)              ; save original word
01:00F0AD96 30BC4E4E        	   807:                 move.w  #BP_OPCODE,(a0)
01:00F0AD9A 2283            	   808:                 move.l  d3,(a1)                 ; mark slot in use
01:00F0AD9C 41FA1937        	   809:                 lea     bp_set_msg(pc),a0
01:00F0ADA0 61000762        	   810:                 bsr.w   puts
01:00F0ADA4 2003            	   811:                 move.l  d3,d0
01:00F0ADA6 610007AC        	   812:                 bsr.w   puthex_long
01:00F0ADAA 61000764        	   813:                 bsr.w   put_crlf
01:00F0ADAE 601C            	   814:                 bra.b   .out
                            	   815: .dup:
01:00F0ADB0 41FA192D        	   816:                 lea     bp_dup_msg(pc),a0
01:00F0ADB4 6100074E        	   817:                 bsr.w   puts
01:00F0ADB8 6012            	   818:                 bra.b   .out
                            	   819: .full:
01:00F0ADBA 41FA1932        	   820:                 lea     bp_full_msg(pc),a0
01:00F0ADBE 61000744        	   821:                 bsr.w   puts
01:00F0ADC2 6008            	   822:                 bra.b   .out
                            	   823: .odd:
01:00F0ADC4 41FA1939        	   824:                 lea     bp_odd_msg(pc),a0
01:00F0ADC8 6100073A        	   825:                 bsr.w   puts
                            	   826: .out:
01:00F0ADCC 4CDF030F        	   827:                 movem.l (sp)+,d0-d3/a0-a1
01:00F0ADD0 4E75            	   828:                 rts
