01:00F0B04C 6D3C            	   984:                 blt.b   .end
01:00F0B04E 0C020039        	   985:                 cmpi.b  #'9',d2
01:00F0B052 6F24            	   986:                 ble.b   .dig
01:00F0B054 0C020041        	   987:                 cmpi.b  #'A',d2
01:00F0B058 6D30            	   988:                 blt.b   .end
01:00F0B05A 0C020046        	   989:                 cmpi.b  #'F',d2
01:00F0B05E 6F12            	   990:                 ble.b   .upper
01:00F0B060 0C020061        	   991:                 cmpi.b  #'a',d2
01:00F0B064 6D24            	   992:                 blt.b   .end
01:00F0B066 0C020066        	   993:                 cmpi.b  #'f',d2
01:00F0B06A 6E1E            	   994:                 bgt.b   .end
01:00F0B06C 04020057        	   995:                 subi.b  #'a'-10,d2
01:00F0B070 600A            	   996:                 bra.b   .acc
                            	   997: .upper:
01:00F0B072 04020037        	   998:                 subi.b  #'A'-10,d2
01:00F0B076 6004            	   999:                 bra.b   .acc
                            	  1000: .dig:
01:00F0B078 04020030        	  1001:                 subi.b  #'0',d2
                            	  1002: .acc:
01:00F0B07C E988            	  1003:                 lsl.l   #4,d0
01:00F0B07E 0202000F        	  1004:                 andi.b  #$0F,d2
01:00F0B082 8002            	  1005:                 or.b    d2,d0
01:00F0B084 528E            	  1006:                 addq.l  #1,a6
01:00F0B086 5203            	  1007:                 addq.b  #1,d3
01:00F0B088 60BC            	  1008:                 bra.b   .lp
                            	  1009: .end:
01:00F0B08A 4A03            	  1010:                 tst.b   d3
01:00F0B08C 6704            	  1011:                 beq.b   .err
01:00F0B08E 7201            	  1012:                 moveq   #1,d1
01:00F0B090 4E75            	  1013:                 rts
                            	  1014: .err:
01:00F0B092 4201            	  1015:                 clr.b   d1
01:00F0B094 4E75            	  1016:                 rts
                            	  1017: 
                            	  1018: ;================================================================
                            	  1019: ; srec_check — is it safe to write d2 bytes starting at d3?
                            	  1020: ;   returns d1 = 1 safe, 0 = refuse.  Preserves d0/d2/d3.
                            	  1021: ;
                            	  1022: ; A load is refused unless its whole range lies in on-board RAM and
                            	  1023: ; clear of the two regions the monitor itself needs:
                            	  1024: ;
                            	  1025: ;   $000000-$0003FF  the exception vector table
                            	  1026: ;   $00F800-$00FEFF  MON_* workspace, breakpoint table, and the
                            	  1027: ;                    cold-entry supervisor stack below $0FF00
                            	  1028: ;
                            	  1029: ; Anything at or above $20000 is refused outright.  That range is ROM
                            	  1030: ; and peripherals, and a stray S2/S3 record pointed there would not
                            	  1031: ; merely be ignored: a write to $F70011 would transmit a byte over the
                            	  1032: ; SIO, and writes to the XLTR or AP I/F blocks would poke the chassis.
                            	  1033: ; Deliberate peripheral pokes are what the `w` command is for.
                            	  1034: ;
                            	  1035: ; The workspace used to live at $1F000, inside the WCS staging buffer,
                            	  1036: ; which forced the top 4 KB of the buffer to be refused.  It now sits at
                            	  1037: ; $0F800, below the buffer, so $10000-$1FFFF is loadable end to end.
                            	  1038: ;================================================================
                            	  1039: srec_check:
01:00F0B096 48E79000        	  1040:                 movem.l d0/d3,-(sp)
01:00F0B09A 7200            	  1041:                 moveq   #0,d1
01:00F0B09C 0C8300000400    	  1042:                 cmpi.l  #$400,d3
01:00F0B0A2 6528            	  1043:                 bcs.b   .out                    ; below vector-table top
01:00F0B0A4 0C8300020000    	  1044:                 cmpi.l  #$20000,d3
01:00F0B0AA 6420            	  1045:                 bcc.b   .out                    ; beyond on-board RAM
01:00F0B0AC 2003            	  1046:                 move.l  d3,d0
01:00F0B0AE D082            	  1047:                 add.l   d2,d0
01:00F0B0B0 5380            	  1048:                 subq.l  #1,d0                   ; last byte to be written
01:00F0B0B2 0C8000020000    	  1049:                 cmpi.l  #$20000,d0
01:00F0B0B8 6412            	  1050:                 bcc.b   .out                    ; would run off the end of RAM
01:00F0B0BA 0C830000FF00    	  1051:                 cmpi.l  #MON_HI,d3
01:00F0B0C0 6408            	  1052:                 bcc.b   .ok                     ; starts above our region
01:00F0B0C2 0C800000F800    	  1053:                 cmpi.l  #MON_LO,d0
01:00F0B0C8 6402            	  1054:                 bcc.b   .out                    ; reaches workspace/stack
                            	  1055: .ok:
01:00F0B0CA 7201            	  1056:                 moveq   #1,d1
                            	  1057: .out:
01:00F0B0CC 4CDF0009        	  1058:                 movem.l (sp)+,d0/d3
01:00F0B0D0 4E75            	  1059:                 rts
                            	  1060: 
                            	  1061: ; ---- read_hex_byte: read 2 hex chars from SIO, return byte in d0 ----
                            	  1062: read_hex_byte:
01:00F0B0D2 2F02            	  1063:                 move.l  d2,-(sp)                ; preserve d2 (caller may use it)
01:00F0B0D4 61000010        	  1064:                 bsr.w   read_hex_nibble
01:00F0B0D8 E908            	  1065:                 lsl.b   #4,d0
01:00F0B0DA 1400            	  1066:                 move.b  d0,d2
01:00F0B0DC 61000008        	  1067:                 bsr.w   read_hex_nibble
01:00F0B0E0 8002            	  1068:                 or.b    d2,d0
01:00F0B0E2 241F            	  1069:                 move.l  (sp)+,d2
01:00F0B0E4 4E75            	  1070:                 rts
                            	  1071: 
                            	  1072: read_hex_nibble:
01:00F0B0E6 61000110        	  1073:                 bsr.w   getchar
01:00F0B0EA 0C000039        	  1074:                 cmpi.b  #'9',d0
01:00F0B0EE 6E06            	  1075:                 bgt.b   .alpha
01:00F0B0F0 04000030        	  1076:                 subi.b  #'0',d0
01:00F0B0F4 4E75            	  1077:                 rts
                            	  1078: .alpha:
01:00F0B0F6 0C000046        	  1079:                 cmpi.b  #'F',d0
01:00F0B0FA 6E06            	  1080:                 bgt.b   .lower
01:00F0B0FC 04000037        	  1081:                 subi.b  #'A'-10,d0
01:00F0B100 4E75            	  1082:                 rts
                            	  1083: .lower:
01:00F0B102 04000057        	  1084:                 subi.b  #'a'-10,d0
01:00F0B106 4E75            	  1085:                 rts
                            	  1086: 
                            	  1087: ;================================================================
                            	  1088: ; cold_init — called from monitor_cold ONLY (never from monitor_entry).
                            	  1089: ;
                            	  1090: ; The MC68000 has no VBR: the exception vector table is hard-wired at
                            	  1091: ; $000000-$0003FF, which on this board is plain DRAM.  The reset SSP/PC
                            	  1092: ; are the only vectors that come from ROM — the M68KVM02 maps just the
                            	  1093: ; first 8 bytes of ROM to address 0 for the first four bus cycles after
                            	  1094: ; a total system reset, then address 0 is DRAM like any other.  So at
                            	  1095: ; power-on every vector except reset is whatever the DRAM happens to
                            	  1096: ; hold, i.e. garbage.
                            	  1097: ;
                            	  1098: ; The stock firmware handles this on its 2nd and 3rd instructions —
                            	  1099: ; MainInit at F08700 does `lea $1ffd0,a7` then immediately installs
                            	  1100: ; $8 and $C (F08706 / F0870E) before touching any I/O.  But when
                            	  1101: ; patch_rom.py --reset points the reset PC at monitor_cold, MainInit
                            	  1102: ; never executes, so nothing fills the table and the monitor inherits
                            	  1103: ; garbage.  Any bus or address error then fetches a junk handler
                            	  1104: ; address, faults again, and the 68000 asserts HALT (double bus fault)
                            	  1105: ; with no diagnostic at all.  That is what a bad SIO address did on
                            	  1106: ; real hardware: FAIL + HALTED, silently.
                            	  1107: ;
                            	  1108: ; Point every vector at monitor_entry so the next fault reports itself
                            	  1109: ; instead of killing the CPU.  Writing all 1 KB also leaves valid DRAM
                            	  1110: ; parity across the table, which matters if the board's parity strap is
                            	  1111: ; enabled (a read of never-written DRAM can raise BERR).
                            	  1112: ;
                            	  1113: ; This deliberately does NOT run on the panic path: with --panic only,
                            	  1114: ; the firmware booted normally and its live vectors are already in
                            	  1115: ; place, and `g` needs them intact to resume.
                            	  1116: ;================================================================
                            	  1117: cold_init:
01:00F0B108 91C8            	  1118:                 suba.l  a0,a0                   ; a0 = $000000
01:00F0B10A 203C00F0A840    	  1119:                 move.l  #monitor_entry,d0
01:00F0B110 323C00FF        	  1120:                 move.w  #255,d1                 ; 256 vectors, dbra -> 256 passes
                            	  1121: .vfill:
01:00F0B114 20C0            	  1122:                 move.l  d0,(a0)+
01:00F0B116 51C9FFFC        	  1123:                 dbra    d1,.vfill
                            	  1124: 
                            	  1125:                 ; Vectors 2 and 3 push the 7-word group-0 frame, which
                            	  1126:                 ; monitor_entry would misread — give them their own stub.
01:00F0B11A 21FC00F0A8740008	  1127:                 move.l  #grp0_entry,$8          ; bus error
01:00F0B122 21FC00F0A874000C	  1128:                 move.l  #grp0_entry,$C          ; address error
                            	  1129: 
                            	  1130:                 ; Pre-write the whole workspace.  Two reasons: it leaves
                            	  1131:                 ; valid DRAM parity on every byte the monitor later reads
                            	  1132:                 ; back (MON_NEST and MON_LASTADDR are both read before
                            	  1133:                 ; being written otherwise), and it puts the guard in a
                            	  1134:                 ; known state.  move.l/move.b, never clr: a real MC68000
                            	  1135:                 ; READS the destination before writing it on CLR, so clr
                            	  1136:                 ; on never-written DRAM is a parity-BERR risk.  (Musashi
                            	  1137:                 ; models CLR as a pure write, so the emulator never shows
                            	  1138:                 ; this — see m68k_in.c, M68KMAKE_OP(clr, 32, ., .).)
                            	  1139:                 ; MON_REGS itself must be written too, not just the
                            	  1140:                 ; scalars below it: cmd_regs READS all 60 bytes, and on a
                            	  1141:                 ; cold boot nothing has written them yet.  On a board with
                            	  1142:                 ; the DRAM parity strap enabled, reading never-written
                            	  1143:                 ; memory raises BERR, so `r` before any fault would have
                            	  1144:                 ; been a parity trap rather than a register dump.  The
                            	  1145:                 ; emulator cannot show this — its RAM is zero-filled and
                            	  1146:                 ; it models no parity.
01:00F0B12A 41F90000F800    	  1147:                 lea     MON_REGS,a0
01:00F0B130 720E            	  1148:                 moveq   #14,d1                  ; 15 longs, dbra -> 15 passes
                            	  1149: .rclr:
01:00F0B132 20FC00000000    	  1150:                 move.l  #0,(a0)+
01:00F0B138 51C9FFF8        	  1151:                 dbra    d1,.rclr
                            	  1152: 
01:00F0B13C 23FC000000000000	  1153:                 move.l  #0,MON_SPC
01:00F0B144 F83C
01:00F0B146 33FC27000000F840	  1154:                 move.w  #$2700,MON_SSR
01:00F0B14E 23FC000000000000	  1155:                 move.l  #0,MON_LASTADDR
01:00F0B156 F890
01:00F0B158 13FC00FF0000F894	  1156:                 move.b  #$FF,MON_GRP0           ; cold entry: no frame
01:00F0B160 13FC00000000F895	  1157:                 move.b  #0,MON_NEST             ; first fault is reportable
01:00F0B168 13FC00000000F896	  1158:                 move.b  #0,MON_TXFAIL
                            	  1159:                 ; clear the breakpoint slot table (addr 0 = free)
01:00F0B170 41F90000F8A0    	  1160:                 lea     MON_BPT,a0
01:00F0B176 7207            	  1161:                 moveq   #MON_BPN-1,d1
                            	  1162: .bpclr:
01:00F0B178 20BC00000000    	  1163:                 move.l  #0,(a0)
01:00F0B17E 317C00000004    	  1164:                 move.w  #0,4(a0)
01:00F0B184 5C88            	  1165:                 lea     MON_BP_SZ(a0),a0
01:00F0B186 51C9FFF0        	  1166:                 dbra    d1,.bpclr
01:00F0B18A 4E75            	  1167:                 rts
                            	  1168: 
                            	  1169: ; ---- SIO init for 9600 8N1, RX+TX enabled, no IRQs ----
                            	  1170: sio_init:
                            	  1171:                 ; Channel reset
01:00F0B18C 13FC001800F70015	  1172:                 move.b  #$18,SIO_A_CTRL         ; WR0: cmd 3 = chan reset
01:00F0B194 4E71            	  1173:                 nop
01:00F0B196 4E71            	  1174:                 nop
01:00F0B198 4E71            	  1175:                 nop
01:00F0B19A 4E71            	  1176:                 nop
                            	  1177:                 ; WR4: x16 clk, 1 stop, no parity
01:00F0B19C 13FC000400F70015	  1178:                 move.b  #$04,SIO_A_CTRL         ; WR0: ptr to WR4
01:00F0B1A4 13FC004400F70015	  1179:                 move.b  #$44,SIO_A_CTRL
                            	  1180:                 ; WR3: 8 bits/RX char, RX enable
01:00F0B1AC 13FC000300F70015	  1181:                 move.b  #$03,SIO_A_CTRL         ; WR0: ptr to WR3
01:00F0B1B4 13FC00C100F70015	  1182:                 move.b  #$C1,SIO_A_CTRL
                            	  1183:                 ; WR5: 8 bits/TX char, TX enable, DTR, RTS
01:00F0B1BC 13FC000500F70015	  1184:                 move.b  #$05,SIO_A_CTRL         ; WR0: ptr to WR5
01:00F0B1C4 13FC00EA00F70015	  1185:                 move.b  #$EA,SIO_A_CTRL
01:00F0B1CC 4E75            	  1186:                 rts
                            	  1187: 
                            	  1188: ; ---- putchar: send byte in d0 over SIO chA.  Bounded: drops the
                            	  1189: ;      character and sets MON_TXFAIL rather than hanging forever, so a
                            	  1190: ;      dead or mis-strapped SIO still lets the monitor make progress and
                            	  1191: ;      leaves evidence in RAM.  Preserves d0 and d1.
                            	  1192: putchar:
01:00F0B1CE 2F01            	  1193:                 move.l  d1,-(sp)
01:00F0B1D0 72104841        	  1194:                 move.l  #TX_SPIN_LIMIT,d1
                            	  1195: .wait:
01:00F0B1D4 0839000200F70015	  1196:                 btst.b  #RR0_TX_EMPTY,SIO_A_CTRL
01:00F0B1DC 6610            	  1197:                 bne.b   .ready
01:00F0B1DE 5381            	  1198:                 subq.l  #1,d1
01:00F0B1E0 66F2            	  1199:                 bne.b   .wait
                            	  1200:                 ; Timed out.  move.b, not an increment: a read-modify-write
                            	  1201:                 ; on never-written DRAM is a parity-BERR risk on real
                            	  1202:                 ; hardware, and this path runs when things are already bad.
01:00F0B1E2 13FC00010000F896	  1203:                 move.b  #1,MON_TXFAIL
01:00F0B1EA 221F            	  1204:                 move.l  (sp)+,d1
01:00F0B1EC 4E75            	  1205:                 rts
                            	  1206: .ready:
01:00F0B1EE 13C000F70011    	  1207:                 move.b  d0,SIO_A_DATA
01:00F0B1F4 221F            	  1208:                 move.l  (sp)+,d1
01:00F0B1F6 4E75            	  1209:                 rts
                            	  1210: 
                            	  1211: ; ---- getchar: receive byte from SIO chA into d0 ----
                            	  1212: ;      Deliberately unbounded: waiting indefinitely for a human to type
                            	  1213: ;      is correct behaviour for a monitor prompt, and a timeout here
                            	  1214: ;      would just spin the prompt.  The dangerous spin was putchar,
                            	  1215: ;      which blocks *before* any output exists; that one is bounded
                            	  1216: ;      above.  If a board goes quiet, MON_TXFAIL distinguishes "TX
                            	  1217: ;      never became ready" from "nobody typed anything".
                            	  1218: getchar:
01:00F0B1F8 0839000000F70015	  1219:                 btst.b  #RR0_RX_AVAIL,SIO_A_CTRL
01:00F0B200 67F6            	  1220:                 beq.b   getchar
01:00F0B202 103900F70011    	  1221:                 move.b  SIO_A_DATA,d0
01:00F0B208 4E75            	  1222:                 rts
                            	  1223: 
                            	  1224: ; ---- puts: print null-terminated string at (a0) ----
                            	  1225: puts:
01:00F0B20A 1018            	  1226:                 move.b  (a0)+,d0
01:00F0B20C 6706            	  1227:                 beq.b   .end
01:00F0B20E 6100FFBE        	  1228:                 bsr.w   putchar
01:00F0B212 60F6            	  1229:                 bra.b   puts
                            	  1230: .end:
01:00F0B214 4E75            	  1231:                 rts
                            	  1232: 
                            	  1233: put_crlf:
01:00F0B216 103C000D        	  1234:                 move.b  #13,d0
01:00F0B21A 6100FFB2        	  1235:                 bsr.w   putchar
01:00F0B21E 103C000A        	  1236:                 move.b  #10,d0
01:00F0B222 6000FFAA        	  1237:                 bra.w   putchar
                            	  1238: 
                            	  1239: puthex_nibble:
01:00F0B226 0200000F        	  1240:                 andi.b  #$0F,d0
01:00F0B22A 0C00000A        	  1241:                 cmpi.b  #10,d0
01:00F0B22E 6D08            	  1242:                 blt.b   .num
01:00F0B230 06000037        	  1243:                 addi.b  #'A'-10,d0
01:00F0B234 6000FF98        	  1244:                 bra.w   putchar
                            	  1245: .num:
01:00F0B238 06000030        	  1246:                 addi.b  #'0',d0
01:00F0B23C 6000FF90        	  1247:                 bra.w   putchar
                            	  1248: 
                            	  1249: puthex_byte:
01:00F0B240 2F00            	  1250:                 move.l  d0,-(sp)
01:00F0B242 E808            	  1251:                 lsr.b   #4,d0
01:00F0B244 6100FFE0        	  1252:                 bsr.w   puthex_nibble
01:00F0B248 201F            	  1253:                 move.l  (sp)+,d0
01:00F0B24A 6000FFDA        	  1254:                 bra.w   puthex_nibble
                            	  1255: 
                            	  1256: puthex_word:
01:00F0B24E E158            	  1257:                 rol.w   #8,d0
01:00F0B250 6100FFEE        	  1258:                 bsr.w   puthex_byte
01:00F0B254 E158            	  1259:                 rol.w   #8,d0
01:00F0B256 6000FFE8        	  1260:                 bra.w   puthex_byte
                            	  1261: 
                            	  1262: puthex_long:
01:00F0B25A 4840            	  1263:                 swap    d0
01:00F0B25C 6100FFF0        	  1264:                 bsr.w   puthex_word
01:00F0B260 4840            	  1265:                 swap    d0
01:00F0B262 6000FFEA        	  1266:                 bra.w   puthex_word
                            	  1267: 
