01:00F0B6A8 397C00000008    	  2064:                 move.w  #0,8(a4)                ; +$08 data high
01:00F0B6AE 3946000A        	  2065:                 move.w  d6,$A(a4)               ; +$0A operation code
01:00F0B6B2 397C8004000E    	  2066:                 move.w  #$8004,$E(a4)           ; +$0E REQUEST-TRANSFER
01:00F0B6B8 610000B4        	  2067:                 bsr.w   ac_poll                 ; d2 = poll count
