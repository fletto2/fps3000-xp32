                            	   464: ;----------------------------------------------------------------
                            	   465: ; Memory display (default 16 bytes from last addr or parsed addr)
                            	   466: ;   m            -> dump 16 bytes from MON_LASTADDR
                            	   467: ;   m XXXXXX     -> set MON_LASTADDR, dump 16 bytes
                            	   468: ;   m XXXXXX YY  -> dump YY bytes (hex count)
                            	   469: ;----------------------------------------------------------------
                            	   470: cmd_mem:
                            	   471:                 ; d7 = access width: 1 byte (default), 2 word, 4 long.
                            	   472:                 ; The byte form is kept because the MC6840 PTM and the SIO
                            	   473:                 ; are odd-byte-only on D0-D7 and must be reached with
                            	   474:                 ; move.b; the wide forms exist because the AP I/F and XLTR
                            	   475:                 ; are 16-bit-only blocks that move.b cannot drive at all.
01:00F0AAF4 7E01            	   476:                 moveq   #1,d7
01:00F0AAF6 528E            	   477:                 addq.l  #1,a6
01:00F0AAF8 1016            	   478:                 move.b  (a6),d0
01:00F0AAFA 0C000077        	   479:                 cmpi.b  #'w',d0
01:00F0AAFE 6708            	   480:                 beq.b   .w16
01:00F0AB00 0C00006C        	   481:                 cmpi.b  #'l',d0
01:00F0AB04 6708            	   482:                 beq.b   .w32
01:00F0AB06 600A            	   483:                 bra.b   .havew
                            	   484: .w16:
01:00F0AB08 7E02            	   485:                 moveq   #2,d7
01:00F0AB0A 528E            	   486:                 addq.l  #1,a6
01:00F0AB0C 6004            	   487:                 bra.b   .havew
                            	   488: .w32:
01:00F0AB0E 7E04            	   489:                 moveq   #4,d7
01:00F0AB10 528E            	   490:                 addq.l  #1,a6
                            	   491: .havew:
01:00F0AB12 61000728        	   492:                 bsr.w   skip_ws
01:00F0AB16 1016            	   493:                 move.b  (a6),d0
01:00F0AB18 671A            	   494:                 beq.b   .use_last
01:00F0AB1A 61000734        	   495:                 bsr.w   parse_hex
01:00F0AB1E 4A01            	   496:                 tst.b   d1
01:00F0AB20 6700007E        	   497:                 beq.w   cmd_err
01:00F0AB24 61000A8C        	   498:                 bsr.w   odd_check
01:00F0AB28 4A01            	   499:                 tst.b   d1
01:00F0AB2A 6700FE44        	   500:                 beq.w   cmd_loop
01:00F0AB2E 23C00000F890    	   501:                 move.l  d0,MON_LASTADDR
                            	   502: .use_last:
01:00F0AB34 61000706        	   503:                 bsr.w   skip_ws
01:00F0AB38 7410            	   504:                 moveq   #16,d2                  ; default: 16 bytes
01:00F0AB3A 0C070002        	   505:                 cmpi.b  #2,d7
01:00F0AB3E 6602            	   506:                 bne.b   .d1
01:00F0AB40 7408            	   507:                 moveq   #8,d2                   ;          8 words
                            	   508: .d1:
01:00F0AB42 0C070004        	   509:                 cmpi.b  #4,d7
01:00F0AB46 6602            	   510:                 bne.b   .d2
01:00F0AB48 7404            	   511:                 moveq   #4,d2                   ;          4 longs
                            	   512: .d2:
01:00F0AB4A 1016            	   513:                 move.b  (a6),d0
01:00F0AB4C 670C            	   514:                 beq.b   .cap
01:00F0AB4E 61000700        	   515:                 bsr.w   parse_hex
01:00F0AB52 4A01            	   516:                 tst.b   d1
01:00F0AB54 6700004A        	   517:                 beq.w   cmd_err
01:00F0AB58 2400            	   518:                 move.l  d0,d2
                            	   519: .cap:
                            	   520:                 ; one line's worth per line, one screen's worth per command
01:00F0AB5A 7640            	   521:                 moveq   #64,d3                  ; words
01:00F0AB5C 0C070002        	   522:                 cmpi.b  #2,d7
01:00F0AB60 670C            	   523:                 beq.b   .havecap
01:00F0AB62 7620            	   524:                 moveq   #32,d3                  ; longs
01:00F0AB64 0C070004        	   525:                 cmpi.b  #4,d7
01:00F0AB68 6704            	   526:                 beq.b   .havecap
01:00F0AB6A 767F            	   527:                 moveq   #127,d3
01:00F0AB6C 5283            	   528:                 addq.l  #1,d3                   ; 128 bytes
                            	   529: .havecap:
01:00F0AB6E B483            	   530:                 cmp.l   d3,d2
01:00F0AB70 6302            	   531:                 bls.b   .do                     ; UNSIGNED.  Third site of one
                            	   532:                                                 ;   bug (also cmd_bulk, cmd_page):
                            	   533:                                                 ;   a signed `ble` reads
                            	   534:                                                 ;   $FFFFFFFF as -1 and skips the
                            	   535:                                                 ;   clamp, and `m 1000 FFFFFFFF`
                            	   536:                                                 ;   then prints 268M lines at
                            	   537:                                                 ;   9600 baud -- unrecoverable
                            	   538:                                                 ;   without a reset.
01:00F0AB72 2403            	   539:                 move.l  d3,d2
                            	   540: .do:
01:00F0AB74 28790000F890    	   541:                 move.l  MON_LASTADDR,a4
01:00F0AB7A 0C070001        	   542:                 cmpi.b  #1,d7
01:00F0AB7E 660E            	   543:                 bne.b   .wide
01:00F0AB80 6100057C        	   544:                 bsr.w   hexdump
01:00F0AB84 D5B90000F890    	   545:                 add.l   d2,MON_LASTADDR
01:00F0AB8A 6000FDE4        	   546:                 bra.w   cmd_loop
                            	   547: .wide:
01:00F0AB8E 610009D0        	   548:                 bsr.w   xdump
01:00F0AB92 2002            	   549:                 move.l  d2,d0
01:00F0AB94 C0C7            	   550:                 mulu.w  d7,d0
01:00F0AB96 D1B90000F890    	   551:                 add.l   d0,MON_LASTADDR
01:00F0AB9C 6000FDD2        	   552:                 bra.w   cmd_loop
