                            	  2107: .ack:
                            	  2108:                 ; --- the acknowledge, $8000 ---
                            	  2109:                 ; The firmware's sub-mode acknowledge is $F07ECA and its two
                            	  2110:                 ; siblings: +$08 <- 0, +$0A <- $1B, +$0E <- $8000.  It is
                            	  2111:                 ; FIRE-AND-FORGET -- all three sites bra.w away immediately,
                            	  2112:                 ; with no poll and no status read -- because it is the SBC
                            	  2113:                 ; answering the AC, not asking it.  A chassis owes no response,
                            	  2114:                 ; so polling here would time out on correct hardware and
                            	  2115:                 ; report a fault that is not one.  Hence no poll.
01:00F0B706 397C00000008    	  2116:                 move.w  #0,8(a4)
01:00F0B70C 3946000A        	  2117:                 move.w  d6,$A(a4)               ; the opcode ($1B in the firmware)
01:00F0B710 397C8000000E    	  2118:                 move.w  #$8000,$E(a4)
01:00F0B716 41FA1620        	  2119:                 lea     ac_ack_msg(pc),a0
01:00F0B71A 6100FDE8        	  2120:                 bsr.w   puts
                            	  2121:                 ; One status read for the operator's benefit, which the
                            	  2122:                 ; firmware does NOT do on this path.  Safe because +$0E has no
                            	  2123:                 ; pop semantics -- the channel ISR and the `x` map both read it
                            	  2124:                 ; freely; it is $FF0008, the bulk port, whose reads pop.
01:00F0B71E 302C000E        	  2125:                 move.w  $E(a4),d0
01:00F0B722 6100FE24        	  2126:                 bsr.w   puthex_word
01:00F0B726 41FA1560        	  2127:                 lea     ac_data_msg(pc),a0
01:00F0B72A 6100FDD8        	  2128:                 bsr.w   puts
01:00F0B72E 302C0008        	  2129:                 move.w  8(a4),d0
01:00F0B732 6100FE14        	  2130:                 bsr.w   puthex_word
01:00F0B736 103C003A        	  2131:                 move.b  #':',d0
01:00F0B73A 6100FD52        	  2132:                 bsr.w   putchar
01:00F0B73E 302C000A        	  2133:                 move.w  $A(a4),d0
01:00F0B742 6100FE04        	  2134:                 bsr.w   puthex_word
01:00F0B746 6100FDC8        	  2135:                 bsr.w   put_crlf
                            	  2136: .tear:
                            	  2137:                 ; $FF021A is deliberately NOT written back.  This command never
                            	  2138:                 ; modifies it -- it is read at entry and was previously written
                            	  2139:                 ; back here, a blind word store of a value nothing had changed.
                            	  2140:                 ;
                            	  2141:                 ; That store is not merely redundant, it is the one operation no
                            	  2142:                 ; other code in the machine performs.  The firmware treats
                            	  2143:                 ; $FF021A as CLEAR-ONLY: 50 read-modify-write sites, every one a
                            	  2144:                 ; bclr, ZERO bset, and a single literal write ($FFF, in self-test
                            	  2145:                 ; phase $1600).  So a word write-back can only ever SET bits that
                            	  2146:                 ; the firmware had deliberately cleared.
                            	  2147:                 ;
                            	  2148:                 ; And there is a window for exactly that.  OUR channel's bit
                            	  2149:                 ; cannot change while we hold its BIM masked at $4F -- but the
                            	  2150:                 ; other three channels' BIMs are live at level 7, so their ISRs
                            	  2151:                 ; may legitimately bclr their own bits between our read at entry
                            	  2152:                 ; and this point.  Writing the whole word back RESURRECTS them,
                            	  2153:                 ; and the recorded consequence of a stuck $FF021A bit is a
                            	  2154:                 ; channel that never re-enables: the machine degrades one channel
                            	  2155:                 ; at a time in a way that looks like a firmware bug.
                            	  2156:                 ;
                            	  2157:                 ; The saved word is reported instead, which is the useful half:
                            	  2158:                 ; the operator can see the mask state that was in force around
                            	  2159:                 ; the transaction.
01:00F0B74A 3A83            	  2160:                 move.w  d3,(a5)                 ; restore BIM CR -- this one WAS
                            	  2161:                                                 ;   modified, to $4F, and must go
                            	  2162:                                                 ;   back or the channel stays
                            	  2163:                                                 ;   masked for good
01:00F0B74C 41FA161C        	  2164:                 lea     ac_tear_msg(pc),a0
01:00F0B750 6100FDB2        	  2165:                 bsr.w   puts
01:00F0B754 3004            	  2166:                 move.w  d4,d0
01:00F0B756 6100FDF0        	  2167:                 bsr.w   puthex_word
01:00F0B75A 6100FDB4        	  2168:                 bsr.w   put_crlf
01:00F0B75E 6000F210        	  2169:                 bra.w   cmd_loop
                            	  2170: .badch:
01:00F0B762 41FA152D        	  2171:                 lea     ac_ch_msg(pc),a0
01:00F0B766 6100FD9C        	  2172:                 bsr.w   puts
01:00F0B76A 6000F204        	  2173:                 bra.w   cmd_loop
                            	  2174: 
                            	  2175: ; ---- ac_poll: poll +$0E for DONE/ERROR, then report the phase ----
                            	  2176: ;      in : a4 = channel window
                            	  2177: ;      out: d2 = poll count.  Clobbers d0/d7.
                            	  2178: ;
                            	  2179: ;      FACTORED rather than copied.  Both phases of an AC transaction poll
                            	  2180: ;      identically -- 1000 iterations on bit 14 DONE with bit 13 ERROR, the
                            	  2181: ;      firmware's own budget -- and this monitor's recorded failure mode is
                            	  2182: ;      that a rule which grows a second copy diverges: three separate clamp
                            	  2183: ;      bugs came from exactly that, and srec_check is shared by L, f and b
                            	  2184: ;      for the same reason.
                            	  2185: ac_poll:
01:00F0B76E 7400            	  2186:                 clr.l   d2                      ; poll count
01:00F0B770 2E3C000003E8    	  2187:                 move.l  #1000,d7
                            	  2188: .poll:
01:00F0B776 302C000E        	  2189:                 move.w  $E(a4),d0
01:00F0B77A 0800000E        	  2190:                 btst    #14,d0                  ; DONE
01:00F0B77E 6620            	  2191:                 bne.b   .done
01:00F0B780 0800000D        	  2192:                 btst    #13,d0                  ; ERROR
01:00F0B784 6610            	  2193:                 bne.b   .err
01:00F0B786 5282            	  2194:                 addq.l  #1,d2
01:00F0B788 5387            	  2195:                 subq.l  #1,d7
01:00F0B78A 66EA            	  2196:                 bne.b   .poll
01:00F0B78C 41FA14C1        	  2197:                 lea     ac_to_msg(pc),a0
01:00F0B790 6100FD72        	  2198:                 bsr.w   puts
01:00F0B794 6012            	  2199:                 bra.b   .report
