                            	   983: ; ---- parse_hex: parse hex number at (a6) into d0; d1=1 ok, 0 err ----
                            	   984: ;                 advances a6 past digits
                            	   985: parse_hex:
01:00F0B054 7000            	   986:                 clr.l   d0
