                            	  2895: 
                            	  2896: .write:
                            	  2897:                 ; pw PAGE OFF VAL [VAL...] -- write consecutive LONGS into
                            	  2898:                 ; the paged chassis window, saving and restoring MODE2.
                            	  2899:                 ;
                            	  2900:                 ; This exists because the two-step workaround is a footgun.
                            	  2901:                 ; `ww FF0210 000F` + `wl 400080 ...` already works, and
                            	  2902:                 ; leaves MODE2 SET -- and MODE2's post-boot value is defined
                            	  2903:                 ; and is ZERO, forced by RTOS init at $F0A1FE and again by
                            	  2904:                 ; self-test phase $1600.  Nothing after init ever changes
                            	  2905:                 ; the resting page: op $3, RDHC's command path and TCBIO1I
                            	  2906:                 ; all save and restore it.  So a stale MODE2 sends RDHC's
                            	  2907:                 ; next command fetch to the wrong page with no path to
                            	  2908:                 ; correction, and the failure surfaces later as a bad
                            	  2909:                 ; command record rather than as a wrong-page fault.  Making
                            	  2910:                 ; the safe form the easy form is the whole point.
                            	  2911:                 ;
                            	  2912:                 ; The SBC genuinely writes SCM this way: op $3's write arm
                            	  2913:                 ; assembles a 32-bit word from $FF0204 in two halves, pages
                            	  2914:                 ; via $FF0210, and stores with move.l $e70,(a1,d1.l) --
                            	  2915:                 ; measured at 219 stores into the window in a driven boot.
                            	  2916:                 ;
                            	  2917:                 ; LIMITATION, shared with the read path above: if the window
                            	  2918:                 ; bus-errors mid-write, grp0_entry takes over and the
                            	  2919:                 ; stack-saved MODE2 is lost with the frame, so the page is
                            	  2920:                 ; left selected.  The fault address is reported, so the
                            	  2921:                 ; condition is visible; `p 0` afterwards re-selects page 0.
01:00F0BCA4 528E            	  2922:                 addq.l  #1,a6                   ; past the 'w'
01:00F0BCA6 6100F594        	  2923:                 bsr.w   skip_ws
01:00F0BCAA 6100F5A4        	  2924:                 bsr.w   parse_hex
01:00F0BCAE 4A01            	  2925:                 tst.b   d1
01:00F0BCB0 6700EEEE        	  2926:                 beq.w   cmd_err
01:00F0BCB4 028000000FFF    	  2927:                 andi.l  #$FFF,d0                ; 12-bit page field, as `p`
01:00F0BCBA 3A00            	  2928:                 move.w  d0,d5
01:00F0BCBC 6100F57E        	  2929:                 bsr.w   skip_ws
01:00F0BCC0 6100F58E        	  2930:                 bsr.w   parse_hex
01:00F0BCC4 4A01            	  2931:                 tst.b   d1
01:00F0BCC6 6700EED8        	  2932:                 beq.w   cmd_err
01:00F0BCCA 0280003FFFFC    	  2933:                 andi.l  #$3FFFFC,d0             ; long-aligned, inside the
                            	  2934:                                                 ;   4 MB window.  Masking
                            	  2935:                                                 ;   rather than rejecting
                            	  2936:                                                 ;   matches `p`'s treatment
                            	  2937:                                                 ;   of the page field, and an
                            	  2938:                                                 ;   odd offset would address-
                            	  2939:                                                 ;   error on the move.l.
01:00F0BCD0 2800            	  2940:                 move.l  d0,d4
01:00F0BCD2 6100F568        	  2941:                 bsr.w   skip_ws
01:00F0BCD6 4A16            	  2942:                 tst.b   (a6)                    ; at least one value
01:00F0BCD8 6700EEC6        	  2943:                 beq.w   cmd_err
01:00F0BCDC 3F3900FF0210    	  2944:                 move.w  $FF0210,-(sp)           ; save MODE2 -- on the STACK,
                            	  2945:                                                 ;   for the reason the read
                            	  2946:                                                 ;   path documents above
01:00F0BCE2 33C500FF0210    	  2947:                 move.w  d5,$FF0210
01:00F0BCE8 49F900400000    	  2948:                 lea     $400000,a4
01:00F0BCEE D9C4            	  2949:                 adda.l  d4,a4
01:00F0BCF0 7C00            	  2950:                 moveq   #0,d6                   ; longs written
                            	  2951: .wloop:
01:00F0BCF2 6100F548        	  2952:                 bsr.w   skip_ws
01:00F0BCF6 4A16            	  2953:                 tst.b   (a6)
01:00F0BCF8 670E            	  2954:                 beq.b   .wdone
01:00F0BCFA 6100F554        	  2955:                 bsr.w   parse_hex
01:00F0BCFE 4A01            	  2956:                 tst.b   d1
01:00F0BD00 6706            	  2957:                 beq.b   .wdone                  ; trailing junk ends the list
                            	  2958:                                                 ;   rather than aborting a
                            	  2959:                                                 ;   half-done write
01:00F0BD02 28C0            	  2960:                 move.l  d0,(a4)+
01:00F0BD04 5286            	  2961:                 addq.l  #1,d6
01:00F0BD06 60EA            	  2962:                 bra.b   .wloop
                            	  2963: .wdone:
01:00F0BD08 3A1F            	  2964:                 move.w  (sp)+,d5
01:00F0BD0A 33C500FF0210    	  2965:                 move.w  d5,$FF0210              ; restore MODE2
01:00F0BD10 2006            	  2966:                 move.l  d6,d0
01:00F0BD12 6100F826        	  2967:                 bsr.w   puthex_byte
01:00F0BD16 41FA14BA        	  2968:                 lea     pagew_msg(pc),a0
01:00F0BD1A 6100F7E8        	  2969:                 bsr.w   puts
01:00F0BD1E 3005            	  2970:                 move.w  d5,d0
01:00F0BD20 6100F826        	  2971:                 bsr.w   puthex_word
01:00F0BD24 6100F7EA        	  2972:                 bsr.w   put_crlf
01:00F0BD28 6000EC46        	  2973:                 bra.w   cmd_loop
