01:00F0AFEA 671A            	   941:                 beq.b   .bs
01:00F0AFEC 0C00007F        	   942:                 cmpi.b  #127,d0                 ; DEL
01:00F0AFF0 6714            	   943:                 beq.b   .bs
01:00F0AFF2 610001DA        	   944:                 bsr.w   putchar                 ; echo
