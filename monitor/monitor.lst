01:00F0AA8C 6000FFA2        	   370:                 bra.w   cmd_mem
                            	   371: 
                            	   372: ;----------------------------------------------------------------
                            	   373: ; Memory write:  w XXXXXX BB BB BB ...
                            	   374: ;----------------------------------------------------------------
                            	   375: cmd_write:
01:00F0AA90 528E            	   376:                 addq.l  #1,a6
01:00F0AA92 61000598        	   377:                 bsr.w   skip_ws
01:00F0AA96 610005A8        	   378:                 bsr.w   parse_hex
01:00F0AA9A 4A01            	   379:                 tst.b   d1
01:00F0AA9C 6700FFE2        	   380:                 beq.w   cmd_err
01:00F0AAA0 2840            	   381:                 move.l  d0,a4
                            	   382: .wloop:
01:00F0AAA2 61000588        	   383:                 bsr.w   skip_ws
01:00F0AAA6 1016            	   384:                 move.b  (a6),d0
01:00F0AAA8 670E            	   385:                 beq.b   .done
01:00F0AAAA 61000594        	   386:                 bsr.w   parse_hex
01:00F0AAAE 4A01            	   387:                 tst.b   d1
01:00F0AAB0 6700FFCE        	   388:                 beq.w   cmd_err
01:00F0AAB4 18C0            	   389:                 move.b  d0,(a4)+
01:00F0AAB6 60EA            	   390:                 bra.b   .wloop
                            	   391: .done:
01:00F0AAB8 41FA0A65        	   392:                 lea     ok_msg(pc),a0
01:00F0AABC 6100074C        	   393:                 bsr.w   puts
01:00F0AAC0 6000FE38        	   394:                 bra.w   cmd_loop
                            	   395: 
                            	   396: ;----------------------------------------------------------------
                            	   397: ; Go — restore registers and RTE.  No address arg = use saved PC.
                            	   398: ; "g XXXXXX" replaces the saved PC before resuming.
                            	   399: ;----------------------------------------------------------------
                            	   400: ; Only a short (4-word) frame can be *resumed*.  A group-0 frame is not
                            	   401: ; restartable on a 68000, and cold entry has no frame at all — but with
                            	   402: ; an explicit address, cold entry can still start code by synthesizing a
                            	   403: ; frame and RTE'ing into it.  That is what makes the standalone monitor
                            	   404: ; able to run and then debug something, rather than only look at memory.
                            	   405: cmd_go:
01:00F0AAC4 528E            	   406:                 addq.l  #1,a6
01:00F0AAC6 61000564        	   407:                 bsr.w   skip_ws
01:00F0AACA 1016            	   408:                 move.b  (a6),d0
01:00F0AACC 6728            	   409:                 beq.b   .noaddr
01:00F0AACE 61000570        	   410:                 bsr.w   parse_hex
01:00F0AAD2 4A01            	   411:                 tst.b   d1
01:00F0AAD4 6700FFAA        	   412:                 beq.w   cmd_err
01:00F0AAD8 0C3900FF0000F894	   413:                 cmpi.b  #$FF,MON_GRP0
01:00F0AAE0 67000056        	   414:                 beq.w   .fresh                  ; cold entry + address
01:00F0AAE4 4A390000F894    	   415:                 tst.b   MON_GRP0
01:00F0AAEA 66000086        	   416:                 bne.w   .no_frame               ; group-0: not resumable
01:00F0AAEE 23C00000F83C    	   417:                 move.l  d0,MON_SPC
01:00F0AAF4 600C            	   418:                 bra.b   .resume
                            	   419: .noaddr:
01:00F0AAF6 4A390000F894    	   420:                 tst.b   MON_GRP0                ; no address: need a real frame
01:00F0AAFC 66000074        	   421:                 bne.w   .no_frame
01:00F0AB00 4DD6            	   422:                 bra.b   .resume
                            	   423: .resume:
01:00F0AB02 41FA0AEE        	   424:                 lea     resume_msg(pc),a0
01:00F0AB06 61000702        	   425:                 bsr.w   puts
01:00F0AB0A 20390000F83C    	   426:                 move.l  MON_SPC,d0
01:00F0AB10 61000748        	   427:                 bsr.w   puthex_long
01:00F0AB14 61000700        	   428:                 bsr.w   put_crlf
                            	   429:                 ; rebuild stack frame and RTE
01:00F0AB18 08B900070000F840	   430:                 bclr.b  #SR_TRACE_BIT-8,MON_SSR ; stop tracing on a plain g
01:00F0AB20 2F790000F83C0002	   431:                 move.l  MON_SPC,2(sp)
01:00F0AB28 3EB90000F840    	   432:                 move.w  MON_SSR,(sp)
01:00F0AB2E 4CF97FFF0000F800	   433:                 movem.l MON_REGS,d0-d7/a0-a6
01:00F0AB36 4E73            	   434:                 rte
                            	   435: .fresh:
                            	   436:                 ; Cold entry: no frame exists, so build one.  RTE pops SR
                            	   437:                 ; then PC, so push PC first and SR on top.  IPL stays 7 and
                            	   438:                 ; the T bit stays clear; every vector already points at the
                            	   439:                 ; monitor, so a fault in the target lands back here.
01:00F0AB38 23C00000F83C    	   440:                 move.l  d0,MON_SPC
01:00F0AB3E 41FA0AB2        	   441:                 lea     resume_msg(pc),a0
01:00F0AB42 610006C6        	   442:                 bsr.w   puts
01:00F0AB46 20390000F83C    	   443:                 move.l  MON_SPC,d0
01:00F0AB4C 6100070C        	   444:                 bsr.w   puthex_long
01:00F0AB50 610006C4        	   445:                 bsr.w   put_crlf
01:00F0AB54 33FC27000000F840	   446:                 move.w  #$2700,MON_SSR
01:00F0AB5C 2F390000F83C    	   447:                 move.l  MON_SPC,-(sp)           ; PC
01:00F0AB62 3F390000F840    	   448:                 move.w  MON_SSR,-(sp)           ; SR
01:00F0AB68 4CF97FFF0000F800	   449:                 movem.l MON_REGS,d0-d7/a0-a6
01:00F0AB70 4E73            	   450:                 rte
                            	   451: .no_frame:
01:00F0AB72 41FA0A45        	   452:                 lea     nogo_msg(pc),a0
01:00F0AB76 61000692        	   453:                 bsr.w   puts
01:00F0AB7A 6000FD7E        	   454:                 bra.w   cmd_loop
                            	   455: 
                            	   456: ;================================================================
                            	   457: ; Breakpoints:  b            list slots
                            	   458: ;               b ADDR       set a breakpoint
                            	   459: ;               b -ADDR      clear one
                            	   460: ;               b -          clear all
                            	   461: ;
                            	   462: ; A breakpoint replaces the word at ADDR with TRAP #14 ($4E4E) and keeps
                            	   463: ; the original in the slot table.  Vector 46 ($B8) is pointed at
                            	   464: ; monitor_entry when the first breakpoint is armed — cold_init already
                            	   465: ; filled every vector, but on the --panic path the firmware owns the
                            	   466: ; table, so arming has to install it explicitly.  That is the only write
                            	   467: ; this command makes outside the target word and the slot table.
                            	   468: ;
                            	   469: ; TRAP pushes the 4-word frame, so MON_SPC/MON_SSR read correctly and
                            	   470: ; MON_GRP0 stays 0, which keeps `g` usable.  Note the pushed PC points
                            	   471: ; *after* the trap word: `g` therefore resumes past the breakpoint, and
                            	   472: ; the original instruction is NOT re-executed.  Clear the breakpoint and
                            	   473: ; `g ADDR` if you need to run it.
                            	   474: ;================================================================
                            	   475: cmd_bp:
01:00F0AB7E 528E            	   476:                 addq.l  #1,a6
01:00F0AB80 610004AA        	   477:                 bsr.w   skip_ws
01:00F0AB84 1016            	   478:                 move.b  (a6),d0
01:00F0AB86 67000134        	   479:                 beq.w   bp_list                 ; bare "b" -> list
01:00F0AB8A 0C00002D        	   480:                 cmpi.b  #'-',d0
01:00F0AB8E 6712            	   481:                 beq.b   .clear
01:00F0AB90 610004AE        	   482:                 bsr.w   parse_hex
01:00F0AB94 4A01            	   483:                 tst.b   d1
01:00F0AB96 6700FEE8        	   484:                 beq.w   cmd_err
01:00F0AB9A 61000032        	   485:                 bsr.w   bp_set
01:00F0AB9E 6000FD5A        	   486:                 bra.w   cmd_loop
                            	   487: .clear:
01:00F0ABA2 528E            	   488:                 addq.l  #1,a6                   ; skip '-'
01:00F0ABA4 61000486        	   489:                 bsr.w   skip_ws
01:00F0ABA8 1016            	   490:                 move.b  (a6),d0
01:00F0ABAA 6712            	   491:                 beq.b   .clr_all
01:00F0ABAC 61000492        	   492:                 bsr.w   parse_hex
01:00F0ABB0 4A01            	   493:                 tst.b   d1
01:00F0ABB2 6700FECC        	   494:                 beq.w   cmd_err
01:00F0ABB6 6100009A        	   495:                 bsr.w   bp_clr_one
01:00F0ABBA 6000FD3E        	   496:                 bra.w   cmd_loop
                            	   497: .clr_all:
01:00F0ABBE 610000D4        	   498:                 bsr.w   bp_clr_all
01:00F0ABC2 41FA095B        	   499:                 lea     ok_msg(pc),a0
01:00F0ABC6 61000642        	   500:                 bsr.w   puts
01:00F0ABCA 6000FD2E        	   501:                 bra.w   cmd_loop
                            	   502: 
                            	   503: ; ---- bp_set: arm a breakpoint at d0 ----
                            	   504: bp_set:
01:00F0ABCE 48E7F0C0        	   505:                 movem.l d0-d3/a0-a1,-(sp)
01:00F0ABD2 2600            	   506:                 move.l  d0,d3                   ; target address
01:00F0ABD4 6700006E        	   507:                 beq.w   .odd                    ; 0 is not a target
01:00F0ABD8 08030000        	   508:                 btst.l  #0,d3
01:00F0ABDC 66000066        	   509:                 bne.w   .odd                    ; must be word-aligned
                            	   510:                 ; find a free slot, and reject a duplicate
01:00F0ABE0 41F90000F8A0    	   511:                 lea     MON_BPT,a0
01:00F0ABE6 7207            	   512:                 moveq   #MON_BPN-1,d1
01:00F0ABE8 93C9            	   513:                 suba.l  a1,a1                   ; a1 = first free slot, or 0
                            	   514: .scan:
01:00F0ABEA 2410            	   515:                 move.l  (a0),d2
01:00F0ABEC 6708            	   516:                 beq.b   .isfree
01:00F0ABEE B483            	   517:                 cmp.l   d3,d2
01:00F0ABF0 6700003E        	   518:                 beq.w   .dup
01:00F0ABF4 6006            	   519:                 bra.b   .next
                            	   520: .isfree:
01:00F0ABF6 2409            	   521:                 move.l  a1,d2
01:00F0ABF8 6602            	   522:                 bne.b   .next                   ; already have a free slot
01:00F0ABFA 2248            	   523:                 move.l  a0,a1
                            	   524: .next:
01:00F0ABFC 5C88            	   525:                 lea     MON_BP_SZ(a0),a0
01:00F0ABFE 51C9FFEA        	   526:                 dbra    d1,.scan
01:00F0AC02 2409            	   527:                 move.l  a1,d2
01:00F0AC04 67000034        	   528:                 beq.w   .full
                            	   529:                 ; point the TRAP #14 vector at the monitor, then patch
01:00F0AC08 21FC00F0A84000B8	   530:                 move.l  #monitor_entry,BP_VECTOR
01:00F0AC10 2043            	   531:                 move.l  d3,a0
01:00F0AC12 33500004        	   532:                 move.w  (a0),4(a1)              ; save original word
01:00F0AC16 30BC4E4E        	   533:                 move.w  #BP_OPCODE,(a0)
01:00F0AC1A 2283            	   534:                 move.l  d3,(a1)                 ; mark slot in use
01:00F0AC1C 41FA090D        	   535:                 lea     bp_set_msg(pc),a0
01:00F0AC20 610005E8        	   536:                 bsr.w   puts
01:00F0AC24 2003            	   537:                 move.l  d3,d0
01:00F0AC26 61000632        	   538:                 bsr.w   puthex_long
01:00F0AC2A 610005EA        	   539:                 bsr.w   put_crlf
01:00F0AC2E 601C            	   540:                 bra.b   .out
                            	   541: .dup:
01:00F0AC30 41FA0903        	   542:                 lea     bp_dup_msg(pc),a0
01:00F0AC34 610005D4        	   543:                 bsr.w   puts
01:00F0AC38 6012            	   544:                 bra.b   .out
                            	   545: .full:
01:00F0AC3A 41FA0908        	   546:                 lea     bp_full_msg(pc),a0
01:00F0AC3E 610005CA        	   547:                 bsr.w   puts
01:00F0AC42 6008            	   548:                 bra.b   .out
                            	   549: .odd:
01:00F0AC44 41FA090F        	   550:                 lea     bp_odd_msg(pc),a0
01:00F0AC48 610005C0        	   551:                 bsr.w   puts
                            	   552: .out:
01:00F0AC4C 4CDF030F        	   553:                 movem.l (sp)+,d0-d3/a0-a1
01:00F0AC50 4E75            	   554:                 rts
                            	   555: 
                            	   556: ; ---- bp_clr_one: disarm the breakpoint at d0, restoring its word ----
                            	   557: bp_clr_one:
01:00F0AC52 48E7E0C0        	   558:                 movem.l d0-d2/a0-a1,-(sp)
01:00F0AC56 2400            	   559:                 move.l  d0,d2
01:00F0AC58 6700002C        	   560:                 beq.w   .nf                     ; 0 never matches a slot
01:00F0AC5C 41F90000F8A0    	   561:                 lea     MON_BPT,a0
01:00F0AC62 7207            	   562:                 moveq   #MON_BPN-1,d1
                            	   563: .scan:
01:00F0AC64 2010            	   564:                 move.l  (a0),d0
01:00F0AC66 B082            	   565:                 cmp.l   d2,d0
01:00F0AC68 6616            	   566:                 bne.b   .next
01:00F0AC6A 2240            	   567:                 move.l  d0,a1
01:00F0AC6C 32A80004        	   568:                 move.w  4(a0),(a1)              ; put the original back
01:00F0AC70 20BC00000000    	   569:                 move.l  #0,(a0)                 ; free the slot
01:00F0AC76 41FA08A7        	   570:                 lea     ok_msg(pc),a0
01:00F0AC7A 6100058E        	   571:                 bsr.w   puts
01:00F0AC7E 600E            	   572:                 bra.b   .out
                            	   573: .next:
01:00F0AC80 5C88            	   574:                 lea     MON_BP_SZ(a0),a0
01:00F0AC82 51C9FFE0        	   575:                 dbra    d1,.scan
                            	   576: .nf:
01:00F0AC86 41FA08F4        	   577:                 lea     bp_none_msg(pc),a0
01:00F0AC8A 6100057E        	   578:                 bsr.w   puts
                            	   579: .out:
01:00F0AC8E 4CDF0307        	   580:                 movem.l (sp)+,d0-d2/a0-a1
01:00F0AC92 4E75            	   581:                 rts
                            	   582: 
                            	   583: ; ---- bp_clr_all: disarm every armed slot ----
                            	   584: bp_clr_all:
01:00F0AC94 48E7C0C0        	   585:                 movem.l d0-d1/a0-a1,-(sp)
01:00F0AC98 41F90000F8A0    	   586:                 lea     MON_BPT,a0
01:00F0AC9E 7207            	   587:                 moveq   #MON_BPN-1,d1
                            	   588: .scan:
01:00F0ACA0 2010            	   589:                 move.l  (a0),d0
01:00F0ACA2 670C            	   590:                 beq.b   .next
01:00F0ACA4 2240            	   591:                 move.l  d0,a1
01:00F0ACA6 32A80004        	   592:                 move.w  4(a0),(a1)
01:00F0ACAA 20BC00000000    	   593:                 move.l  #0,(a0)
                            	   594: .next:
01:00F0ACB0 5C88            	   595:                 lea     MON_BP_SZ(a0),a0
01:00F0ACB2 51C9FFEC        	   596:                 dbra    d1,.scan
01:00F0ACB6 4CDF0303        	   597:                 movem.l (sp)+,d0-d1/a0-a1
