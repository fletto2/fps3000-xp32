01:00F0B83C 32E80008        	  1989:                 move.w  8(a0),(a1)+             ; data high
01:00F0B840 32E8000A        	  1990:                 move.w  $A(a0),(a1)+            ; data low
01:00F0B844 12C2            	  1991:                 move.b  d2,(a1)+                ; channel
01:00F0B846 12FC0000        	  1992:                 move.b  #0,(a1)+
