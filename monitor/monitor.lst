                            	  3065: ;----------------------------------------------------------------
                            	  3066: ; f AAAA NNNN VVVV — fill words
                            	  3067: ;
                            	  3068: ; Bounds-checked through srec_check, the same audited checker the S-record
                            	  3069: ; loader uses: it refuses the vector table, anything at or above $20000,
                            	  3070: ; and anything reaching this monitor's own workspace or stack.  Filling
                            	  3071: ; over MON_BASE would destroy the stack the fill is running on.
                            	  3072: ;
                            	  3073: ; Deliberate pokes at devices and ROM space are what `w` is for; a fill
                            	  3074: ; is a RAM operation and is guarded like one.
                            	  3075: ;----------------------------------------------------------------
                            	  3076: cmd_fill:
01:00F0BDF6 528E            	  3077:                 addq.l  #1,a6
01:00F0BDF8 6100F442        	  3078:                 bsr.w   skip_ws
01:00F0BDFC 6100F452        	  3079:                 bsr.w   parse_hex
01:00F0BE00 4A01            	  3080:                 tst.b   d1
01:00F0BE02 6700ED9C        	  3081:                 beq.w   cmd_err
01:00F0BE06 2800            	  3082:                 move.l  d0,d4                   ; start
01:00F0BE08 7E02            	  3083:                 moveq   #2,d7
01:00F0BE0A 6100F7A6        	  3084:                 bsr.w   odd_check
01:00F0BE0E 4A01            	  3085:                 tst.b   d1
01:00F0BE10 6700EB5E        	  3086:                 beq.w   cmd_loop
01:00F0BE14 6100F426        	  3087:                 bsr.w   skip_ws
01:00F0BE18 6100F436        	  3088:                 bsr.w   parse_hex
01:00F0BE1C 4A01            	  3089:                 tst.b   d1
01:00F0BE1E 6700ED80        	  3090:                 beq.w   cmd_err
01:00F0BE22 2400            	  3091:                 move.l  d0,d2                   ; byte count, for srec_check
01:00F0BE24 2604            	  3092:                 move.l  d4,d3                   ; start,      for srec_check
01:00F0BE26 6100F486        	  3093:                 bsr.w   srec_check              ; clobbers d1 only
01:00F0BE2A 4A01            	  3094:                 tst.b   d1
01:00F0BE2C 67000030        	  3095:                 beq.w   .refuse
01:00F0BE30 2002            	  3096:                 move.l  d2,d0
01:00F0BE32 E288            	  3097:                 lsr.l   #1,d0                   ; bytes -> words
01:00F0BE34 6700ED6A        	  3098:                 beq.w   cmd_err
01:00F0BE38 2600            	  3099:                 move.l  d0,d3
01:00F0BE3A 6100F400        	  3100:                 bsr.w   skip_ws
01:00F0BE3E 6100F410        	  3101:                 bsr.w   parse_hex
01:00F0BE42 4A01            	  3102:                 tst.b   d1
01:00F0BE44 6700ED5A        	  3103:                 beq.w   cmd_err
01:00F0BE48 3A00            	  3104:                 move.w  d0,d5                   ; fill value
01:00F0BE4A 2844            	  3105:                 move.l  d4,a4
                            	  3106: .lp:
01:00F0BE4C 38C5            	  3107:                 move.w  d5,(a4)+
01:00F0BE4E 5383            	  3108:                 subq.l  #1,d3
01:00F0BE50 66FA            	  3109:                 bne.b   .lp
01:00F0BE52 41FA0C30        	  3110:                 lea     fill_ok_msg(pc),a0
01:00F0BE56 6100F6AC        	  3111:                 bsr.w   puts
01:00F0BE5A 6000EB14        	  3112:                 bra.w   cmd_loop
                            	  3113: .refuse:
01:00F0BE5E 41FA0C2D        	  3114:                 lea     fill_no_msg(pc),a0
