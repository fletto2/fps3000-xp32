01:00F0B1A6 6F12            	  1146:                 ble.b   .upper
01:00F0B1A8 0C020061        	  1147:                 cmpi.b  #'a',d2
01:00F0B1AC 6D24            	  1148:                 blt.b   .end
01:00F0B1AE 0C020066        	  1149:                 cmpi.b  #'f',d2
