Sections:
00: "segf0a826" (F0A826-F0A838)
01: "segf0a840" (F0A840-F0D280)


Source: "monitor.s"
                            	     1: ; ----------------------------------------------------------------
                            	     2: ; FPS-3000 SBC Monitor / Debugger / Host Interface
                            	     3: ; Lives in the 21.9 KB of free ROM at $F0A826 onwards.
                            	     4: ;
                            	     5: ; Communicates over the on-board NEC µPD7201 SIO Channel A
                            	     6: ; ($F70011 data, $F70015 control), which the FPS firmware never
                            	     7: ; initialises or uses — so we have it all to ourselves.
                            	     8: ;
                            	     9: ; Triggered by jumping to monitor_entry (typically by patching
                            	    10: ; one or more vectors).
                            	    11: ; ----------------------------------------------------------------
                            	    12: 
                            	    13: ; µPD7201 register addresses, per Motorola's VERSAdos source for this
                            	    14: ; board — verdos06/SDLCPRI/NEC7201.EQ, in rms68k_source.SA:
                            	    15: ;
                            	    16: ;     NEC7201 EQU $F70011      <- ODD base: the chip is on D0-D7 / LDS
                            	    17: ;     ch A data    = base+0 = $F70011
                            	    18: ;     ch B data    = base+2 = $F70013
                            	    19: ;     ch A control = base+4 = $F70015
                            	    20: ;     ch B control = base+6 = $F70017
                            	    21: ;
                            	    22: ; Registers are grouped by FUNCTION (both data, then both control), not
                            	    23: ; interleaved per channel.  Earlier versions of this file used $F70010
                            	    24: ; and $F70012, which is wrong twice over: even addresses assert UDS only
                            	    25: ; and this chip never answers them (-> no DTACK -> BERR), and the odd
                            	    26: ; byte of that second slot, $F70013, is channel B's DATA register, not
                            	    27: ; channel A's control.  Corroborated by verdos06/_root/NEC7201.EQ
                            	    28: ; (CREG/SREG = 0, DREG = -4) and by the ROM's own MC6840 access at odd
                            	    29: ; $F70001/$F70003 in PTMInit (F09176).
                            	    30: SIO_A_DATA      equ     $F70011
                            	    31: SIO_A_CTRL      equ     $F70015
                            	    32: SIO_B_DATA      equ     $F70013
                            	    33: SIO_B_CTRL      equ     $F70017
                            	    34: 
                            	    35: ; Z80-SIO/i8274 RR0 status bits
                            	    36: RR0_RX_AVAIL    equ     0
                            	    37: ESC             equ     $1B             ; abort character for L (see getchar)
                            	    38: RR0_TX_EMPTY    equ     2
                            	    39: 
                            	    40: ; Monitor RAM workspace.
                            	    41: ;
                            	    42: ; This used to live at $1F000, which was wrong in two ways at once:
                            	    43: ;
                            	    44: ;   * $1F000 is INSIDE the AU WCS staging buffer ($10000-$1FFFF), so
                            	    45: ;     loading a full 64 KB bank — the whole point of the L command —
                            	    46: ;     would overwrite the monitor's own saved registers, line buffer and
                            	    47: ;     stack partway through the transfer.
                            	    48: ;   * The factory firmware also writes live data there.  A RAM dump after
                            	    49: ;     booting the stock ROM to the scheduler idle loop shows 40 nonzero
                            	    50: ;     bytes in $1F000-$1F09F, so entering via the panic vector clobbered
                            	    51: ;     firmware state and quietly compromised `g`.
                            	    52: ;
                            	    53: ; Measured alternative: dumping RAM after a full stock boot shows
                            	    54: ; $01200-$0FFFF — 60,928 bytes — completely untouched by the firmware.
                            	    55: ; The workspace and the cold-path stack both now live there, which puts
                            	    56: ; them below the staging buffer AND out of the firmware's way, fixing
                            	    57: ; both problems at once.
                            	    58: ;
                            	    59: ; Caveat on the evidence: "untouched after booting to idle" is not proof
                            	    60: ; that RMS68K never allocates there under load — it is a measurement of
                            	    61: ; this chassis reaching its idle loop, not a guarantee.  It is strictly
                            	    62: ; better than the old placement, which was measurably in use.
                            	    63: MON_BASE        equ     $0F800
                            	    64: MON_REGS        equ     MON_BASE        ; saved D0..D7 then A0..A6 (15*4=60 bytes)
                            	    65: MON_SPC         equ     MON_BASE+$3C    ; saved PC (long) — at MON_REGS + 60
                            	    66: MON_SSR         equ     MON_BASE+$40    ; saved SR (word)
                            	    67: MON_CMDSP       equ     MON_BASE+$44    ; sp as it stands at the top of cmd_loop
                            	    68:                                         ;   (long).  The abort anchor: getchar
                            	    69:                                         ;   can be three frames deep inside L
                            	    70:                                         ;   (cmd_load_srec -> read_hex_byte ->
                            	    71:                                         ;   read_hex_nibble -> getchar), so an
                            	    72:                                         ;   abort cannot rts out.  It must NOT
                            	    73:                                         ;   simply `lea MON_STACK,sp` either:
                            	    74:                                         ;   monitor_common deliberately runs on
                            	    75:                                         ;   the stack it was entered with, and
                            	    76:                                         ;   the firmware's exception frame is
                            	    77:                                         ;   still beneath it -- that frame is
                            	    78:                                         ;   what `g` resumes through.  Anchoring
                            	    79:                                         ;   on cmd_loop's own sp unwinds exactly
                            	    80:                                         ;   as far as the prompt and no further.
                            	    81: MON_MAGIC       equ     MON_BASE+$4C    ; long.  "MON1" once ws_init has run.
                            	    82:                                         ;   The panic image never runs cold_init,
                            	    83:                                         ;   so on real hardware every workspace
                            	    84:                                         ;   field starts as never-written DRAM --
                            	    85:                                         ;   random, not the zeroes the emulator
                            	    86:                                         ;   shows.  This is the one-shot flag that
                            	    87:                                         ;   says "the workspace is real".  Chosen
                            	    88:                                         ;   as ASCII so it is recognisable in a RAM
                            	    89:                                         ;   dump; a random long matching it is 1 in
                            	    90:                                         ;   4 billion.
                            	    91: MON_MAGIC_V     equ     $4D4F4E31       ; 'MON1'
                            	    92: MON_ABORT       equ     MON_BASE+$48    ; nonzero: ESC seen in getchar aborts to
                            	    93:                                         ;   cmd_loop.  Set only for the duration
                            	    94:                                         ;   of L, so ESC stays an ordinary
                            	    95:                                         ;   (ignored) character at the prompt.
                            	    96: MON_LINEBUF     equ     MON_BASE+$50    ; cmd line buffer (64 B)
                            	    97: MON_LASTADDR    equ     MON_BASE+$90    ; last 'm' addr (long)
                            	    98: MON_GRP0        equ     MON_BASE+$94    ; frame kind: 0 = short (4-word,
                            	    99:                                         ;   resumable), 1 = group-0 (7-word
                            	   100:                                         ;   bus/addr error), $FF = no frame
                            	   101:                                         ;   at all (cold entry)
                            	   102: MON_NEST        equ     MON_BASE+$95    ; re-entry guard: 0 = not inside a
                            	   103:                                         ;   fault report, 1 = reporting,
                            	   104:                                         ;   2 = died re-entering (sticky)
                            	   105: MON_FADDR       equ     MON_BASE+$98    ; group-0 ACCESS ADDRESS (long).
                            	   106:                                         ;   The 68000 pushes the address that
                            	   107:                                         ;   faulted at (sp)+2; discarding it
                            	   108:                                         ;   leaves "bus error at PC X" with no
                            	   109:                                         ;   way to say WHAT X touched, which is
                            	   110:                                         ;   the one number bring-up needs.
                            	   111: MON_SSW         equ     MON_BASE+$9C    ; group-0 special status word: bit 4 =
                            	   112:                                         ;   R/W (1 = read), bit 3 = I/N, bits
                            	   113:                                         ;   2-0 = function code (5 = supervisor
                            	   114:                                         ;   data, 6 = supervisor program)
                            	   115: MON_TXFAIL      equ     MON_BASE+$96    ; nonzero once a putchar has timed
                            	   116:                                         ;   out — survives for a RAM dump
                            	   117: 
                            	   118: ; Cold-entry supervisor stack top, growing down toward the workspace end
                            	   119: ; at MON_BASE+$97.  ~1.7 KB of stack, all inside the free region.  The
                            	   120: ; panic path deliberately leaves SP alone — it needs the firmware's
                            	   121: ; exception frame where the firmware left it.
                            	   122: MON_STACK       equ     $0FF00
                            	   123: 
                            	   124: ; Region srec_check refuses to load over: workspace + cold-entry stack.
                            	   125: MON_LO          equ     MON_BASE
                            	   126: MON_HI          equ     MON_STACK
                            	   127: 
                            	   128: ; Breakpoint table: 8 slots of {addr.l, saved original word}.  A slot
                            	   129: ; with addr = 0 is free.
                            	   130: MON_BPN         equ     8
                            	   131: MON_BPT         equ     MON_BASE+$A0    ; 8 * 6 bytes = 48, ends +$CF
                            	   132: MON_BP_SZ       equ     6
                            	   133: 
                            	   134: ; Tier 4 tap state and capture ring.  All of it sits inside
                            	   135: ; MON_LO..MON_HI, so srec_check already refuses to load over it, and
                            	   136: ; cold_init pre-writes every byte for the same DRAM-parity reason it
                            	   137: ; pre-writes MON_REGS.
                            	   138: MON_TAPMSK      equ     MON_BASE+$D0    ; armed channels, bit n = ch n+1
                            	   139: MON_TAPTGT      equ     MON_BASE+$F0    ; chain target scratch -- FOUR longs, one
                            	   140:                                         ;   per channel ($F0-$FF, the gap below
                            	   141:                                         ;   MON_RING).  One shared slot was a
                            	   142:                                         ;   cross-channel race: see tap_body.
                            	   143: ; Saved TRACE vector, or 0 = nothing saved.  Long-aligned, and it fits the
                            	   144: ; $D1-$D7 gap (MON_TAPMSK is a BYTE), so the workspace does not grow -- the
                            	   145: ; same trick MON_TAPTGT used to claim $F0-$FF.
                            	   146: ;
                            	   147: ; Zero is a safe sentinel because vector 9 is never zero on either image:
                            	   148: ; the kernel's static vector table at $F00114 puts $F00AEE there (measured
                            	   149: ; from the ROM), and cold_init fills all 256 vectors on the reset image.
                            	   150: MON_TRCSAV      equ     MON_BASE+$D4    ; saved vector 9, 0 = none saved
                            	   151: MON_TAPSAV      equ     MON_BASE+$D8    ; 4 saved vectors, $D8..$E7
                            	   152: MON_RINGHD      equ     MON_BASE+$E8    ; ring head index (word)
                            	   153: MON_RINGN       equ     MON_BASE+$EA    ; entries captured, saturating
                            	   154: MON_RINGOV      equ     MON_BASE+$EC    ; wrap count
                            	   155: MON_RING        equ     MON_BASE+$100   ; 64 * 10 bytes = $280, ending at
                            	   156:                                         ;   $0FB7F -- which leaves 896 bytes
                            	   157:                                         ;   of cold-entry stack below $0FF00
                            	   158: MON_RING_N      equ     64
                            	   159: MON_RING_SZ     equ     10
                            	   160: 
                            	   161: ; TRAP #14 opcode, used as the breakpoint trap.  Vector 46 at $B8.
                            	   162: BP_OPCODE       equ     $4E4E
                            	   163: BP_VECTOR       equ     $B8
                            	   164: TRACE_VECTOR    equ     $24             ; vector 9 — T-bit trace
                            	   165: SR_TRACE_BIT    equ     15              ; T bit in SR
                            	   166: 
                            	   167: ; putchar TX-ready spin limit.  The btst loop is ~20 cycles, so this is
                            	   168: ; roughly 20M cycles / ~2.5 s at 8 MHz — comfortably longer than one
                            	   169: ; character time even at the slowest strappable rate (50 baud = 200 ms),
                            	   170: ; while still being bounded.  An unbounded spin here is why a dead SIO
                            	   171: ; produced total silence on the first hardware attempt: the monitor hung
                            	   172: ; before emitting a single byte, so there was nothing to diagnose.
                            	   173: TX_SPIN_LIMIT   equ     $100000
                            	   174: 
                            	   175:                 org     $F0A826
                            	   176: 
                            	   177: ;================================================================
                            	   178: ; Cold entry — used when monitor is patched in as the reset PC.
                            	   179: ; SP isn't loaded by the FPS reset path, so we install it ourselves
                            	   180: ; before doing anything that pushes (like bsr).
                            	   181: ;================================================================
                            	   182: monitor_cold:
00:00F0A826 007C2700        	   183:                 ori.w   #$2700,sr               ; supervisor, IPL=7
00:00F0A82A 2E7C0000FF00    	   184:                 movea.l #MON_STACK,sp           ; supervisor stack (below
                            	   185:                                                 ;   the WCS staging buffer)
00:00F0A830 61000AEE        	   186:                 bsr.w   cold_init               ; vectors + workspace
00:00F0A834 600000C8        	   187:                 bra.w   monitor_common
                            	   188: 
                            	   189: ; monitor_entry MUST stay at $F0A840: patch_rom.py hardcodes
                            	   190: ; MON_ENTRY = 0xA840, and README.md / CLAUDE.md both document that
                            	   191: ; address.  Pinning it here means edits to monitor_cold above cannot
                            	   192: ; silently shift it and send the panic-vector patch into the middle of
                            	   193: ; an instruction.  vasm errors out if monitor_cold ever overflows.
                            	   194:                 org     $F0A840
                            	   195: 
                            	   196: ;================================================================
                            	   197: ; Exception entry — called as JMP target from patched vectors.
                            	   198: ;
                            	   199: ; If entered via an exception, the supervisor stack contains the
                            	   200: ; standard 7-word frame (or 4-word for IRQ).  We save D0-D7/A0-A6
                            	   201: ; into MON_REGS, then read the saved PC and SR from the stack.
                            	   202: ;================================================================
                            	   203: monitor_entry:
                            	   204:                 ; The workspace check has to come before EVERYTHING, including
                            	   205:                 ; the re-entry guard -- because the re-entry guard reads
                            	   206:                 ; MON_NEST, and on the panic image nothing has ever written it.
                            	   207:                 ; cold_init runs only on the --reset path; the panic image jumps
                            	   208:                 ; straight here from the firmware's catch-all, and $0F800-$0FEFF
                            	   209:                 ; is DRAM the firmware never touches, so on real hardware every
                            	   210:                 ; byte of it powers up RANDOM.  A garbage MON_NEST sends this
                            	   211:                 ; entry to mon_dead and STOPs the CPU with no banner and no
                            	   212:                 ; prompt -- a board that looks dead, ~255 times out of 256.
                            	   213:                 ; The emulator cannot show it: ram[] is zero-filled, and zero is
                            	   214:                 ; a valid initial state for nearly every field here.
                            	   215:                 ;
                            	   216:                 ; Ordering is safe: a genuine re-entry means the monitor has
                            	   217:                 ; already run, so the magic is set and ws_init is skipped -- the
                            	   218:                 ; guard still sees the MON_NEST=1 that the first pass wrote.
01:00F0A840 0CB94D4F4E310000	   219:                 cmpi.l  #MON_MAGIC_V,MON_MAGIC
01:00F0A848 F84C
01:00F0A84A 6704            	   220:                 beq.b   .ws_ok
01:00F0A84C 61000AF8        	   221:                 bsr.w   ws_init                 ; preserves d0/d1/a0
                            	   222: .ws_ok:
                            	   223:                 ; Re-entry guard, before clobbering anything: if we are already
                            	   224:                 ; reporting a fault, the fault is coming from the monitor's own
                            	   225:                 ; I/O path and reporting it again just recurses, pushing a frame
                            	   226:                 ; per pass until the stack eats the workspace.  Bail to mon_dead
                            	   227:                 ; and keep the FIRST fault's PC/SR intact for post-mortem.
01:00F0A850 4A390000F895    	   228:                 tst.b   MON_NEST
01:00F0A856 66000092        	   229:                 bne.w   mon_dead
01:00F0A85A 13FC00010000F895	   230:                 move.b  #1,MON_NEST
                            	   231: 
01:00F0A862 48F97FFF0000F800	   232:                 movem.l d0-d7/a0-a6,MON_REGS
01:00F0A86A 13FC00000000F894	   233:                 move.b  #0,MON_GRP0             ; short frame: SR, then PC
01:00F0A872 23FC000000000000	   234:                 move.l  #0,MON_FADDR            ; no access address in a short
01:00F0A87A F898
01:00F0A87C 33FC00000000F89C	   235:                 move.w  #0,MON_SSW              ;   frame -- do not leave stale
01:00F0A884 33D70000F840    	   236:                 move.w  (sp),MON_SSR
01:00F0A88A 23EF00020000F83C	   237:                 move.l  2(sp),MON_SPC
01:00F0A892 6000006A        	   238:                 bra.w   monitor_common
                            	   239: 
                            	   240: ;================================================================
                            	   241: ; grp0_entry — vectors 2 (bus error) and 3 (address error) ONLY.
                            	   242: ;
                            	   243: ; The 68000 pushes a 7-word group-0 frame, which is NOT laid out like
                            	   244: ; the 4-word frame every other exception uses:
                            	   245: ;
                            	   246: ;   (sp)+0  special status word
                            	   247: ;   (sp)+2  access address (long)
                            	   248: ;   (sp)+6  instruction register
                            	   249: ;   (sp)+8  status register      <- SR lives here, not at (sp)
                            	   250: ;   (sp)+10 program counter      <- PC lives here, not at 2(sp)
                            	   251: ;
                            	   252: ; Reading it as a short frame reports the SSW as "SR" and half the
                            	   253: ; fault address as "PC", which is worse than useless during bring-up.
                            	   254: ; Group-0 faults are also not resumable on a 68000, so flag the frame
                            	   255: ; and let cmd_go refuse rather than RTE into the weeds.
                            	   256: ;================================================================
                            	   257: grp0_entry:
                            	   258:                 ; Same first-write problem as monitor_entry, and the same
                            	   259:                 ; ordering argument -- see the comment there.  A bus error is
                            	   260:                 ; the LIKELIEST first entry on the panic image (that is what the
                            	   261:                 ; catch-all is for), so this path is the one that would present
                            	   262:                 ; as a dead board.
01:00F0A896 0CB94D4F4E310000	   263:                 cmpi.l  #MON_MAGIC_V,MON_MAGIC
01:00F0A89E F84C
01:00F0A8A0 6704            	   264:                 beq.b   .ws_ok
01:00F0A8A2 61000AA2        	   265:                 bsr.w   ws_init
                            	   266: .ws_ok:
01:00F0A8A6 4A390000F895    	   267:                 tst.b   MON_NEST
01:00F0A8AC 6600003C        	   268:                 bne.w   mon_dead
01:00F0A8B0 13FC00010000F895	   269:                 move.b  #1,MON_NEST
                            	   270: 
01:00F0A8B8 48F97FFF0000F800	   271:                 movem.l d0-d7/a0-a6,MON_REGS
01:00F0A8C0 13FC00010000F894	   272:                 move.b  #1,MON_GRP0             ; group-0: not resumable
01:00F0A8C8 33D70000F89C    	   273:                 move.w  (sp),MON_SSW            ; special status word
01:00F0A8CE 23EF00020000F898	   274:                 move.l  2(sp),MON_FADDR         ; THE ACCESS ADDRESS
01:00F0A8D6 33EF00080000F840	   275:                 move.w  8(sp),MON_SSR
01:00F0A8DE 23EF000A0000F83C	   276:                 move.l  10(sp),MON_SPC
01:00F0A8E6 60000016        	   277:                 bra.w   monitor_common
                            	   278: 
                            	   279: ;================================================================
                            	   280: ; mon_dead — nested fault.  Touch NO I/O (the I/O is what is broken)
                            	   281: ; and do not let the stack creep: re-anchor SP every pass, mark RAM so
                            	   282: ; a later RAM dump shows how we got here, and stop the CPU.  STOP with
                            	   283: ; IPL 7 still admits a level-7 NMI, so loop back and re-stop instead of
                            	   284: ; falling through into whatever follows.
                            	   285: ;================================================================
                            	   286: mon_dead:
01:00F0A8EA 2E7C0000FF00    	   287:                 movea.l #MON_STACK,sp           ; re-anchor: no creep
01:00F0A8F0 13FC00020000F895	   288:                 move.b  #2,MON_NEST             ; sticky post-mortem marker
01:00F0A8F8 4E722700        	   289:                 stop    #$2700
01:00F0A8FC 60EC            	   290:                 bra.b   mon_dead
                            	   291: 
                            	   292: monitor_common:
                            	   293:                 ; cold_init runs on the COLD path only, so on the panic path
                            	   294:                 ; MON_ABORT would be whatever the firmware left in DRAM -- and
                            	   295:                 ; every getchar reads it.  Clear it here, which both entries
                            	   296:                 ; reach, rather than relying on cmd_loop happening to write
                            	   297:                 ; MON_CMDSP before the first character arrives.
01:00F0A8FE 13FC00000000F848	   298:                 move.b  #0,MON_ABORT
01:00F0A906 61000B44        	   299:                 bsr.w   sio_init
01:00F0A90A 61000C04        	   300:                 bsr.w   put_crlf
01:00F0A90E 61000C00        	   301:                 bsr.w   put_crlf
01:00F0A912 41FA17FA        	   302:                 lea     banner_msg(pc),a0
01:00F0A916 61000BEC        	   303:                 bsr.w   puts
01:00F0A91A 41FA18A7        	   304:                 lea     entry_msg(pc),a0
01:00F0A91E 61000BE4        	   305:                 bsr.w   puts
01:00F0A922 20390000F83C    	   306:                 move.l  MON_SPC,d0
01:00F0A928 61000C2A        	   307:                 bsr.w   puthex_long
01:00F0A92C 41FA18A5        	   308:                 lea     sr_msg(pc),a0
01:00F0A930 61000BD2        	   309:                 bsr.w   puts
01:00F0A934 30390000F840    	   310:                 move.w  MON_SSR,d0
01:00F0A93A 61000C0C        	   311:                 bsr.w   puthex_word
                            	   312:                 ; A group-0 frame carries the address that actually faulted.
                            	   313:                 ; Report it here: "bus error at PC X" without it says nothing
                            	   314:                 ; about WHAT the access touched, and on this board the answer
                            	   315:                 ; is usually a device that did not answer.
01:00F0A93E 0C3900010000F894	   316:                 cmpi.b  #1,MON_GRP0
01:00F0A946 6624            	   317:                 bne.b   .no_faddr
01:00F0A948 41FA1890        	   318:                 lea     faddr_msg(pc),a0
01:00F0A94C 61000BB6        	   319:                 bsr.w   puts
01:00F0A950 20390000F898    	   320:                 move.l  MON_FADDR,d0
01:00F0A956 61000BFC        	   321:                 bsr.w   puthex_long
01:00F0A95A 41FA1888        	   322:                 lea     ssw_msg(pc),a0
01:00F0A95E 61000BA4        	   323:                 bsr.w   puts
01:00F0A962 30390000F89C    	   324:                 move.w  MON_SSW,d0
01:00F0A968 61000BDE        	   325:                 bsr.w   puthex_word
                            	   326: .no_faddr:
01:00F0A96C 61000BA2        	   327:                 bsr.w   put_crlf
                            	   328: 
                            	   329: cmd_loop:
                            	   330:                 ; We reached the prompt, so the I/O path works: re-arm the
                            	   331:                 ; guard so a later fault is reportable too.
01:00F0A970 13FC00000000F895	   332:                 move.b  #0,MON_NEST
01:00F0A978 23CF0000F844    	   333:                 move.l  sp,MON_CMDSP            ; re-taken every pass, so the
                            	   334:                                                 ;   abort anchor cannot go stale
01:00F0A97E 41FA186C        	   335:                 lea     prompt_msg(pc),a0
01:00F0A982 61000B80        	   336:                 bsr.w   puts
01:00F0A986 61000810        	   337:                 bsr.w   read_line               ; reads into MON_LINEBUF, term=0
01:00F0A98A 4DF90000F850    	   338:                 lea     MON_LINEBUF,a6          ; a6 = parse pointer
01:00F0A990 610008AA        	   339:                 bsr.w   skip_ws
01:00F0A994 1016            	   340:                 move.b  (a6),d0
