01:00F0B5E8 6000F35E        	  1734:                 bra.w   cmd_loop
                            	  1735: 
                            	  1736: ; ---- ch_window: d5 = channel 1..4 -> a4 = window base, a5 = BIM CR ----
                            	  1737: ;      window = $FF0000 + ((ch+1) << 5)      [firmware's own $F04CAA]
                            	  1738: ;      BIM CR = ac_bimcr[(ch-1)]             [firmware's table $F046E0]
                            	  1739: ch_window:
01:00F0B5EC 2005            	  1740:                 move.l  d5,d0
01:00F0B5EE 5280            	  1741:                 addq.l  #1,d0
01:00F0B5F0 EB88            	  1742:                 lsl.l   #5,d0
01:00F0B5F2 068000FF0000    	  1743:                 addi.l  #$FF0000,d0
01:00F0B5F8 2840            	  1744:                 move.l  d0,a4
01:00F0B5FA 2005            	  1745:                 move.l  d5,d0
01:00F0B5FC 5380            	  1746:                 subq.l  #1,d0
01:00F0B5FE E588            	  1747:                 lsl.l   #2,d0
01:00F0B600 41FA0440        	  1748:                 lea     ac_bimcr(pc),a0
01:00F0B604 2A700800        	  1749:                 move.l  0(a0,d0.l),a5
01:00F0B608 4E75            	  1750:                 rts
                            	  1751: 
                            	  1752: ;================================================================
                            	  1753: ; TIER 4 — resident ISR taps on the four channel BIM vectors
                            	  1754: ;
                            	  1755: ;   s     arm taps on channels 1-4
                            	  1756: ;   s-    disarm, restoring the original vectors
                            	  1757: ;   sl    list the capture ring
                            	  1758: ;   sc    clear the ring
                            	  1759: ;   s+    start PTM timer 1 free-running, for timestamps
                            	  1760: ;
                            	  1761: ; This is the tier that argues for ROM residency: everything else the
                            	  1762: ; probe does can be a transient stub poked into RAM and jumped to, but
                            	  1763: ; an interrupt handler must still be there when the interrupt arrives.
                            	  1764: ;
                            	  1765: ; Vectors $45-$48 are the four XP channel BIMs — $FF0244/$46/$50/$52
                            	  1766: ; programmed to $5F (level 7, IRE set), with handlers $F07EE6,
                            	  1767: ; $F074E6, $F06AE6 and $F060CE.  Vector n lives at n*4, so the four
                            	  1768: ; addresses are $114 $118 $11C $120.
                            	  1769: ;
                            	  1770: ; The tap CHAINS: it latches +$0E, +$08 and +$0A into a ring and then
                            	  1771: ; transfers to the original handler, so on an image where the RTOS is
                            	  1772: ; running the firmware still services its own channel.  The one
                            	  1773: ; exception is cold_init's filler — it points all 256 vectors at
                            	  1774: ; monitor_entry, so a tap that chained there would drop into the
                            	  1775: ; prompt on every interrupt.  When the saved vector IS monitor_entry
                            	  1776: ; there is nobody else to service it and the tap simply RTEs.
                            	  1777: ;
                            	  1778: ; The three registers latched are exactly the three the firmware's own
                            	  1779: ; channel ISR latches, into $1066+(ch-1)*6 as {status, data-hi,
                            	  1780: ; data-lo} — and the task then consumes the data pair as ONE longword
                            	  1781: ; (move.l $1068,d1 at $F07E20), which is the direct proof that +$08
                            	  1782: ; and +$0A are halves of a single 32-bit register.
                            	  1783: ;
                            	  1784: ; TIMESTAMP: PTM timer 1, read MSB-then-LSB because reading the MSB
                            	  1785: ; latches the LSB.  T1 is an external-input counter as the firmware
                            	  1786: ; leaves it (CR1 = $00, bit 1 clear selects the external pin) and
                            	  1787: ; nothing drives that pin, so it reads a CONSTANT until `s+` switches
                            	  1788: ; it to the internal E clock.  A constant timestamp column is
                            	  1789: ; self-evidently not a timestamp, which is better than an absent one.
                            	  1790: ;
                            	  1791: ; `s+` writes CR2 bit 0 = 1 to select CR1, then CR1 = $02.  Bit 0 of
                            	  1792: ; the value is 0, so this does NOT assert the internal reset that
                            	  1793: ; would hold all three timers — but it does leave CR2's select bit
                            	  1794: ; set, and TIMER 3 IS THE RTOS SYSTEM TICK.  Safe on the --reset
                            	  1795: ; image; on the panic image the firmware's next CR3 write would land
                            	  1796: ; on CR1 instead.
                            	  1797: ;================================================================
                            	  1798: cmd_tap:
01:00F0B60A 528E            	  1799:                 addq.l  #1,a6
01:00F0B60C 1016            	  1800:                 move.b  (a6),d0
01:00F0B60E 0C00002D        	  1801:                 cmpi.b  #'-',d0
01:00F0B612 67000056        	  1802:                 beq.w   .disarm
01:00F0B616 0C00006C        	  1803:                 cmpi.b  #'l',d0
01:00F0B61A 67000108        	  1804:                 beq.w   .list
01:00F0B61E 0C000063        	  1805:                 cmpi.b  #'c',d0
01:00F0B622 67000090        	  1806:                 beq.w   .clear
01:00F0B626 0C00002B        	  1807:                 cmpi.b  #'+',d0
01:00F0B62A 670000AC        	  1808:                 beq.w   .startt1
                            	  1809: 
                            	  1810:                 ; ---- arm ----
01:00F0B62E 41FA0422        	  1811:                 lea     tap_vec(pc),a0          ; tap entry points
01:00F0B632 43F90000F8D8    	  1812:                 lea     MON_TAPSAV,a1
01:00F0B638 7400            	  1813:                 moveq   #0,d2                   ; channel index 0..3
                            	  1814: .aloop:
01:00F0B63A 2002            	  1815:                 move.l  d2,d0
01:00F0B63C E588            	  1816:                 lsl.l   #2,d0
01:00F0B63E 45F80114        	  1817:                 lea     $114,a2
01:00F0B642 D5C0            	  1818:                 adda.l  d0,a2                   ; a2 = vector address
01:00F0B644 2292            	  1819:                 move.l  (a2),(a1)               ; save original
01:00F0B646 24B00800        	  1820:                 move.l  0(a0,d0.l),(a2)         ; install tap
01:00F0B64A 5889            	  1821:                 addq.l  #4,a1
01:00F0B64C 5282            	  1822:                 addq.l  #1,d2
01:00F0B64E 0C8200000004    	  1823:                 cmpi.l  #4,d2
01:00F0B654 6DE4            	  1824:                 blt.b   .aloop
01:00F0B656 13FC000F0000F8D0	  1825:                 move.b  #$0F,MON_TAPMSK
01:00F0B65E 41FA109A        	  1826:                 lea     tap_on_msg(pc),a0
01:00F0B662 6100FD60        	  1827:                 bsr.w   puts
01:00F0B666 6000F2E0        	  1828:                 bra.w   cmd_loop
