                            	   385: ;----------------------------------------------------------------
                            	   386: ; Memory display (default 16 bytes from last addr or parsed addr)
                            	   387: ;   m            -> dump 16 bytes from MON_LASTADDR
                            	   388: ;   m XXXXXX     -> set MON_LASTADDR, dump 16 bytes
                            	   389: ;   m XXXXXX YY  -> dump YY bytes (hex count)
                            	   390: ;----------------------------------------------------------------
                            	   391: cmd_mem:
                            	   392:                 ; d7 = access width: 1 byte (default), 2 word, 4 long.
                            	   393:                 ; The byte form is kept because the MC6840 PTM and the SIO
                            	   394:                 ; are odd-byte-only on D0-D7 and must be reached with
                            	   395:                 ; move.b; the wide forms exist because the AP I/F and XLTR
                            	   396:                 ; are 16-bit-only blocks that move.b cannot drive at all.
01:00F0AAB6 7E01            	   397:                 moveq   #1,d7
01:00F0AAB8 528E            	   398:                 addq.l  #1,a6
01:00F0AABA 1016            	   399:                 move.b  (a6),d0
01:00F0AABC 0C000077        	   400:                 cmpi.b  #'w',d0
01:00F0AAC0 6708            	   401:                 beq.b   .w16
01:00F0AAC2 0C00006C        	   402:                 cmpi.b  #'l',d0
01:00F0AAC6 6708            	   403:                 beq.b   .w32
01:00F0AAC8 600A            	   404:                 bra.b   .havew
