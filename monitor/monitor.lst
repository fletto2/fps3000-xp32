Sections:
00: "segf0a826" (F0A826-F0A838)
01: "segf0a840" (F0A840-F0B802)


Source: "monitor.s"
                            	     1: ; ----------------------------------------------------------------
                            	     2: ; FPS-3000 SBC Monitor / Debugger / Host Interface
                            	     3: ; Lives in the 21.9 KB of free ROM at $F0A826 onwards.
                            	     4: ;
                            	     5: ; Communicates over the on-board NEC µPD7201 SIO Channel A
                            	     6: ; ($F70011 data, $F70015 control), which the FPS firmware never
                            	     7: ; initialises or uses — so we have it all to ourselves.
                            	     8: ;
                            	     9: ; Triggered by jumping to monitor_entry (typically by patching
                            	    10: ; one or more vectors).
                            	    11: ; ----------------------------------------------------------------
                            	    12: 
                            	    13: ; µPD7201 register addresses, per Motorola's VERSAdos source for this
                            	    14: ; board — verdos06/SDLCPRI/NEC7201.EQ, in rms68k_source.SA:
                            	    15: ;
                            	    16: ;     NEC7201 EQU $F70011      <- ODD base: the chip is on D0-D7 / LDS
                            	    17: ;     ch A data    = base+0 = $F70011
                            	    18: ;     ch B data    = base+2 = $F70013
                            	    19: ;     ch A control = base+4 = $F70015
                            	    20: ;     ch B control = base+6 = $F70017
                            	    21: ;
                            	    22: ; Registers are grouped by FUNCTION (both data, then both control), not
                            	    23: ; interleaved per channel.  Earlier versions of this file used $F70010
                            	    24: ; and $F70012, which is wrong twice over: even addresses assert UDS only
                            	    25: ; and this chip never answers them (-> no DTACK -> BERR), and the odd
                            	    26: ; byte of that second slot, $F70013, is channel B's DATA register, not
                            	    27: ; channel A's control.  Corroborated by verdos06/_root/NEC7201.EQ
                            	    28: ; (CREG/SREG = 0, DREG = -4) and by the ROM's own MC6840 access at odd
                            	    29: ; $F70001/$F70003 in PTMInit (F09176).
                            	    30: SIO_A_DATA      equ     $F70011
                            	    31: SIO_A_CTRL      equ     $F70015
                            	    32: SIO_B_DATA      equ     $F70013
                            	    33: SIO_B_CTRL      equ     $F70017
                            	    34: 
                            	    35: ; Z80-SIO/i8274 RR0 status bits
                            	    36: RR0_RX_AVAIL    equ     0
                            	    37: RR0_TX_EMPTY    equ     2
                            	    38: 
                            	    39: ; Monitor RAM workspace.
                            	    40: ;
                            	    41: ; This used to live at $1F000, which was wrong in two ways at once:
                            	    42: ;
                            	    43: ;   * $1F000 is INSIDE the AU WCS staging buffer ($10000-$1FFFF), so
                            	    44: ;     loading a full 64 KB bank — the whole point of the L command —
                            	    45: ;     would overwrite the monitor's own saved registers, line buffer and
                            	    46: ;     stack partway through the transfer.
                            	    47: ;   * The factory firmware also writes live data there.  A RAM dump after
                            	    48: ;     booting the stock ROM to the scheduler idle loop shows 40 nonzero
                            	    49: ;     bytes in $1F000-$1F09F, so entering via the panic vector clobbered
                            	    50: ;     firmware state and quietly compromised `g`.
                            	    51: ;
                            	    52: ; Measured alternative: dumping RAM after a full stock boot shows
                            	    53: ; $01200-$0FFFF — 60,928 bytes — completely untouched by the firmware.
                            	    54: ; The workspace and the cold-path stack both now live there, which puts
                            	    55: ; them below the staging buffer AND out of the firmware's way, fixing
                            	    56: ; both problems at once.
                            	    57: ;
                            	    58: ; Caveat on the evidence: "untouched after booting to idle" is not proof
                            	    59: ; that RMS68K never allocates there under load — it is a measurement of
                            	    60: ; this chassis reaching its idle loop, not a guarantee.  It is strictly
                            	    61: ; better than the old placement, which was measurably in use.
                            	    62: MON_BASE        equ     $0F800
                            	    63: MON_REGS        equ     MON_BASE        ; saved D0..D7 then A0..A6 (15*4=60 bytes)
                            	    64: MON_SPC         equ     MON_BASE+$3C    ; saved PC (long) — at MON_REGS + 60
                            	    65: MON_SSR         equ     MON_BASE+$40    ; saved SR (word)
                            	    66: MON_LINEBUF     equ     MON_BASE+$50    ; cmd line buffer (64 B)
                            	    67: MON_LASTADDR    equ     MON_BASE+$90    ; last 'm' addr (long)
                            	    68: MON_GRP0        equ     MON_BASE+$94    ; frame kind: 0 = short (4-word,
                            	    69:                                         ;   resumable), 1 = group-0 (7-word
                            	    70:                                         ;   bus/addr error), $FF = no frame
                            	    71:                                         ;   at all (cold entry)
                            	    72: MON_NEST        equ     MON_BASE+$95    ; re-entry guard: 0 = not inside a
                            	    73:                                         ;   fault report, 1 = reporting,
                            	    74:                                         ;   2 = died re-entering (sticky)
                            	    75: MON_TXFAIL      equ     MON_BASE+$96    ; nonzero once a putchar has timed
                            	    76:                                         ;   out — survives for a RAM dump
                            	    77: 
                            	    78: ; Cold-entry supervisor stack top, growing down toward the workspace end
                            	    79: ; at MON_BASE+$97.  ~1.7 KB of stack, all inside the free region.  The
                            	    80: ; panic path deliberately leaves SP alone — it needs the firmware's
                            	    81: ; exception frame where the firmware left it.
                            	    82: MON_STACK       equ     $0FF00
                            	    83: 
                            	    84: ; Region srec_check refuses to load over: workspace + cold-entry stack.
                            	    85: MON_LO          equ     MON_BASE
                            	    86: MON_HI          equ     MON_STACK
                            	    87: 
                            	    88: ; Breakpoint table: 8 slots of {addr.l, saved original word}.  A slot
                            	    89: ; with addr = 0 is free.
                            	    90: MON_BPN         equ     8
                            	    91: MON_BPT         equ     MON_BASE+$A0    ; 8 * 6 bytes = 48, ends +$CF
                            	    92: MON_BP_SZ       equ     6
                            	    93: 
                            	    94: ; TRAP #14 opcode, used as the breakpoint trap.  Vector 46 at $B8.
                            	    95: BP_OPCODE       equ     $4E4E
                            	    96: BP_VECTOR       equ     $B8
                            	    97: TRACE_VECTOR    equ     $24             ; vector 9 — T-bit trace
                            	    98: SR_TRACE_BIT    equ     15              ; T bit in SR
                            	    99: 
                            	   100: ; putchar TX-ready spin limit.  The btst loop is ~20 cycles, so this is
                            	   101: ; roughly 20M cycles / ~2.5 s at 8 MHz — comfortably longer than one
                            	   102: ; character time even at the slowest strappable rate (50 baud = 200 ms),
                            	   103: ; while still being bounded.  An unbounded spin here is why a dead SIO
                            	   104: ; produced total silence on the first hardware attempt: the monitor hung
                            	   105: ; before emitting a single byte, so there was nothing to diagnose.
                            	   106: TX_SPIN_LIMIT   equ     $100000
                            	   107: 
                            	   108:                 org     $F0A826
                            	   109: 
                            	   110: ;================================================================
                            	   111: ; Cold entry — used when monitor is patched in as the reset PC.
                            	   112: ; SP isn't loaded by the FPS reset path, so we install it ourselves
                            	   113: ; before doing anything that pushes (like bsr).
                            	   114: ;================================================================
                            	   115: monitor_cold:
00:00F0A826 007C2700        	   116:                 ori.w   #$2700,sr               ; supervisor, IPL=7
00:00F0A82A 2E7C0000FF00    	   117:                 movea.l #MON_STACK,sp           ; supervisor stack (below
                            	   118:                                                 ;   the WCS staging buffer)
00:00F0A830 610008D6        	   119:                 bsr.w   cold_init               ; vectors + workspace
00:00F0A834 60000088        	   120:                 bra.w   monitor_common
                            	   121: 
                            	   122: ; monitor_entry MUST stay at $F0A840: patch_rom.py hardcodes
                            	   123: ; MON_ENTRY = 0xA840, and README.md / CLAUDE.md both document that
                            	   124: ; address.  Pinning it here means edits to monitor_cold above cannot
                            	   125: ; silently shift it and send the panic-vector patch into the middle of
                            	   126: ; an instruction.  vasm errors out if monitor_cold ever overflows.
                            	   127:                 org     $F0A840
                            	   128: 
                            	   129: ;================================================================
                            	   130: ; Exception entry — called as JMP target from patched vectors.
                            	   131: ;
                            	   132: ; If entered via an exception, the supervisor stack contains the
                            	   133: ; standard 7-word frame (or 4-word for IRQ).  We save D0-D7/A0-A6
                            	   134: ; into MON_REGS, then read the saved PC and SR from the stack.
                            	   135: ;================================================================
                            	   136: monitor_entry:
                            	   137:                 ; Re-entry guard FIRST, before clobbering anything: if we
                            	   138:                 ; are already reporting a fault, the fault is coming from
                            	   139:                 ; the monitor's own I/O path and reporting it again just
                            	   140:                 ; recurses, pushing a frame per pass until the stack eats
                            	   141:                 ; the workspace.  Bail to mon_dead and keep the FIRST
                            	   142:                 ; fault's PC/SR intact for post-mortem.
01:00F0A840 4A390000F895    	   143:                 tst.b   MON_NEST
01:00F0A846 66000062        	   144:                 bne.w   mon_dead
01:00F0A84A 13FC00010000F895	   145:                 move.b  #1,MON_NEST
                            	   146: 
01:00F0A852 48F97FFF0000F800	   147:                 movem.l d0-d7/a0-a6,MON_REGS
01:00F0A85A 13FC00000000F894	   148:                 move.b  #0,MON_GRP0             ; short frame: SR, then PC
01:00F0A862 33D70000F840    	   149:                 move.w  (sp),MON_SSR
01:00F0A868 23EF00020000F83C	   150:                 move.l  2(sp),MON_SPC
01:00F0A870 6000004C        	   151:                 bra.w   monitor_common
                            	   152: 
                            	   153: ;================================================================
                            	   154: ; grp0_entry — vectors 2 (bus error) and 3 (address error) ONLY.
                            	   155: ;
                            	   156: ; The 68000 pushes a 7-word group-0 frame, which is NOT laid out like
                            	   157: ; the 4-word frame every other exception uses:
                            	   158: ;
                            	   159: ;   (sp)+0  special status word
                            	   160: ;   (sp)+2  access address (long)
                            	   161: ;   (sp)+6  instruction register
                            	   162: ;   (sp)+8  status register      <- SR lives here, not at (sp)
                            	   163: ;   (sp)+10 program counter      <- PC lives here, not at 2(sp)
                            	   164: ;
                            	   165: ; Reading it as a short frame reports the SSW as "SR" and half the
                            	   166: ; fault address as "PC", which is worse than useless during bring-up.
                            	   167: ; Group-0 faults are also not resumable on a 68000, so flag the frame
                            	   168: ; and let cmd_go refuse rather than RTE into the weeds.
                            	   169: ;================================================================
                            	   170: grp0_entry:
01:00F0A874 4A390000F895    	   171:                 tst.b   MON_NEST
01:00F0A87A 6600002E        	   172:                 bne.w   mon_dead
01:00F0A87E 13FC00010000F895	   173:                 move.b  #1,MON_NEST
                            	   174: 
01:00F0A886 48F97FFF0000F800	   175:                 movem.l d0-d7/a0-a6,MON_REGS
01:00F0A88E 13FC00010000F894	   176:                 move.b  #1,MON_GRP0             ; group-0: not resumable
01:00F0A896 33EF00080000F840	   177:                 move.w  8(sp),MON_SSR
01:00F0A89E 23EF000A0000F83C	   178:                 move.l  10(sp),MON_SPC
01:00F0A8A6 60000016        	   179:                 bra.w   monitor_common
                            	   180: 
                            	   181: ;================================================================
                            	   182: ; mon_dead — nested fault.  Touch NO I/O (the I/O is what is broken)
                            	   183: ; and do not let the stack creep: re-anchor SP every pass, mark RAM so
                            	   184: ; a later RAM dump shows how we got here, and stop the CPU.  STOP with
                            	   185: ; IPL 7 still admits a level-7 NMI, so loop back and re-stop instead of
                            	   186: ; falling through into whatever follows.
                            	   187: ;================================================================
                            	   188: mon_dead:
01:00F0A8AA 2E7C0000FF00    	   189:                 movea.l #MON_STACK,sp           ; re-anchor: no creep
01:00F0A8B0 13FC00020000F895	   190:                 move.b  #2,MON_NEST             ; sticky post-mortem marker
01:00F0A8B8 4E722700        	   191:                 stop    #$2700
01:00F0A8BC 60EC            	   192:                 bra.b   mon_dead
                            	   193: 
                            	   194: monitor_common:
                            	   195: 
01:00F0A8BE 610008CC        	   196:                 bsr.w   sio_init
01:00F0A8C2 61000952        	   197:                 bsr.w   put_crlf
01:00F0A8C6 6100094E        	   198:                 bsr.w   put_crlf
01:00F0A8CA 41FA099A        	   199:                 lea     banner_msg(pc),a0
01:00F0A8CE 6100093A        	   200:                 bsr.w   puts
01:00F0A8D2 41FA0A47        	   201:                 lea     entry_msg(pc),a0
01:00F0A8D6 61000932        	   202:                 bsr.w   puts
01:00F0A8DA 20390000F83C    	   203:                 move.l  MON_SPC,d0
01:00F0A8E0 61000978        	   204:                 bsr.w   puthex_long
01:00F0A8E4 41FA0A45        	   205:                 lea     sr_msg(pc),a0
01:00F0A8E8 61000920        	   206:                 bsr.w   puts
01:00F0A8EC 30390000F840    	   207:                 move.w  MON_SSR,d0
01:00F0A8F2 6100095A        	   208:                 bsr.w   puthex_word
01:00F0A8F6 6100091E        	   209:                 bsr.w   put_crlf
                            	   210: 
                            	   211: cmd_loop:
                            	   212:                 ; We reached the prompt, so the I/O path works: re-arm the
                            	   213:                 ; guard so a later fault is reportable too.
01:00F0A8FA 13FC00000000F895	   214:                 move.b  #0,MON_NEST
01:00F0A902 41FA0A2E        	   215:                 lea     prompt_msg(pc),a0
01:00F0A906 61000902        	   216:                 bsr.w   puts
01:00F0A90A 610006C2        	   217:                 bsr.w   read_line               ; reads into MON_LINEBUF, term=0
01:00F0A90E 4DF90000F850    	   218:                 lea     MON_LINEBUF,a6          ; a6 = parse pointer
01:00F0A914 61000716        	   219:                 bsr.w   skip_ws
01:00F0A918 1016            	   220:                 move.b  (a6),d0
01:00F0A91A 67DE            	   221:                 beq.b   cmd_loop                ; empty line
                            	   222: 
01:00F0A91C 0C00003F        	   223:                 cmpi.b  #'?',d0
01:00F0A920 67000066        	   224:                 beq.w   cmd_help
01:00F0A924 0C000068        	   225:                 cmpi.b  #'h',d0
01:00F0A928 6700005E        	   226:                 beq.w   cmd_help
01:00F0A92C 0C000072        	   227:                 cmpi.b  #'r',d0
01:00F0A930 6700006E        	   228:                 beq.w   cmd_regs
01:00F0A934 0C00006D        	   229:                 cmpi.b  #'m',d0
01:00F0A938 670000F6        	   230:                 beq.w   cmd_mem
01:00F0A93C 0C000064        	   231:                 cmpi.b  #'d',d0
01:00F0A940 6700014A        	   232:                 beq.w   cmd_dump
01:00F0A944 0C000077        	   233:                 cmpi.b  #'w',d0
01:00F0A948 67000146        	   234:                 beq.w   cmd_write
01:00F0A94C 0C000067        	   235:                 cmpi.b  #'g',d0
01:00F0A950 67000172        	   236:                 beq.w   cmd_go
01:00F0A954 0C00004C        	   237:                 cmpi.b  #'L',d0
01:00F0A958 67000494        	   238:                 beq.w   cmd_load_srec
01:00F0A95C 0C000069        	   239:                 cmpi.b  #'i',d0
01:00F0A960 67000404        	   240:                 beq.w   cmd_info
01:00F0A964 0C000021        	   241:                 cmpi.b  #'!',d0
01:00F0A968 6700002A        	   242:                 beq.w   cmd_about
01:00F0A96C 0C000062        	   243:                 cmpi.b  #'b',d0
01:00F0A970 6700020C        	   244:                 beq.w   cmd_bp
01:00F0A974 0C000074        	   245:                 cmpi.b  #'t',d0
01:00F0A978 67000398        	   246:                 beq.w   cmd_trace
                            	   247: 
01:00F0A97C 41FA09BC        	   248:                 lea     unknown_msg(pc),a0
01:00F0A980 61000888        	   249:                 bsr.w   puts
01:00F0A984 6000FF74        	   250:                 bra.w   cmd_loop
                            	   251: 
                            	   252: ;----------------------------------------------------------------
                            	   253: ; Help — print command list
                            	   254: ;----------------------------------------------------------------
                            	   255: cmd_help:
01:00F0A988 41FA09C8        	   256:                 lea     help_msg(pc),a0
01:00F0A98C 6100087C        	   257:                 bsr.w   puts
01:00F0A990 6000FF68        	   258:                 bra.w   cmd_loop
                            	   259: 
                            	   260: ;----------------------------------------------------------------
                            	   261: ; About / Banner
                            	   262: ;----------------------------------------------------------------
                            	   263: cmd_about:
01:00F0A994 41FA08D0        	   264:                 lea     banner_msg(pc),a0
01:00F0A998 61000870        	   265:                 bsr.w   puts
01:00F0A99C 6000FF5C        	   266:                 bra.w   cmd_loop
                            	   267: 
                            	   268: ;----------------------------------------------------------------
                            	   269: ; Show registers
                            	   270: ;   format:
                            	   271: ;     D0=12345678  D1=12345678  D2=12345678  D3=12345678
                            	   272: ;     D4=12345678  D5=12345678  D6=12345678  D7=12345678
                            	   273: ;     A0=12345678  A1=12345678  A2=12345678  A3=12345678
                            	   274: ;     A4=12345678  A5=12345678  A6=12345678
                            	   275: ;     PC=12345678  SR=1234
                            	   276: ;----------------------------------------------------------------
                            	   277: cmd_regs:
01:00F0A9A0 7400            	   278:                 moveq   #0,d2                   ; reg index 0..14
                            	   279: .loop:
01:00F0A9A2 7600            	   280:                 moveq   #0,d3
01:00F0A9A4 1602            	   281:                 move.b  d2,d3
01:00F0A9A6 0C030008        	   282:                 cmpi.b  #8,d3
01:00F0A9AA 6D08            	   283:                 blt.b   .is_d
01:00F0A9AC 103C0041        	   284:                 move.b  #'A',d0
01:00F0A9B0 5103            	   285:                 subi.b  #8,d3
01:00F0A9B2 6004            	   286:                 bra.b   .show
                            	   287: .is_d:
01:00F0A9B4 103C0044        	   288:                 move.b  #'D',d0
                            	   289: .show:
01:00F0A9B8 61000814        	   290:                 bsr.w   putchar
01:00F0A9BC 1003            	   291:                 move.b  d3,d0
01:00F0A9BE 06000030        	   292:                 addi.b  #'0',d0
01:00F0A9C2 6100080A        	   293:                 bsr.w   putchar
01:00F0A9C6 103C003D        	   294:                 move.b  #'=',d0
01:00F0A9CA 61000802        	   295:                 bsr.w   putchar
                            	   296:                 ; load reg from MON_REGS[d2*4]
01:00F0A9CE 3002            	   297:                 move.w  d2,d0
01:00F0A9D0 E548            	   298:                 lsl.w   #2,d0
01:00F0A9D2 41F90000F800    	   299:                 lea     MON_REGS,a0
01:00F0A9D8 20300000        	   300:                 move.l  (a0,d0.w),d0
01:00F0A9DC 6100087C        	   301:                 bsr.w   puthex_long
01:00F0A9E0 103C0020        	   302:                 move.b  #' ',d0
01:00F0A9E4 610007E8        	   303:                 bsr.w   putchar
01:00F0A9E8 610007E4        	   304:                 bsr.w   putchar
01:00F0A9EC 5202            	   305:                 addq.b  #1,d2
                            	   306:                 ; new line every 4 regs
01:00F0A9EE 1002            	   307:                 move.b  d2,d0
01:00F0A9F0 02000003        	   308:                 andi.b  #3,d0
01:00F0A9F4 6604            	   309:                 bne.b   .nonl
01:00F0A9F6 6100081E        	   310:                 bsr.w   put_crlf
                            	   311: .nonl:
01:00F0A9FA 0C02000F        	   312:                 cmpi.b  #15,d2
01:00F0A9FE 6DA2            	   313:                 blt.b   .loop
01:00F0AA00 61000814        	   314:                 bsr.w   put_crlf
01:00F0AA04 41FA0DF0        	   315:                 lea     pcmsg(pc),a0
01:00F0AA08 61000800        	   316:                 bsr.w   puts
01:00F0AA0C 20390000F83C    	   317:                 move.l  MON_SPC,d0
01:00F0AA12 61000846        	   318:                 bsr.w   puthex_long
01:00F0AA16 41FA0DE3        	   319:                 lea     srmsg(pc),a0
01:00F0AA1A 610007EE        	   320:                 bsr.w   puts
01:00F0AA1E 30390000F840    	   321:                 move.w  MON_SSR,d0
01:00F0AA24 61000828        	   322:                 bsr.w   puthex_word
01:00F0AA28 610007EC        	   323:                 bsr.w   put_crlf
01:00F0AA2C 6000FECC        	   324:                 bra.w   cmd_loop
                            	   325: 
                            	   326: ;----------------------------------------------------------------
                            	   327: ; Memory display (default 16 bytes from last addr or parsed addr)
                            	   328: ;   m            -> dump 16 bytes from MON_LASTADDR
                            	   329: ;   m XXXXXX     -> set MON_LASTADDR, dump 16 bytes
                            	   330: ;   m XXXXXX YY  -> dump YY bytes (hex count)
                            	   331: ;----------------------------------------------------------------
                            	   332: cmd_mem:
01:00F0AA30 528E            	   333:                 addq.l  #1,a6
01:00F0AA32 610005F8        	   334:                 bsr.w   skip_ws
01:00F0AA36 1016            	   335:                 move.b  (a6),d0
01:00F0AA38 6710            	   336:                 beq.b   .use_last
01:00F0AA3A 61000604        	   337:                 bsr.w   parse_hex
01:00F0AA3E 4A01            	   338:                 tst.b   d1
01:00F0AA40 6700003E        	   339:                 beq.w   cmd_err
01:00F0AA44 23C00000F890    	   340:                 move.l  d0,MON_LASTADDR
                            	   341: .use_last:
01:00F0AA4A 610005E0        	   342:                 bsr.w   skip_ws
01:00F0AA4E 7410            	   343:                 moveq   #16,d2                  ; default count
01:00F0AA50 1016            	   344:                 move.b  (a6),d0
01:00F0AA52 6718            	   345:                 beq.b   .do
01:00F0AA54 610005EA        	   346:                 bsr.w   parse_hex
01:00F0AA58 4A01            	   347:                 tst.b   d1
01:00F0AA5A 67000024        	   348:                 beq.w   cmd_err
01:00F0AA5E 2400            	   349:                 move.l  d0,d2
01:00F0AA60 0C8200000080    	   350:                 cmpi.l  #128,d2
01:00F0AA66 6F04            	   351:                 ble.b   .do
01:00F0AA68 7480            	   352:                 moveq   #-128,d2
01:00F0AA6A 4482            	   353:                 neg.l   d2
