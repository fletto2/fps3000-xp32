                            	  2069:                 ; --- the latch discriminator ---
01:00F0B6BC 4A82            	  2070:                 tst.l   d2
01:00F0B6BE 6610            	  2071:                 bne.b   .cont_chk               ; it took at least one poll
01:00F0B6C0 302C000A        	  2072:                 move.w  $A(a4),d0
01:00F0B6C4 B046            	  2073:                 cmp.w   d6,d0
01:00F0B6C6 6608            	  2074:                 bne.b   .cont_chk               ; data low is not our opcode
01:00F0B6C8 41FA15DE        	  2075:                 lea     ac_latch_msg(pc),a0
01:00F0B6CC 6100FE36        	  2076:                 bsr.w   puts
                            	  2077: .cont_chk:
                            	  2078:                 ; --- the CONTINUE phase, $8005 ---
                            	  2079:                 ; The firmware's primitive is TWO phases, not one: $F07F12
                            	  2080:                 ; opens with $8004 and $F07F90 then writes d2 across the data
                            	  2081:                 ; pair and issues $8005 CONTINUE-TRANSFER, polling identically
                            	  2082:                 ; and reporting panel $26B on error.  A normal channel request
                            	  2083:                 ; is in fact two back-to-back transactions -- op $10 to open,
                            	  2084:                 ; then op $0E carrying a longword -- so a command that can only
                            	  2085:                 ; issue $8004 cannot reproduce one.
                            	  2086:                 ;
                            	  2087:                 ; Gated on phase 1 having actually completed: continuing a
                            	  2088:                 ; transfer that never started would write the pair and issue a
                            	  2089:                 ; verb into a channel that is not listening.
01:00F0B6D0 200A            	  2090:                 move.l  a2,d0
01:00F0B6D2 0C8000000001    	  2091:                 cmpi.l  #1,d0
01:00F0B6D8 6670            	  2092:                 bne.b   .tear
01:00F0B6DA 302C000E        	  2093:                 move.w  $E(a4),d0
01:00F0B6DE 0800000E        	  2094:                 btst    #14,d0                  ; DONE from phase 1?
01:00F0B6E2 6766            	  2095:                 beq.b   .tear
01:00F0B6E4 41FA163D        	  2096:                 lea     ac_cont_msg(pc),a0
01:00F0B6E8 6100FE1A        	  2097:                 bsr.w   puts
01:00F0B6EC 200B            	  2098:                 move.l  a3,d0
01:00F0B6EE 4840            	  2099:                 swap    d0
01:00F0B6F0 39400008        	  2100:                 move.w  d0,8(a4)                ; +$08 = high half
01:00F0B6F4 200B            	  2101:                 move.l  a3,d0
01:00F0B6F6 3940000A        	  2102:                 move.w  d0,$A(a4)               ; +$0A = low half
01:00F0B6FA 397C8005000E    	  2103:                 move.w  #$8005,$E(a4)           ; CONTINUE-TRANSFER
01:00F0B700 6100006C        	  2104:                 bsr.w   ac_poll
01:00F0B704 6044            	  2105:                 bra.b   .tear
