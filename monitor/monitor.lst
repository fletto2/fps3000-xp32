01:00F0B7B0 41FA14CC        	  2210:                 lea     ac_poll_msg(pc),a0
01:00F0B7B4 6100FD4E        	  2211:                 bsr.w   puts
01:00F0B7B8 2002            	  2212:                 move.l  d2,d0
01:00F0B7BA 6100FD98        	  2213:                 bsr.w   puthex_long
01:00F0B7BE 41FA14C8        	  2214:                 lea     ac_data_msg(pc),a0
01:00F0B7C2 6100FD40        	  2215:                 bsr.w   puts
01:00F0B7C6 302C0008        	  2216:                 move.w  8(a4),d0
01:00F0B7CA 6100FD7C        	  2217:                 bsr.w   puthex_word
01:00F0B7CE 103C003A        	  2218:                 move.b  #':',d0
01:00F0B7D2 6100FCBA        	  2219:                 bsr.w   putchar
01:00F0B7D6 302C000A        	  2220:                 move.w  $A(a4),d0
01:00F0B7DA 6100FD6C        	  2221:                 bsr.w   puthex_word
01:00F0B7DE 6100FD30        	  2222:                 bsr.w   put_crlf
01:00F0B7E2 4E75            	  2223:                 rts
                            	  2224: 
                            	  2225: ; ---- ch_window: d5 = channel 1..4 -> a4 = window base, a5 = BIM CR ----
                            	  2226: ;      window = $FF0000 + ((ch+1) << 5)      [firmware's own $F04CAA]
                            	  2227: ;      BIM CR = ac_bimcr[(ch-1)]             [firmware's table $F046E0]
                            	  2228: ch_window:
01:00F0B7E4 2005            	  2229:                 move.l  d5,d0
01:00F0B7E6 5280            	  2230:                 addq.l  #1,d0
01:00F0B7E8 EB88            	  2231:                 lsl.l   #5,d0
01:00F0B7EA 068000FF0000    	  2232:                 addi.l  #$FF0000,d0
01:00F0B7F0 2840            	  2233:                 move.l  d0,a4
01:00F0B7F2 2005            	  2234:                 move.l  d5,d0
01:00F0B7F4 5380            	  2235:                 subq.l  #1,d0
01:00F0B7F6 E588            	  2236:                 lsl.l   #2,d0
01:00F0B7F8 41FA0670        	  2237:                 lea     ac_bimcr(pc),a0
01:00F0B7FC 2A700800        	  2238:                 move.l  0(a0,d0.l),a5
01:00F0B800 4E75            	  2239:                 rts
                            	  2240: 
                            	  2241: ;================================================================
                            	  2242: ; TIER 4 — resident ISR taps on the four channel BIM vectors
                            	  2243: ;
                            	  2244: ;   s     arm taps on channels 1-4
                            	  2245: ;   s-    disarm, restoring the original vectors
                            	  2246: ;   sl    list the capture ring
                            	  2247: ;   sc    clear the ring
                            	  2248: ;   s+    start PTM timer 3 free-running (--reset image only; the RTOS
                            	  2249: ;         programs T3 itself, so this is refused when it owns the tick)
                            	  2250: ;
                            	  2251: ; This is the tier that argues for ROM residency: everything else the
                            	  2252: ; probe does can be a transient stub poked into RAM and jumped to, but
                            	  2253: ; an interrupt handler must still be there when the interrupt arrives.
                            	  2254: ;
                            	  2255: ; Vectors $45-$48 are the four XP channel BIMs — $FF0244/$46/$50/$52
                            	  2256: ; programmed to $5F (level 7, IRE set), with handlers $F07EE6,
                            	  2257: ; $F074E6, $F06AE6 and $F060CE.  Vector n lives at n*4, so the four
                            	  2258: ; addresses are $114 $118 $11C $120.
                            	  2259: ;
                            	  2260: ; The tap CHAINS: it latches +$0E, +$08 and +$0A into a ring and then
                            	  2261: ; transfers to the original handler, so on an image where the RTOS is
                            	  2262: ; running the firmware still services its own channel.  The one
                            	  2263: ; exception is cold_init's filler — it points all 256 vectors at
                            	  2264: ; monitor_entry, so a tap that chained there would drop into the
                            	  2265: ; prompt on every interrupt.  When the saved vector IS monitor_entry
                            	  2266: ; there is nobody else to service it and the tap simply RTEs.
                            	  2267: ;
                            	  2268: ; The three registers latched are exactly the three the firmware's own
                            	  2269: ; channel ISR latches, into $1066+(ch-1)*6 as {status, data-hi,
                            	  2270: ; data-lo} — and the task then consumes the data pair as ONE longword
                            	  2271: ; (move.l $1068,d1 at $F07E20), which is the direct proof that +$08
                            	  2272: ; and +$0A are halves of a single 32-bit register.
                            	  2273: ;
                            	  2274: ; TIMESTAMP: PTM timer THREE ($F7000D MSB, $F7000F LSB), read
                            	  2275: ; MSB-then-LSB because reading the MSB latches the LSB.  T3 rather
                            	  2276: ; than T1 for two reasons: it is the counter the firmware's own
                            	  2277: ; sub-tick clock reads (TRAP #0 $1C at $F00F96), so tap and RTOS agree
                            	  2278: ; on what time is; and on the PANIC image the RTOS has already
                            	  2279: ; programmed it, so timestamps work with NO PTM write from us at all.
                            	  2280: ;
                            	  2281: ; (The `s+` sub-command and the .startt1 label keep their historical
                            	  2282: ; names.  They program T3.)
                            	  2283: ;
                            	  2284: ; What each image gives you:
                            	  2285: ;
                            	  2286: ;   panic   T3 already free-running, latch $27C7, DUAL 8-BIT mode
                            	  2287: ;           (CR3 = $C6, bit 2).  Timestamps need nothing.  But the
                            	  2288: ;           halves are INDEPENDENT counters -- the LSB reloads from
                            	  2289: ;           199, not from 255 -- so a concatenated MSB:LSB read is a
                            	  2290: ;           usable ORDERING marker and NOT a linear count.  Do not
                            	  2291: ;           subtract two of them and call the result a duration.
                            	  2292: ;   --reset no RTOS, so T3 is unprogrammed and reads a constant until
                            	  2293: ;           `s+`.  There it IS 16-bit continuous, and differences are
                            	  2294: ;           linear at 1.25 us per count.
                            	  2295: ;
                            	  2296: ; `s+` is refused unless the tick vector shows the RTOS is absent --
                            	  2297: ; see .startt1.  An earlier version of this comment warned instead
                            	  2298: ; that `s+` leaves CR2's select bit set so "the firmware's next CR3
                            	  2299: ; write would land on CR1".  That warning was void: the firmware's
                            	  2300: ; own init ($F0A2DE) leaves the select bit at 1 too, and it sets the
                            	  2301: ; bit explicitly before touching either register rather than assuming.
                            	  2302: ; The real hazard is the one now enforced -- `s+` stops the tick.
                            	  2303: ;================================================================
                            	  2304: cmd_tap:
01:00F0B802 528E            	  2305:                 addq.l  #1,a6
01:00F0B804 1016            	  2306:                 move.b  (a6),d0
01:00F0B806 0C00002D        	  2307:                 cmpi.b  #'-',d0
01:00F0B80A 67000060        	  2308:                 beq.w   .disarm
01:00F0B80E 0C00006C        	  2309:                 cmpi.b  #'l',d0
01:00F0B812 67000136        	  2310:                 beq.w   .list
01:00F0B816 0C000063        	  2311:                 cmpi.b  #'c',d0
01:00F0B81A 670000A6        	  2312:                 beq.w   .clear
01:00F0B81E 0C00002B        	  2313:                 cmpi.b  #'+',d0
01:00F0B822 670000C2        	  2314:                 beq.w   .startt1
                            	  2315: 
                            	  2316:                 ; ---- arm ----
                            	  2317:                 ; Refuse a SECOND arm.  The disarm below guards on
                            	  2318:                 ; MON_TAPMSK and this did not, so `s` twice re-ran the save
                            	  2319:                 ; loop against vectors that already held tap1..tap4 -- the
                            	  2320:                 ; taps saved THEMSELVES into MON_TAPSAV.  Measured: after
                            	  2321:                 ; the second `s`, MON_TAPSAV read 00F0B8B8 00F0B8C0
                            	  2322:                 ; 00F0B8C8 00F0B8D0, and `s-` then "restored" those over
                            	  2323:                 ; the vectors, leaving the taps permanently installed while
                            	  2324:                 ; reporting success.
                            	  2325:                 ;
                            	  2326:                 ; On the panic image it is worse than untidy: the saved
                            	  2327:                 ; vector is a real firmware ISR there, so tap_body's
                            	  2328:                 ; `cmpi.l #monitor_entry,d1` no longer matches, and the
                            	  2329:                 ; chain jumps to MON_TAPSAV[ch] -- which is now the tap
                            	  2330:                 ; itself.  It re-captures, re-chains, and never reaches an
                            	  2331:                 ; rte, so the BIM is never acknowledged: typing `s` twice
                            	  2332:                 ; HANGS THE BOARD inside the ISR.  Stack-neutral per pass
                            	  2333:                 ; (movem push, movem pop, push 4, rts pops 4), so it does
                            	  2334:                 ; not even overflow into something noticeable -- it just
                            	  2335:                 ; stops.
01:00F0B826 4A390000F8D0    	  2336:                 tst.b   MON_TAPMSK
01:00F0B82C 66000088        	  2337:                 bne.w   .rearm
01:00F0B830 41FA0648        	  2338:                 lea     tap_vec(pc),a0          ; tap entry points
01:00F0B834 43F90000F8D8    	  2339:                 lea     MON_TAPSAV,a1
01:00F0B83A 7400            	  2340:                 moveq   #0,d2                   ; channel index 0..3
                            	  2341: .aloop:
01:00F0B83C 2002            	  2342:                 move.l  d2,d0
01:00F0B83E E588            	  2343:                 lsl.l   #2,d0
01:00F0B840 45F80114        	  2344:                 lea     $114,a2
01:00F0B844 D5C0            	  2345:                 adda.l  d0,a2                   ; a2 = vector address
01:00F0B846 2292            	  2346:                 move.l  (a2),(a1)               ; save original
01:00F0B848 24B00800        	  2347:                 move.l  0(a0,d0.l),(a2)         ; install tap
01:00F0B84C 5889            	  2348:                 addq.l  #4,a1
01:00F0B84E 5282            	  2349:                 addq.l  #1,d2
01:00F0B850 0C8200000004    	  2350:                 cmpi.l  #4,d2
01:00F0B856 6DE4            	  2351:                 blt.b   .aloop
01:00F0B858 13FC000F0000F8D0	  2352:                 move.b  #$0F,MON_TAPMSK
01:00F0B860 41FA1534        	  2353:                 lea     tap_on_msg(pc),a0
01:00F0B864 6100FC9E        	  2354:                 bsr.w   puts
01:00F0B868 6000F106        	  2355:                 bra.w   cmd_loop
                            	  2356: 
                            	  2357: .disarm:
01:00F0B86C 4A390000F8D0    	  2358:                 tst.b   MON_TAPMSK
01:00F0B872 67000036        	  2359:                 beq.w   .notarmed
01:00F0B876 43F90000F8D8    	  2360:                 lea     MON_TAPSAV,a1
01:00F0B87C 7400            	  2361:                 moveq   #0,d2
                            	  2362: .dloop:
01:00F0B87E 2002            	  2363:                 move.l  d2,d0
01:00F0B880 E588            	  2364:                 lsl.l   #2,d0
01:00F0B882 45F80114        	  2365:                 lea     $114,a2
01:00F0B886 D5C0            	  2366:                 adda.l  d0,a2
01:00F0B888 2491            	  2367:                 move.l  (a1),(a2)               ; restore original
01:00F0B88A 5889            	  2368:                 addq.l  #4,a1
01:00F0B88C 5282            	  2369:                 addq.l  #1,d2
01:00F0B88E 0C8200000004    	  2370:                 cmpi.l  #4,d2
01:00F0B894 6DE8            	  2371:                 blt.b   .dloop
01:00F0B896 13FC00000000F8D0	  2372:                 move.b  #0,MON_TAPMSK
01:00F0B89E 41FA153B        	  2373:                 lea     tap_off_msg(pc),a0
01:00F0B8A2 6100FC60        	  2374:                 bsr.w   puts
01:00F0B8A6 6000F0C8        	  2375:                 bra.w   cmd_loop
                            	  2376: 
                            	  2377: .notarmed:
01:00F0B8AA 41FA155A        	  2378:                 lea     tap_noarm_msg(pc),a0
01:00F0B8AE 6100FC54        	  2379:                 bsr.w   puts
01:00F0B8B2 6000F0BC        	  2380:                 bra.w   cmd_loop
                            	  2381: 
                            	  2382: .rearm:
01:00F0B8B6 41FA155B        	  2383:                 lea     tap_rearm_msg(pc),a0
01:00F0B8BA 6100FC48        	  2384:                 bsr.w   puts
01:00F0B8BE 6000F0B0        	  2385:                 bra.w   cmd_loop
                            	  2386: 
                            	  2387: .clear:
01:00F0B8C2 33FC00000000F8E8	  2388:                 move.w  #0,MON_RINGHD
01:00F0B8CA 33FC00000000F8EA	  2389:                 move.w  #0,MON_RINGN
01:00F0B8D2 33FC00000000F8EC	  2390:                 move.w  #0,MON_RINGOV
01:00F0B8DA 41FA0DED        	  2391:                 lea     ok_msg(pc),a0
01:00F0B8DE 6100FC24        	  2392:                 bsr.w   puts
01:00F0B8E2 6000F08C        	  2393:                 bra.w   cmd_loop
                            	  2394: 
                            	  2395: .startt1:
                            	  2396:                 ; REFUSE if the RTOS owns the tick.  Every step below is
                            	  2397:                 ; destructive to it: CR1 bit 0 asserts the CHIP-WIDE
                            	  2398:                 ; internal reset (all three timers, not just T3), CR3=$02
                            	  2399:                 ; replaces dual-8-bit with 16-bit continuous AND clears
                            	  2400:                 ; bit 6 so T3 stops interrupting, and the $FFFF latch
                            	  2401:                 ; replaces the firmware's $27C7 -- (39+1)*(199+1) = 8000
                            	  2402:                 ; E cycles = exactly 10.0000 ms.  Run on the panic image
                            	  2403:                 ; this does not corrupt a timestamp, it stops the RTOS
                            	  2404:                 ; system tick.
                            	  2405:                 ;
                            	  2406:                 ; The test is the tick's own vector.  $1C is the level-4
                            	  2407:                 ; autovector the tick uses, at $1C*4 = $70, and the
                            	  2408:                 ; kernel's static table at $F00114 puts $F00EC8 there.
                            	  2409:                 ; cold_init fills all 256 with monitor_entry, so on the
                            	  2410:                 ; --reset image it reads monitor_entry and s+ proceeds.
01:00F0B8E6 0CB800F0A8400070	  2411:                 cmpi.l  #monitor_entry,$70
01:00F0B8EE 6600004E        	  2412:                 bne.w   .tickowned
                            	  2413:                 ; Free-run T3 for timestamps, in the firmware's own order
                            	  2414:                 ; ($F0A294-$F0A2E4): assert the internal reset, load the
                            	  2415:                 ; latch, configure, release.  A model that ignores that
                            	  2416:                 ; ordering loads a latch into a running timer.
01:00F0B8F2 13FC000100F70003	  2417:                 move.b  #$01,$F70003            ; CR2 bit0=1 -> +$1 is CR1
01:00F0B8FA 13FC000100F70001	  2418:                 move.b  #$01,$F70001            ; CR1 bit0=1 -> INTERNAL
                            	  2419:                                                 ;   RESET: holds ALL THREE
                            	  2420:                                                 ;   timers, not just T1
01:00F0B902 13FC000000F70003	  2421:                 move.b  #$00,$F70003            ; CR2 bit0=0 -> +$1 is CR3
01:00F0B90A 13FC000200F70001	  2422:                 move.b  #$02,$F70001            ; CR3: 16-bit, continuous,
                            	  2423:                                                 ;   internal E clock, IRQ
                            	  2424:                                                 ;   DISABLED (bit 6 = 0)
01:00F0B912 13FC00FF00F7000D	  2425:                 move.b  #$FF,$F7000D            ; T3 latch MSB
01:00F0B91A 13FC00FF00F7000F	  2426:                 move.b  #$FF,$F7000F            ; T3 latch LSB -> 65536
                            	  2427:                                                 ;   counts = 82 ms wrap at
                            	  2428:                                                 ;   1.25 us resolution
01:00F0B922 13FC000100F70003	  2429:                 move.b  #$01,$F70003            ; select CR1 again
01:00F0B92A 13FC000000F70001	  2430:                 move.b  #$00,$F70001            ; release the reset: the
                            	  2431:                                                 ;   timers start HERE
01:00F0B932 41FA1548        	  2432:                 lea     tap_t1_msg(pc),a0
01:00F0B936 6100FBCC        	  2433:                 bsr.w   puts
01:00F0B93A 6000F034        	  2434:                 bra.w   cmd_loop
                            	  2435: .tickowned:
01:00F0B93E 41FA1654        	  2436:                 lea     tap_tick_msg(pc),a0
01:00F0B942 6100FBC0        	  2437:                 bsr.w   puts
01:00F0B946 6000F028        	  2438:                 bra.w   cmd_loop
                            	  2439: 
                            	  2440: .list:
01:00F0B94A 41FA1741        	  2441:                 lea     tap_hdr_msg(pc),a0
01:00F0B94E 6100FBB4        	  2442:                 bsr.w   puts
01:00F0B952 3C390000F8EA    	  2443:                 move.w  MON_RINGN,d6
01:00F0B958 4A46            	  2444:                 tst.w   d6
01:00F0B95A 670000A2        	  2445:                 beq.w   .empty
01:00F0B95E 0C460040        	  2446:                 cmpi.w  #MON_RING_N,d6
01:00F0B962 6F04            	  2447:                 ble.b   .have
01:00F0B964 3C3C0040        	  2448:                 move.w  #MON_RING_N,d6
                            	  2449: .have:
                            	  2450:                 ; oldest first: start at (head - n) mod N
01:00F0B968 3A390000F8E8    	  2451:                 move.w  MON_RINGHD,d5
01:00F0B96E 9A46            	  2452:                 sub.w   d6,d5
01:00F0B970 6C04            	  2453:                 bge.b   .lloop
01:00F0B972 06450040        	  2454:                 addi.w  #MON_RING_N,d5
                            	  2455: .lloop:
01:00F0B976 3005            	  2456:                 move.w  d5,d0
01:00F0B978 02800000FFFF    	  2457:                 andi.l  #$FFFF,d0
01:00F0B97E C0FC000A        	  2458:                 mulu.w  #MON_RING_SZ,d0
01:00F0B982 49F90000F900    	  2459:                 lea     MON_RING,a4
01:00F0B988 D9C0            	  2460:                 adda.l  d0,a4
01:00F0B98A 102C0008        	  2461:                 move.b  8(a4),d0                ; channel
01:00F0B98E 6100FBAA        	  2462:                 bsr.w   puthex_byte
01:00F0B992 103C0020        	  2463:                 move.b  #' ',d0
01:00F0B996 6100FAF6        	  2464:                 bsr.w   putchar
01:00F0B99A 3014            	  2465:                 move.w  (a4),d0                 ; timestamp
01:00F0B99C 6100FBAA        	  2466:                 bsr.w   puthex_word
01:00F0B9A0 103C0020        	  2467:                 move.b  #' ',d0
01:00F0B9A4 6100FAE8        	  2468:                 bsr.w   putchar
01:00F0B9A8 302C0002        	  2469:                 move.w  2(a4),d0                ; status
01:00F0B9AC 6100FB9A        	  2470:                 bsr.w   puthex_word
01:00F0B9B0 103C0020        	  2471:                 move.b  #' ',d0
01:00F0B9B4 6100FAD8        	  2472:                 bsr.w   putchar
01:00F0B9B8 302C0004        	  2473:                 move.w  4(a4),d0                ; data hi
01:00F0B9BC 6100FB8A        	  2474:                 bsr.w   puthex_word
01:00F0B9C0 103C003A        	  2475:                 move.b  #':',d0
01:00F0B9C4 6100FAC8        	  2476:                 bsr.w   putchar
01:00F0B9C8 302C0006        	  2477:                 move.w  6(a4),d0                ; data lo
01:00F0B9CC 6100FB7A        	  2478:                 bsr.w   puthex_word
01:00F0B9D0 6100FB3E        	  2479:                 bsr.w   put_crlf
01:00F0B9D4 5245            	  2480:                 addq.w  #1,d5
01:00F0B9D6 0C450040        	  2481:                 cmpi.w  #MON_RING_N,d5
01:00F0B9DA 6D04            	  2482:                 blt.b   .nowr
01:00F0B9DC 3A3C0000        	  2483:                 move.w  #0,d5
                            	  2484: .nowr:
01:00F0B9E0 5346            	  2485:                 subq.w  #1,d6
01:00F0B9E2 6692            	  2486:                 bne.b   .lloop
01:00F0B9E4 41FA16D1        	  2487:                 lea     tap_ov_msg(pc),a0
01:00F0B9E8 6100FB1A        	  2488:                 bsr.w   puts
01:00F0B9EC 30390000F8EC    	  2489:                 move.w  MON_RINGOV,d0
01:00F0B9F2 6100FB54        	  2490:                 bsr.w   puthex_word
01:00F0B9F6 6100FB18        	  2491:                 bsr.w   put_crlf
01:00F0B9FA 6000EF74        	  2492:                 bra.w   cmd_loop
