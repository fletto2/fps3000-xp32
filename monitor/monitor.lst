01:00F0B57A 6100FE48        	  1699:                 bsr.w   puts
                            	  1700: .report:
01:00F0B57E 302C000E        	  1701:                 move.w  $E(a4),d0
01:00F0B582 6100FE84        	  1702:                 bsr.w   puthex_word
01:00F0B586 41FA10AC        	  1703:                 lea     ac_poll_msg(pc),a0
01:00F0B58A 6100FE38        	  1704:                 bsr.w   puts
01:00F0B58E 2002            	  1705:                 move.l  d2,d0
01:00F0B590 6100FE82        	  1706:                 bsr.w   puthex_long
01:00F0B594 41FA10A8        	  1707:                 lea     ac_data_msg(pc),a0
01:00F0B598 6100FE2A        	  1708:                 bsr.w   puts
01:00F0B59C 302C0008        	  1709:                 move.w  8(a4),d0
01:00F0B5A0 6100FE66        	  1710:                 bsr.w   puthex_word
01:00F0B5A4 103C003A        	  1711:                 move.b  #':',d0
01:00F0B5A8 6100FDCE        	  1712:                 bsr.w   putchar
01:00F0B5AC 302C000A        	  1713:                 move.w  $A(a4),d0
01:00F0B5B0 6100FE56        	  1714:                 bsr.w   puthex_word
01:00F0B5B4 6100FE1A        	  1715:                 bsr.w   put_crlf
                            	  1716: 
                            	  1717:                 ; --- the latch discriminator ---
01:00F0B5B8 4A82            	  1718:                 tst.l   d2
01:00F0B5BA 6610            	  1719:                 bne.b   .tear                   ; it took at least one poll
01:00F0B5BC 302C000A        	  1720:                 move.w  $A(a4),d0
01:00F0B5C0 B046            	  1721:                 cmp.w   d6,d0
01:00F0B5C2 6608            	  1722:                 bne.b   .tear                   ; data low is not our opcode
01:00F0B5C4 41FA1098        	  1723:                 lea     ac_latch_msg(pc),a0
01:00F0B5C8 6100FDFA        	  1724:                 bsr.w   puts
                            	  1725: .tear:
01:00F0B5CC 33C400FF021A    	  1726:                 move.w  d4,$FF021A              ; restore mask word
01:00F0B5D2 3A83            	  1727:                 move.w  d3,(a5)                 ; restore BIM CR
01:00F0B5D4 41FA1103        	  1728:                 lea     ac_tear_msg(pc),a0
01:00F0B5D8 6100FDEA        	  1729:                 bsr.w   puts
01:00F0B5DC 6000F36A        	  1730:                 bra.w   cmd_loop
                            	  1731: .badch:
01:00F0B5E0 41FA1065        	  1732:                 lea     ac_ch_msg(pc),a0
