01:00F0B058 4203            	   988:                 clr.b   d3                      ; digit count
                            	   989: .lp:
01:00F0B05A 1416            	   990:                 move.b  (a6),d2
01:00F0B05C 0C020030        	   991:                 cmpi.b  #'0',d2
01:00F0B060 6D3C            	   992:                 blt.b   .end
01:00F0B062 0C020039        	   993:                 cmpi.b  #'9',d2
01:00F0B066 6F24            	   994:                 ble.b   .dig
01:00F0B068 0C020041        	   995:                 cmpi.b  #'A',d2
01:00F0B06C 6D30            	   996:                 blt.b   .end
01:00F0B06E 0C020046        	   997:                 cmpi.b  #'F',d2
01:00F0B072 6F12            	   998:                 ble.b   .upper
01:00F0B074 0C020061        	   999:                 cmpi.b  #'a',d2
01:00F0B078 6D24            	  1000:                 blt.b   .end
01:00F0B07A 0C020066        	  1001:                 cmpi.b  #'f',d2
01:00F0B07E 6E1E            	  1002:                 bgt.b   .end
01:00F0B080 04020057        	  1003:                 subi.b  #'a'-10,d2
01:00F0B084 600A            	  1004:                 bra.b   .acc
                            	  1005: .upper:
01:00F0B086 04020037        	  1006:                 subi.b  #'A'-10,d2
01:00F0B08A 6004            	  1007:                 bra.b   .acc
                            	  1008: .dig:
01:00F0B08C 04020030        	  1009:                 subi.b  #'0',d2
                            	  1010: .acc:
01:00F0B090 E988            	  1011:                 lsl.l   #4,d0
01:00F0B092 0202000F        	  1012:                 andi.b  #$0F,d2
01:00F0B096 8002            	  1013:                 or.b    d2,d0
01:00F0B098 528E            	  1014:                 addq.l  #1,a6
01:00F0B09A 5203            	  1015:                 addq.b  #1,d3
01:00F0B09C 60BC            	  1016:                 bra.b   .lp
                            	  1017: .end:
01:00F0B09E 4A03            	  1018:                 tst.b   d3
01:00F0B0A0 6704            	  1019:                 beq.b   .err
01:00F0B0A2 7201            	  1020:                 moveq   #1,d1
01:00F0B0A4 4E75            	  1021:                 rts
                            	  1022: .err:
01:00F0B0A6 4201            	  1023:                 clr.b   d1
01:00F0B0A8 4E75            	  1024:                 rts
                            	  1025: 
                            	  1026: ;================================================================
                            	  1027: ; srec_check — is it safe to write d2 bytes starting at d3?
                            	  1028: ;   returns d1 = 1 safe, 0 = refuse.  Preserves d0/d2/d3.
                            	  1029: ;
                            	  1030: ; A load is refused unless its whole range lies in on-board RAM and
                            	  1031: ; clear of the two regions the monitor itself needs:
                            	  1032: ;
                            	  1033: ;   $000000-$0003FF  the exception vector table
                            	  1034: ;   $00F800-$00FEFF  MON_* workspace, breakpoint table, and the
                            	  1035: ;                    cold-entry supervisor stack below $0FF00
                            	  1036: ;
                            	  1037: ; Anything at or above $20000 is refused outright.  That range is ROM
                            	  1038: ; and peripherals, and a stray S2/S3 record pointed there would not
                            	  1039: ; merely be ignored: a write to $F70011 would transmit a byte over the
                            	  1040: ; SIO, and writes to the XLTR or AP I/F blocks would poke the chassis.
                            	  1041: ; Deliberate peripheral pokes are what the `w` command is for.
                            	  1042: ;
                            	  1043: ; The workspace used to live at $1F000, inside the WCS staging buffer,
                            	  1044: ; which forced the top 4 KB of the buffer to be refused.  It now sits at
                            	  1045: ; $0F800, below the buffer, so $10000-$1FFFF is loadable end to end.
                            	  1046: ;================================================================
                            	  1047: srec_check:
01:00F0B0AA 48E79000        	  1048:                 movem.l d0/d3,-(sp)
01:00F0B0AE 7200            	  1049:                 moveq   #0,d1
01:00F0B0B0 0C8300000400    	  1050:                 cmpi.l  #$400,d3
01:00F0B0B6 6528            	  1051:                 bcs.b   .out                    ; below vector-table top
01:00F0B0B8 0C8300020000    	  1052:                 cmpi.l  #$20000,d3
01:00F0B0BE 6420            	  1053:                 bcc.b   .out                    ; beyond on-board RAM
01:00F0B0C0 2003            	  1054:                 move.l  d3,d0
01:00F0B0C2 D082            	  1055:                 add.l   d2,d0
01:00F0B0C4 5380            	  1056:                 subq.l  #1,d0                   ; last byte to be written
01:00F0B0C6 0C8000020000    	  1057:                 cmpi.l  #$20000,d0
01:00F0B0CC 6412            	  1058:                 bcc.b   .out                    ; would run off the end of RAM
01:00F0B0CE 0C830000FF00    	  1059:                 cmpi.l  #MON_HI,d3
01:00F0B0D4 6408            	  1060:                 bcc.b   .ok                     ; starts above our region
01:00F0B0D6 0C800000F800    	  1061:                 cmpi.l  #MON_LO,d0
01:00F0B0DC 6402            	  1062:                 bcc.b   .out                    ; reaches workspace/stack
                            	  1063: .ok:
01:00F0B0DE 7201            	  1064:                 moveq   #1,d1
                            	  1065: .out:
01:00F0B0E0 4CDF0009        	  1066:                 movem.l (sp)+,d0/d3
01:00F0B0E4 4E75            	  1067:                 rts
                            	  1068: 
                            	  1069: ; ---- read_hex_byte: read 2 hex chars from SIO, return byte in d0 ----
                            	  1070: read_hex_byte:
01:00F0B0E6 2F02            	  1071:                 move.l  d2,-(sp)                ; preserve d2 (caller may use it)
01:00F0B0E8 61000010        	  1072:                 bsr.w   read_hex_nibble
01:00F0B0EC E908            	  1073:                 lsl.b   #4,d0
01:00F0B0EE 1400            	  1074:                 move.b  d0,d2
01:00F0B0F0 61000008        	  1075:                 bsr.w   read_hex_nibble
01:00F0B0F4 8002            	  1076:                 or.b    d2,d0
01:00F0B0F6 241F            	  1077:                 move.l  (sp)+,d2
01:00F0B0F8 4E75            	  1078:                 rts
                            	  1079: 
                            	  1080: read_hex_nibble:
01:00F0B0FA 61000118        	  1081:                 bsr.w   getchar
01:00F0B0FE 0C000039        	  1082:                 cmpi.b  #'9',d0
01:00F0B102 6E06            	  1083:                 bgt.b   .alpha
01:00F0B104 04000030        	  1084:                 subi.b  #'0',d0
01:00F0B108 4E75            	  1085:                 rts
                            	  1086: .alpha:
01:00F0B10A 0C000046        	  1087:                 cmpi.b  #'F',d0
01:00F0B10E 6E06            	  1088:                 bgt.b   .lower
01:00F0B110 04000037        	  1089:                 subi.b  #'A'-10,d0
01:00F0B114 4E75            	  1090:                 rts
                            	  1091: .lower:
01:00F0B116 04000057        	  1092:                 subi.b  #'a'-10,d0
01:00F0B11A 4E75            	  1093:                 rts
                            	  1094: 
                            	  1095: ;================================================================
                            	  1096: ; cold_init — called from monitor_cold ONLY (never from monitor_entry).
                            	  1097: ;
                            	  1098: ; The MC68000 has no VBR: the exception vector table is hard-wired at
                            	  1099: ; $000000-$0003FF, which on this board is plain DRAM.  The reset SSP/PC
                            	  1100: ; are the only vectors that come from ROM — the M68KVM02 maps just the
                            	  1101: ; first 8 bytes of ROM to address 0 for the first four bus cycles after
                            	  1102: ; a total system reset, then address 0 is DRAM like any other.  So at
                            	  1103: ; power-on every vector except reset is whatever the DRAM happens to
                            	  1104: ; hold, i.e. garbage.
                            	  1105: ;
                            	  1106: ; The stock firmware handles this on its 2nd and 3rd instructions —
                            	  1107: ; MainInit at F08700 does `lea $1ffd0,a7` then immediately installs
                            	  1108: ; $8 and $C (F08706 / F0870E) before touching any I/O.  But when
                            	  1109: ; patch_rom.py --reset points the reset PC at monitor_cold, MainInit
                            	  1110: ; never executes, so nothing fills the table and the monitor inherits
                            	  1111: ; garbage.  Any bus or address error then fetches a junk handler
                            	  1112: ; address, faults again, and the 68000 asserts HALT (double bus fault)
                            	  1113: ; with no diagnostic at all.  That is what a bad SIO address did on
                            	  1114: ; real hardware: FAIL + HALTED, silently.
                            	  1115: ;
                            	  1116: ; Point every vector at monitor_entry so the next fault reports itself
                            	  1117: ; instead of killing the CPU.  Writing all 1 KB also leaves valid DRAM
                            	  1118: ; parity across the table, which matters if the board's parity strap is
                            	  1119: ; enabled (a read of never-written DRAM can raise BERR).
                            	  1120: ;
                            	  1121: ; This deliberately does NOT run on the panic path: with --panic only,
                            	  1122: ; the firmware booted normally and its live vectors are already in
                            	  1123: ; place, and `g` needs them intact to resume.
                            	  1124: ;================================================================
                            	  1125: cold_init:
01:00F0B11C 91C8            	  1126:                 suba.l  a0,a0                   ; a0 = $000000
01:00F0B11E 203C00F0A840    	  1127:                 move.l  #monitor_entry,d0
01:00F0B124 323C00FF        	  1128:                 move.w  #255,d1                 ; 256 vectors, dbra -> 256 passes
                            	  1129: .vfill:
01:00F0B128 20C0            	  1130:                 move.l  d0,(a0)+
01:00F0B12A 51C9FFFC        	  1131:                 dbra    d1,.vfill
                            	  1132: 
                            	  1133:                 ; Vectors 2 and 3 push the 7-word group-0 frame, which
                            	  1134:                 ; monitor_entry would misread — give them their own stub.
01:00F0B12E 21FC00F0A8740008	  1135:                 move.l  #grp0_entry,$8          ; bus error
01:00F0B136 21FC00F0A874000C	  1136:                 move.l  #grp0_entry,$C          ; address error
                            	  1137: 
                            	  1138:                 ; Pre-write the whole workspace.  Two reasons: it leaves
                            	  1139:                 ; valid DRAM parity on every byte the monitor later reads
                            	  1140:                 ; back (MON_NEST and MON_LASTADDR are both read before
                            	  1141:                 ; being written otherwise), and it puts the guard in a
                            	  1142:                 ; known state.  move.l/move.b, never clr: a real MC68000
                            	  1143:                 ; READS the destination before writing it on CLR, so clr
                            	  1144:                 ; on never-written DRAM is a parity-BERR risk.  (Musashi
                            	  1145:                 ; models CLR as a pure write, so the emulator never shows
                            	  1146:                 ; this — see m68k_in.c, M68KMAKE_OP(clr, 32, ., .).)
                            	  1147:                 ; MON_REGS itself must be written too, not just the
                            	  1148:                 ; scalars below it: cmd_regs READS all 60 bytes, and on a
                            	  1149:                 ; cold boot nothing has written them yet.  On a board with
                            	  1150:                 ; the DRAM parity strap enabled, reading never-written
                            	  1151:                 ; memory raises BERR, so `r` before any fault would have
                            	  1152:                 ; been a parity trap rather than a register dump.  The
                            	  1153:                 ; emulator cannot show this — its RAM is zero-filled and
                            	  1154:                 ; it models no parity.
01:00F0B13E 41F90000F800    	  1155:                 lea     MON_REGS,a0
01:00F0B144 720E            	  1156:                 moveq   #14,d1                  ; 15 longs, dbra -> 15 passes
                            	  1157: .rclr:
01:00F0B146 20FC00000000    	  1158:                 move.l  #0,(a0)+
01:00F0B14C 51C9FFF8        	  1159:                 dbra    d1,.rclr
                            	  1160: 
01:00F0B150 23FC000000000000	  1161:                 move.l  #0,MON_SPC
01:00F0B158 F83C
01:00F0B15A 33FC27000000F840	  1162:                 move.w  #$2700,MON_SSR
01:00F0B162 23FC000000000000	  1163:                 move.l  #0,MON_LASTADDR
01:00F0B16A F890
01:00F0B16C 13FC00FF0000F894	  1164:                 move.b  #$FF,MON_GRP0           ; cold entry: no frame
01:00F0B174 13FC00000000F895	  1165:                 move.b  #0,MON_NEST             ; first fault is reportable
01:00F0B17C 13FC00000000F896	  1166:                 move.b  #0,MON_TXFAIL
                            	  1167:                 ; clear the breakpoint slot table (addr 0 = free)
01:00F0B184 41F90000F8A0    	  1168:                 lea     MON_BPT,a0
01:00F0B18A 7207            	  1169:                 moveq   #MON_BPN-1,d1
                            	  1170: .bpclr:
01:00F0B18C 20BC00000000    	  1171:                 move.l  #0,(a0)
01:00F0B192 317C00000004    	  1172:                 move.w  #0,4(a0)
01:00F0B198 5C88            	  1173:                 lea     MON_BP_SZ(a0),a0
01:00F0B19A 51C9FFF0        	  1174:                 dbra    d1,.bpclr
01:00F0B19E 4E75            	  1175:                 rts
                            	  1176: 
                            	  1177: ; ---- SIO init for 9600 8N1, RX+TX enabled, no IRQs ----
                            	  1178: sio_init:
                            	  1179:                 ; Channel reset
01:00F0B1A0 13FC001800F70015	  1180:                 move.b  #$18,SIO_A_CTRL         ; WR0: cmd 3 = chan reset
01:00F0B1A8 4E71            	  1181:                 nop
01:00F0B1AA 4E71            	  1182:                 nop
01:00F0B1AC 4E71            	  1183:                 nop
01:00F0B1AE 4E71            	  1184:                 nop
                            	  1185:                 ; WR4: x16 clk, 1 stop, no parity
01:00F0B1B0 13FC000400F70015	  1186:                 move.b  #$04,SIO_A_CTRL         ; WR0: ptr to WR4
01:00F0B1B8 13FC004400F70015	  1187:                 move.b  #$44,SIO_A_CTRL
                            	  1188:                 ; WR3: 8 bits/RX char, RX enable
01:00F0B1C0 13FC000300F70015	  1189:                 move.b  #$03,SIO_A_CTRL         ; WR0: ptr to WR3
01:00F0B1C8 13FC00C100F70015	  1190:                 move.b  #$C1,SIO_A_CTRL
                            	  1191:                 ; WR5: 8 bits/TX char, TX enable, DTR, RTS
01:00F0B1D0 13FC000500F70015	  1192:                 move.b  #$05,SIO_A_CTRL         ; WR0: ptr to WR5
01:00F0B1D8 13FC00EA00F70015	  1193:                 move.b  #$EA,SIO_A_CTRL
01:00F0B1E0 4E75            	  1194:                 rts
                            	  1195: 
                            	  1196: ; ---- putchar: send byte in d0 over SIO chA.  Bounded: drops the
                            	  1197: ;      character and sets MON_TXFAIL rather than hanging forever, so a
                            	  1198: ;      dead or mis-strapped SIO still lets the monitor make progress and
                            	  1199: ;      leaves evidence in RAM.  Preserves d0 and d1.
                            	  1200: putchar:
01:00F0B1E2 2F01            	  1201:                 move.l  d1,-(sp)
                            	  1202:                 ; Belt-and-braces: point the register pointer at RR0 before
                            	  1203:                 ; polling status.  On a Z80-SIO-family part the pointer
                            	  1204:                 ; auto-resets to 0 after each access, so this should be
                            	  1205:                 ; unnecessary -- but $00 to WR0 is the null command
                            	  1206:                 ; (pointer := 0, no side effect), it costs two instructions,
                            	  1207:                 ; and if the auto-reset does NOT behave as assumed the poll
                            	  1208:                 ; would otherwise read WR5 forever and never transmit.  One
                            	  1209:                 ; attempt per hardware trip: take the insurance.
01:00F0B1E4 13FC000000F70015	  1210:                 move.b  #0,SIO_A_CTRL
01:00F0B1EC 72104841        	  1211:                 move.l  #TX_SPIN_LIMIT,d1
                            	  1212: .wait:
01:00F0B1F0 0839000200F70015	  1213:                 btst.b  #RR0_TX_EMPTY,SIO_A_CTRL
01:00F0B1F8 6610            	  1214:                 bne.b   .ready
01:00F0B1FA 5381            	  1215:                 subq.l  #1,d1
01:00F0B1FC 66F2            	  1216:                 bne.b   .wait
                            	  1217:                 ; Timed out.  move.b, not an increment: a read-modify-write
                            	  1218:                 ; on never-written DRAM is a parity-BERR risk on real
                            	  1219:                 ; hardware, and this path runs when things are already bad.
01:00F0B1FE 13FC00010000F896	  1220:                 move.b  #1,MON_TXFAIL
01:00F0B206 221F            	  1221:                 move.l  (sp)+,d1
01:00F0B208 4E75            	  1222:                 rts
                            	  1223: .ready:
01:00F0B20A 13C000F70011    	  1224:                 move.b  d0,SIO_A_DATA
01:00F0B210 221F            	  1225:                 move.l  (sp)+,d1
01:00F0B212 4E75            	  1226:                 rts
                            	  1227: 
                            	  1228: ; ---- getchar: receive byte from SIO chA into d0 ----
                            	  1229: ;      Deliberately unbounded: waiting indefinitely for a human to type
                            	  1230: ;      is correct behaviour for a monitor prompt, and a timeout here
                            	  1231: ;      would just spin the prompt.  The dangerous spin was putchar,
                            	  1232: ;      which blocks *before* any output exists; that one is bounded
                            	  1233: ;      above.  If a board goes quiet, MON_TXFAIL distinguishes "TX
                            	  1234: ;      never became ready" from "nobody typed anything".
                            	  1235: getchar:
01:00F0B214 13FC000000F70015	  1236:                 move.b  #0,SIO_A_CTRL           ; point at RR0 (see putchar)
                            	  1237: .poll:
01:00F0B21C 0839000000F70015	  1238:                 btst.b  #RR0_RX_AVAIL,SIO_A_CTRL
01:00F0B224 67F6            	  1239:                 beq.b   .poll
01:00F0B226 103900F70011    	  1240:                 move.b  SIO_A_DATA,d0
01:00F0B22C 4E75            	  1241:                 rts
                            	  1242: 
                            	  1243: ; ---- puts: print null-terminated string at (a0) ----
                            	  1244: puts:
01:00F0B22E 1018            	  1245:                 move.b  (a0)+,d0
01:00F0B230 6706            	  1246:                 beq.b   .end
01:00F0B232 6100FFAE        	  1247:                 bsr.w   putchar
01:00F0B236 60F6            	  1248:                 bra.b   puts
                            	  1249: .end:
01:00F0B238 4E75            	  1250:                 rts
                            	  1251: 
                            	  1252: put_crlf:
01:00F0B23A 103C000D        	  1253:                 move.b  #13,d0
01:00F0B23E 6100FFA2        	  1254:                 bsr.w   putchar
01:00F0B242 103C000A        	  1255:                 move.b  #10,d0
01:00F0B246 6000FF9A        	  1256:                 bra.w   putchar
                            	  1257: 
                            	  1258: puthex_nibble:
01:00F0B24A 0200000F        	  1259:                 andi.b  #$0F,d0
01:00F0B24E 0C00000A        	  1260:                 cmpi.b  #10,d0
01:00F0B252 6D08            	  1261:                 blt.b   .num
01:00F0B254 06000037        	  1262:                 addi.b  #'A'-10,d0
01:00F0B258 6000FF88        	  1263:                 bra.w   putchar
                            	  1264: .num:
01:00F0B25C 06000030        	  1265:                 addi.b  #'0',d0
01:00F0B260 6000FF80        	  1266:                 bra.w   putchar
                            	  1267: 
                            	  1268: puthex_byte:
01:00F0B264 2F00            	  1269:                 move.l  d0,-(sp)
01:00F0B266 E808            	  1270:                 lsr.b   #4,d0
01:00F0B268 6100FFE0        	  1271:                 bsr.w   puthex_nibble
01:00F0B26C 201F            	  1272:                 move.l  (sp)+,d0
01:00F0B26E 6000FFDA        	  1273:                 bra.w   puthex_nibble
                            	  1274: 
                            	  1275: puthex_word:
01:00F0B272 E158            	  1276:                 rol.w   #8,d0
01:00F0B274 6100FFEE        	  1277:                 bsr.w   puthex_byte
01:00F0B278 E158            	  1278:                 rol.w   #8,d0
01:00F0B27A 6000FFE8        	  1279:                 bra.w   puthex_byte
                            	  1280: 
                            	  1281: puthex_long:
01:00F0B27E 4840            	  1282:                 swap    d0
01:00F0B280 6100FFF0        	  1283:                 bsr.w   puthex_word
01:00F0B284 4840            	  1284:                 swap    d0
01:00F0B286 6000FFEA        	  1285:                 bra.w   puthex_word
                            	  1286: 
