                            	  1174: ;================================================================
                            	  1175: ; srec_check — is it safe to write d2 bytes starting at d3?
                            	  1176: ;   returns d1 = 1 safe, 0 = refuse.  Preserves d0/d2/d3.
                            	  1177: ;
                            	  1178: ; A load is refused unless its whole range lies in on-board RAM and
                            	  1179: ; clear of the two regions the monitor itself needs:
                            	  1180: ;
                            	  1181: ;   $000000-$0003FF  the exception vector table
                            	  1182: ;   $00F800-$00FEFF  MON_* workspace, breakpoint table, and the
                            	  1183: ;                    cold-entry supervisor stack below $0FF00
                            	  1184: ;
                            	  1185: ; Anything at or above $20000 is refused outright.  That range is ROM
                            	  1186: ; and peripherals, and a stray S2/S3 record pointed there would not
                            	  1187: ; merely be ignored: a write to $F70011 would transmit a byte over the
                            	  1188: ; SIO, and writes to the XLTR or AP I/F blocks would poke the chassis.
                            	  1189: ; Deliberate peripheral pokes are what the `w` command is for.
                            	  1190: ;
                            	  1191: ; The workspace used to live at $1F000, inside the WCS staging buffer,
                            	  1192: ; which forced the top 4 KB of the buffer to be refused.  It now sits at
                            	  1193: ; $0F800, below the buffer, so $10000-$1FFFF is loadable end to end.
                            	  1194: ;================================================================
                            	  1195: srec_check:
01:00F0B1DE 48E79000        	  1196:                 movem.l d0/d3,-(sp)
01:00F0B1E2 7200            	  1197:                 moveq   #0,d1
01:00F0B1E4 0C8300000400    	  1198:                 cmpi.l  #$400,d3
01:00F0B1EA 6528            	  1199:                 bcs.b   .out                    ; below vector-table top
01:00F0B1EC 0C8300020000    	  1200:                 cmpi.l  #$20000,d3
01:00F0B1F2 6420            	  1201:                 bcc.b   .out                    ; beyond on-board RAM
01:00F0B1F4 2003            	  1202:                 move.l  d3,d0
01:00F0B1F6 D082            	  1203:                 add.l   d2,d0
01:00F0B1F8 5380            	  1204:                 subq.l  #1,d0                   ; last byte to be written
01:00F0B1FA 0C8000020000    	  1205:                 cmpi.l  #$20000,d0
01:00F0B200 6412            	  1206:                 bcc.b   .out                    ; would run off the end of RAM
01:00F0B202 0C830000FF00    	  1207:                 cmpi.l  #MON_HI,d3
01:00F0B208 6408            	  1208:                 bcc.b   .ok                     ; starts above our region
01:00F0B20A 0C800000F800    	  1209:                 cmpi.l  #MON_LO,d0
01:00F0B210 6402            	  1210:                 bcc.b   .out                    ; reaches workspace/stack
                            	  1211: .ok:
01:00F0B212 7201            	  1212:                 moveq   #1,d1
                            	  1213: .out:
01:00F0B214 4CDF0009        	  1214:                 movem.l (sp)+,d0/d3
01:00F0B218 4E75            	  1215:                 rts
                            	  1216: 
                            	  1217: ; ---- read_hex_byte: read 2 hex chars from SIO, return byte in d0 ----
                            	  1218: read_hex_byte:
01:00F0B21A 2F02            	  1219:                 move.l  d2,-(sp)                ; preserve d2 (caller may use it)
01:00F0B21C 61000010        	  1220:                 bsr.w   read_hex_nibble
01:00F0B220 E908            	  1221:                 lsl.b   #4,d0
01:00F0B222 1400            	  1222:                 move.b  d0,d2
01:00F0B224 61000008        	  1223:                 bsr.w   read_hex_nibble
01:00F0B228 8002            	  1224:                 or.b    d2,d0
01:00F0B22A 241F            	  1225:                 move.l  (sp)+,d2
01:00F0B22C 4E75            	  1226:                 rts
                            	  1227: 
                            	  1228: read_hex_nibble:
01:00F0B22E 6100017A        	  1229:                 bsr.w   getchar
01:00F0B232 0C000039        	  1230:                 cmpi.b  #'9',d0
01:00F0B236 6E06            	  1231:                 bgt.b   .alpha
01:00F0B238 04000030        	  1232:                 subi.b  #'0',d0
01:00F0B23C 4E75            	  1233:                 rts
                            	  1234: .alpha:
01:00F0B23E 0C000046        	  1235:                 cmpi.b  #'F',d0
01:00F0B242 6E06            	  1236:                 bgt.b   .lower
01:00F0B244 04000037        	  1237:                 subi.b  #'A'-10,d0
01:00F0B248 4E75            	  1238:                 rts
                            	  1239: .lower:
01:00F0B24A 04000057        	  1240:                 subi.b  #'a'-10,d0
01:00F0B24E 4E75            	  1241:                 rts
                            	  1242: 
                            	  1243: ;================================================================
                            	  1244: ; cold_init — called from monitor_cold ONLY (never from monitor_entry).
                            	  1245: ;
                            	  1246: ; The MC68000 has no VBR: the exception vector table is hard-wired at
                            	  1247: ; $000000-$0003FF, which on this board is plain DRAM.  The reset SSP/PC
                            	  1248: ; are the only vectors that come from ROM — the M68KVM02 maps just the
                            	  1249: ; first 8 bytes of ROM to address 0 for the first four bus cycles after
                            	  1250: ; a total system reset, then address 0 is DRAM like any other.  So at
                            	  1251: ; power-on every vector except reset is whatever the DRAM happens to
                            	  1252: ; hold, i.e. garbage.
                            	  1253: ;
                            	  1254: ; The stock firmware handles this on its 2nd and 3rd instructions —
                            	  1255: ; MainInit at F08700 does `lea $1ffd0,a7` then immediately installs
                            	  1256: ; $8 and $C (F08706 / F0870E) before touching any I/O.  But when
                            	  1257: ; patch_rom.py --reset points the reset PC at monitor_cold, MainInit
                            	  1258: ; never executes, so nothing fills the table and the monitor inherits
                            	  1259: ; garbage.  Any bus or address error then fetches a junk handler
                            	  1260: ; address, faults again, and the 68000 asserts HALT (double bus fault)
                            	  1261: ; with no diagnostic at all.  That is what a bad SIO address did on
                            	  1262: ; real hardware: FAIL + HALTED, silently.
                            	  1263: ;
                            	  1264: ; Point every vector at monitor_entry so the next fault reports itself
                            	  1265: ; instead of killing the CPU.  Writing all 1 KB also leaves valid DRAM
                            	  1266: ; parity across the table, which matters if the board's parity strap is
                            	  1267: ; enabled (a read of never-written DRAM can raise BERR).
                            	  1268: ;
                            	  1269: ; This deliberately does NOT run on the panic path: with --panic only,
                            	  1270: ; the firmware booted normally and its live vectors are already in
                            	  1271: ; place, and `g` needs them intact to resume.
                            	  1272: ;================================================================
                            	  1273: cold_init:
01:00F0B250 91C8            	  1274:                 suba.l  a0,a0                   ; a0 = $000000
01:00F0B252 203C00F0A840    	  1275:                 move.l  #monitor_entry,d0
01:00F0B258 323C00FF        	  1276:                 move.w  #255,d1                 ; 256 vectors, dbra -> 256 passes
                            	  1277: .vfill:
01:00F0B25C 20C0            	  1278:                 move.l  d0,(a0)+
01:00F0B25E 51C9FFFC        	  1279:                 dbra    d1,.vfill
                            	  1280: 
                            	  1281:                 ; Vectors 2 and 3 push the 7-word group-0 frame, which
                            	  1282:                 ; monitor_entry would misread — give them their own stub.
01:00F0B262 21FC00F0A8860008	  1283:                 move.l  #grp0_entry,$8          ; bus error
01:00F0B26A 21FC00F0A886000C	  1284:                 move.l  #grp0_entry,$C          ; address error
                            	  1285: 
                            	  1286:                 ; Pre-write the whole workspace.  Two reasons: it leaves
                            	  1287:                 ; valid DRAM parity on every byte the monitor later reads
                            	  1288:                 ; back (MON_NEST and MON_LASTADDR are both read before
                            	  1289:                 ; being written otherwise), and it puts the guard in a
                            	  1290:                 ; known state.  move.l/move.b, never clr: a real MC68000
                            	  1291:                 ; READS the destination before writing it on CLR, so clr
                            	  1292:                 ; on never-written DRAM is a parity-BERR risk.  (Musashi
                            	  1293:                 ; models CLR as a pure write, so the emulator never shows
                            	  1294:                 ; this — see m68k_in.c, M68KMAKE_OP(clr, 32, ., .).)
                            	  1295:                 ; MON_REGS itself must be written too, not just the
                            	  1296:                 ; scalars below it: cmd_regs READS all 60 bytes, and on a
                            	  1297:                 ; cold boot nothing has written them yet.  On a board with
                            	  1298:                 ; the DRAM parity strap enabled, reading never-written
                            	  1299:                 ; memory raises BERR, so `r` before any fault would have
                            	  1300:                 ; been a parity trap rather than a register dump.  The
                            	  1301:                 ; emulator cannot show this — its RAM is zero-filled and
                            	  1302:                 ; it models no parity.
01:00F0B272 41F90000F800    	  1303:                 lea     MON_REGS,a0
01:00F0B278 720E            	  1304:                 moveq   #14,d1                  ; 15 longs, dbra -> 15 passes
                            	  1305: .rclr:
01:00F0B27A 20FC00000000    	  1306:                 move.l  #0,(a0)+
01:00F0B280 51C9FFF8        	  1307:                 dbra    d1,.rclr
                            	  1308: 
01:00F0B284 23FC000000000000	  1309:                 move.l  #0,MON_SPC
01:00F0B28C F83C
01:00F0B28E 33FC27000000F840	  1310:                 move.w  #$2700,MON_SSR
01:00F0B296 23FC000000000000	  1311:                 move.l  #0,MON_LASTADDR
01:00F0B29E F890
01:00F0B2A0 13FC00FF0000F894	  1312:                 move.b  #$FF,MON_GRP0           ; cold entry: no frame
01:00F0B2A8 13FC00000000F895	  1313:                 move.b  #0,MON_NEST             ; first fault is reportable
01:00F0B2B0 13FC00000000F896	  1314:                 move.b  #0,MON_TXFAIL
01:00F0B2B8 23FC000000000000	  1315:                 move.l  #0,MON_FADDR            ; no fault yet: a stale address
01:00F0B2C0 F898
01:00F0B2C2 33FC00000000F89C	  1316:                 move.w  #0,MON_SSW              ;   would read as a live one
                            	  1317:                 ; clear the breakpoint slot table (addr 0 = free)
01:00F0B2CA 41F90000F8A0    	  1318:                 lea     MON_BPT,a0
01:00F0B2D0 7207            	  1319:                 moveq   #MON_BPN-1,d1
                            	  1320: .bpclr:
01:00F0B2D2 20BC00000000    	  1321:                 move.l  #0,(a0)
01:00F0B2D8 317C00000004    	  1322:                 move.w  #0,4(a0)
01:00F0B2DE 5C88            	  1323:                 lea     MON_BP_SZ(a0),a0
01:00F0B2E0 51C9FFF0        	  1324:                 dbra    d1,.bpclr
