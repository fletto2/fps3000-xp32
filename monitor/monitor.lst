01:00F0BD5A 2002            	  2993:                 move.l  d2,d0
01:00F0BD5C 6100F7F6        	  2994:                 bsr.w   puthex_long
01:00F0BD60 41FA150C        	  2995:                 lea     rdy_val_msg(pc),a0
01:00F0BD64 6100F79E        	  2996:                 bsr.w   puts
01:00F0BD68 303900FF0004    	  2997:                 move.w  $FF0004,d0
01:00F0BD6E 6100F7D8        	  2998:                 bsr.w   puthex_word
01:00F0BD72 6100F79C        	  2999:                 bsr.w   put_crlf
