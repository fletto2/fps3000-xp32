                            	  2498: ; ---- the four tap entry points ----
01:00F0BA0A 48E7E0C0        	  2499: tap1:           movem.l d0-d2/a0-a1,-(sp)
01:00F0BA0E 7401            	  2500:                 moveq   #1,d2
01:00F0BA10 6016            	  2501:                 bra.b   tap_body
01:00F0BA12 48E7E0C0        	  2502: tap2:           movem.l d0-d2/a0-a1,-(sp)
01:00F0BA16 7402            	  2503:                 moveq   #2,d2
01:00F0BA18 600E            	  2504:                 bra.b   tap_body
01:00F0BA1A 48E7E0C0        	  2505: tap3:           movem.l d0-d2/a0-a1,-(sp)
01:00F0BA1E 7403            	  2506:                 moveq   #3,d2
01:00F0BA20 6006            	  2507:                 bra.b   tap_body
01:00F0BA22 48E7E0C0        	  2508: tap4:           movem.l d0-d2/a0-a1,-(sp)
01:00F0BA26 7404            	  2509:                 moveq   #4,d2
                            	  2510: 
                            	  2511: tap_body:
                            	  2512:                 ; channel window = $FF0000 + ((ch+1) << 5)
01:00F0BA28 2002            	  2513:                 move.l  d2,d0
01:00F0BA2A 5280            	  2514:                 addq.l  #1,d0
01:00F0BA2C EB88            	  2515:                 lsl.l   #5,d0
01:00F0BA2E 068000FF0000    	  2516:                 addi.l  #$FF0000,d0
01:00F0BA34 2040            	  2517:                 move.l  d0,a0
                            	  2518: 
                            	  2519:                 ; ring slot
01:00F0BA36 30390000F8E8    	  2520:                 move.w  MON_RINGHD,d0
01:00F0BA3C 02800000FFFF    	  2521:                 andi.l  #$FFFF,d0
01:00F0BA42 C0FC000A        	  2522:                 mulu.w  #MON_RING_SZ,d0
01:00F0BA46 43F90000F900    	  2523:                 lea     MON_RING,a1
01:00F0BA4C D3C0            	  2524:                 adda.l  d0,a1
                            	  2525: 
                            	  2526:                 ; Timestamp: PTM TIMER 3, read MSB then LSB because reading
                            	  2527:                 ; the MSB latches the LSB.  T3 rather than T1 because on
                            	  2528:                 ; the panic image the RTOS has ALREADY programmed it --
                            	  2529:                 ; latch $27C7 = (4*10-1)<<8 | (800/4-1), dual 8-bit, giving
                            	  2530:                 ; a 10.0000 ms tick at E = 800 kHz -- so the tap needs no
                            	  2531:                 ; PTM writes at all in the configuration that matters, and
                            	  2532:                 ; it reads the very counter the firmware's own sub-tick
                            	  2533:                 ; clock reads (TRAP #0 $1C at $F00F96).  On the --reset
                            	  2534:                 ; image T3 is unprogrammed and this column reads a
                            	  2535:                 ; constant, which is self-evidently not a timestamp; `s+`
                            	  2536:                 ; starts it there.
                            	  2537:                 ;
                            	  2538:                 ; DUAL 8-BIT is not 16-bit: the halves count
                            	  2539:                 ; independently and the LSB reloads from 199, not 255.
                            	  2540:                 ; So on the panic image this concatenation ORDERS events
                            	  2541:                 ; and does not MEASURE them -- subtracting two of these
                            	  2542:                 ; over-counts by 256/200 per MSB step.  Linear only on
                            	  2543:                 ; the --reset image after `s+` (16-bit continuous).
01:00F0BA4E 123900F7000D    	  2544:                 move.b  $F7000D,d1
01:00F0BA54 E149            	  2545:                 lsl.w   #8,d1
01:00F0BA56 123900F7000F    	  2546:                 move.b  $F7000F,d1
01:00F0BA5C 32C1            	  2547:                 move.w  d1,(a1)+
01:00F0BA5E 32E8000E        	  2548:                 move.w  $E(a0),(a1)+            ; status
01:00F0BA62 32E80008        	  2549:                 move.w  8(a0),(a1)+             ; data high
01:00F0BA66 32E8000A        	  2550:                 move.w  $A(a0),(a1)+            ; data low
01:00F0BA6A 12C2            	  2551:                 move.b  d2,(a1)+                ; channel
01:00F0BA6C 12FC0000        	  2552:                 move.b  #0,(a1)+
                            	  2553: 
                            	  2554:                 ; advance head, count, overruns
01:00F0BA70 30390000F8E8    	  2555:                 move.w  MON_RINGHD,d0
01:00F0BA76 5240            	  2556:                 addq.w  #1,d0
01:00F0BA78 0C400040        	  2557:                 cmpi.w  #MON_RING_N,d0
01:00F0BA7C 6D12            	  2558:                 blt.b   .nowrap
01:00F0BA7E 303C0000        	  2559:                 move.w  #0,d0
01:00F0BA82 32390000F8EC    	  2560:                 move.w  MON_RINGOV,d1
01:00F0BA88 5241            	  2561:                 addq.w  #1,d1
01:00F0BA8A 33C10000F8EC    	  2562:                 move.w  d1,MON_RINGOV
                            	  2563: .nowrap:
01:00F0BA90 33C00000F8E8    	  2564:                 move.w  d0,MON_RINGHD
01:00F0BA96 32390000F8EA    	  2565:                 move.w  MON_RINGN,d1
01:00F0BA9C 0C410040        	  2566:                 cmpi.w  #MON_RING_N,d1
01:00F0BAA0 6C08            	  2567:                 bge.b   .nosat
01:00F0BAA2 5241            	  2568:                 addq.w  #1,d1
01:00F0BAA4 33C10000F8EA    	  2569:                 move.w  d1,MON_RINGN
                            	  2570: .nosat:
                            	  2571:                 ; chain to the original handler, or RTE if the saved
                            	  2572:                 ; vector is cold_init's filler and there is nobody else
01:00F0BAAA 2002            	  2573:                 move.l  d2,d0
01:00F0BAAC 5380            	  2574:                 subq.l  #1,d0
01:00F0BAAE E588            	  2575:                 lsl.l   #2,d0
01:00F0BAB0 41F90000F8D8    	  2576:                 lea     MON_TAPSAV,a0
01:00F0BAB6 22300800        	  2577:                 move.l  0(a0,d0.l),d1
01:00F0BABA 0C8100F0A840    	  2578:                 cmpi.l  #monitor_entry,d1
01:00F0BAC0 674C            	  2579:                 beq.b   .own
01:00F0BAC2 41F90000F8F0    	  2580:                 lea     MON_TAPTGT,a0
01:00F0BAC8 21810800        	  2581:                 move.l  d1,0(a0,d0.l)           ; this channel's OWN slot
                            	  2582:                 ; rts pops the target we push below and jumps to it, leaving the
                            	  2583:                 ; exception frame beneath it untouched for the original handler's
                            	  2584:                 ; own rte.  The target has to survive the movem that restores
                            	  2585:                 ; d0-d2/a0-a1 -- every one of which the chained handler expects
                            	  2586:                 ; to see as it was at interrupt time -- so it cannot stay in a
                            	  2587:                 ; register, and after the restore there is no register left to
                            	  2588:                 ; index with either.  Hence four fixed slots and a dispatch on
                            	  2589:                 ; the channel while d2 is still live.
                            	  2590:                 ;
                            	  2591:                 ; It used to be ONE slot, justified as "all four channel BIMs are
                            	  2592:                 ; level 7 and a 68000 masks the level it is already servicing, so
                            	  2593:                 ; two channel taps cannot nest".  That is wrong, and this file
                            	  2594:                 ; says so twelve hundred lines up: mon_dead's comment notes that
                            	  2595:                 ; "STOP with IPL 7 still admits a level-7 NMI".  Level 7 is
                            	  2596:                 ; non-maskable on a 68000 -- it is transition-sensitive, not
                            	  2597:                 ; level-sensitive against the mask -- so a second BIM asserting
                            	  2598:                 ; while the first is being serviced IS taken.  The window was the
                            	  2599:                 ; three instructions below: channel 2 would overwrite the slot and
                            	  2600:                 ; channel 1 would then chain into channel 2's ISR, which reads the
                            	  2601:                 ; wrong window and leaves channel 1 unacknowledged.  Narrow (~4 us
                            	  2602:                 ; at 8 MHz) and real.  Per-channel slots close it for distinct
                            	  2603:                 ; channels; a channel re-interrupting inside its own three
                            	  2604:                 ; instructions is all that remains, and the BIM's IRE is cleared
                            	  2605:                 ; during service.
01:00F0BACC 0C020002        	  2606:                 cmpi.b  #2,d2
01:00F0BAD0 6718            	  2607:                 beq.b   .ch2
01:00F0BAD2 0C020003        	  2608:                 cmpi.b  #3,d2
01:00F0BAD6 671E            	  2609:                 beq.b   .ch3
01:00F0BAD8 0C020004        	  2610:                 cmpi.b  #4,d2
01:00F0BADC 6724            	  2611:                 beq.b   .ch4
01:00F0BADE 4CDF0307        	  2612:                 movem.l (sp)+,d0-d2/a0-a1
01:00F0BAE2 2F390000F8F0    	  2613:                 move.l  MON_TAPTGT,-(sp)
01:00F0BAE8 4E75            	  2614:                 rts
                            	  2615: .ch2:
01:00F0BAEA 4CDF0307        	  2616:                 movem.l (sp)+,d0-d2/a0-a1
01:00F0BAEE 2F390000F8F4    	  2617:                 move.l  MON_TAPTGT+4,-(sp)
01:00F0BAF4 4E75            	  2618:                 rts
                            	  2619: .ch3:
01:00F0BAF6 4CDF0307        	  2620:                 movem.l (sp)+,d0-d2/a0-a1
01:00F0BAFA 2F390000F8F8    	  2621:                 move.l  MON_TAPTGT+8,-(sp)
01:00F0BB00 4E75            	  2622:                 rts
                            	  2623: .ch4:
01:00F0BB02 4CDF0307        	  2624:                 movem.l (sp)+,d0-d2/a0-a1
01:00F0BB06 2F390000F8FC    	  2625:                 move.l  MON_TAPTGT+12,-(sp)
01:00F0BB0C 4E75            	  2626:                 rts
                            	  2627: .own:
01:00F0BB0E 4CDF0307        	  2628:                 movem.l (sp)+,d0-d2/a0-a1
01:00F0BB12 4E73            	  2629:                 rte
                            	  2630: 
                            	  2631: ;================================================================
                            	  2632: ; TIER 5 — the bulk path, the chassis window and the ready flag
                            	  2633: ;
                            	  2634: ;   e [NN]      drain NN words from the bulk data port
                            	  2635: ;   p PP [NN [OO]]     read NN longs at page PP, byte offset OO
                            	  2636: ;   pw PP OO VV [VV..] write longs at page PP, byte offset OO
                            	  2637: ;   q           bounded poll of $FF0004 bit 0
                            	  2638: ;
                            	  2639: ; --- e ---
                            	  2640: ; Reproduces TCBRDHC's polled bulk loop at $F04AE2: arm
                            	  2641: ; XLTR_STATUS_IRQ ($FF0218) with $400 — bit 10, the arm — poll bit 15
                            	  2642: ; for done, clear, then `move.w (a0),(a1)+` with a0 = $FF0008.  The
                            	  2643: ; firmware writes XLTR_COUNTER ($FF020C) = 4 when the bulk port is the
                            	  2644: ; source, which is the concrete role of that register.
                            	  2645: ;
                            	  2646: ; It reads $FF0000 BEFORE and AFTER the drain, because that is the one
                            	  2647: ; SBC-visible test of whether the word count is a hardware down-counter.
                            	  2648: ; The firmware only ever COMPARES that register — three cmpi, never a
                            	  2649: ; move — and never writes it, while its value decreases as the FIFO is
                            	  2650: ; popped; and the AP I/F photograph carries six 74S169 synchronous
                            	  2651: ; UP/DOWN counters against three up-only parts.  Firmware evidence and
                            	  2652: ; silicon agree and neither was derived from the other.  If the count
                            	  2653: ; does not fall, either the port is not being popped or the counter is
                            	  2654: ; not loaded — and this prints both readings so the operator can tell.
                            	  2655: ;
                            	  2656: ; --- p ---
                            	  2657: ; MODE2 ($FF0210) is the page register for the $400000 window:
                            	  2658: ; page = addr >> 20, offset = (addr & $FFFFF) << 2, so one page is 1M
                            	  2659: ; longwords and the field is 12 bits — 4096 pages, not the 4 bits the
                            	  2660: ; observed $0/$F suggest.  MODE2 is saved and restored, because the
                            	  2661: ; firmware itself saves and restores it in all four of its disciplines
                            	  2662: ; and RTOS init forces it to zero; leaving it changed would put a later
                            	  2663: ; operation on the wrong page with no path to correction.
                            	  2664: ;
                            	  2665: ; --- q ---
                            	  2666: ; All eleven $FF0004 sites in the firmware are byte-identical UNBOUNDED
                            	  2667: ; spins: move.w, btst #0, beq back, with no counter and no exit but
                            	  2668: ; success.  That makes it the hardest obligation on the board — a model
                            	  2669: ; that never raises it produces no diagnostic at all — so the one thing
                            	  2670: ; a probe must not do is reproduce the unbounded spin.  This one counts.
                            	  2671: ;================================================================
                            	  2672: cmd_bulk:
01:00F0BB14 528E            	  2673:                 addq.l  #1,a6
01:00F0BB16 6100F724        	  2674:                 bsr.w   skip_ws
01:00F0BB1A 7A08            	  2675:                 moveq   #8,d5                   ; default words
01:00F0BB1C 1016            	  2676:                 move.b  (a6),d0
01:00F0BB1E 671C            	  2677:                 beq.b   .havecnt
01:00F0BB20 6100F72E        	  2678:                 bsr.w   parse_hex
01:00F0BB24 4A01            	  2679:                 tst.b   d1
01:00F0BB26 6700F078        	  2680:                 beq.w   cmd_err
01:00F0BB2A 2A00            	  2681:                 move.l  d0,d5
                            	  2682:                 ; Two ways a typo used to run the .drain loop 2^32 times,
                            	  2683:                 ; popping the $FF0008 FIFO and writing 8 GB through a 640-byte
                            	  2684:                 ; ring.  xdump's own guard is downstream and cannot help --
                            	  2685:                 ; .drain runs first.
01:00F0BB2C 4A85            	  2686:                 tst.l   d5
01:00F0BB2E 6700F070        	  2687:                 beq.w   cmd_err                 ; `e 0`: subq/bne wraps to -1
01:00F0BB32 0C8500000040    	  2688:                 cmpi.l  #64,d5
01:00F0BB38 6302            	  2689:                 bls.b   .havecnt                ; UNSIGNED -- `ble` let every
                            	  2690:                                                 ;   value >= $80000000 through
                            	  2691:                                                 ;   the clamp as "negative"
01:00F0BB3A 7A40            	  2692:                 moveq   #64,d5
                            	  2693: .havecnt:
01:00F0BB3C 41FA1581        	  2694:                 lea     bulk_arm_msg(pc),a0
01:00F0BB40 6100F9C2        	  2695:                 bsr.w   puts
01:00F0BB44 33FC040000FF0218	  2696:                 move.w  #$400,$FF0218           ; arm
01:00F0BB4C 7E024847        	  2697:                 move.l  #$20000,d7
                            	  2698: .wait:
01:00F0BB50 303900FF0218    	  2699:                 move.w  $FF0218,d0
01:00F0BB56 0800000F        	  2700:                 btst    #15,d0
01:00F0BB5A 6618            	  2701:                 bne.b   .ready
01:00F0BB5C 5387            	  2702:                 subq.l  #1,d7
01:00F0BB5E 66F0            	  2703:                 bne.b   .wait
01:00F0BB60 41FA1588        	  2704:                 lea     bulk_to_msg(pc),a0
01:00F0BB64 6100F99E        	  2705:                 bsr.w   puts
01:00F0BB68 33FC000000FF0218	  2706:                 move.w  #0,$FF0218
01:00F0BB70 6000EDFE        	  2707:                 bra.w   cmd_loop
                            	  2708: .ready:
01:00F0BB74 33FC000000FF0218	  2709:                 move.w  #0,$FF0218              ; clear the arm
                            	  2710:                 ; $FF020C is READABLE and was the one device this monitor
                            	  2711:                 ; changed without putting back -- cmd_ac restores the BIM CR
                            	  2712:                 ; and $FF021A, cmd_page restores MODE2, cmd_tap restores the
                            	  2713:                 ; vectors, and this did not.  4 is the operational value at
                            	  2714:                 ; all seven firmware sites, so the write is usually a no-op;
                            	  2715:                 ; $01 and $FF are the boot-diagnostic values, and silently
                            	  2716:                 ; overwriting one of those is how a probe changes the state
                            	  2717:                 ; it was brought in to observe.  On the STACK, not a
                            	  2718:                 ; register: xdump below clobbers d3/d4/d6.
01:00F0BB7C 3F3900FF020C    	  2719:                 move.w  $FF020C,-(sp)
01:00F0BB82 33FC000400FF020C	  2720:                 move.w  #4,$FF020C              ; counter/config, bulk source
01:00F0BB8A 3C3900FF0000    	  2721:                 move.w  $FF0000,d6              ; count BEFORE
01:00F0BB90 41FA157C        	  2722:                 lea     bulk_pre_msg(pc),a0
01:00F0BB94 6100F96E        	  2723:                 bsr.w   puts
01:00F0BB98 3006            	  2724:                 move.w  d6,d0
01:00F0BB9A 6100F9AC        	  2725:                 bsr.w   puthex_word
01:00F0BB9E 6100F970        	  2726:                 bsr.w   put_crlf
                            	  2727: 
                            	  2728:                 ; Borrowing the tap ring as scratch destroys whatever the tap
                            	  2729:                 ; captured, so invalidate its bookkeeping FIRST -- otherwise a
                            	  2730:                 ; later `sl` prints bulk words as if they were channel
                            	  2731:                 ; interrupts, with fabricated timestamps and channel numbers.
                            	  2732:                 ; Arming the tap and then running `e` to see whether the drain
                            	  2733:                 ; raises an interrupt is a sensible experiment; silently
                            	  2734:                 ; mislabelling the result is not.  A capture that reports the
                            	  2735:                 ; wrong value is worse than none, because it is believed.
01:00F0BBA2 33FC00000000F8E8	  2736:                 move.w  #0,MON_RINGHD
01:00F0BBAA 33FC00000000F8EA	  2737:                 move.w  #0,MON_RINGN
01:00F0BBB2 33FC00000000F8EC	  2738:                 move.w  #0,MON_RINGOV
01:00F0BBBA 49F90000F900    	  2739:                 lea     MON_RING,a4             ; land the words in the ring
01:00F0BBC0 2605            	  2740:                 move.l  d5,d3
                            	  2741: .drain:
01:00F0BBC2 38F900FF0008    	  2742:                 move.w  $FF0008,(a4)+
01:00F0BBC8 5383            	  2743:                 subq.l  #1,d3
01:00F0BBCA 66F6            	  2744:                 bne.b   .drain
                            	  2745: 
01:00F0BBCC 383900FF0000    	  2746:                 move.w  $FF0000,d4              ; count AFTER
01:00F0BBD2 41FA1552        	  2747:                 lea     bulk_post_msg(pc),a0
01:00F0BBD6 6100F92C        	  2748:                 bsr.w   puts
01:00F0BBDA 3004            	  2749:                 move.w  d4,d0
01:00F0BBDC 6100F96A        	  2750:                 bsr.w   puthex_word
01:00F0BBE0 6100F92E        	  2751:                 bsr.w   put_crlf
                            	  2752:                 ; UNSIGNED, and this is the FOURTH instance of the same bug
                            	  2753:                 ; -- the clamp twenty lines up already carries the comment
                            	  2754:                 ; "UNSIGNED -- `ble` let every value >= $80000000 through",
                            	  2755:                 ; and this comparison in the SAME routine was missed.
                            	  2756:                 ;
                            	  2757:                 ; d6 is the count BEFORE and d4 the count AFTER, both read
                            	  2758:                 ; from $FF0000, which the record establishes as a HARDWARE
                            	  2759:                 ; DOWN-COUNTER loaded off-card by the host -- six 74S169
                            	  2760:                 ; up/down parts against three up-only, and the CPU never
                            	  2761:                 ; writes it.  A microcode bank is $8000 words, so counts
                            	  2762:                 ; above $7FFF are ordinary rather than exotic.
                            	  2763:                 ;
                            	  2764:                 ; With bge, a count falling $8000 -> $7FFF (a decrement of
                            	  2765:                 ; exactly one) reads as +32767 >= -32768 and reports "count
                            	  2766:                 ; did NOT fall"; a count RISING $7FFF -> $8000 reports that
                            	  2767:                 ; it fell.  Both inversions land on the one operation this
                            	  2768:                 ; command exists for: draining a bulk microcode load.
01:00F0BBE4 B846            	  2769:                 cmp.w   d6,d4
01:00F0BBE6 6406            	  2770:                 bcc.b   .nodec
01:00F0BBE8 41FA1554        	  2771:                 lea     bulk_dec_msg(pc),a0
01:00F0BBEC 6004            	  2772:                 bra.b   .say
                            	  2773: .nodec:
01:00F0BBEE 41FA158B        	  2774:                 lea     bulk_flat_msg(pc),a0
                            	  2775: .say:
01:00F0BBF2 6100F910        	  2776:                 bsr.w   puts
01:00F0BBF6 49F90000F900    	  2777:                 lea     MON_RING,a4
01:00F0BBFC 2405            	  2778:                 move.l  d5,d2
01:00F0BBFE 7E02            	  2779:                 moveq   #2,d7
01:00F0BC00 6100F95E        	  2780:                 bsr.w   xdump
01:00F0BC04 33DF00FF020C    	  2781:                 move.w  (sp)+,$FF020C           ; put the counter/config back
                            	  2782:                                                 ;   (pushed at .ready; the
                            	  2783:                                                 ;   timeout path exits before
                            	  2784:                                                 ;   the push, so both exits
                            	  2785:                                                 ;   leave the stack balanced)
01:00F0BC0A 6000ED64        	  2786:                 bra.w   cmd_loop
