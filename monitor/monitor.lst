01:00F0B00A 10C0            	   953:                 move.b  d0,(a0)+
01:00F0B00C 51CAFFDC        	   954:                 dbra    d2,.rloop
                            	   955: .end:
01:00F0B010 10BC0000        	   956:                 move.b  #0,(a0)                 ; not clr: CLR reads first
01:00F0B014 61000224        	   957:                 bsr.w   put_crlf
01:00F0B018 4E75            	   958:                 rts
                            	   959: .bs:
01:00F0B01A B1FC0000F850    	   960:                 cmpa.l  #MON_LINEBUF,a0
01:00F0B020 67C8            	   961:                 beq.b   .rloop                  ; empty - ignore
01:00F0B022 5388            	   962:                 subq.l  #1,a0
01:00F0B024 5282            	   963:                 addq.l  #1,d2
01:00F0B026 103C0008        	   964:                 move.b  #8,d0
01:00F0B02A 610001B6        	   965:                 bsr.w   putchar
01:00F0B02E 103C0020        	   966:                 move.b  #' ',d0
01:00F0B032 610001AE        	   967:                 bsr.w   putchar
01:00F0B036 103C0008        	   968:                 move.b  #8,d0
01:00F0B03A 610001A6        	   969:                 bsr.w   putchar
01:00F0B03E 60AA            	   970:                 bra.b   .rloop
