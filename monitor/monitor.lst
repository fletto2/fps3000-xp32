                            	   567: ; ---- SIO init for 9600 8N1, RX+TX enabled, no IRQs ----
                            	   568: sio_init:
                            	   569:                 ; Channel reset
00:00F0AD22 13FC001800F70012	   570:                 move.b  #$18,SIO_A_CTRL         ; WR0: cmd 3 = chan reset
