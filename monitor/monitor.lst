01:00F0B67A 6100FBC0        	  2046:                 bsr.w   skip_ws
01:00F0B67E 6100FBD0        	  2047:                 bsr.w   parse_hex
01:00F0B682 4A01            	  2048:                 tst.b   d1
01:00F0B684 6706            	  2049:                 beq.b   .noc
01:00F0B686 2640            	  2050:                 move.l  d0,a3
01:00F0B688 7001            	  2051:                 moveq   #1,d0
01:00F0B68A 2440            	  2052:                 move.l  d0,a2
