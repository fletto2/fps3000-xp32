01:00F0ADE0 41FA13F6        	   750:                 lea     bp_list_msg(pc),a0
01:00F0ADE4 610005DE        	   751:                 bsr.w   puts
01:00F0ADE8 49F90000F8A0    	   752:                 lea     MON_BPT,a4
01:00F0ADEE 7607            	   753:                 moveq   #MON_BPN-1,d3
01:00F0ADF0 7A00            	   754:                 moveq   #0,d5                   ; count
                            	   755: .scan:
01:00F0ADF2 2014            	   756:                 move.l  (a4),d0
01:00F0ADF4 6728            	   757:                 beq.b   .next
01:00F0ADF6 5285            	   758:                 addq.l  #1,d5
01:00F0ADF8 103C0020        	   759:                 move.b  #' ',d0
01:00F0ADFC 6100057A        	   760:                 bsr.w   putchar
01:00F0AE00 61000576        	   761:                 bsr.w   putchar
01:00F0AE04 2014            	   762:                 move.l  (a4),d0
01:00F0AE06 6100060C        	   763:                 bsr.w   puthex_long
01:00F0AE0A 41FA13E6        	   764:                 lea     bp_was_msg(pc),a0
01:00F0AE0E 610005B4        	   765:                 bsr.w   puts
01:00F0AE12 302C0004        	   766:                 move.w  4(a4),d0
01:00F0AE16 610005F0        	   767:                 bsr.w   puthex_word
01:00F0AE1A 610005B4        	   768:                 bsr.w   put_crlf
                            	   769: .next:
01:00F0AE1E 5C8C            	   770:                 lea     MON_BP_SZ(a4),a4
01:00F0AE20 51CBFFD0        	   771:                 dbra    d3,.scan
01:00F0AE24 4A85            	   772:                 tst.l   d5
01:00F0AE26 6600FB20        	   773:                 bne.w   cmd_loop
01:00F0AE2A 41FA13BB        	   774:                 lea     bp_empty_msg(pc),a0
01:00F0AE2E 61000594        	   775:                 bsr.w   puts
01:00F0AE32 6000FB14        	   776:                 bra.w   cmd_loop
                            	   777: 
                            	   778: ;================================================================
                            	   779: ; Single step:  t
                            	   780: ;
                            	   781: ; Sets the T bit in the saved SR and resumes.  The 68000 then takes a
                            	   782: ; trace exception after one instruction, which lands back in the monitor
                            	   783: ; (vector 9 at $24).  Needs a resumable frame, same as `g`.  The T bit
                            	   784: ; stays set in the restored SR, so `t` repeats naturally; `g` clears it
                            	   785: ; on the way out so a resume does not keep tracing.
                            	   786: ;================================================================
                            	   787: cmd_trace:
01:00F0AE36 4A390000F894    	   788:                 tst.b   MON_GRP0
01:00F0AE3C 66000040        	   789:                 bne.w   trace_noframe
01:00F0AE40 21FC00F0A8400024	   790:                 move.l  #monitor_entry,TRACE_VECTOR
01:00F0AE48 08F900070000F840	   791:                 bset.b  #SR_TRACE_BIT-8,MON_SSR ; high byte of the saved SR
01:00F0AE50 41FA13A9        	   792:                 lea     trace_msg(pc),a0
01:00F0AE54 6100056E        	   793:                 bsr.w   puts
01:00F0AE58 20390000F83C    	   794:                 move.l  MON_SPC,d0
01:00F0AE5E 610005B4        	   795:                 bsr.w   puthex_long
01:00F0AE62 6100056C        	   796:                 bsr.w   put_crlf
01:00F0AE66 2F790000F83C0002	   797:                 move.l  MON_SPC,2(sp)
01:00F0AE6E 3EB90000F840    	   798:                 move.w  MON_SSR,(sp)
01:00F0AE74 4CF97FFF0000F800	   799:                 movem.l MON_REGS,d0-d7/a0-a6
01:00F0AE7C 4E73            	   800:                 rte
                            	   801: trace_noframe:
01:00F0AE7E 41FA1387        	   802:                 lea     nogo_msg(pc),a0
01:00F0AE82 61000540        	   803:                 bsr.w   puts
01:00F0AE86 6000FAC0        	   804:                 bra.w   cmd_loop
                            	   805: 
                            	   806: ;----------------------------------------------------------------
                            	   807: ; Info — chassis state, ROM version, free RAM, etc.
                            	   808: ;----------------------------------------------------------------
                            	   809: cmd_info:
01:00F0AE8A 41FA13F3        	   810:                 lea     info_msg(pc),a0
01:00F0AE8E 61000534        	   811:                 bsr.w   puts
                            	   812: 
                            	   813:                 ; Live board status.  Byte read at ODD $F70019 — the board
                            	   814:                 ; status/control register is an 8-bit device on D0-D7, and
                            	   815:                 ; the ROM bit-tests this same odd byte (F08728 etc).
01:00F0AE92 41FA1553        	   816:                 lea     bstat_msg(pc),a0
01:00F0AE96 6100052C        	   817:                 bsr.w   puts
01:00F0AE9A 103900F70019    	   818:                 move.b  $F70019,d0
01:00F0AEA0 61000558        	   819:                 bsr.w   puthex_byte
01:00F0AEA4 6100052A        	   820:                 bsr.w   put_crlf
                            	   821: 
                            	   822:                 ; VERSAmodule control register image at $1FFF0.  Per the
                            	   823:                 ; manual this is "control register image only — register
                            	   824:                 ; not directly accessible", so read-back is mediated by
                            	   825:                 ; external logic and may not reflect what was written.
01:00F0AEA8 41FA1555        	   826:                 lea     vmod_msg(pc),a0
01:00F0AEAC 61000516        	   827:                 bsr.w   puts
01:00F0AEB0 30390001FFF0    	   828:                 move.w  $1FFF0,d0
01:00F0AEB6 61000550        	   829:                 bsr.w   puthex_word
01:00F0AEBA 61000514        	   830:                 bsr.w   put_crlf
                            	   831: 
                            	   832:                 ; Where this build actually ends, rather than a hardcoded
                            	   833:                 ; number that goes stale every time the monitor grows.
01:00F0AEBE 41FA1556        	   834:                 lea     mend_msg(pc),a0
01:00F0AEC2 61000500        	   835:                 bsr.w   puts
01:00F0AEC6 203C00F0CA5E    	   836:                 move.l  #monitor_end,d0
01:00F0AECC 61000546        	   837:                 bsr.w   puthex_long
01:00F0AED0 610004FE        	   838:                 bsr.w   put_crlf
                            	   839: 
                            	   840:                 ; Fault / link state: frame kind, nest guard, TX-timeout
                            	   841:                 ; flag.  MON_NEST = 2 means a previous run died while
                            	   842:                 ; reporting a fault; MON_TXFAIL = 1 means putchar gave up
                            	   843:                 ; waiting for the SIO at some point.
01:00F0AED4 41FA1557        	   844:                 lea     fault_msg(pc),a0
01:00F0AED8 610004EA        	   845:                 bsr.w   puts
01:00F0AEDC 10390000F894    	   846:                 move.b  MON_GRP0,d0
01:00F0AEE2 61000516        	   847:                 bsr.w   puthex_byte
01:00F0AEE6 103C002F        	   848:                 move.b  #'/',d0
01:00F0AEEA 6100048C        	   849:                 bsr.w   putchar
01:00F0AEEE 10390000F895    	   850:                 move.b  MON_NEST,d0
01:00F0AEF4 61000504        	   851:                 bsr.w   puthex_byte
01:00F0AEF8 103C002F        	   852:                 move.b  #'/',d0
01:00F0AEFC 6100047A        	   853:                 bsr.w   putchar
01:00F0AF00 10390000F896    	   854:                 move.b  MON_TXFAIL,d0
01:00F0AF06 610004F2        	   855:                 bsr.w   puthex_byte
01:00F0AF0A 41FA0EA6        	   856:                 lea     faddr_msg(pc),a0
01:00F0AF0E 610004B4        	   857:                 bsr.w   puts
01:00F0AF12 20390000F898    	   858:                 move.l  MON_FADDR,d0
01:00F0AF18 610004FA        	   859:                 bsr.w   puthex_long
01:00F0AF1C 41FA0E9E        	   860:                 lea     ssw_msg(pc),a0
01:00F0AF20 610004A2        	   861:                 bsr.w   puts
01:00F0AF24 30390000F89C    	   862:                 move.w  MON_SSW,d0
01:00F0AF2A 610004DC        	   863:                 bsr.w   puthex_word
01:00F0AF2E 610004A0        	   864:                 bsr.w   put_crlf
01:00F0AF32 6000FA14        	   865:                 bra.w   cmd_loop
                            	   866: 
                            	   867: ;----------------------------------------------------------------
                            	   868: ; Load S-record over the SIO (channel A).
                            	   869: ; Each line consumed and validated; bytes go to addresses inside.
                            	   870: ; Terminator: S8 / S9 record.
                            	   871: ;----------------------------------------------------------------
                            	   872: cmd_load_srec:
01:00F0AF36 41FA1312        	   873:                 lea     load_msg(pc),a0
01:00F0AF3A 61000488        	   874:                 bsr.w   puts
01:00F0AF3E 7800            	   875:                 clr.l   d4                      ; record count
01:00F0AF40 7A00            	   876:                 clr.l   d5                      ; byte count
                            	   877: .scan_S:
01:00F0AF42 61000466        	   878:                 bsr.w   getchar
01:00F0AF46 0C000053        	   879:                 cmpi.b  #'S',d0
01:00F0AF4A 66F6            	   880:                 bne.b   .scan_S                  ; skip until 'S'
01:00F0AF4C 6100045C        	   881:                 bsr.w   getchar                  ; record type
01:00F0AF50 0C000038        	   882:                 cmpi.b  #'8',d0
01:00F0AF54 670000F2        	   883:                 beq.w   .terminator
01:00F0AF58 0C000039        	   884:                 cmpi.b  #'9',d0
01:00F0AF5C 670000EA        	   885:                 beq.w   .terminator
01:00F0AF60 0C000037        	   886:                 cmpi.b  #'7',d0
01:00F0AF64 670000E2        	   887:                 beq.w   .terminator
01:00F0AF68 0C000030        	   888:                 cmpi.b  #'0',d0
01:00F0AF6C 670000C4        	   889:                 beq.w   .eat_eol                ; header — skip
01:00F0AF70 0C000031        	   890:                 cmpi.b  #'1',d0
01:00F0AF74 6D00FFCC        	   891:                 blt.w   .scan_S
01:00F0AF78 0C000033        	   892:                 cmpi.b  #'3',d0
01:00F0AF7C 6E00FFC4        	   893:                 bgt.w   .scan_S
                            	   894:                 ; data record S1 / S2 / S3
01:00F0AF80 1C00            	   895:                 move.b  d0,d6                   ; save type
01:00F0AF82 61000296        	   896:                 bsr.w   read_hex_byte
                            	   897:                 ; read_hex_byte only writes d0's low byte, so the upper 24
                            	   898:                 ; bits are stale.  Zero-extend explicitly, and keep the
                            	   899:                 ; count word-sized below: a payload count >= $80 is legal
                            	   900:                 ; in an S1 record, and a signed byte test would read it as
                            	   901:                 ; negative and silently truncate the record to no data.
01:00F0AF86 7400            	   902:                 moveq   #0,d2
01:00F0AF88 1400            	   903:                 move.b  d0,d2                   ; payload count (incl addr+cksum)
                            	   904:                 ; d7 accumulates the record checksum: sum of the count byte,
                            	   905:                 ; the address bytes and the data bytes.  A valid record has
                            	   906:                 ; (sum + cksum) & $FF == $FF.  Without this a corrupted line
                            	   907:                 ; loads silently and reports success, which over a serial
                            	   908:                 ; link at an unverified baud rate is exactly the failure we
                            	   909:                 ; would not notice.
01:00F0AF8A 7E00            	   910:                 moveq   #0,d7
01:00F0AF8C DE00            	   911:                 add.b   d0,d7
01:00F0AF8E 7600            	   912:                 clr.l   d3
01:00F0AF90 0C060033        	   913:                 cmpi.b  #'3',d6
01:00F0AF94 6708            	   914:                 beq.b   .a32
01:00F0AF96 0C060032        	   915:                 cmpi.b  #'2',d6
01:00F0AF9A 670E            	   916:                 beq.b   .a24
01:00F0AF9C 6018            	   917:                 bra.b   .a16
                            	   918: .a32:
01:00F0AF9E 6100027A        	   919:                 bsr.w   read_hex_byte
01:00F0AFA2 DE00            	   920:                 add.b   d0,d7
01:00F0AFA4 E18B            	   921:                 lsl.l   #8,d3
01:00F0AFA6 8600            	   922:                 or.b    d0,d3
01:00F0AFA8 5342            	   923:                 subq.w  #1,d2
                            	   924: .a24:
01:00F0AFAA 6100026E        	   925:                 bsr.w   read_hex_byte
01:00F0AFAE DE00            	   926:                 add.b   d0,d7
01:00F0AFB0 E18B            	   927:                 lsl.l   #8,d3
01:00F0AFB2 8600            	   928:                 or.b    d0,d3
01:00F0AFB4 5342            	   929:                 subq.w  #1,d2
                            	   930: .a16:
01:00F0AFB6 61000262        	   931:                 bsr.w   read_hex_byte
01:00F0AFBA DE00            	   932:                 add.b   d0,d7
01:00F0AFBC E18B            	   933:                 lsl.l   #8,d3
01:00F0AFBE 8600            	   934:                 or.b    d0,d3
01:00F0AFC0 61000258        	   935:                 bsr.w   read_hex_byte
01:00F0AFC4 DE00            	   936:                 add.b   d0,d7
01:00F0AFC6 E18B            	   937:                 lsl.l   #8,d3
01:00F0AFC8 8600            	   938:                 or.b    d0,d3
01:00F0AFCA 5542            	   939:                 subq.w  #2,d2
01:00F0AFCC 5342            	   940:                 subq.w  #1,d2                   ; -1 for checksum
01:00F0AFCE 2843            	   941:                 move.l  d3,a4                   ; dest pointer
01:00F0AFD0 6100020C        	   942:                 bsr.w   srec_check              ; d1 = 0 -> would self-destruct
01:00F0AFD4 4A01            	   943:                 tst.b   d1
01:00F0AFD6 67000044        	   944:                 beq.w   .badaddr
                            	   945: .dloop:
01:00F0AFDA 4A42            	   946:                 tst.w   d2
01:00F0AFDC 6F0E            	   947:                 ble.b   .endrec
01:00F0AFDE 6100023A        	   948:                 bsr.w   read_hex_byte
01:00F0AFE2 DE00            	   949:                 add.b   d0,d7
01:00F0AFE4 18C0            	   950:                 move.b  d0,(a4)+
01:00F0AFE6 5285            	   951:                 addq.l  #1,d5
01:00F0AFE8 5342            	   952:                 subq.w  #1,d2
01:00F0AFEA 60EE            	   953:                 bra.b   .dloop
                            	   954: .endrec:
01:00F0AFEC 6100022C        	   955:                 bsr.w   read_hex_byte           ; the record's checksum byte
01:00F0AFF0 DE00            	   956:                 add.b   d0,d7
01:00F0AFF2 0C0700FF        	   957:                 cmpi.b  #$FF,d7
01:00F0AFF6 660E            	   958:                 bne.b   .badsum
01:00F0AFF8 5284            	   959:                 addq.l  #1,d4
01:00F0AFFA 103C002E        	   960:                 move.b  #'.',d0
01:00F0AFFE 61000378        	   961:                 bsr.w   putchar
01:00F0B002 6000002E        	   962:                 bra.w   .eat_eol
                            	   963: .badsum:
                            	   964:                 ; The data was already written by the time we can check, so
                            	   965:                 ; say which record failed and let the operator re-send it.
01:00F0B006 41FA1469        	   966:                 lea     srec_sum_msg(pc),a0
01:00F0B00A 610003B8        	   967:                 bsr.w   puts
01:00F0B00E 2003            	   968:                 move.l  d3,d0
01:00F0B010 61000402        	   969:                 bsr.w   puthex_long
01:00F0B014 610003BA        	   970:                 bsr.w   put_crlf
01:00F0B018 6000FF28        	   971:                 bra.w   .scan_S
                            	   972: .badaddr:
                            	   973:                 ; Skip this record.  No need to consume its hex: .scan_S
                            	   974:                 ; resyncs on the next 'S', and hex digits are 0-9A-F so
                            	   975:                 ; none of the skipped payload can be mistaken for a
                            	   976:                 ; record start.
01:00F0B01C 41FA1426        	   977:                 lea     srec_bad_msg(pc),a0
01:00F0B020 610003A2        	   978:                 bsr.w   puts
01:00F0B024 2003            	   979:                 move.l  d3,d0
01:00F0B026 610003EC        	   980:                 bsr.w   puthex_long
01:00F0B02A 610003A4        	   981:                 bsr.w   put_crlf
01:00F0B02E 6000FF12        	   982:                 bra.w   .scan_S
                            	   983: .eat_eol:
01:00F0B032 61000376        	   984:                 bsr.w   getchar
01:00F0B036 0C00000D        	   985:                 cmpi.b  #13,d0
