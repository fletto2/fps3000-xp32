                            	   607: .scan:
01:00F0ACCE 2014            	   608:                 move.l  (a4),d0
01:00F0ACD0 6728            	   609:                 beq.b   .next
01:00F0ACD2 5285            	   610:                 addq.l  #1,d5
01:00F0ACD4 103C0020        	   611:                 move.b  #' ',d0
01:00F0ACD8 610004F4        	   612:                 bsr.w   putchar
01:00F0ACDC 610004F0        	   613:                 bsr.w   putchar
01:00F0ACE0 2014            	   614:                 move.l  (a4),d0
01:00F0ACE2 61000576        	   615:                 bsr.w   puthex_long
01:00F0ACE6 41FA08BC        	   616:                 lea     bp_was_msg(pc),a0
01:00F0ACEA 6100051E        	   617:                 bsr.w   puts
01:00F0ACEE 302C0004        	   618:                 move.w  4(a4),d0
01:00F0ACF2 6100055A        	   619:                 bsr.w   puthex_word
01:00F0ACF6 6100051E        	   620:                 bsr.w   put_crlf
                            	   621: .next:
01:00F0ACFA 5C8C            	   622:                 lea     MON_BP_SZ(a4),a4
01:00F0ACFC 51CBFFD0        	   623:                 dbra    d3,.scan
01:00F0AD00 4A85            	   624:                 tst.l   d5
01:00F0AD02 6600FBF6        	   625:                 bne.w   cmd_loop
01:00F0AD06 41FA0891        	   626:                 lea     bp_empty_msg(pc),a0
01:00F0AD0A 610004FE        	   627:                 bsr.w   puts
