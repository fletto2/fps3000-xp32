                            	   637: 
                            	   638: ;================================================================
                            	   639: ; Single step:  t
                            	   640: ;
                            	   641: ; Sets the T bit in the saved SR and resumes.  The 68000 then takes a
                            	   642: ; trace exception after one instruction, which lands back in the monitor
                            	   643: ; (vector 9 at $24).  Needs a resumable frame, same as `g`.  The T bit
                            	   644: ; stays set in the restored SR, so `t` repeats naturally; `g` clears it
                            	   645: ; on the way out so a resume does not keep tracing.
                            	   646: ;================================================================
                            	   647: cmd_trace:
01:00F0AD26 4A390000F894    	   648:                 tst.b   MON_GRP0
01:00F0AD2C 66000040        	   649:                 bne.w   trace_noframe
01:00F0AD30 21FC00F0A8400024	   650:                 move.l  #monitor_entry,TRACE_VECTOR
01:00F0AD38 08F900070000F840	   651:                 bset.b  #SR_TRACE_BIT-8,MON_SSR ; high byte of the saved SR
01:00F0AD40 41FA0897        	   652:                 lea     trace_msg(pc),a0
01:00F0AD44 610004E8        	   653:                 bsr.w   puts
01:00F0AD48 20390000F83C    	   654:                 move.l  MON_SPC,d0
01:00F0AD4E 6100052E        	   655:                 bsr.w   puthex_long
01:00F0AD52 610004E6        	   656:                 bsr.w   put_crlf
01:00F0AD56 2F790000F83C0002	   657:                 move.l  MON_SPC,2(sp)
01:00F0AD5E 3EB90000F840    	   658:                 move.w  MON_SSR,(sp)
01:00F0AD64 4CF97FFF0000F800	   659:                 movem.l MON_REGS,d0-d7/a0-a6
01:00F0AD6C 4E73            	   660:                 rte
                            	   661: trace_noframe:
01:00F0AD6E 41FA0875        	   662:                 lea     nogo_msg(pc),a0
01:00F0AD72 610004BA        	   663:                 bsr.w   puts
01:00F0AD76 6000FB82        	   664:                 bra.w   cmd_loop
